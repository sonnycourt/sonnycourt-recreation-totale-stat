    color: #007AFF;
  }

  .share-copied-toast {
    position: absolute;
    bottom: -40px;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: #34C759;
    color: #fff;
    padding: 8px 16px;
    border-radius: 8px;
