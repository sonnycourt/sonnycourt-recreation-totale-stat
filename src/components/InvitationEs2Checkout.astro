  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: radial-gradient(1200px 600px at 50% -100px, rgba(59, 130, 246, 0.18), transparent 60%), #0f172a;
      color: #fff;
      min-height: 100vh;
    }
    .page {
      max-width: 1080px;
      margin: 0 auto;
      padding: 48px 16px 80px;
    }
    .hero { text-align: center; margin-bottom: 26px; }
    .hero h1 {
      font-size: clamp(28px, 5vw, 44px);
      font-weight: 900;
      line-height: 1.15;
      letter-spacing: -0.01em;
      margin-bottom: 16px;
    }
    .hero h1 .accent { color: #60a5fa; display: block; margin-top: 4px; }
    @media (min-width: 769px) {
      .hero h1 .accent { margin-top: 10px; }
    }
    .hero .sub {
      font-size: clamp(15px, 2.5vw, 18px);
      line-height: 1.55;
      color: rgba(255, 255, 255, 0.78);
      max-width: 700px;
      margin: 0 auto;
    }
    /* Urgence personnalisée : reste visible pendant tout le checkout. */
    .urgency-sticky {
      width: 0;
      height: 0;
      pointer-events: none;
    }
    .offer-countdown { margin: 0; text-align: center; display: none; }
    .offer-countdown.is-visible { display: block; }
    .offer-countdown-grid {
      display: flex;
      gap: 6px;
    }
    .offer-countdown-box {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-width: 52px;
      padding: 6px 7px 5px;
      border-radius: 10px;
      border: 1px solid rgba(248, 113, 113, 0.2);
      background: rgba(2, 6, 23, 0.52);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
    .offer-countdown-value {
      font-size: 20px;
      line-height: 1;
      font-weight: 900;
      color: #fff;
      font-variant-numeric: tabular-nums;
      text-shadow: 0 0 18px rgba(239, 68, 68, 0.45);
    }
    .offer-countdown-label {
      font-size: 8px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.5);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-top: 3px;
    }
    /* Barre de progression préremplissage : encadré bleu premium, jumeau du bloc rouge */
    .prefill-progress {
      display: none;
      position: relative;
      margin: 30px auto 0;
      width: 100%;
      padding: 18px 26px 16px;
      border-radius: 16px;
      border: 1px solid rgba(96, 165, 250, 0.32);
      background:
        radial-gradient(140% 180% at 50% -40%, rgba(37, 99, 235, 0.22) 0%, rgba(15, 23, 42, 0.55) 55%, rgba(15, 23, 42, 0.85) 100%);
      box-shadow:
        0 18px 45px rgba(30, 58, 138, 0.22),
        0 0 0 1px rgba(255, 255, 255, 0.03),
        inset 0 1px 0 rgba(255, 255, 255, 0.07);
      backdrop-filter: blur(8px);
    }
    .prefill-progress.is-visible { display: block; }
    .prefill-progress::before {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(135deg, rgba(96, 165, 250, 0.45), rgba(96, 165, 250, 0) 40%, rgba(96, 165, 250, 0) 60%, rgba(96, 165, 250, 0.25));
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
    }
    .page.is-locked .prefill-progress, .page.is-expired .prefill-progress { display: none; }
    .prefill-progress__row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 10px;
    }
    .prefill-progress__label {
      font-size: 14.5px;
      font-weight: 800;
      color: #fff;
    }
    .prefill-progress__pct {
      font-size: 16px;
      font-weight: 900;
      color: #60a5fa;
      font-variant-numeric: tabular-nums;
      text-shadow: 0 0 16px rgba(59, 130, 246, 0.5);
    }
    .prefill-progress__bar {
      height: 14px;
      border-radius: 999px;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.09);
      box-shadow: inset 0 1px 3px rgba(2, 6, 23, 0.5);
    }
    .prefill-progress__fill {
      position: relative;
      height: 100%;
      width: 0;
      border-radius: inherit;
      overflow: hidden;
      background: linear-gradient(90deg, #60a5fa, #2563eb);
      box-shadow: 0 0 16px rgba(59, 130, 246, 0.6);
      transition: width 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .prefill-progress__fill::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(110deg, rgba(255, 255, 255, 0) 20%, rgba(255, 255, 255, 0.38) 50%, rgba(255, 255, 255, 0) 80%);
      background-size: 220% 100%;
      animation: prefillShimmer 1.9s linear infinite;
    }
    @keyframes prefillShimmer {
      0% { background-position: 160% 0; }
      100% { background-position: -60% 0; }
    }
    .prefill-progress__hint {
      margin-top: 9px;
      font-size: 12.5px;
      color: rgba(255, 255, 255, 0.62);
    }
    /* Checkout */
    .checkout-layout {
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-top: 34px;
    }
    .checkout-wrap {
      min-width: 0;
      /* Fond transparent : le thème sombre de la page traverse l'embed
         (le checkout Spiffy est lui-même en fond transparent via son Custom CSS). */
    }
    .checkout-main {
      position: relative;
      min-width: 0;
    }
    .checkout-guidance {
      position: absolute;
      z-index: 2;
      width: 188px;
      pointer-events: none;
      filter: drop-shadow(0 8px 15px rgba(2, 6, 23, 0.42));
    }
    .checkout-guidance--card {
      top: 218px;
      left: -196px;
    }
    .checkout-guidance--submit {
      top: 590px;
      right: -196px;
      text-align: right;
    }
    .checkout-guidance--terms {
      top: 485px;
      left: -196px;
    }
    .checkout-guidance__sticker {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 12px 7px;
      border: 2px solid rgba(255, 255, 255, 0.88);
      border-radius: 8px 12px 9px 11px;
      background: #f8fafc;
      box-shadow:
        0 6px 18px rgba(2, 6, 23, 0.34),
        inset 0 -2px 0 rgba(15, 23, 42, 0.08);
      color: #0f172a;
      font-family: 'Caveat', 'Comic Sans MS', cursive;
      font-size: 18px;
      line-height: 1;
      font-weight: 700;
      white-space: nowrap;
      transform: rotate(-2.5deg);
    }
    .checkout-guidance__number {
      display: inline-grid;
      place-items: center;
      flex: 0 0 auto;
      width: 23px;
      height: 23px;
      border-radius: 50%;
      background: #2563eb;
      color: #fff;
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      line-height: 1;
      font-weight: 900;
      box-shadow: 0 3px 8px rgba(37, 99, 235, 0.3);
    }
    .checkout-guidance--submit .checkout-guidance__sticker {
      transform: rotate(2.5deg);
    }
    .checkout-guidance svg {
      display: block;
      width: 188px;
      height: 112px;
      overflow: visible;
      margin-top: 2px;
    }
    .checkout-guidance__line,
    .checkout-guidance__head {
      fill: none;
      stroke: rgba(255, 255, 255, 0.96);
      stroke-width: 4.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .checkout-guidance__line {
      filter: url(#checkout-handdrawn-softness);
    }
    .checkout-note {
      text-align: center;
      margin-top: 16px;
      font-size: 13px;
      color: rgba(255, 255, 255, 0.55);
    }
    /* Récapitulatif produit maison : Spiffy conserve uniquement la logique
       du formulaire et du paiement dans la colonne de gauche. */
    .checkout-sidebar {
      position: relative;
      display: block;
      min-width: 0;
    }
    .custom-order-card {
      display: grid;
      grid-template-columns: minmax(270px, 0.82fr) minmax(0, 1.18fr);
      grid-template-areas:
        "visual body"
        "price body"
        "offer offer";
      overflow: hidden;
      border: 1px solid rgba(96, 165, 250, 0.26);
      border-radius: 22px;
      background:
        radial-gradient(120% 70% at 50% 0%, rgba(37, 99, 235, 0.18), transparent 54%),
        rgba(8, 15, 31, 0.96);
      box-shadow:
        0 28px 70px rgba(2, 6, 23, 0.42),
        0 0 0 1px rgba(255, 255, 255, 0.025),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }
    .custom-order-card__visual {
      grid-area: visual;
      position: relative;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: #020617;
    }
    .custom-order-card__visual::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, transparent 55%, rgba(8, 15, 31, 0.96) 100%),
        linear-gradient(115deg, rgba(59, 130, 246, 0.08), transparent 55%);
      pointer-events: none;
    }
    .custom-order-card__visual img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }
    .custom-order-card__visual-label {
      position: absolute;
      z-index: 1;
      left: 18px;
      bottom: 14px;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 10px;
      border: 1px solid rgba(191, 219, 254, 0.24);
      border-radius: 999px;
      background: rgba(2, 6, 23, 0.7);
      color: #dbeafe;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.11em;
      text-transform: uppercase;
      backdrop-filter: blur(10px);
    }
    .custom-order-card__visual-label::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: #60a5fa;
      box-shadow: 0 0 12px rgba(96, 165, 250, 0.9);
    }
    .custom-order-card__body {
      grid-area: body;
      padding: 22px 20px 18px;
      border-left: 1px solid rgba(96, 165, 250, 0.13);
    }
    .custom-order-card__eyebrow {
      color: #60a5fa;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .custom-order-card__title {
      margin-top: 7px;
      font-size: 24px;
      line-height: 1.1;
      letter-spacing: -0.025em;
      font-weight: 900;
      color: #fff;
    }
    .custom-order-card__intro {
      margin-top: 9px;
      color: rgba(226, 232, 240, 0.7);
      font-size: 12.5px;
      line-height: 1.5;
    }
    .custom-order-card__list {
      display: grid;
      gap: 9px;
      margin-top: 18px;
      list-style: none;
    }
    .custom-order-card__item {
      display: grid;
      grid-template-columns: 34px minmax(0, 1fr);
      align-items: center;
      gap: 11px;
      padding: 10px 11px;
      border: 1px solid rgba(148, 163, 184, 0.11);
      border-radius: 13px;
      background: rgba(15, 23, 42, 0.55);
    }
    .custom-order-card__icon {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      border: 1px solid rgba(96, 165, 250, 0.24);
      border-radius: 10px;
      color: #93c5fd;
      background: rgba(37, 99, 235, 0.12);
      font-size: 10px;
      line-height: 1;
      font-weight: 900;
    }
    .custom-order-card__item strong {
      display: block;
      color: #f8fafc;
      font-size: 12.5px;
      line-height: 1.3;
    }
    .custom-order-card__item span:last-child {
      display: block;
      margin-top: 2px;
      color: rgba(203, 213, 225, 0.64);
      font-size: 10.5px;
      line-height: 1.35;
    }
    .custom-order-card__guarantee {
      display: flex;
      align-items: center;
      gap: 11px;
      margin-top: 17px;
      padding: 11px 13px;
      border: 1px solid rgba(96, 165, 250, 0.25);
      border-radius: 13px;
      color: #dbeafe;
      background:
        linear-gradient(135deg, rgba(37, 99, 235, 0.16), rgba(30, 58, 138, 0.08));
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.055),
        0 10px 24px rgba(2, 6, 23, 0.12);
    }
    .custom-order-card__guarantee-mark {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      flex: 0 0 34px;
      border: 1px solid rgba(74, 222, 128, 0.38);
      border-radius: 999px;
      color: #86efac;
      background:
        radial-gradient(circle at 50% 42%, rgba(74, 222, 128, 0.28), rgba(21, 128, 61, 0.14));
      box-shadow:
        0 0 10px rgba(34, 197, 94, 0.32),
        0 0 24px rgba(34, 197, 94, 0.2),
        inset 0 1px 0 rgba(220, 252, 231, 0.18);
    }
    .custom-order-card__guarantee-mark svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      filter: drop-shadow(0 0 5px rgba(74, 222, 128, 0.7));
    }
    .custom-order-card__guarantee-copy strong {
      display: block;
      color: #f8fafc;
      font-size: 13px;
      line-height: 1.25;
      font-weight: 900;
    }
    .custom-order-card__guarantee-copy small {
      display: block;
      margin-top: 3px;
      color: #93c5fd;
      font-size: 10.5px;
      line-height: 1.25;
      font-weight: 700;
    }
    .custom-order-card__price {
      grid-area: price;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 14px;
      row-gap: 11px;
      padding: 17px 20px 18px;
      border-top: 1px solid rgba(96, 165, 250, 0.17);
      background:
        linear-gradient(135deg, rgba(29, 78, 216, 0.28), rgba(37, 99, 235, 0.08));
    }
    .custom-order-card__price-copy {
      min-width: 0;
    }
    .custom-order-card__launch-offer {
      grid-area: offer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      min-height: 44px;
      padding: 13px 18px;
      border-top: 1px solid rgba(248, 113, 113, 0.38);
      color: #fee2e2;
      background: linear-gradient(90deg, rgba(127, 29, 29, 0.3), rgba(220, 38, 38, 0.2), rgba(127, 29, 29, 0.3));
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
      font-size: 11.5px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: 0.065em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .custom-order-card__launch-offer::before {
      content: '';
      width: 8px;
      height: 8px;
      flex: 0 0 auto;
      border-radius: 999px;
      background: #f87171;
      box-shadow: 0 0 10px rgba(248, 113, 113, 0.72);
    }
    .custom-order-card__price-label {
      display: block;
      color: rgba(219, 234, 254, 0.68);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .custom-order-card__price-plan {
      display: block;
      margin-top: 4px;
      color: #fff;
      font-size: 12px;
      font-weight: 700;
    }
    .custom-order-card__price-day {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 7px 10px;
      border: 1px solid rgba(96, 165, 250, 0.3);
      border-radius: 9px;
      color: #dbeafe;
      background:
        linear-gradient(90deg, rgba(37, 99, 235, 0.12), rgba(59, 130, 246, 0.24), rgba(37, 99, 235, 0.12));
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.06),
        0 0 16px rgba(59, 130, 246, 0.12);
      font-size: 12.5px;
      line-height: 1;
      font-weight: 900;
    }
    .custom-order-card__price-value {
      flex: 0 0 auto;
      color: #60a5fa;
      font-size: 36px;
      line-height: 1;
      letter-spacing: -0.04em;
      font-weight: 900;
      text-shadow: 0 0 24px rgba(59, 130, 246, 0.4);
    }
    .custom-order-card__price-value small {
      font-size: 17px;
      vertical-align: 8px;
    }
    .checkout-review {
      position: relative;
      display: flex;
      align-items: center;
      gap: 16px;
      overflow: hidden;
      border: 1px solid rgba(96, 165, 250, 0.28);
      border-radius: 18px;
      background:
        radial-gradient(90% 180% at 0% 50%, rgba(37, 99, 235, 0.18), transparent 56%),
        linear-gradient(135deg, rgba(30, 58, 138, 0.16), rgba(8, 15, 31, 0.9));
      box-shadow:
        0 14px 34px rgba(2, 6, 23, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.055);
    }
    .checkout-review::before {
      content: '';
      position: absolute;
      top: 13px;
      bottom: 13px;
      left: 0;
      width: 3px;
      border-radius: 0 999px 999px 0;
      background: linear-gradient(180deg, #93c5fd, #2563eb);
      box-shadow: 0 0 14px rgba(59, 130, 246, 0.5);
    }
    .checkout-review--primary {
      max-width: 820px;
      width: 100%;
      margin: 18px auto 0;
      padding: 16px 19px 16px 21px;
    }
    .checkout-review--secondary {
      padding: 17px 20px 17px 22px;
      margin-top: 16px;
    }
    .checkout-review__avatar {
      flex: 0 0 auto;
      width: 56px;
      height: 56px;
      display: grid;
      place-items: center;
      border: 2px solid rgba(147, 197, 253, 0.42);
      border-radius: 50%;
      object-fit: cover;
      background: rgba(30, 58, 138, 0.38);
      color: #dbeafe;
      font-size: 12px;
      font-weight: 900;
      box-shadow:
        0 0 0 4px rgba(59, 130, 246, 0.08),
        0 8px 18px rgba(2, 6, 23, 0.28);
      pointer-events: none;
      user-select: none;
      -webkit-user-select: none;
      -webkit-user-drag: none;
    }
    .checkout-review__quote {
      color: rgba(248, 250, 252, 0.96);
      font-size: 14.5px;
      line-height: 1.55;
      font-weight: 600;
    }
    .checkout-review__meta {
      display: block;
      margin-top: 7px;
      color: #93c5fd;
      font-size: 11px;
      font-weight: 800;
      line-height: 1.35;
      letter-spacing: 0.025em;
    }
    .checkout-pending {
      display: grid;
      min-height: 360px;
      place-items: center;
      padding: 32px;
      border: 1px dashed rgba(96, 165, 250, 0.42);
      border-radius: 22px;
      background: rgba(15, 23, 42, 0.72);
      color: rgba(219, 234, 254, 0.78);
      text-align: center;
      font-size: 15px;
      font-weight: 700;
      line-height: 1.6;
    }
    @media (max-width: 1240px) {
      .checkout-guidance { display: none; }
    }
    @media (max-width: 820px) {
      .checkout-sidebar {
        position: relative;
        top: auto;
        width: min(100%, 520px);
        margin: 0 auto;
      }
      .custom-order-card {
        display: block;
      }
      .custom-order-card__body {
        border-left: 0;
      }
      .checkout-review--primary {
        margin-top: 15px;
        padding: 14px 13px 14px 17px;
      }
      .checkout-review--secondary {
        padding: 14px 13px 14px 17px;
      }
      .checkout-review {
        align-items: flex-start;
        gap: 12px;
      }
      .checkout-review__avatar {
        width: 46px;
        height: 46px;
      }
      .checkout-review__quote {
        font-size: 13px;
        line-height: 1.5;
      }
      .checkout-review__meta {
        margin-top: 6px;
        font-size: 10px;
      }
    }
    /* Carte d'urgence compacte, alignée en haut à droite. */
    .scarcity-card {
      position: relative;
      width: min(100%, 420px);
      margin: 0;
      padding: 11px 13px;
      border-radius: 14px;
      border: 1px solid rgba(248, 113, 113, 0.3);
      background:
        radial-gradient(120% 180% at 0% -40%, rgba(220, 38, 38, 0.2) 0%, rgba(15, 23, 42, 0.88) 58%, rgba(8, 15, 29, 0.96) 100%);
      box-shadow:
        0 18px 45px rgba(2, 6, 23, 0.36),
        0 8px 28px rgba(127, 29, 29, 0.18),
        0 0 0 1px rgba(255, 255, 255, 0.03),
        inset 0 1px 0 rgba(255, 255, 255, 0.07);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
      text-align: center;
      display: none;
      pointer-events: auto;
    }
    .scarcity-card.is-visible {
      display: flex;
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 80;
      width: min(420px, calc(100vw - 40px));
      align-items: center;
      justify-content: space-between;
      gap: 13px;
      animation: urgencyDockIn 180ms ease-out both;
    }
    @keyframes urgencyDockIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .scarcity-card::before {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(135deg, rgba(248, 113, 113, 0.45), rgba(248, 113, 113, 0) 40%, rgba(248, 113, 113, 0) 60%, rgba(248, 113, 113, 0.25));
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
    }
    .scarcity-top {
      flex: 0 0 auto;
      margin: 0;
    }
    .scarcity-live {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      max-width: 105px;
      font-size: 10px;
      line-height: 1.35;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #fecaca;
      text-align: left;
    }
    .scarcity-live__dot {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: #ef4444;
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.6);
      animation: scarcityPulse 1.8s ease-out infinite;
    }
    @keyframes scarcityPulse {
      0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.6); }
      70% { box-shadow: 0 0 0 9px rgba(239, 68, 68, 0); }
      100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }
    @media (max-width: 768px) {
      .scarcity-card {
        width: 100%;
        padding: 9px 10px;
        border-radius: 13px;
      }
      .scarcity-card.is-visible { gap: 8px; }
      .scarcity-live {
        max-width: 82px;
        gap: 6px;
        font-size: 9px;
        letter-spacing: 0.07em;
      }
      .scarcity-live__dot {
        width: 6px;
        height: 6px;
      }
      .offer-countdown-grid { gap: 4px; }
      .offer-countdown-box {
        min-width: 46px;
        padding: 5px 4px 4px;
        border-radius: 9px;
      }
      .offer-countdown-value { font-size: 18px; }
      .offer-countdown-label { font-size: 7px; }
      .scarcity-card.is-visible {
        right: 10px;
        bottom: 10px;
        width: min(310px, calc(100vw - 20px));
        padding: 7px 8px;
      }
      .scarcity-card.is-visible .scarcity-live {
        max-width: 68px;
        font-size: 8px;
      }
      .scarcity-card.is-visible .offer-countdown-box {
        min-width: 42px;
        padding: 4px 3px 3px;
      }
    }
    /* Exit popup (desktop uniquement) */
    .exit-popup {
      position: fixed;
      inset: 0;
      z-index: 100000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(2, 6, 23, 0.82);
      backdrop-filter: blur(10px);
    }
    .exit-popup.is-visible { display: flex; }
    .exit-popup__panel {
      position: relative;
      width: min(560px, 100%);
      padding: 42px 38px 34px;
      border-radius: 20px;
      border: 1px solid rgba(96, 165, 250, 0.35);
      background:
        radial-gradient(130% 160% at 50% -30%, rgba(37, 99, 235, 0.25) 0%, rgba(15, 23, 42, 0.97) 55%, rgba(15, 23, 42, 1) 100%);
      box-shadow: 0 40px 120px rgba(2, 6, 23, 0.8), 0 0 60px rgba(59, 130, 246, 0.15);
      text-align: center;
      overflow: hidden;
      animation: exitPopIn 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
    @keyframes exitPopIn {
      from { opacity: 0; transform: translateY(18px) scale(0.97); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .exit-popup__glow {
      position: absolute;
      top: -80px;
      left: 50%;
      transform: translateX(-50%);
      width: 300px;
      height: 160px;
      background: radial-gradient(closest-side, rgba(96, 165, 250, 0.35), transparent);
      pointer-events: none;
    }
    .exit-popup__close {
      position: absolute;
      top: 14px;
      right: 16px;
      width: 34px;
      height: 34px;
      border: none;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      color: rgba(255, 255, 255, 0.7);
      font-size: 20px;
      line-height: 1;
      cursor: pointer;
    }
    .exit-popup__close:hover { background: rgba(255, 255, 255, 0.15); }
    .exit-popup__kicker {
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #93c5fd;
      margin-bottom: 12px;
    }
    .exit-popup__title {
      font-size: clamp(24px, 4vw, 32px);
      font-weight: 900;
      margin-bottom: 16px;
    }
    .exit-popup__text {
      font-size: 15.5px;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.78);
      margin-bottom: 14px;
    }
    .exit-popup__text--strong { color: #fff; font-weight: 600; }
    .exit-popup__cta {
      display: block;
      width: 100%;
      height: 54px;
      margin-top: 22px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      color: #fff;
      font-size: 16px;
      font-weight: 800;
      font-family: inherit;
      cursor: pointer;
      box-shadow: 0 10px 30px rgba(37, 99, 235, 0.4);
      transition: transform 0.12s ease;
    }
    .exit-popup__cta:active { transform: scale(0.985); }
    .exit-popup__reassure {
      margin-top: 12px;
      font-size: 12.5px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.55);
    }
    .exit-popup__dismiss {
      margin-top: 14px;
      background: none;
      border: none;
      font-size: 12.5px;
      font-family: inherit;
      color: rgba(255, 255, 255, 0.4);
      text-decoration: underline;
      cursor: pointer;
    }
    .exit-popup__dismiss:hover { color: rgba(255, 255, 255, 0.6); }
    /* Gate d'identification (pas de token trouvé) */
    .page.is-locked .checkout-wrap,
    .page.is-locked .custom-order-card,
    .page.is-locked .checkout-review,
    .page.is-locked .checkout-guidance,
    .page.is-locked .checkout-note,
    .page.is-locked .scarcity-card,
    .page.is-expired .scarcity-card,
    .page.is-locked .offer-countdown { display: none; }
    .gate-overlay {
      display: none;
      margin: 40px auto 0;
      max-width: 460px;
      padding: 34px 26px;
      border-radius: 18px;
      border: 1px solid rgba(96, 165, 250, 0.3);
      background: rgba(15, 23, 42, 0.9);
      box-shadow: 0 24px 70px rgba(2, 6, 23, 0.45);
      text-align: center;
    }
    .gate-overlay.is-visible { display: block; }
    .gate-overlay h2 { font-size: 21px; font-weight: 900; margin-bottom: 8px; }
    .gate-overlay p { color: rgba(255, 255, 255, 0.72); font-size: 14.5px; line-height: 1.55; margin-bottom: 18px; }
    .gate-form { display: flex; flex-direction: column; gap: 10px; }
    .gate-input {
      height: 48px;
      border-radius: 12px;
      border: 1px solid rgba(148, 163, 184, 0.35);
      background: rgba(2, 6, 23, 0.6);
      color: #fff;
      font-size: 15px;
      font-family: inherit;
      padding: 0 14px;
      outline: none;
    }
    .gate-input:focus { border-color: rgba(96, 165, 250, 0.7); }
    .gate-btn {
      height: 48px;
      border-radius: 12px;
      border: none;
      background: linear-gradient(135deg, #3b82f6, #2563eb);
      color: #fff;
      font-size: 15px;
      font-weight: 800;
      font-family: inherit;
      cursor: pointer;
      transition: transform 0.12s ease;
    }
    .gate-btn:active { transform: scale(0.98); }
    .gate-btn[disabled] { opacity: 0.6; cursor: wait; }
    .gate-error {
      display: none;
      margin-top: 12px;
      font-size: 13.5px;
      line-height: 1.5;
      color: #fca5a5;
    }
    .gate-error.on { display: block; }
    .gate-error a { color: #93c5fd; }
    /* Offre expirée */
    .expired-overlay {
      display: none;
      text-align: center;
      margin-top: 40px;
      padding: 40px 24px;
      border-radius: 18px;
      border: 1px solid rgba(148, 163, 184, 0.25);
      background: rgba(15, 23, 42, 0.85);
    }
    .expired-overlay.is-visible { display: block; }
    .expired-overlay .icon { font-size: 40px; margin-bottom: 12px; }
    .expired-overlay h2 { font-size: 24px; font-weight: 900; margin-bottom: 8px; }
    .expired-overlay p { color: rgba(255, 255, 255, 0.72); line-height: 1.55; max-width: 480px; margin: 0 auto; }
    .is-expired .checkout-wrap, .is-expired .custom-order-card, .is-expired .checkout-review, .is-expired .checkout-guidance, .is-expired .offer-countdown { display: none; }
    /* Toast notifications d'achat (identique /invitation) */
    .purchase-toast {
      position: fixed;
      left: 20px;
      bottom: 20px;
      z-index: 9999;
      opacity: 0;
      transform: translateY(20px);
      pointer-events: none;
      transition: opacity 0.4s ease, transform 0.4s ease;
    }
    .purchase-toast.show { opacity: 1; transform: translateY(0); }
    .purchase-toast__content {
      display: flex;
      align-items: center;
      gap: 10px;
      max-width: 360px;
      padding: 14px 16px;
      border-radius: 14px;
      border: 1px solid rgba(59, 130, 246, 0.3);
      background: linear-gradient(135deg, rgba(15, 23, 42, 0.98), rgba(30, 41, 59, 0.95));
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(59, 130, 246, 0.2);
      backdrop-filter: blur(10px);
    }
    .purchase-toast__thumb-wrap { position: relative; width: 58px; height: 58px; flex-shrink: 0; }
    .purchase-toast__thumb {
      width: 58px; height: 58px; border-radius: 9px; object-fit: cover; display: block;
      border: 1px solid rgba(59, 130, 246, 0.4);
      box-shadow: 0 4px 16px rgba(2, 6, 23, 0.35);
    }
    .purchase-toast__thumb-flag {
      position: absolute; right: -4px; bottom: -4px; font-size: 14px; line-height: 1;
      filter: drop-shadow(0 2px 6px rgba(2, 6, 23, 0.5));
    }
    .purchase-toast__text { margin: 0; font-size: 14px; line-height: 1.35; color: #fff; }
    .purchase-toast__name { color: #60a5fa !important; font-weight: 900 !important; text-shadow: 0 0 10px rgba(96, 165, 250, 0.35); }
    .purchase-toast__action { color: rgba(255, 255, 255, 0.72); }
    .purchase-toast__course { display: block; margin-top: 2px; color: #ffffff !important; font-weight: 400 !important; }
    @media (max-width: 1023px) {
      .purchase-toast { left: auto; right: 10px; bottom: 82px; transform: translateY(20px); }
      .purchase-toast__content { max-width: min(360px, calc(100vw - 20px)); }
      .page { padding-top: 32px; }
    }
    @media (max-width: 560px) {
      .page { padding: 22px 10px 72px; }
      .hero { margin-bottom: 18px; }
      .hero h1 { margin-bottom: 11px; }
      .hero .sub { font-size: 13px; line-height: 1.45; }
      .prefill-progress {
        margin-top: 20px;
        padding: 14px 15px 13px;
      }
      .prefill-progress__row { margin-bottom: 8px; }
      .prefill-progress__label { font-size: 12.5px; }
      .prefill-progress__pct { font-size: 14px; }
      .prefill-progress__bar { height: 10px; }
      .prefill-progress__hint {
        margin-top: 7px;
        font-size: 10.5px;
        line-height: 1.4;
      }
      .checkout-layout { margin-top: 20px; }
    }
  </style>
</head>
<body>
  <div class="page is-locked" id="page" data-checkout-base={checkoutBase} data-checkout-enabled={String(checkoutEnabled)}>
    <header class="hero">
      <h1>TU Y ES ! 🎉<span class="accent">LE PREMIER PAS EST DÉJÀ FAIT.</span></h1>
      <p class="sub">
        {plan === 'complet'
          ? 'Ta décision est protégée pendant 30 jours : suis le protocole et, si ta vie ne bouge pas, tu es remboursé. Seules les prestations personnalisées déjà consommées restent dues.'
          : 'Ta décision est protégée pendant 30 jours : suis le protocole et, si ta vie ne bouge pas, tu es remboursé intégralement.'}
      </p>
    </header>

    <div class="urgency-sticky">
      <div class="scarcity-card" id="scarcity-card" role="timer" aria-live="off" aria-label="Temps restant avant l'expiration de l'offre">
        <div class="scarcity-top">
          <span class="scarcity-live"><span class="scarcity-live__dot"></span>L'offre expire dans</span>
        </div>
        <div class="offer-countdown" id="offer-countdown">
          <div class="offer-countdown-grid">
            <div class="offer-countdown-box"><span id="offer-days" class="offer-countdown-value">--</span><span class="offer-countdown-label">Jours</span></div>
            <div class="offer-countdown-box"><span id="offer-hours" class="offer-countdown-value">--</span><span class="offer-countdown-label">Heures</span></div>
            <div class="offer-countdown-box"><span id="offer-minutes" class="offer-countdown-value">--</span><span class="offer-countdown-label">Min</span></div>
            <div class="offer-countdown-box"><span id="offer-seconds" class="offer-countdown-value">--</span><span class="offer-countdown-label">Sec</span></div>
          </div>
        </div>
      </div>
    </div>

    <article class="checkout-review checkout-review--primary" aria-label="Témoignage de Cyril">
      <img class="checkout-review__avatar" src="/media/pages/Cyril.webp" alt="Cyril" loading="lazy" draggable="false" />
      <p class="checkout-review__quote">« C'est un investissement qui en vaut vraiment la peine. Franchement, n'hésitez pas : foncez, vous ne le regretterez pas. »<span class="checkout-review__meta">Cyril · résultats en 21 jours</span></p>
    </article>

    <div class="prefill-progress" id="prefill-progress">
      <div class="prefill-progress__row">
        <span class="prefill-progress__label">Ton inscription a déjà commencé</span>
        <span class="prefill-progress__pct">90&nbsp;%</span>
      </div>
      <div class="prefill-progress__bar"><div class="prefill-progress__fill" id="prefill-fill"></div></div>
      <p class="prefill-progress__hint">Tes informations sont déjà remplies. Ajoute maintenant ton moyen de paiement et commence ta transformation immédiatement.</p>
    </div>

    <div class="checkout-layout">
      <div class="checkout-sidebar">
        <aside class="custom-order-card" aria-label="Récapitulatif de ton accès">
          <div class="custom-order-card__visual">
            <img src="/media/pages/ES20-banner.webp" alt="Esprit Subconscient 2.0" />
            <span class="custom-order-card__visual-label">{planConfig.label}</span>
          </div>
          <div class="custom-order-card__body">
            <p class="custom-order-card__eyebrow">Esprit Subconscient 2.0</p>
            <h2 class="custom-order-card__title">{planConfig.title}</h2>
            <p class="custom-order-card__intro">{planConfig.intro}</p>
            <ul class="custom-order-card__list">
              {planConfig.items.map((item) => (
                <li class="custom-order-card__item">
                  <span class="custom-order-card__icon">{item.icon}</span>
                  <span><strong>{item.title}</strong><span>{item.detail}</span></span>
                </li>
              ))}
            </ul>
            <div class="custom-order-card__guarantee">
              <span class="custom-order-card__guarantee-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3 20 6v5c0 5.1-3.2 8.4-8 10-4.8-1.6-8-4.9-8-10V6l8-3Z" />
                  <path d="m8.5 12 2.2 2.2 4.8-5" />
                </svg>
              </span>
              <span class="custom-order-card__guarantee-copy">
                <strong>Protégé par la garantie 30 jours</strong>
                <small>{plan === 'complet' ? 'Satisfait ou remboursé · prestations consommées déduites' : 'Satisfait ou remboursé'}</small>
              </span>
            </div>
          </div>
          <div class="custom-order-card__price">
            <span class="custom-order-card__price-copy">
              <span class="custom-order-card__price-label">{priceLabel}</span>
              <span class="custom-order-card__price-plan">{pricePlan}</span>
            </span>
            <strong class="custom-order-card__price-value"><small>€</small>{displayedPriceText}</strong>
            <span class="custom-order-card__price-day">{priceDetail}</span>
          </div>
          <span class="custom-order-card__launch-offer">Offre de lancement · −30 % déjà appliqués</span>
        </aside>
      </div>

      <div class="checkout-main">
        <div class="checkout-guidance checkout-guidance--card" aria-hidden="true">
          <span class="checkout-guidance__sticker"><span class="checkout-guidance__number">1</span>Entre tes infos de carte</span>
          <svg viewBox="0 0 188 112" role="presentation">
            <defs>
              <filter id="checkout-handdrawn-softness" x="-10%" y="-10%" width="120%" height="120%">
                <feTurbulence type="fractalNoise" baseFrequency="0.025 0.08" numOctaves="1" seed="7" result="noise" />
                <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.15" xChannelSelector="R" yChannelSelector="G" />
              </filter>
            </defs>
            <path class="checkout-guidance__line" d="M14 10 C25 65, 76 84, 161 88" />
            <path class="checkout-guidance__head" d="M161 88 L147 78 M161 88 L149 99" />
          </svg>
        </div>
        <div class="checkout-guidance checkout-guidance--terms" aria-hidden="true">
          <span class="checkout-guidance__sticker"><span class="checkout-guidance__number">2</span>Coche la case</span>
          <svg viewBox="0 0 188 112" role="presentation">
            <path class="checkout-guidance__line" d="M14 10 C25 65, 76 84, 161 88" />
            <path class="checkout-guidance__head" d="M161 88 L147 78 M161 88 L149 99" />
          </svg>
        </div>
        <div class="checkout-guidance checkout-guidance--submit" aria-hidden="true">
          <span class="checkout-guidance__sticker"><span class="checkout-guidance__number">3</span>Clique ici</span>
          <svg viewBox="0 0 188 112" role="presentation">
            <path class="checkout-guidance__line" d="M174 10 C163 65, 112 84, 27 88" />
            <path class="checkout-guidance__head" d="M27 88 L41 78 M27 88 L39 99" />
          </svg>
        </div>
        <section class="checkout-wrap" id="checkout-slot">
          <!-- L'élément <spiffy-checkout> est injecté en JS avec les infos du lead
               préremplies (name_first, email) une fois le token résolu. -->
          {!checkoutEnabled && (
            <div class="checkout-pending">
              Cette page est prête. Le checkout Spiffy sera connecté à l’étape suivante.
            </div>
          )}
        </section>

        <article class="checkout-review checkout-review--secondary" aria-label="Témoignage d'un participant ES2">
          <img class="checkout-review__avatar" src="/media/pages/review-couple-es2-selfie-homme-v1.webp" alt="Portrait illustratif d'un participant" loading="lazy" draggable="false" />
          <p class="checkout-review__quote">« Ma femme m'a fortement déconseillé de m'inscrire. Je ne l'ai pas écoutée. Ironie du sort : elle suit maintenant la formation avec moi… et elle adore. »<span class="checkout-review__meta">Participant ES2 · formation suivie en couple · portrait illustratif</span></p>
        </article>

      </div>
    </div>

    <div class="gate-overlay" id="gate-overlay">
      <h2>Retrouvons ton invitation</h2>
      <p>Cette offre est réservée aux participants de la masterclass. Entre l'email utilisé lors de ton inscription pour retrouver ton accès et ton temps restant.</p>
      <form class="gate-form" id="gate-form">
        <input type="email" class="gate-input" id="gate-email" placeholder="ton@email.com" autocomplete="email" required />
        <button type="submit" class="gate-btn" id="gate-btn">Accéder à mon offre</button>
      </form>
      <p class="gate-error" id="gate-error"></p>
    </div>

    <div class="expired-overlay" id="expired-overlay">
      <div class="icon">⏳</div>
      <h2>L'offre n'est plus disponible</h2>
      <p>Ta fenêtre d'inscription est terminée. Si tu as des questions, contacte le support&nbsp;: support@sonnycourt.com</p>
    </div>
  </div>

  <div class="exit-popup" id="exit-popup" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="exit-popup__panel">
      <button type="button" class="exit-popup__close" id="exit-popup-close" aria-label="Fermer">&times;</button>
      <div class="exit-popup__glow" aria-hidden="true"></div>
      <p class="exit-popup__kicker">Avant de partir</p>
      <h2 class="exit-popup__title">Attends une seconde.</h2>
      <p class="exit-popup__text">
        Tu sais ce qui t'attend si tu fermes cette page : la même vie, les mêmes pensées qui tournent en rond.
      </p>
      <p class="exit-popup__text exit-popup__text--strong">
        Tu as tenu plus d'une heure face à toi-même. Une partie de toi a déjà dit oui.
      </p>
      <button type="button" class="exit-popup__cta" id="exit-popup-cta">Je choisis ma nouvelle vie →</button>
      <p class="exit-popup__reassure">✓ Garantie 30 jours &nbsp;·&nbsp; ✓ environ 6 € par jour</p>
      <button type="button" class="exit-popup__dismiss" id="exit-popup-dismiss">Non merci, je préfère avancer seul</button>
    </div>
  </div>

  <div id="purchase-toast" class="purchase-toast" aria-live="polite">
    <div class="purchase-toast__content">
      <div class="purchase-toast__thumb-wrap">
        <img class="purchase-toast__thumb" src="/media/pages/es2-square-sonny.webp" alt="" aria-hidden="true" />
        <span id="purchase-toast-flag" class="purchase-toast__thumb-flag">🇫🇷</span>
      </div>
      <p class="purchase-toast__text" id="purchase-toast-text"><span class="purchase-toast__name">Sophie</span> <span class="purchase-toast__action">vient de rejoindre</span><br /><span class="purchase-toast__course">Esprit Subconscient 2.0</span></p>
    </div>
  </div>

  <script>
    import { getCurrentWindow, SCARCITY_WINDOW_START_AFTER_SESSION_MS } from '../lib/scarcity-engine';
    import { mountCheckoutSocialProof, shouldEnableEs2SocialProof } from '../lib/es2-social-proof';

    document.addEventListener('DOMContentLoaded', async function () {
      const params = new URLSearchParams(window.location.search);
      const isPreview = params.get('preview') === 'true' || params.get('preview') === 'dev';
      const TOKEN_KEY = 'masterclass_es2_token';

      // Token : URL -> localStorage -> cookie. S'il existe quelque part, on ne
      // demande rien au visiteur ; sinon, gate d'identification par email.
      function readCookieToken() {
        const m = document.cookie.match(/(?:^|;\s*)masterclass_es2_token=([^;]+)/);
        return m ? decodeURIComponent(m[1]).trim() : '';
      }
      const urlToken = (params.get('t') || params.get('token') || '').trim();
      let token = urlToken;
      if (!token) {
        try { token = (localStorage.getItem(TOKEN_KEY) || '').trim(); } catch (e) { /* noop */ }
      }
      if (!token) token = readCookieToken();
      if (token) {
        try { localStorage.setItem(TOKEN_KEY, token); } catch (e) { /* noop */ }
      }

      const pageEl = document.getElementById('page');
      const gateEl = document.getElementById('gate-overlay');
      const CHECKOUT_ENABLED = pageEl.dataset.checkoutEnabled !== 'false';
      const CHECKOUT_BASE = pageEl.dataset.checkoutBase || 'https://sonnycourt.spiffy.co/checkout/esprit-subconscient-2-0-2-3';
      let checkoutMounted = false;
      // Monte l'embed avec les infos du lead préremplies (name_first, email).
      // Le nom de famille n'existe pas en base masterclass, Spiffy le demandera.
      function mountCheckout(lead) {
        if (!CHECKOUT_ENABLED) return;
        if (checkoutMounted) return;
        checkoutMounted = true;
        // encodeURIComponent (espace -> %20) : Spiffy ne décode pas le "+"
        // produit par URLSearchParams dans les champs texte.
        const parts = [];
        // Code promo TOUJOURS appliqué : le prix de base du checkout est 3 994 €,
        // c'est ce code qui affiche 1 997 € (12x197). Sans lui, prix double à l'écran.
        parts.push('code=OFFRE50POURCENT');
        if (lead && lead.prenom) parts.push('name_first=' + encodeURIComponent(lead.prenom));
        if (lead && lead.email) parts.push('email=' + encodeURIComponent(lead.email));
        if (lead && lead.pays && lead.pays !== 'Autre') parts.push('country=' + encodeURIComponent(lead.pays));
        const checkoutUrl = parts.length ? CHECKOUT_BASE + '?' + parts.join('&') : CHECKOUT_BASE;
        const slot = document.getElementById('checkout-slot');
        if (window.location.protocol === 'http:') {
          // Spiffy bloque ses Elements sur les pages non-HTTPS. En local uniquement,
          // on reproduit l'URL inline créée par son script pour prévisualiser
          // fidèlement le checkout publié, sans modifier le comportement en ligne.
          const previewUrl = new URL(checkoutUrl);
          previewUrl.searchParams.set('elements', btoa(JSON.stringify({
            modality: 'inline',
            uid: 1,
            from: window.location.href,
            handles: {}
          })));
          const frame = document.createElement('iframe');
          frame.className = 'checkout-preview-frame';
          frame.src = previewUrl.toString();
          frame.title = 'Paiement sécurisé Esprit Subconscient 2.0';
          frame.setAttribute('allow', 'payment');
          frame.setAttribute('loading', 'eager');
          frame.style.cssText = [
            'display:block',
            'width:100%',
            'height:' + (window.matchMedia('(max-width: 700px)').matches ? '940px' : '820px'),
            'border:0',
            'border-radius:22px',
            'background:transparent'
          ].join(';');
          window.addEventListener('message', function syncPreviewHeight(event) {
            if (event.origin !== 'https://sonnycourt.spiffy.co') return;
            let payload = event.data;
            if (typeof payload === 'string') {
              try { payload = JSON.parse(payload); } catch (e) { return; }
            }
            if (payload && payload.event === 'form:size') {
              const height = Number(payload.height || (payload.data && payload.data.height));
              if (Number.isFinite(height) && height > 500) {
                const maxPreviewHeight = window.matchMedia('(max-width: 700px)').matches ? 960 : 840;
                frame.style.height = Math.min(Math.ceil(height), maxPreviewHeight) + 'px';
              }
            }
          });
          slot.appendChild(frame);
        } else {
          const el = document.createElement('spiffy-checkout');
          el.setAttribute('url', checkoutUrl);
          slot.appendChild(el);
        }
        // Barre "déjà commencé" : affichée après un vrai préremplissage et dans
        // l'aperçu interne afin de pouvoir contrôler son rendu avant publication.
        if (isPreview || (lead && (lead.prenom || lead.email))) {
          const prog = document.getElementById('prefill-progress');
          const fill = document.getElementById('prefill-fill');
          if (prog && fill) {
            prog.classList.add('is-visible');
            setTimeout(function () { fill.style.width = '90%'; }, 300);
          }
        }
      }
      function unlockPage() {
        pageEl.classList.remove('is-locked');
        gateEl.classList.remove('is-visible');
      }
      function showGate() {
        pageEl.classList.add('is-locked');
        gateEl.classList.add('is-visible');
      }

      const countdownEl = document.getElementById('offer-countdown');
      const urgencyCardEl = document.getElementById('scarcity-card');

      const pad2 = (n) => String(n).padStart(2, '0');
      let offerExpiryMs = null;
      let sessionStartsAtMs = null;
      let countdownInterval = null;

      function renderCountdown() {
        if (!Number.isFinite(offerExpiryMs)) return;
        const diff = Math.max(0, offerExpiryMs - Date.now());
        const total = Math.floor(diff / 1000);
        const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = pad2(v); };
        set('offer-days', Math.floor(total / 86400));
        set('offer-hours', Math.floor((total % 86400) / 3600));
        set('offer-minutes', Math.floor((total % 3600) / 60));
        set('offer-seconds', total % 60);
        if (diff <= 0) lockExpired();
      }

      function lockExpired() {
        if (countdownInterval) { clearInterval(countdownInterval); countdownInterval = null; }
        document.getElementById('page').classList.add('is-expired');
        const overlay = document.getElementById('expired-overlay');
        if (overlay) overlay.classList.add('is-visible');
      }

      // --- Gate + récupération de l'expiration réelle du lead (source serveur) ---
      if (isPreview) {
        // Aperçu interne uniquement : pas de token requis et jamais de page expirée.
        // Hors fenêtre de vente, on crée une fenêtre visuelle de 48 h sans toucher
        // à l'expiration réelle utilisée par le funnel evergreen.
        const previewNow = Date.now();
        const win = getCurrentWindow(previewNow);
        if (win.phase === 'active' && win.endMs > previewNow) {
          offerExpiryMs = win.endMs;
          sessionStartsAtMs = win.startMs - SCARCITY_WINDOW_START_AFTER_SESSION_MS;
        } else {
          offerExpiryMs = previewNow + 48 * 60 * 60 * 1000;
          sessionStartsAtMs = previewNow - SCARCITY_WINDOW_START_AFTER_SESSION_MS;
        }
        unlockPage();
        mountCheckout(null);
      } else if (token) {
        try {
          const res = await fetch('/.netlify/functions/get-webinaire-registration?t=' + encodeURIComponent(token));
          if (res.ok) {
            const data = await res.json();
            const exp = new Date(data.offreExpiresAt || data.offre_expires_at || '').getTime();
            const ses = new Date(data.sessionStartsAt || data.session_date || '').getTime();
            if (Number.isFinite(exp)) offerExpiryMs = exp;
            if (Number.isFinite(ses)) sessionStartsAtMs = ses;
            unlockPage();
            mountCheckout({ prenom: data.prenom || '', email: data.email || '', pays: data.pays || '' });
          } else if (res.status === 404 || res.status === 400) {
            // Token inconnu en base : on nettoie et on demande l'email.
            try { localStorage.removeItem(TOKEN_KEY); } catch (e) { /* noop */ }
            showGate();
          } else {
            // Erreur serveur passagère : on ne bloque pas un acheteur.
            unlockPage();
            mountCheckout(null);
          }
        } catch (e) {
          // Réseau KO : on ne bloque pas un acheteur, countdown absent.
          unlockPage();
          mountCheckout(null);
        }
      } else {
        showGate();
      }

      // --- Gate : retrouver le token via l'email d'inscription masterclass ---
      const gateForm = document.getElementById('gate-form');
      const gateBtn = document.getElementById('gate-btn');
      const gateErr = document.getElementById('gate-error');
      if (gateForm) {
        gateForm.addEventListener('submit', async function (ev) {
          ev.preventDefault();
          const email = (document.getElementById('gate-email').value || '').trim().toLowerCase();
          if (!email) return;
          gateErr.classList.remove('on');
          gateBtn.disabled = true;
          const prevLabel = gateBtn.textContent;
          gateBtn.textContent = 'Recherche…';
          try {
            const res = await fetch('/.netlify/functions/check-webinaire-eligibility', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email }),
            });
            const data = await res.json().catch(function () { return {}; });
            if (res.ok && data.reason === 'already_registered' && data.token) {
              try { localStorage.setItem(TOKEN_KEY, data.token); } catch (e) { /* noop */ }
              window.location.replace('/invitation-es2/?t=' + encodeURIComponent(data.token));
              return;
            }
            if (res.ok && data.eligible === true) {
              gateErr.innerHTML = 'Aucune inscription trouvée avec cet email. Utilise l\'email de ton inscription à la masterclass, ou <a href="/masterclass/">inscris-toi ici</a>.';
            } else if (res.ok && data.reason === 'excluded') {
              gateErr.innerHTML = 'Un problème avec ton accès ? Écris-nous : <a href="mailto:support@sonnycourt.com">support@sonnycourt.com</a>';
            } else {
              gateErr.textContent = 'Erreur de connexion, réessaie dans un instant.';
            }
            gateErr.classList.add('on');
          } catch (e) {
            gateErr.textContent = 'Erreur réseau, vérifie ta connexion et réessaie.';
            gateErr.classList.add('on');
          }
          gateBtn.disabled = false;
          gateBtn.textContent = prevLabel;
        });
      }

      if (Number.isFinite(offerExpiryMs)) {
        if (offerExpiryMs - Date.now() <= 0) {
          lockExpired();
        } else {
          countdownEl.classList.add('is-visible');
          if (urgencyCardEl) urgencyCardEl.classList.add('is-visible');
          renderCountdown();
          countdownInterval = setInterval(renderCountdown, 1000);
        }
      }

      // --- Exit popup : desktop uniquement, une fois par session ---
      (function () {
        const popup = document.getElementById('exit-popup');
        if (!popup) return;
        const EXIT_KEY = 'es2_exit_popup_shown';
        const isDesktop = window.matchMedia('(pointer: fine)').matches && window.innerWidth >= 1024;
        function canShow() {
          if (!isDesktop) return false;
          if (pageEl.classList.contains('is-locked') || pageEl.classList.contains('is-expired')) return false;
          try { if (sessionStorage.getItem(EXIT_KEY)) return false; } catch (e) { /* noop */ }
          return true;
        }
        function openPopup() {
          if (!canShow()) return;
          try { sessionStorage.setItem(EXIT_KEY, '1'); } catch (e) { /* noop */ }
          popup.classList.add('is-visible');
          popup.setAttribute('aria-hidden', 'false');
        }
        function closePopup() {
          popup.classList.remove('is-visible');
          popup.setAttribute('aria-hidden', 'true');
        }
        document.addEventListener('mouseout', function (ev) {
          if (!ev.relatedTarget && ev.clientY <= 0) openPopup();
        });
        document.addEventListener('keydown', function (ev) {
          if (ev.key === 'Escape') closePopup();
        });
        popup.addEventListener('click', function (ev) {
          if (ev.target === popup) closePopup();
        });
        document.getElementById('exit-popup-close').addEventListener('click', closePopup);
        // « J'avance seul » : retour sur la page de vente (avec le token du lead),
        // là où vit toute l'argumentation, plutôt que de le laisser filer.
        document.getElementById('exit-popup-dismiss').addEventListener('click', function () {
          const t = urlToken || token || '';
          window.location.href = '/invitation/' + (t ? '?t=' + encodeURIComponent(t) : '');
        });
        document.getElementById('exit-popup-cta').addEventListener('click', function () {
          closePopup();
          const target = document.getElementById('checkout-slot');
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      })();

      // --- Preuve sociale checkout : contrôleur indépendant de la scarcity ---
      const toast = document.getElementById('purchase-toast');
      const toastFlag = document.getElementById('purchase-toast-flag');
      const toastText = document.getElementById('purchase-toast-text');
      const socialProofEnabled = shouldEnableEs2SocialProof(params, params.get('preview') === 'dev');
      mountCheckoutSocialProof({
        enabled: socialProofEnabled,
        token,
        toast,
        flag: toastFlag,
        text: toastText,
        canShow: function () {
          return document.visibilityState === 'visible'
            && !pageEl.classList.contains('is-expired')
            && !pageEl.classList.contains('is-locked');
        },
      });
    });
  </script>
</body>
</html>
