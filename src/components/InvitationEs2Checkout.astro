---
// Composant checkout direct ES2 avec Spiffy embed.
// Countdown = offre_expires_at du lead (token webinaire), vérifié côté serveur.
// Preuve sociale = contrôleur commun /invitation + checkout, indépendant de la scarcity.
interface Props {
  checkoutBase?: string;
  checkoutEnabled?: boolean;
  plan?: 'standard' | 'avance' | 'complet';
  paymentMode?: '12' | '1';
}

const {
  checkoutBase = 'https://sonnycourt.spiffy.co/checkout/esprit-subconscient-2-0-2-3',
  checkoutEnabled = true,
  plan = 'avance',
  paymentMode = '12'
} = Astro.props;

const planConfigs = {
  standard: {
    label: 'Formule standard',
    title: "L'essentiel, en toute autonomie.",
    intro: 'La méthode fondamentale complète pour avancer à ton rythme, avec un chemin clair du premier au dernier jour.',
    monthlyPrice: 97,
    singlePrice: 997,
    dailyPrice: '3,19',
    saving: 167,
    items: [
      { icon: '4', title: 'La méthode fondamentale', detail: 'Modules 1 à 4, dans le bon ordre' },
      { icon: '15', title: 'Un protocole simple à suivre', detail: 'Environ 15 minutes par jour' },
      { icon: 'V', title: 'La communauté Volt', detail: "Pour avancer avec les autres membres d'ES2" },
      { icon: '∞', title: 'Mises à jour à vie', detail: 'Toutes les améliorations futures incluses' }
    ]
  },
  avance: {
    label: 'Formule avancée',
    title: 'Accélère et mesure tes progrès.',
    intro: 'Tout le programme, les outils de suivi et un bilan personnalisé pour avancer sans te demander si tu es sur la bonne voie.',
    monthlyPrice: 197,
    singlePrice: 1997,
    dailyPrice: '6,50',
    saving: 367,
    items: [
      { icon: '5', title: 'Les 5 modules, sans compromis', detail: 'Méthode fondamentale + Accélérateur NeuroIA' },
      { icon: 'IA', title: 'Morpho, ton compagnon IA', detail: 'Tes exercices et ton suivi réunis au même endroit' },
      { icon: 'J+30', title: 'Un bilan personnalisé à J+30', detail: "Tes progrès analysés + ton plan d'action pour la suite" },
      { icon: '∞', title: "L'élan ne retombe pas", detail: "60 jours d'emails guidés · Volt · mises à jour à vie" }
    ]
  },
  complet: {
    label: 'Formule complète',
    title: 'Tout, avec un accompagnement privé.',
    intro: "La version la plus complète d'ES2, avec des humains à tes côtés aux moments où tout peut basculer.",
    monthlyPrice: 297,
    singlePrice: 2997,
    dailyPrice: '9,76',
    saving: 567,
    items: [
      { icon: 'SC', title: 'Accès illimité à Sonny pendant 30 jours', detail: 'Tes questions, mes réponses personnelles' },
      { icon: '6', title: '6 coachings privés avec Romain', detail: 'Un expert du subconscient suit ton évolution' },
      { icon: 'X', title: 'La Méthode X + Morpho', detail: "Le niveau de suivi le plus poussé d'ES2" },
      { icon: '∞', title: 'Tout le programme, sans compromis', detail: '5 modules · bilan J+30 · Volt · mises à jour à vie' }
    ]
  }
} as const;

const planConfig = planConfigs[plan];
const isMonthly = paymentMode === '12';
const displayedPrice = isMonthly ? planConfig.monthlyPrice : planConfig.singlePrice;
const displayedPriceText = new Intl.NumberFormat('fr-FR').format(displayedPrice);
const priceLabel = `${displayedPriceText} € aujourd'hui`;
const pricePlan = isMonthly
  ? 'puis 11 mensualités'
  : `paiement unique · économise ${planConfig.saving} €`;
const priceDetail = isMonthly
  ? `soit environ ${planConfig.dailyPrice} € par jour`
  : 'accès immédiat, aucun autre paiement';
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Rejoindre Esprit Subconscient 2.0</title>
  <meta name="description" content="Complète ton inscription à Esprit Subconscient 2.0." />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Esprit Subconscient 2.0 - La formation pour reprogrammer ton subconscient" />
  <meta property="og:description" content="Accès à la formation Esprit Subconscient 2.0 : reprogramme ton subconscient et manifeste la vie de tes rêves avec la méthode de Sonny Court." />
  <meta property="og:image" content={new URL("/media/pages/ES20-banner.webp", Astro.url)} />
  <meta property="og:url" content={Astro.url.href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Esprit Subconscient 2.0 - La formation pour reprogrammer ton subconscient" />
  <meta name="twitter:description" content="Accès à la formation Esprit Subconscient 2.0 : reprogramme ton subconscient et manifeste la vie de tes rêves avec la méthode de Sonny Court." />
  <meta name="twitter:image" content={new URL("/media/pages/ES20-banner.webp", Astro.url)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  <script is:inline>
