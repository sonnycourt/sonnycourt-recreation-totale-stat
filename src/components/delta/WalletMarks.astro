    <circle cx="7.416" cy="12" r="7.416" fill="#EB001B" />
    <circle cx="16.584" cy="12" r="7.416" fill="#F79E1B" />
    <path fill="#FF5F00" d="M12 6.174c-.096.075-.189.15-.28.231C10.156 7.764 9.169 9.765 9.169 12c0 2.236.987 4.236 2.551 5.595.09.08.185.158.28.232.096-.074.189-.152.28-.232 1.563-1.359 2.551-3.359 2.551-5.595 0-2.235-.987-4.236-2.551-5.595-.09-.08-.184-.156-.28-.231z" />
  </svg>
</div>

<style>
  .wallet-marks{display:flex;align-items:center;justify-content:center;gap:14px;margin-top:17px;color:#393630}
  .wallet-marks svg{display:block;flex:none;fill:currentColor;height:25px;width:auto}
  .wallet-marks .visa{width:43px;height:22px;color:#1A1F71}
  .wallet-marks .mastercard{width:34px;height:23px}
  @media(max-width:360px){.wallet-marks{gap:10px}}
</style>
