---
import { blackFriday, deltaBlackFriday, discountPercent } from '../../config/blackFriday';
---
<aside id="bf-offer" data-start={blackFriday.start} data-end={blackFriday.end} aria-label="Offre Black Friday">
    <a class="delta-strip" href="#tarif">
      <span class="delta-strip-offer">Black Friday <strong>−{discountPercent(deltaBlackFriday)} %</strong></span>
      <span class="delta-strip-time"><small>Fin de l’offre</small><b data-bf-clock>…</b></span>
    </a>
</aside>
<script is:inline>
  (() => {
    const bar = document.getElementById('bf-offer');
    const start = Date.parse(bar.dataset.start), end = Date.parse(bar.dataset.end);

    function update() {
      const now = Date.now();
      if (now < start || now >= end) {
        location.replace('/delta-vision/');
        return;
      }
      const seconds = Math.ceil((end - now) / 1000);
      const pad = n => String(n).padStart(2, '0');
      const label = Math.floor(seconds / 86400) + ' j ' + pad(Math.floor(seconds / 3600) % 24) + ':' + pad(Math.floor(seconds / 60) % 60) + ':' + pad(seconds % 60);
      document.querySelectorAll('[data-bf-clock]').forEach(clock => { clock.textContent = label; });
    }
    update();
    setInterval(update, 1000);
    window.addEventListener('pageshow', update);
  })();
</script>
<style>
#bf-offer { position:sticky; top:0; z-index:99999; color:white; font:600 14px/1.3 Inter,system-ui,sans-serif; }
#bf-offer {
  background: #b51532;
  border: 0;
  box-shadow: none;
}
.delta-strip {
  width: min(100%, 760px);
  min-height: 52px;
  margin: auto;
  padding: 8px clamp(14px, 4vw, 32px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  color: white;
  text-decoration: none;
}
.delta-strip:focus-visible { outline: 2px solid white; outline-offset: -3px; }
.delta-strip-offer { display: flex; align-items: center; gap: clamp(8px, 2vw, 16px); font: 600 clamp(18px, 3vw, 24px)/1 var(--serif, Georgia, serif); letter-spacing: -.025em; }
.delta-strip-offer strong { border-left: 1px solid #ed8e9c; padding-left: clamp(8px, 2vw, 16px); font: 650 14px/1.15 system-ui, sans-serif; }
.delta-strip-time { display: grid; gap: 3px; text-align: right; }
.delta-strip-time small { font-size: 10px; font-weight: 500; color: #ffe5ea; }
.delta-strip-time b { font-size: 14px; line-height: 1; letter-spacing: .025em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  :global(body:has(#bf-offer) [hidden]) { display:none !important; }
</style>
