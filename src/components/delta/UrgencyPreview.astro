---
// Both instances share one persisted deadline, initialized once by the page.
const { anchor = 'urgence' } = Astro.props;
---
<div class="urgency-preview" id={anchor} data-dv-urgency hidden>
    <div class="urgency-clock" role="timer" aria-label="Temps restant pour ton tarif de bienvenue" aria-live="off">
      <span class="urgency-unit"><strong data-hours>23</strong><small>HEURES</small></span>
      <span class="urgency-colon" aria-hidden="true">:</span>
      <span class="urgency-unit"><strong data-minutes>17</strong><small>MINUTES</small></span>
      <span class="urgency-colon" aria-hidden="true">:</span>
      <span class="urgency-unit"><strong data-seconds>34</strong><small>SECONDES</small></span>
    </div>
    <p class="urgency-note">Ce tarif t’est réservé pendant 23 h à partir de ta première visite. Ensuite, Delta Vision est à 147 €.</p>
</div>

<style>
  .urgency-preview[hidden]{display:none!important}
  .urgency-preview{margin:-3px auto 25px;scroll-margin-top:90px;text-align:center}
  .urgency-clock{display:flex;align-items:flex-start;justify-content:center;gap:10px}
  .urgency-unit{display:grid;gap:7px}
  .urgency-unit strong{display:grid;place-items:center;width:58px;height:51px;border:1px solid #e3d5c3;border-radius:9px;background:#efe5d780;font-size:29px;line-height:1;font-weight:500;letter-spacing:-.8px;font-variant-numeric:tabular-nums;color:#795a43}
  .urgency-unit small{font-size:7px;font-weight:500;letter-spacing:1.1px;color:#99836e}
  .urgency-colon{padding-top:11px;color:#b49a80;font-size:22px;font-weight:400}
  .urgency-note{margin:12px auto 0;max-width:340px;font-size:10px;line-height:1.6;color:#99836e}
</style>
