---
interface Props {
  hideFormations?: boolean;
  variant?: 'default' | 'compact-glass';
}

const { hideFormations = false, variant = 'default' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class:list={{ 'footer--compact-glass': variant === 'compact-glass' }}>
  <div class="footer-container">
    <div class="footer-content">
      <div class="footer-section">
        <div class="footer-logo">
          <div class="logo-icon">
            <svg viewBox="0 0 24 24" fill="currentColor" style="width: 24px; height: 24px;">
              <path d="M11.86 0L11.66 0.2L11.63 0.17L11.66 0.2L11.46 0.44L11.39 0.44L11.42 0.51L11.12 0.88L10.98 0.95L11.01 0.98L10.95 1.09L9.86 2.44L9.79 2.51L9.76 2.48L9.76 2.58L9.38 3.06L9.28 3.16L9.25 3.12L9.28 3.16L9.15 3.36L8.77 3.84L8.71 3.9L8.67 3.87L8.71 3.94L7.99 4.85L7.89 4.96L7.86 4.92L7.89 4.99L7.79 5.13L7.31 5.74L7.21 5.84L7.18 5.8L7.21 5.87L7.11 6.01L5.92 7.54L5.85 7.6L5.82 7.57L5.85 7.6L5.72 7.81L5.62 7.91L5.58 7.88L5.58 7.98L5.28 8.38L5.04 8.66L5.01 8.62L5.04 8.69L4.84 8.96L3.24 11.03L3.14 11.13L3.1 11.1L3.14 11.17L2.56 11.92L2.46 12.02L2.43 11.98L2.46 12.05L1.48 13.31L1.37 13.41L1.34 13.37L1.37 13.44L1 13.88L1.03 13.92L2.46 13.75L4.06 13.65L5.89 13.44L6.3 13.48L6.26 13.54L6.23 13.51L6.26 13.61L6.19 13.71L6.16 13.68L6.16 13.88L5.82 14.63L3.04 21.59L2.8 22.3L2.46 23.08L2.29 23.66L2.12 23.93L2.15 24L2.43 23.73L3.1 22.85L3.24 22.71L3.27 22.74L3.24 22.68L5.58 19.69L5.68 19.59L5.72 19.62L5.68 19.55L6.57 18.4L11.46 12.08L11.69 11.81L11.73 11.85L11.73 11.75L12.44 10.83L12.81 10.39L12.88 10.42L12.81 10.35L13.08 10.05L12.92 10.01L7.99 10.49L7.72 10.46L10.95 2.31L11.08 2.04L11.12 2.1L11.08 1.97L11.79 0.14L11.9 0Z"/>
            </svg>
          </div>
          <span>SONNY COURT</span>
        </div>
        <p class="footer-description">
          Reprogramme ton subconscient et crée la vie que tu mérites vraiment.
        </p>
      </div>
      
      <div class="footer-links">
        <div class="footer-column">
          <h4>Entreprise</h4>
          <ul>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/conditions-utilisation/">Conditions d'utilisation</a></li>
            <li><a href="/confidentialite/">Politique de confidentialité</a></li>
            <li><a href="/mentions-legales/">Mentions légales</a></li>
          </ul>
        </div>
      </div>
    </div>
    
    <div class="footer-bottom">
      <div class="footer-legal">
        <div class="footer-audience" aria-label="4,3 millions d'abonnés cumulés sur Instagram, TikTok, YouTube et Facebook">
          <div class="footer-audience-copy">
            <strong>4,3 M</strong>
            <span>d’abonnés cumulés</span>
          </div>
          <span class="footer-audience-divider" aria-hidden="true"></span>
          <div class="footer-audience-logos" aria-label="Instagram, TikTok, YouTube et Facebook">
            <a href="https://instagram.com/sonnycourt" aria-label="Instagram">
              <img src="/media/brands/instagram.svg?v=2" alt="" width="26" height="26" loading="lazy" />
            </a>
            <a href="https://tiktok.com/@sonnycourt" aria-label="TikTok">
              <img src="/media/brands/tiktok.svg?v=2" alt="" width="24" height="26" loading="lazy" />
            </a>
            <a href="https://youtube.com/@sonnycourt" aria-label="YouTube">
              <img src="/media/brands/youtube.svg?v=2" alt="" width="30" height="22" loading="lazy" />
            </a>
            <a href="https://facebook.com/sonnycourt" aria-label="Facebook">
              <img src="/media/brands/facebook.svg?v=2" alt="" width="26" height="26" loading="lazy" />
            </a>
          </div>
        </div>
        <p>&copy; {currentYear} Sonny Court. Tous droits réservés.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    background: linear-gradient(135deg, #0a0f1c 0%, #1a1f2e 100%);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 60px 0 30px;
    margin-top: 80px;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 60px;
    margin-bottom: 40px;
  }

  .footer-section {
    max-width: 300px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .footer-logo span {
    font-size: 18px;
    font-weight: 600;
    color: #FFFFFF;
  }

  .logo-icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #007AFF;
  }

  .footer-description {
    color: #8E8E93;
    line-height: 1.6;
    font-size: 14px;
  }

  .footer-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .footer-column h4 {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }

  .footer-column ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-column li {
    margin-bottom: 8px;
  }

  .footer-column a {
    color: #8E8E93;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s ease;
  }

  .footer-column a:hover {
    color: #FFFFFF;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-legal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .footer-legal p {
    color: #636366;
    font-size: 12px;
    margin: 0;
  }

  .footer-audience {
    width: fit-content;
    max-width: 100%;
    min-height: 42px;
    padding: 6px 9px 6px 13px;
    display: flex;
    align-items: center;
    gap: 11px;
    border: 1px solid rgba(191, 219, 254, 0.12);
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.025));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 12px 34px rgba(0, 0, 0, 0.14);
  }

  .footer-audience-copy {
    display: flex;
    align-items: baseline;
    gap: 6px;
    white-space: nowrap;
  }

  .footer-audience-copy strong {
    color: rgba(255, 255, 255, 0.9);
    font-size: 17px;
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .footer-audience-copy span {
    color: rgba(191, 219, 254, 0.5);
    font-size: 10px;
    font-weight: 500;
  }

  .footer-audience-divider {
    width: 1px;
    height: 20px;
    flex-shrink: 0;
    background: rgba(191, 219, 254, 0.12);
  }

  .footer-audience-logos {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .footer-audience-logos a {
    width: 18px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .footer-audience-logos a:hover {
    opacity: 0.72;
    transform: translateY(-1px);
  }

  .footer-audience-logos img {
    display: block;
    max-width: 15px;
    max-height: 15px;
    object-fit: contain;
    opacity: 0.84;
    filter:
      drop-shadow(0 1px 0 rgba(255, 255, 255, 0.14))
      drop-shadow(0 2px 5px rgba(37, 99, 235, 0.18));
  }

  .footer-audience-logos a[aria-label='TikTok'] img {
    max-width: 13px;
  }

  .footer-audience-logos a[aria-label='YouTube'] img {
    max-width: 18px;
  }

  .footer-audience-logos a[aria-label='Facebook'] img {
    max-width: 14px;
  }

  footer.footer--compact-glass {
    margin-top: 0;
    padding: 28px 0;
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(180deg, #061128 0%, #030812 100%);
    border-top-color: rgba(147, 197, 253, 0.1);
    box-shadow: 0 1px 0 #030812;
  }

  footer.footer--compact-glass::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(110deg, transparent 18%, rgba(96, 165, 250, 0.05) 52%, transparent 82%);
  }

  .footer--compact-glass .footer-container {
    position: relative;
    padding: 22px 26px 18px;
    border: 1px solid rgba(191, 219, 254, 0.14);
    border-radius: 26px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.025));
    box-shadow:
      0 26px 70px rgba(1, 5, 15, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(28px) saturate(150%);
    -webkit-backdrop-filter: blur(28px) saturate(150%);
  }

  .footer--compact-glass .footer-content {
    grid-template-columns: minmax(310px, 0.85fr) minmax(460px, 1.4fr);
    align-items: center;
    gap: 32px;
    margin-bottom: 16px;
  }

  .footer--compact-glass .footer-section {
    max-width: none;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .footer--compact-glass .footer-logo {
    margin-bottom: 0;
    flex-shrink: 0;
  }

  .footer--compact-glass .footer-description {
    margin: 0;
    max-width: 260px;
    padding-left: 18px;
    border-left: 1px solid rgba(191, 219, 254, 0.12);
    line-height: 1.4;
    color: rgba(191, 219, 254, 0.54);
    font-size: 12px;
  }

  .footer--compact-glass .footer-links,
  .footer--compact-glass .footer-column ul {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 12px 22px;
  }

  .footer--compact-glass .footer-column h4 {
    display: none;
  }

  .footer--compact-glass .footer-column li {
    margin: 0;
  }

  .footer--compact-glass .footer-column a {
    color: rgba(191, 219, 254, 0.6);
    font-size: 13px;
  }

  .footer--compact-glass .footer-bottom {
    padding-top: 14px;
    border-top-color: rgba(147, 197, 253, 0.1);
  }

  /* Mobile Optimization */
  @media (max-width: 768px) {
    footer {
      padding: 40px 0 20px;
    }

    .footer-container {
      padding: 0 20px;
    }

    .footer-content {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .footer-section {
      max-width: none;
      text-align: center;
    }

    .footer-links {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .footer-column {
      text-align: center;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 20px;
      text-align: center;
    }

    .footer-legal {
      align-items: center;
    }

    footer.footer--compact-glass {
      padding: 18px 0;
    }

    .footer--compact-glass .footer-container {
      width: calc(100% - 24px);
      padding: 20px 14px 14px;
      border-radius: 22px;
    }

    .footer--compact-glass .footer-content {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 14px;
    }

    .footer--compact-glass .footer-section {
      display: block;
    }

    .footer--compact-glass .footer-logo {
      justify-content: center;
      margin-bottom: 0;
    }

    .footer--compact-glass .footer-description {
      display: none;
    }

    .footer--compact-glass .footer-links,
    .footer--compact-glass .footer-column ul {
      justify-content: center;
      gap: 8px 14px;
    }

    .footer--compact-glass .footer-column a {
      font-size: 11px;
    }

    .footer--compact-glass .footer-bottom {
      gap: 10px;
      padding-top: 12px;
    }

    .footer-audience {
      min-height: 38px;
      padding: 5px 8px 5px 10px;
      gap: 7px;
    }

    .footer-audience-copy {
      flex-direction: row;
      align-items: baseline;
      gap: 5px;
      text-align: left;
    }

    .footer-audience-copy strong {
      font-size: 15px;
    }

    .footer-audience-copy span {
      font-size: 8px;
    }

    .footer-audience-divider {
      height: 18px;
    }

    .footer-audience-logos {
      gap: 7px;
    }

    .footer-audience-logos a {
      width: 15px;
      height: 18px;
    }

    .footer-audience-logos img {
      max-width: 13px;
      max-height: 13px;
    }

    .footer-audience-logos a[aria-label='TikTok'] img {
      max-width: 11px;
    }

    .footer-audience-logos a[aria-label='YouTube'] img {
      max-width: 15px;
    }

    .footer-audience-logos a[aria-label='Facebook'] img {
      max-width: 12px;
    }
  }

  @media (max-width: 480px) {
    .footer-links {
      grid-template-columns: 1fr;
    }
  }
</style>
