---
const {
  screen,
  columns = [],
  searchPlaceholder = 'Rechercher…',
  emptyTitle = 'Aucune donnée',
  emptyText = 'Les données apparaîtront dès que les passerelles répondront.',
} = Astro.props;
const resourceColumnTemplate = columns.length > 1
  ? `minmax(210px, 1.5fr) repeat(${columns.length - 1}, minmax(90px, .7fr))`
  : 'minmax(210px, 1fr)';
const resourceMinWidth = Math.max(860, 210 + Math.max(0, columns.length - 1) * 120);
---

<div
  class="resource-screen"
  data-pay-resource-page={screen}
  data-resource-columns={JSON.stringify(columns)}
  data-empty-title={emptyTitle}
  data-empty-text={emptyText}
  style={`--resource-columns:${resourceColumnTemplate};--resource-min-width:${resourceMinWidth}px;`}
>
  <section class="resource-toolbar pay-panel">
    <label class="resource-search"><span aria-hidden="true">⌕</span><input type="search" data-resource-search placeholder={searchPlaceholder} /></label>
    <select class="pay-select" data-resource-provider aria-label="Filtrer par passerelle">
      <option value="all">Toutes les passerelles</option>
      <option value="stripe">Stripe</option>
      <option value="paypal">PayPal</option>
      <option value="spiffy">Historique Spiffy</option>
      <option value="internal">Pay</option>
    </select>
    <select class="pay-select" data-resource-status aria-label="Filtrer par statut">
      <option value="all">Tous les statuts</option>
    </select>
    <button class="pay-button pay-button--ghost resource-filter-button" type="button" data-resource-more-filters>＋ Plus de filtres</button>
    <button class="pay-button pay-button--ghost resource-filter-button" type="button" data-resource-saved-filters>☆ Vues enregistrées</button>
    <span class="resource-count" data-resource-count>Chargement…</span>
  </section>

  <section class="resource-filter-summary pay-panel" data-resource-filter-summary hidden>
    <span data-resource-filter-summary-text></span>
    <button type="button" data-resource-filter-clear>Effacer les filtres</button>
  </section>

  <section class="resource-table-panel pay-panel">
    <div class="resource-sync-state" data-resource-state>
      <span class="resource-spinner" aria-hidden="true"></span>
      <div><strong>Synchronisation des données réelles</strong><small>Lecture sécurisée de Stripe et PayPal…</small></div>
    </div>
    <div class="resource-table" data-resource-table hidden>
      <div class="resource-row resource-head">
        {columns.map((column) => <span>{column}</span>)}
      </div>
      <div data-resource-rows></div>
      <footer class="resource-pagination" data-resource-pagination hidden>
        <span data-resource-page-summary>0 résultat</span>
        <label><span>Par page</span><select class="pay-select" data-resource-page-size aria-label="Résultats par page"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></label>
        <nav aria-label="Pagination des résultats">
          <button type="button" data-resource-page-previous aria-label="Page précédente">‹</button>
          <span data-resource-page-buttons></span>
          <button type="button" data-resource-page-next aria-label="Page suivante">›</button>
        </nav>
      </footer>
    </div>
    <div class="resource-empty" data-resource-empty hidden><span>◇</span><h2>{emptyTitle}</h2><p>{emptyText}</p></div>
  </section>

  <dialog class="resource-dialog pay-panel" data-resource-dialog aria-labelledby="resourceDialogTitle">
    <header><div><p class="pay-kicker">Fiche détaillée</p><h2 id="resourceDialogTitle" data-resource-dialog-title>Élément</h2></div><button type="button" data-resource-dialog-close aria-label="Fermer">×</button></header>
    <div class="resource-dialog-grid" data-resource-dialog-content></div>
    <section class="resource-notes" data-resource-notes hidden>
      <header><div><strong>Notes internes</strong><small>Conservées uniquement pendant cette session, jusqu’à l’autorisation Supabase.</small></div><span>Brouillon local</span></header>
      <div class="resource-notes-list" data-resource-notes-list></div>
      <div class="resource-note-compose"><textarea class="pay-textarea" rows="3" maxlength="600" data-resource-note-input placeholder="Ajouter un contexte utile à l’équipe…"></textarea><button class="pay-button pay-button--primary" type="button" data-resource-note-add>Ajouter la note</button></div>
    </section>
    <footer>
      <div class="resource-dialog-actions" data-resource-dialog-actions hidden>
        <a class="pay-button pay-button--ghost" data-resource-dialog-edit href="#">Modifier le brouillon</a>
        <button class="pay-button pay-button--primary" type="button" data-resource-dialog-publish>Préparer la publication</button>
        <button class="pay-button resource-dialog-delete" type="button" data-resource-dialog-delete>Supprimer</button>
      </div>
      <button class="pay-button pay-button--ghost" type="button" data-resource-dialog-close>Fermer</button>
    </footer>
  </dialog>

  <dialog class="resource-dialog resource-publish-dialog pay-panel" data-resource-publish-dialog aria-labelledby="resourcePublishTitle">
    <header><div><p class="pay-kicker">Publication · confirmation 2 sur 2</p><h2 id="resourcePublishTitle" data-resource-publish-title>Publier vers Stripe</h2></div><button type="button" data-resource-publish-close aria-label="Fermer">×</button></header>
    <div class="resource-publish-body">
      <div class="resource-publish-state" data-resource-publish-state><span class="resource-spinner" aria-hidden="true"></span><span><strong>Préparation du plan</strong><small>Aucune écriture n’est envoyée pendant cette étape.</small></span></div>
      <div class="resource-publish-plan" data-resource-publish-plan hidden></div>
      <label class="resource-publish-confirm" data-resource-publish-confirm-wrap hidden><span>Recopie la confirmation exacte</span><input class="pay-input" type="text" autocomplete="off" spellcheck="false" data-resource-publish-confirm /><small data-resource-publish-confirm-hint></small></label>
    </div>
    <footer><button class="pay-button pay-button--ghost" type="button" data-resource-publish-close>Annuler</button><button class="pay-button pay-button--primary" type="button" data-resource-publish-execute disabled>Publier vers Stripe</button></footer>
  </dialog>

  <dialog class="resource-dialog resource-filter-dialog pay-panel" data-resource-filter-dialog aria-labelledby="resourceFilterTitle">
    <header><div><p class="pay-kicker">Filtre personnalisé</p><h2 id="resourceFilterTitle">Affiner cette liste</h2></div><button type="button" data-resource-filter-close aria-label="Fermer">×</button></header>
    <div class="resource-filter-form">
      <label><span>Colonne</span><select class="pay-select" data-resource-filter-column>{columns.map((column, index) => <option value={index}>{column}</option>)}</select></label>
      <label><span>Condition</span><select class="pay-select" data-resource-filter-operator><option value="contains">Contient</option><option value="equals">Est exactement</option><option value="starts_with">Commence par</option><option value="ends_with">Se termine par</option><option value="not_contains">Ne contient pas</option></select></label>
      <label class="resource-filter-value"><span>Valeur</span><input class="pay-input" type="text" data-resource-filter-value placeholder="Saisir une valeur…" /></label>
    </div>
    <footer><button class="pay-button pay-button--ghost" type="button" data-resource-filter-close>Annuler</button><button class="pay-button pay-button--primary" type="button" data-resource-filter-apply>Appliquer le filtre</button></footer>
  </dialog>

  <dialog class="resource-dialog resource-views-dialog pay-panel" data-resource-views-dialog aria-labelledby="resourceViewsTitle">
    <header><div><p class="pay-kicker">Vues enregistrées</p><h2 id="resourceViewsTitle">Retrouver tes filtres</h2></div><button type="button" data-resource-views-close aria-label="Fermer">×</button></header>
    <div class="resource-views-list" data-resource-views-list></div>
    <div class="resource-view-save">
      <label><span>Nom de la vue actuelle</span><input class="pay-input" type="text" maxlength="60" data-resource-view-name placeholder="Ex. Plans Stripe en retard" /></label>
      <button class="pay-button pay-button--primary" type="button" data-resource-view-save>Enregistrer la vue</button>
    </div>
    <footer><button class="pay-button pay-button--ghost" type="button" data-resource-views-close>Fermer</button></footer>
  </dialog>
</div>

<style is:global>
  .resource-screen { display: grid; gap: 13px; }
  .resource-toolbar { display: grid; grid-template-columns: minmax(220px, 1fr) 150px 150px auto auto auto; align-items: center; gap: 10px; padding: 12px; border-radius: 19px; }
  .resource-search { height: 42px; display: flex; align-items: center; gap: 9px; padding: 0 12px; border: 1px solid var(--pay-line); border-radius: 13px; color: var(--pay-muted); background: rgba(3,12,24,.4); }
  .resource-search input { width: 100%; border: 0; outline: 0; color: #fff; background: transparent; font-size: 10px; }
  .resource-search input::placeholder { color: var(--pay-muted); }
  .resource-toolbar .pay-select { min-width: 0; height: 42px; padding: 0 11px; font-size: 9px; }
  .resource-count { padding: 0 7px; color: var(--pay-muted); font-size: 9px; white-space: nowrap; }
  .resource-filter-button { min-height: 42px; padding: 0 12px; white-space: nowrap; }
  .resource-filter-summary { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 10px 13px; border-radius: 15px; color: var(--pay-soft); font-size: 9px; }
  .resource-filter-summary[hidden] { display: none; }
  .resource-filter-summary button { border: 0; color: var(--pay-cyan); background: transparent; font: inherit; cursor: pointer; }
  .resource-table-panel { overflow: hidden; min-height: 300px; border-radius: 22px; }
  .resource-sync-state { min-height: 300px; display: flex; align-items: center; justify-content: center; gap: 13px; color: var(--pay-soft); }
  .resource-sync-state strong, .resource-sync-state small { display: block; }
  .resource-sync-state strong { margin-bottom: 5px; color: #fff; font-size: 10px; }
  .resource-sync-state small { color: var(--pay-muted); font-size: 8px; }
  .resource-spinner { width: 26px; height: 26px; border: 2px solid rgba(112,231,255,.13); border-top-color: var(--pay-cyan); border-radius: 50%; animation: resource-spin .8s linear infinite; }
  @keyframes resource-spin { to { transform: rotate(360deg); } }
  .resource-table { min-width: var(--resource-min-width, 860px); }
  .resource-row { display: grid; grid-template-columns: var(--resource-columns, minmax(210px, 1.5fr) repeat(5, minmax(90px, .7fr))); align-items: center; min-height: 65px; border-bottom: 1px solid var(--pay-line); }
  .resource-row:not(.resource-head) { cursor: pointer; transition: background .16s ease; }
  .resource-row:not(.resource-head):hover, .resource-row:not(.resource-head):focus-visible { outline: none; background: rgba(112,231,255,.035); }
  .resource-row:last-child { border-bottom: 0; }
  .resource-row > span { min-width: 0; padding: 12px 15px; overflow: hidden; color: var(--pay-soft); font-size: 9px; line-height: 1.4; text-overflow: ellipsis; }
  .resource-row > span:first-child { color: #fff; }
  .resource-row strong, .resource-row small { display: block; }
  .resource-row strong { color: #fff; font-size: 10px; }
  .resource-row small { margin-top: 4px; color: var(--pay-muted); font-size: 8px; }
  .resource-row a { color: var(--pay-cyan); text-decoration: none; }
  .resource-row a:hover { text-decoration: underline; }
  .resource-head { min-height: 43px; background: rgba(255,255,255,.025); }
  .resource-head > span { color: var(--pay-muted); font-size: 8px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .resource-pagination { min-height: 58px; display: grid; grid-template-columns: minmax(140px, 1fr) auto auto; align-items: center; gap: 14px; padding: 10px 15px; border-top: 1px solid var(--pay-line); color: var(--pay-muted); font-size: 8px; }
  .resource-pagination[hidden] { display: none; }
  .resource-pagination label { display: flex; align-items: center; gap: 8px; white-space: nowrap; }
  .resource-pagination .pay-select { width: 68px; min-height: 34px; padding: 0 9px; font-size: 8px; }
  .resource-pagination nav, .resource-pagination nav > span { display: flex; align-items: center; gap: 5px; }
  .resource-pagination nav button { min-width: 32px; height: 32px; padding: 0 8px; border: 1px solid var(--pay-line); border-radius: 9px; color: var(--pay-soft); background: rgba(255,255,255,.025); font-size: 8px; cursor: pointer; }
  .resource-pagination nav button:hover:not(:disabled), .resource-pagination nav button[aria-current='page'] { border-color: rgba(112,231,255,.34); color: #fff; background: rgba(112,231,255,.09); }
  .resource-pagination nav button:disabled { opacity: .3; cursor: default; }
  .resource-pagination-ellipsis { width: 20px; text-align: center; }
  .resource-provider { display: inline-flex; align-items: center; gap: 6px; }
  .resource-provider::before { width: 7px; height: 7px; content: ''; border-radius: 50%; background: var(--pay-cyan); box-shadow: 0 0 10px rgba(112,231,255,.45); }
  .resource-provider--paypal::before { background: #72a9ff; box-shadow: 0 0 10px rgba(114,169,255,.45); }
  .resource-provider--spiffy::before { background: #ffb56a; box-shadow: 0 0 10px rgba(255,181,106,.45); }
  .resource-provider--internal::before { background: var(--pay-green); box-shadow: 0 0 10px rgba(101,229,170,.4); }
  .resource-empty { min-height: 300px; display: grid; place-items: center; align-content: center; text-align: center; padding: 40px; }
  .resource-empty > span { width: 46px; height: 46px; display: grid; place-items: center; margin-bottom: 13px; border: 1px solid var(--pay-line); border-radius: 14px; color: var(--pay-cyan); background: rgba(112,231,255,.05); }
  .resource-empty h2 { margin: 0 0 7px; font-size: 14px; }
  .resource-empty p { max-width: 420px; margin: 0; color: var(--pay-muted); font-size: 9px; line-height: 1.6; }
  .resource-dialog { width: min(620px, calc(100% - 28px)); padding: 0; border-radius: 25px; color: var(--pay-text); background: linear-gradient(150deg, rgba(18,43,70,.98), rgba(5,19,35,.99)); }
  .resource-dialog::backdrop { background: rgba(0,5,14,.78); backdrop-filter: blur(10px); }
  .resource-dialog > header { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; padding: 23px; border-bottom: 1px solid var(--pay-line); }
  .resource-dialog h2 { margin: 7px 0 0; font-size: 21px; letter-spacing: -.035em; }
  .resource-dialog header button { width: 38px; height: 38px; border: 1px solid var(--pay-line); border-radius: 12px; color: var(--pay-soft); background: rgba(255,255,255,.04); font-size: 21px; cursor: pointer; }
  .resource-dialog-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; padding: 22px; }
  .resource-dialog-grid > div { min-height: 66px; padding: 13px; border: 1px solid var(--pay-line); border-radius: 13px; background: rgba(1,10,21,.28); }
  .resource-dialog-grid small, .resource-dialog-grid strong { display: block; overflow-wrap: anywhere; }
  .resource-dialog-grid small { margin-bottom: 7px; color: var(--pay-muted); font-size: 8px; text-transform: uppercase; }
  .resource-dialog-grid strong { color: #fff; font-size: 10px; line-height: 1.5; }
  .resource-dialog-grid > .resource-customer-methods { grid-column: 1 / -1; min-height: 92px; border-color: rgba(112,231,255,.2); background: rgba(112,231,255,.045); }
  .resource-customer-methods span, .resource-customer-methods small { display: block; margin-top: 7px; color: var(--pay-soft); font-size: 8px; line-height: 1.55; text-transform: none; }
  .resource-notes { padding: 0 22px 20px; }
  .resource-notes[hidden] { display: none; }
  .resource-notes > header { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; padding: 16px 0 12px; border-top: 1px solid var(--pay-line); }
  .resource-notes > header strong, .resource-notes > header small { display: block; }
  .resource-notes > header strong { color: #fff; font-size: 10px; }
  .resource-notes > header small { margin-top: 5px; color: var(--pay-muted); font-size: 8px; line-height: 1.45; }
  .resource-notes > header span { flex: 0 0 auto; padding: 5px 8px; border: 1px solid rgba(255,194,92,.25); border-radius: 99px; color: var(--pay-amber); background: rgba(255,194,92,.05); font-size: 7px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .resource-notes-list { display: grid; gap: 8px; max-height: 190px; overflow: auto; }
  .resource-note { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 12px; padding: 11px 12px; border: 1px solid var(--pay-line); border-radius: 13px; background: rgba(1,10,21,.28); }
  .resource-note p { margin: 0; color: var(--pay-soft); font-size: 9px; line-height: 1.55; white-space: pre-wrap; overflow-wrap: anywhere; }
  .resource-note small { display: block; margin-top: 6px; color: var(--pay-muted); font-size: 7px; }
  .resource-note button { align-self: start; border: 1px solid var(--pay-line); border-radius: 9px; padding: 7px 9px; color: var(--pay-muted); background: rgba(255,255,255,.025); font-size: 8px; cursor: pointer; }
  .resource-note button[data-resource-note-delete-confirm='true'] { border-color: rgba(255,108,137,.45); color: #ff91a8; }
  .resource-notes-empty { padding: 13px; border: 1px dashed var(--pay-line); border-radius: 12px; color: var(--pay-muted); text-align: center; font-size: 8px; }
  .resource-note-compose { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: end; gap: 10px; margin-top: 10px; }
  .resource-note-compose .pay-textarea { min-height: 72px; padding: 11px 12px; resize: vertical; font-size: 9px; }
  .resource-dialog > footer { display: flex; justify-content: space-between; gap: 12px; padding: 14px 22px 20px; border-top: 1px solid var(--pay-line); }
  .resource-dialog-actions { display: flex; gap: 8px; }
  .resource-dialog-actions[hidden] { display: none; }
  .resource-dialog-delete { border-color: rgba(255,128,148,.24); color: #ff9bad; background: rgba(255,128,148,.055); }
  .resource-dialog-delete[data-resource-dialog-delete-confirm='true'] { border-color: rgba(255,128,148,.55); color: #fff; background: rgba(255,94,124,.24); }
  .resource-publish-body { display: grid; gap: 14px; padding: 22px; }
  .resource-publish-state { min-height: 90px; display: flex; align-items: center; justify-content: center; gap: 12px; border: 1px solid var(--pay-line); border-radius: 15px; color: var(--pay-soft); background: rgba(1,10,21,.25); }
  .resource-publish-state strong, .resource-publish-state small { display: block; }
  .resource-publish-state small { margin-top: 5px; color: var(--pay-muted); font-size: 8px; }
  .resource-publish-plan { display: grid; gap: 8px; }
  .resource-publish-plan > div { display: flex; justify-content: space-between; gap: 18px; padding: 12px 13px; border: 1px solid var(--pay-line); border-radius: 12px; color: var(--pay-soft); font-size: 9px; background: rgba(1,10,21,.25); }
  .resource-publish-plan small { color: var(--pay-muted); }
  .resource-publish-confirm { display: grid; gap: 8px; color: var(--pay-soft); font-size: 9px; }
  .resource-publish-confirm small { color: var(--pay-cyan); font-size: 8px; }
  .resource-filter-form { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 22px; }
  .resource-filter-form label, .resource-view-save label { display: grid; gap: 8px; color: var(--pay-soft); font-size: 9px; font-weight: 700; }
  .resource-filter-form .resource-filter-value { grid-column: 1 / -1; }
  .resource-filter-form .pay-select, .resource-filter-form .pay-input, .resource-view-save .pay-input { width: 100%; min-height: 44px; }
  .resource-views-list { display: grid; gap: 8px; max-height: 320px; overflow: auto; padding: 20px 22px; }
  .resource-view-row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: center; gap: 9px; padding: 11px 12px; border: 1px solid var(--pay-line); border-radius: 13px; background: rgba(1,10,21,.28); }
  .resource-view-row strong, .resource-view-row small { display: block; }
  .resource-view-row strong { color: #fff; font-size: 10px; }
  .resource-view-row small { margin-top: 4px; color: var(--pay-muted); font-size: 8px; }
  .resource-view-row button { border: 1px solid var(--pay-line); border-radius: 9px; padding: 7px 9px; color: var(--pay-soft); background: rgba(255,255,255,.035); font-size: 8px; cursor: pointer; }
  .resource-view-row button[data-resource-view-delete-confirm='true'] { border-color: rgba(255,108,137,.45); color: #ff91a8; }
  .resource-views-empty { padding: 22px 12px; color: var(--pay-muted); text-align: center; font-size: 9px; }
  .resource-view-save { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 12px; padding: 18px 22px; border-top: 1px solid var(--pay-line); }
  @media (max-width: 560px) { .resource-dialog-grid { grid-template-columns: 1fr; } .resource-note-compose { grid-template-columns: 1fr; } .resource-dialog > footer, .resource-dialog-actions { align-items: stretch; flex-direction: column; } }
  @media (max-width: 1100px) { .resource-toolbar { grid-template-columns: minmax(200px, 1fr) 145px 145px; } .resource-count { justify-self: end; } }
  @media (max-width: 780px) { .resource-toolbar { grid-template-columns: 1fr 1fr; } .resource-search { grid-column: 1 / -1; } .resource-count { justify-self: start; } .resource-table-panel { overflow-x: auto; } .resource-view-save { grid-template-columns: 1fr; } .resource-pagination { min-width: var(--resource-min-width, 860px); } }
  @media (max-width: 560px) { .resource-filter-form { grid-template-columns: 1fr; } .resource-filter-form .resource-filter-value { grid-column: auto; } .resource-view-row { grid-template-columns: 1fr auto; } .resource-view-row button:last-child { grid-column: 1 / -1; } }
</style>
