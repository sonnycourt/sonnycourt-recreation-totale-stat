---
interface Props {
  currentPath: string;
  hideFormations?: boolean;
  hideBlog?: boolean;
  variant?: 'default' | 'glass';
}

const { currentPath, hideFormations = false, hideBlog = false, variant = 'default' } = Astro.props;

const navItems = [
  ...(hideFormations ? [] : [{ href: "/formations", label: "Formations" }]),
  ...(hideBlog ? [] : [{ href: "/blog", label: "Blog" }]),
  { href: "/contact", label: "Contact" },
  { href: "https://volt.sonnycourt.com/sign_in#email", label: "Se connecter", className: "nav-login" },
  { href: "/masterclass", label: "Commencer", className: "nav-cta" }
];

const isActivePath = (href: string) =>
  href.startsWith('/') &&
  (currentPath === href || currentPath.startsWith(`${href}/`));
---

<nav class:list={{ 'nav--glass': variant === 'glass' }}>
  <div class="nav-container">
    <a href="/" class="logo">
      <div class="logo-icon">
        <svg viewBox="0 0 24 24" fill="currentColor" style="width: 32px; height: 32px;">
          <path d="M11.86 0L11.66 0.2L11.63 0.17L11.66 0.2L11.46 0.44L11.39 0.44L11.42 0.51L11.12 0.88L10.98 0.95L11.01 0.98L10.95 1.09L9.86 2.44L9.79 2.51L9.76 2.48L9.76 2.58L9.38 3.06L9.28 3.16L9.25 3.12L9.28 3.16L9.15 3.36L8.77 3.84L8.71 3.9L8.67 3.87L8.71 3.94L7.99 4.85L7.89 4.96L7.86 4.92L7.89 4.99L7.79 5.13L7.31 5.74L7.21 5.84L7.18 5.8L7.21 5.87L7.11 6.01L5.92 7.54L5.85 7.6L5.82 7.57L5.85 7.6L5.72 7.81L5.62 7.91L5.58 7.88L5.58 7.98L5.28 8.38L5.04 8.66L5.01 8.62L5.04 8.69L4.84 8.96L3.24 11.03L3.14 11.13L3.1 11.1L3.14 11.17L2.56 11.92L2.46 12.02L2.43 11.98L2.46 12.05L1.48 13.31L1.37 13.41L1.34 13.37L1.37 13.44L1 13.88L1.03 13.92L2.46 13.75L4.06 13.65L5.89 13.44L6.3 13.48L6.26 13.54L6.23 13.51L6.26 13.61L6.19 13.71L6.16 13.68L6.16 13.88L5.82 14.63L3.04 21.59L2.8 22.3L2.46 23.08L2.29 23.66L2.12 23.93L2.15 24L2.43 23.73L3.1 22.85L3.24 22.71L3.27 22.74L3.24 22.68L5.58 19.69L5.68 19.59L5.72 19.62L5.68 19.55L6.57 18.4L11.46 12.08L11.69 11.81L11.73 11.85L11.73 11.75L12.44 10.83L12.81 10.39L12.88 10.42L12.81 10.35L13.08 10.05L12.92 10.01L7.99 10.49L7.72 10.46L10.95 2.31L11.08 2.04L11.12 2.1L11.08 1.97L11.79 0.14L11.9 0Z"/>
        </svg>
      </div>
      <span>SONNY COURT</span>
    </a>
    
    <ul class="nav-menu" id="main-navigation">
      {navItems.map(item => (
        <li>
          <a 
            href={item.href} 
            class={item.className || ""}
            class:active={isActivePath(item.href)}
            aria-current={isActivePath(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    
    <button
      class="mobile-menu-toggle"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: var(--blackfriday-banner-height, 0px);
    left: 0;  /* ensure full-bleed even if body has padding */
    right: 0; /* stretch to the right edge */
    width: 100%;
    padding: 20px 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 0.5px solid rgba(255, 255, 255, 0.1);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 20px;
    font-weight: 600;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: opacity 0.2s ease;
    position: relative;
    z-index: 1003;
  }

  .logo:hover {
    opacity: 0.9;
  }

  .logo-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #007AFF;
  }

  .nav-menu {
    display: flex;
    gap: 16px;
    list-style: none;
    align-items: center;
    margin: 0;
    padding: 0;
  }

  .nav-menu a {
    color: #C7C7CC;
    text-decoration: none;
    font-size: 14px;
    font-weight: 400;
    transition: color 0.2s ease;
  }

  .nav-menu a:hover,
  .nav-menu a.active {
    color: #FFFFFF;
  }

  .nav-cta {
    padding: 8px 16px;
    background: #007AFF;
    color: #FFFFFF;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .nav-cta:hover {
    background: #0051D5;
    transform: scale(1.05);
  }

  .nav-login {
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.05);
    color: #636366;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 400;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .nav-login:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.1);
    border-color: #48484A;
  }

  nav.nav--glass {
    top: calc(var(--blackfriday-banner-height, 0px) + 18px);
    left: 20px;
    right: 20px;
    width: auto;
    padding: 0;
    background: transparent;
    border: 0;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .nav--glass .nav-container {
    max-width: none;
    min-height: 62px;
    padding: 0;
  }

  .nav--glass .logo,
  .nav--glass .nav-menu {
    border: 1px solid rgba(191, 219, 254, 0.18);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.105), rgba(255, 255, 255, 0.04));
    box-shadow:
      0 18px 55px rgba(2, 6, 23, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(26px) saturate(165%);
    -webkit-backdrop-filter: blur(26px) saturate(165%);
  }

  .nav--glass .logo {
    min-height: 54px;
    padding: 8px 17px 8px 12px;
    border-radius: 999px;
  }

  .nav--glass .nav-menu {
    margin-left: auto;
    padding: 8px;
    border-radius: 999px;
  }

  .nav--glass .nav-login {
    color: rgba(219, 234, 254, 0.72);
    background: transparent;
    border-color: transparent;
    box-shadow: none;
  }

  .nav--glass .nav-login:hover {
    color: #ffffff;
    background: transparent;
    border-color: transparent;
  }

  .nav--glass .nav-menu a.active:not(.nav-login):not(.nav-cta) {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.065);
    border: 1px solid rgba(191, 219, 254, 0.16);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .nav--glass .nav-cta {
    background: rgba(37, 99, 235, 0.82);
    border: 1px solid rgba(147, 197, 253, 0.28);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 8px 22px rgba(30, 64, 175, 0.26);
  }

  @media (min-width: 769px) {
    .nav--glass .nav-menu {
      min-height: 50px;
      padding: 6px;
      gap: 5px;
    }

    .nav--glass .nav-menu > li {
      display: flex;
      align-items: center;
    }

    .nav--glass .nav-menu > li > a {
      min-height: 38px;
      padding: 0 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
      border-radius: 999px;
    }

    .nav--glass .nav-menu > li > a:not(.nav-login):not(.nav-cta) {
      padding-inline: 15px;
    }
  }

  /* Mobile Menu Toggle */
  .mobile-menu-toggle {
    display: none;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.055);
    color: #fff;
    z-index: 1003;
    appearance: none;
    -webkit-appearance: none;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .mobile-menu-toggle span {
    position: absolute;
    width: 18px;
    height: 1.5px;
    background: #FFFFFF;
    border-radius: 999px;
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .mobile-menu-toggle span:first-child {
    transform: translateY(-3.5px);
  }

  .mobile-menu-toggle span:last-child {
    transform: translateY(3.5px);
  }

  .mobile-menu-toggle.active span:first-child {
    transform: rotate(45deg);
  }

  .mobile-menu-toggle.active span:last-child {
    transform: rotate(-45deg);
  }

  /* Mobile Optimization */
  @media (max-width: 768px) {
    .mobile-menu-toggle {
      display: flex;
    }

    .nav-menu {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100dvh;
      min-height: 100vh;
      background:
        linear-gradient(145deg, rgba(3, 7, 16, 0.985) 0%, rgba(7, 23, 48, 0.975) 62%, rgba(10, 45, 92, 0.96) 100%);
      backdrop-filter: blur(32px) saturate(145%);
      -webkit-backdrop-filter: blur(32px) saturate(145%);
      border: 0;
      border-radius: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: stretch;
      padding: 118px 24px 44px;
      gap: 4px;
      opacity: 0;
      visibility: hidden;
      transform: scale(1.018);
      transition:
        opacity 0.32s ease,
        visibility 0.32s ease,
        transform 0.46s cubic-bezier(0.22, 1, 0.36, 1);
      z-index: 1001;
      box-shadow: none;
    }

    nav.nav--glass {
      top: calc(var(--blackfriday-banner-height, 0px) + 12px);
      left: 12px;
      right: 12px;
    }

    .nav--glass .nav-container {
      min-height: 58px;
      padding: 0;
    }

    .nav--glass .logo {
      min-height: 48px;
      padding: 6px 14px 6px 9px;
      background: rgba(8, 20, 42, 0.44);
      border-color: rgba(191, 219, 254, 0.16);
    }

    .nav--glass .logo-icon,
    .nav--glass .logo-icon svg {
      width: 28px;
      height: 28px;
    }

    .nav--glass .nav-menu {
      background:
        linear-gradient(145deg, rgba(2, 6, 15, 0.985) 0%, rgba(5, 21, 45, 0.98) 58%, rgba(9, 45, 94, 0.965) 100%);
      padding: 118px 24px 44px;
      border: 0;
      border-radius: 0;
    }

    .nav--glass.menu-open .logo {
      background: rgba(255, 255, 255, 0.075);
      border-color: rgba(191, 219, 254, 0.22);
    }

    .nav-menu.active {
      opacity: 1;
      visibility: visible;
      transform: scale(1);
    }

    .nav-menu li {
      width: min(100%, 420px);
      margin: 0;
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.28s ease,
        transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .nav-menu.active li {
      opacity: 1;
      transform: translateY(0);
    }

    .nav-menu.active li:nth-child(1) {
      transition-delay: 0.06s;
    }

    .nav-menu.active li:nth-child(2) {
      transition-delay: 0.1s;
    }

    .nav-menu.active li:nth-child(3) {
      transition-delay: 0.14s;
    }

    .nav-menu.active li:nth-child(4) {
      transition-delay: 0.18s;
    }

    .nav-menu.active li:nth-child(5) {
      transition-delay: 0.22s;
    }

    .nav-menu a {
      font-size: clamp(25px, 8vw, 38px);
      font-weight: 560;
      line-height: 1.08;
      letter-spacing: -0.035em;
      padding: 13px 4px;
      border-radius: 0;
      transition:
        color 0.2s ease,
        opacity 0.2s ease;
      display: block;
      text-align: center;
      color: rgba(239, 246, 255, 0.82);
    }

    .nav-menu a:hover {
      background: transparent;
      color: #fff;
    }

    .nav--glass .nav-menu a.active:not(.nav-login):not(.nav-cta) {
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.07);
      border-color: rgba(191, 219, 254, 0.18);
    }

    .nav-menu .nav-login {
      margin-top: 18px;
      padding: 13px 4px;
      color: rgba(191, 219, 254, 0.5);
      background: transparent;
      border: 0;
      font-size: 17px;
      font-weight: 500;
      letter-spacing: -0.01em;
    }

    .nav-menu .nav-cta {
      max-width: 280px;
      margin: 12px auto 0;
      padding: 15px 24px;
      color: #fff;
      background: rgba(37, 99, 235, 0.82);
      border: 1px solid rgba(147, 197, 253, 0.3);
      border-radius: 999px;
      font-size: 16px;
      font-weight: 650;
      letter-spacing: -0.01em;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.2),
        0 14px 36px rgba(1, 12, 34, 0.28);
    }

    .nav-menu .nav-cta:hover {
      background: rgba(59, 130, 246, 0.94);
      transform: none;
    }

    .mobile-menu-toggle:focus-visible {
      outline: 2px solid rgba(147, 197, 253, 0.72);
      outline-offset: 3px;
    }
  }
</style>

<script>
  // Mobile menu toggle
  document.addEventListener('DOMContentLoaded', function() {
    const mobileToggle = document.querySelector('.mobile-menu-toggle');
    const navMenu = document.querySelector('.nav-menu');
    const nav = mobileToggle?.closest('nav');

    const setMenuState = (isOpen) => {
      if (!mobileToggle || !navMenu) return;

      mobileToggle.classList.toggle('active', isOpen);
      navMenu.classList.toggle('active', isOpen);
      nav?.classList.toggle('menu-open', isOpen);
      mobileToggle.setAttribute('aria-expanded', String(isOpen));
      mobileToggle.setAttribute('aria-label', isOpen ? 'Fermer le menu' : 'Ouvrir le menu');
      document.documentElement.style.overflow = isOpen ? 'hidden' : '';
    };
    
    if (mobileToggle && navMenu) {
      mobileToggle.addEventListener('click', function() {
        setMenuState(!navMenu.classList.contains('active'));
      });
      
      // Close menu when clicking on a link
      navMenu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', function() {
          setMenuState(false);
        });
      });

      document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape' && navMenu.classList.contains('active')) {
          setMenuState(false);
          mobileToggle.focus();
        }
      });
    }
  });

  // Dynamic nav background
  window.addEventListener('scroll', () => {
    const nav = document.querySelector('nav');
    if (nav && !nav.classList.contains('nav--glass')) {
      if (window.scrollY > 50) {
        nav.style.background = 'rgba(0, 0, 0, 0.9)';
      } else {
        nav.style.background = 'rgba(0, 0, 0, 0.7)';
      }
    }
  });
</script>
