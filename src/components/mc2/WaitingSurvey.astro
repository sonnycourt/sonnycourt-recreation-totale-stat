---
import SurveyIcon from './SurveyIcon.astro';
import { MC2_SURVEY_FIELDS, MC2_SURVEY_OPTIONS } from '../../lib/mc2-survey.mjs';
const questions = [
  {
    title: 'Quel domaine de ta vie veux-tu améliorer en priorité ?',
    options: [
      ['wallet', 'Mes finances ou ma situation professionnelle.'],
      ['heart', 'Ma vie amoureuse ou mes relations.'],
      ['steps', 'Ma confiance en moi et le passage à l’action.'],
      ['leaf', 'Mon stress et mon équilibre intérieur.'],
    ],
  },
  {
    title: 'Avant aujourd’hui, tu connaissais Sonny ?',
    options: [
      ['spark', 'Je ne connaissais pas Sonny, je viens juste de le découvrir.'],
      ['video', 'Oui, je le connaissais, j’avais vu quelques vidéos passer.'],
      ['connection', 'Oui, je le suis depuis un bon moment.'],
    ],
  },
  {
    title: 'Quelle est ta situation professionnelle actuelle ?',
    options: [
      ['briefcase', 'Je travaille comme salarié ou salariée.'],
      ['rocket', 'Je travaille à mon compte.'],
      ['transition', 'Je suis en transition ou en recherche d’emploi.'],
      ['graduation', 'Je suis en études.'],
    ],
  },
  {
    title: 'Aujourd’hui, qu’est-ce qui te correspond le mieux ?',
    options: [
      ['compass', 'Je veux apprendre et explorer des pistes, sans urgence.'],
      ['ascent', 'J’ai besoin de solutions concrètes pour que ma situation évolue rapidement.'],
    ],
  },
];
---

<!-- Private first-party answers only; draft previews never send answers. -->
<mc2-waiting-survey id="mc2-waiting-survey" hidden data-clarity-mask="true">
  <header class="survey__intro" data-survey-intro>
    <h1>PRENDS <span class="survey__duration">1 MINUTE</span> POUR RÉPONDRE À CES QUESTIONS AVANT LA MASTERCLASS.</h1>
    <h2>Tes réponses nous aident à mieux comprendre ta situation et ce que tu souhaites améliorer.</h2>
  </header>
  <section class="survey" aria-label="Questionnaire avant la masterclass">
    <div data-survey-content>
      <div class="survey__progress" aria-hidden="true">
        {questions.map((_, index) => <span data-survey-progress class:list={{ 'is-current': index === 0 }} />)}
      </div>
      {questions.map((question, index) => (
        <fieldset data-survey-question data-survey-field={MC2_SURVEY_FIELDS[index]} hidden={index !== 0}>
          <legend tabindex="-1">{question.title}</legend>
          <div class="survey__options">
            {question.options.map(([icon, label], option) => (
              <label class="survey__option">
                <input type="radio" name={`mc2-survey-${index}`} value={MC2_SURVEY_OPTIONS[MC2_SURVEY_FIELDS[index]][option]} />
                <span class="survey__icon" aria-hidden="true"><SurveyIcon name={icon} /></span>
                <span class="survey__label">{label}</span>
                <span class="survey__radio" aria-hidden="true" />
              </label>
            ))}
          </div>
        </fieldset>
      ))}
      <footer class="survey__footer">
        <button type="button" class="survey__back" data-survey-back hidden>← Retour</button>
        <button type="button" class="survey__next" data-survey-next disabled>Suivant <span aria-hidden="true">→</span></button>
      </footer>
    </div>
    <div class="survey__thanks" data-survey-thanks hidden role="status">
      <span class="survey__thanks-icon" aria-hidden="true">✓</span>
      <h3>Merci pour tes réponses.</h3>
      <p>Installe-toi confortablement, on commence bientôt.</p>
      <button type="button" class="survey__skip" data-survey-edit>Modifier mes réponses</button>
    </div>
    <p class="survey__save-status" data-survey-status role="status" hidden></p>
    <button type="button" class="survey__skip" data-survey-retry hidden>Réessayer</button>
  </section>
</mc2-waiting-survey>

<style>
  .survey__save-status { color: #a5bad5; font-size: 13px; margin: 16px 0 0; }
  mc2-waiting-survey { display: block; box-sizing: border-box; width: min(100%, 720px); margin: 40px auto 44px; padding: 34px 30px 24px; border: 1px solid rgba(147,197,253,.18); border-radius: 24px; background: rgba(17,29,49,.8); text-align: left; }
  mc2-waiting-survey[hidden], [hidden] { display: none !important; }
  .survey { padding: 0; color: #f5f8ff; }
  .survey__intro { max-width: 680px; margin: 0 auto 30px; padding: 0; text-align: center; }
  .survey__intro h1 { margin: 0; color: #f5f8ff; font-size: 28px; font-weight: 700; line-height: 1.3; letter-spacing: -.025em; text-wrap: balance; }
  .survey__duration { color: #60a5fa; white-space: nowrap; }
  .survey__intro h2 { margin: 12px 0 0; color: #a5bad5; font-size: 16px; font-weight: 400; line-height: 1.6; text-wrap: pretty; }
  .survey__progress { display: flex; gap: 6px; margin: 0 0 14px; }
  .survey__progress span { height: 3px; flex: 1; border-radius: 4px; background: rgba(147,197,253,.15); }
  .survey__progress .is-current { background: #93c5fd; }
  .survey__progress .is-past { background: #4879b2; }
  fieldset { min-width: 0; padding: 0; margin: 0; border: 0; }
  legend { width: 100%; padding: 0; margin: 0 0 18px; color: #fff; font-size: 20px; font-weight: 650; line-height: 1.4; letter-spacing: -.025em; }
  .survey__options { display: grid; gap: 9px; }
  .survey__option { position: relative; display: flex; align-items: center; gap: 13px; min-height: 57px; padding: 13px 16px; background: rgba(255,255,255,.035); border: 1px solid rgba(180,206,239,.18); border-radius: 12px; cursor: pointer; transition: background .15s, border-color .15s; }
  .survey__option:hover { background: rgba(147,197,253,.085); border-color: rgba(147,197,253,.5); }
  .survey__option:has(input:checked) { background: rgba(59,130,246,.16); border-color: #93c5fd; }
  .survey__option:has(input:focus-visible) { outline: 2px solid #bfdbfe; outline-offset: 3px; }
  .survey__option input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .survey__icon { display: grid; place-items: center; flex: 0 0 34px; width: 34px; height: 34px; border-radius: 10px; color: #a8d2ff; background: rgba(96,165,250,.08); }
  input:checked ~ .survey__icon { color: #d5eaff; background: rgba(96,165,250,.19); }
  .survey__label { flex: 1; color: #e7effb; font-size: 15px; line-height: 1.5; }
  .survey__radio { flex: 0 0 17px; height: 17px; border: 1.5px solid #6d87a8; border-radius: 50%; }
  input:checked ~ .survey__radio { border: 5px solid #93c5fd; background: #152d50; }
  .survey__footer { display: flex; align-items: center; gap: 14px; margin-top: 21px; }
  button { font-family: inherit; cursor: pointer; }
  button:focus-visible { outline: 2px solid #bfdbfe; outline-offset: 4px; }
  .survey__back, .survey__skip { min-height: 44px; padding: 5px 2px; border: 0; background: transparent; color: #b6c6dc; font-size: 13px; }
  .survey__skip:hover, .survey__back:hover { color: #fff; text-decoration: underline; }
  .survey__skip { margin-left: auto; }
  .survey__footer .survey__next { margin-left: auto; }
  .survey__next { display: flex; align-items: center; justify-content: center; gap: 20px; min-width: 132px; min-height: 44px; padding: 11px 18px; color: #0a2444; background: #b6d8ff; border: 1px solid transparent; border-radius: 10px; font-size: 14px; font-weight: 700; }
  .survey__next:hover:not(:disabled) { background: #d1e6ff; }
  .survey__next:disabled { opacity: .4; cursor: default; }
  .survey__thanks { text-align: center; padding: 28px 0 4px; }
  .survey__thanks-icon { display: grid; place-items: center; width: 42px; height: 42px; margin: 0 auto 14px; border-radius: 50%; background: rgba(147,197,253,.13); color: #bfdbfe; font-size: 23px; }
  .survey__thanks h3 { margin: 0 0 9px; font-size: 21px; }
  .survey__thanks p { margin: 0 0 12px; color: #b6c6dc; font-size: 14px; line-height: 1.6; }
  @media(max-width: 600px) {
    mc2-waiting-survey { margin: 32px auto 38px; padding: 25px 17px 18px; border-radius: 18px; }
    .survey__intro { margin-bottom: 25px; }
    .survey__intro h1 { font-size: 22px; }
    .survey__intro h2 { font-size: 14px; }
    legend { font-size: 18px; margin-bottom: 15px; }
    .survey__option { padding: 12px; gap: 10px; min-height: 58px; }
    .survey__label { font-size: 14px; }
    .survey__icon { flex-basis: 30px; width: 30px; height: 30px; border-radius: 8px; }
    .survey__footer { gap: 12px; margin-top: 15px; }
    .survey__next { min-width: 115px; gap: 14px; }
  }
  @media(prefers-reduced-motion: reduce) { .survey__option { transition: none; } }
</style>

<script>
  import { createSurveySync } from '../../lib/mc2-survey-client.mjs';
  class Mc2WaitingSurvey extends HTMLElement {
    configure!: (context: { token: string; sessionGeneration: number; preview: boolean }) => void;
    stopSync?: () => void;
    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';
      const questions = Array.from(this.querySelectorAll<HTMLFieldSetElement>('[data-survey-question]'));
      const next = this.querySelector<HTMLButtonElement>('[data-survey-next]')!;
      const back = this.querySelector<HTMLButtonElement>('[data-survey-back]')!;
      const content = this.querySelector<HTMLElement>('[data-survey-content]')!;
      const thanks = this.querySelector<HTMLElement>('[data-survey-thanks]')!;
      const status = this.querySelector<HTMLElement>('[data-survey-status]')!;
      const retry = this.querySelector<HTMLButtonElement>('[data-survey-retry]')!;
      let index = 0;
      let ready = false;
      let sync: ReturnType<typeof createSurveySync> | undefined;
      let identity = '';
      const render = (focus = false) => {
        const done = index === questions.length;
        content.hidden = done;
        thanks.hidden = !done;
        this.querySelector<HTMLElement>('[data-survey-intro]')!.hidden = done;
        questions.forEach((question, i) => { question.hidden = i !== index; });
        if (done) return;
        this.querySelectorAll('[data-survey-progress]').forEach((item, i) => {
          item.classList.toggle('is-current', i === index);
          item.classList.toggle('is-past', i < index);
        });
        back.hidden = index === 0;
        next.disabled = !ready || !questions[index].querySelector('input:checked');
        next.innerHTML = index === questions.length - 1 ? 'Terminer <span aria-hidden="true">✓</span>' : 'Suivant <span aria-hidden="true">→</span>';
        if (focus) questions[index].querySelector('legend')?.focus({ preventScroll: true });
      };
      this.configure = (context) => {
        const key = JSON.stringify(context);
        if (key === identity) return;
        identity = key;
        sync?.dispose();
        ready = false;
        index = 0;
        questions.forEach(question => {
          question.disabled = true;
          question.querySelectorAll<HTMLInputElement>('input').forEach(input => { input.checked = false; });
        });
        render();
        sync = createSurveySync({ ...context,
          onLoad: (answers, completed) => {
            questions.forEach(question => {
              question.disabled = false;
              question.querySelectorAll<HTMLInputElement>('input').forEach(input => {
                input.checked = answers[question.dataset.surveyField!] === input.value;
              });
            });
            ready = true;
            const firstMissing = questions.findIndex(question => !question.querySelector('input:checked'));
            index = completed && firstMissing < 0 ? questions.length : Math.max(0, firstMissing);
            render();
          },
          onStatus: (message, canRetry) => {
            status.textContent = message;
            status.hidden = !message;
            retry.hidden = !canRetry;
          },
        });
      };
      this.stopSync = () => sync?.dispose();
      retry.addEventListener('click', () => sync?.retry());
      this.addEventListener('change', (event) => {
        const input = event.target as HTMLInputElement;
        const field = input.closest<HTMLElement>('[data-survey-field]')?.dataset.surveyField;
        if (ready && field && input.checked) sync?.save(field, input.value);
        render();
      });
      next.addEventListener('click', () => { if (!next.disabled && index < questions.length) { index++; render(true); } });
      back.addEventListener('click', () => { index = Math.max(0, index - 1); render(true); });
      this.querySelector('[data-survey-edit]')!.addEventListener('click', () => { index = 0; render(true); });
      render();
    }
    disconnectedCallback() { this.stopSync?.(); }
  }
  if (!customElements.get('mc2-waiting-survey')) customElements.define('mc2-waiting-survey', Mc2WaitingSurvey);
</script>
