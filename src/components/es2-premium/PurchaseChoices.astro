---
interface Props { showReduction?: boolean; }
const { showReduction = false } = Astro.props;
---
<section class="premium-choices" aria-label="Choisir mon accompagnement">
  <div class="premium-choices__plans">
    <div class="premium-plan premium-plan--once">
      {showReduction ? <span class="premium-plan__reduction">Réduction -73%</span> : <span class="premium-plan__badge">🎉 TOP DEAL</span>}
      <p class="premium-plan__daily">3,55 €<span>par jour</span></p>
      <p class="premium-plan__terms"><strong>En un versement unique de 1 297 €</strong></p>
      <p class="premium-plan__saving">(économise 1067 €)</p>
      <a href="https://sonnycourt.spiffy.co/offer/exwGnHQuP" data-premium-plan="once">Oui, je rejoins pour 1 297 €</a>
    </div>
    <div class="premium-plan premium-plan--twelve">
      {showReduction && <span class="premium-plan__reduction">Réduction -51%</span>}
      <p class="premium-plan__daily">6,47 €<span>par jour</span></p>
      <p class="premium-plan__terms"><strong>En 12 mensualités de 197 €</strong></p>
      <a href="https://sonnycourt.spiffy.co/checkout/offre-delta-es2?locale=fr" data-premium-plan="twelve" aria-haspopup="dialog" aria-controls="premium-monthly-dialog">Oui, je rejoins pour 197 €/mois</a>
    </div>
  </div>
  <a class="premium-choices__decline" href="https://sonnycourt.spiffy.co/offer/EKEygTZuX">Non merci, je ne suis pas intéressé par l’accompagnement complet.</a>
</section>

<style>
  .premium-choices { width: 100%; max-width: 920px; margin: 26px auto 32px; text-align: center; font-family: 'Inter', sans-serif; }
  .premium-choices__plans { display: grid; grid-template-columns: 1fr 1fr; align-items: stretch; gap: 18px; padding-top: 12px; }
  .premium-plan { position: relative; padding: 32px 22px 22px; border-radius: 19px; display: flex; flex-direction: column; align-items: stretch; min-width: 0; }
  .premium-plan--once { background: radial-gradient(ellipse at 50% 0, #214f9970, transparent 80%), #111f38; border: 1px solid #6b9dff; box-shadow: 0 0 35px #4382ff17; }
  .premium-plan--twelve { background: #0d1421; border: 1px solid #99afd22b; padding-top: 33px; }
  .premium-plan__badge { position: absolute; top: -16px; left: 50%; transform: translateX(-50%); white-space: nowrap; background: linear-gradient(110deg, #872df0, #c91485); color: white; border-radius: 30px; padding: 9px 17px; font-size: 12px; font-weight: 800; box-shadow: 0 5px 16px #9828d438; }
  .premium-plan__reduction { align-self: center; padding: 8px 13px; border-radius: 7px; background: #c91e21; border: 1px solid #ff6868; color: white; font-size: 16px; font-weight: 800; }
  .premium-plan__label { color: #cbdaf3; font-size: 13px; font-weight: 500; }
  .premium-plan__daily { color: white; font-weight: 800; font-size: clamp(38px, 5vw, 61px); line-height: 1; letter-spacing: -.055em; margin: 22px 0 18px; }
  .premium-plan__daily span { display: block; color: #c2d5ef; font-size: 18px; font-weight: 700; letter-spacing: 0; margin-top: 11px; }
  .premium-plan--twelve .premium-plan__daily { color: white; }
  .premium-plan__terms { font-size: 16px; line-height: 1.6; color: #bbcae0; margin: 0 0 25px; }
  .premium-plan__terms strong { font-weight: 600; color: #eef3fc; }
  .premium-plan__saving { font-size: 14px; color: #b9cdeb; margin: -17px 0 25px; line-height: 1.6; }
  .premium-plan--twelve .premium-plan__saving { color: #8594ac; }
  .premium-plan :is(button, a[data-premium-plan]) { box-sizing: border-box; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 14px; padding: 17px 12px; width: 100%; margin-top: auto; border-radius: 10px; font: 700 13px 'Inter', sans-serif; cursor: pointer; transition: background .2s, border-color .2s; }
  .premium-plan--once a { background: linear-gradient(120deg, #3979f4, #2155c2); border: 1px solid #7ca7ff77; color: white; box-shadow: 0 8px 23px #0002; }
  .premium-plan--once a:hover { background: #3b7cf5; }
  .premium-plan--twelve a { background: #172336; border: 1px solid #93aed840; color: #d8e3f5; }
  .premium-plan--twelve a:hover { background: #20304b; border-color: #93aed8; }
  .premium-plan small { color: #9eafc8; font-size: 10px; line-height: 1.6; margin-top: 12px; }
  .premium-choices__decline { display: inline-flex; align-items: center; justify-content: center; max-width: 100%; min-height: 44px; padding: 12px 20px; border: 1px solid #51555e; border-radius: 9px; background: #282b31; color: #d1d3d8; font-size: 12px; line-height: 1.6; text-decoration: none; text-align: center; }
  .premium-choices__decline { margin-top: 18px; }
  .premium-choices__decline:hover { color: white; background: #35383f; border-color: #747881; }
  .premium-choices__decline:focus-visible { outline: 2px solid #d1d3d8; outline-offset: 4px; }
  @media(max-width: 650px) {
    .premium-choices__plans { grid-template-columns: 1fr; gap: 13px; }
    .premium-plan { padding: 29px 19px 20px; }
    .premium-plan--twelve { padding-top: 22px; }
    .premium-plan__daily { font-size: 48px; margin-top: 19px; }
    .premium-plan--twelve .premium-plan__daily { font-size: 48px; margin: 19px 0 18px; }
    .premium-plan--twelve .premium-plan__saving { margin-bottom: 16px; }
    .premium-choices__decline { font-size: 12px; padding: 12px 16px; }
  }
  @media(prefers-reduced-motion: reduce) { .premium-plan button { transition: none; } }
</style>
