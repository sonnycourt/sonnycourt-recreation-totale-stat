            margin: 0;
            color: #eaf3ff;
            font-size: .78rem;
            font-weight: 850;
        }
        .preview-payment-brands {
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .preview-payment-brand {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 24px;
            min-width: 39px;
            padding: 0 6px;
            overflow: hidden;
            color: #10203b;
            background: #fff;
