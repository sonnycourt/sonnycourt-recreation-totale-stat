            margin: 7px 0 0;
            color: rgba(239, 246, 255, 0.82);
            font-size: 0.86rem;
        }
        .preview-checkout__subtitle strong { color: #fff; font-weight: 900; }
        .preview-seat-badge {
            display: grid;
            justify-items: center;
            gap: 7px;
            width: min(100%, 270px);
            margin-top: 18px;
            padding: 13px 18px 12px;
            border: 1px solid rgba(248, 113, 113, 0.34);
            border-radius: 12px;
            background: rgba(127, 29, 29, 0.15);
            box-sizing: border-box;
            text-align: center;
        }
        .preview-seat-badge__label { color: rgba(255, 232, 234, 0.84); font-size: 0.64rem; font-weight: 850; line-height: 1.3; text-transform: uppercase; letter-spacing: 0.055em; }
