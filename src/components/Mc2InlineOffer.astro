        }
        .offer-cta.is-disabled,
        .offer-cta.is-disabled:hover {
            color: rgba(226, 232, 240, 0.72);
            background: linear-gradient(135deg, #475569 0%, #334155 100%);
            box-shadow: none;
            cursor: not-allowed;
            pointer-events: none;
            transform: none;
        }
        .preview-checkout {
            display: none;
            width: 100%;
            max-width: 760px;
            margin-top: 18px;
            overflow: hidden;
            border: 1px solid rgba(133, 186, 255, 0.34);
            border-radius: 22px;
            background: linear-gradient(145deg, #102947, #07162a 68%);
            box-shadow: 0 30px 82px rgba(0, 5, 17, 0.58), inset 0 1px rgba(255, 255, 255, 0.07);
            color: #fff;
            text-align: left;
        }
        html.mc-preview-dev .preview-checkout,
        .preview-checkout.is-live { display: block; }
        html.mc-preview-dev #offer-cta { display: none !important; }
        .preview-checkout.hidden { display: none !important; }
        .preview-checkout__header {
            display: grid;
            grid-template-columns: 1fr;
            align-items: center;
            gap: 20px;
            padding: 25px 28px;
            background:
                radial-gradient(circle at 85% 0%, rgba(53, 142, 255, 0.3), transparent 44%),
                linear-gradient(135deg, #102f5d 0%, #0d448d 100%);
            border-bottom: 1px solid rgba(159, 202, 255, 0.2);
        }
        .preview-checkout__eyebrow {
            margin: 0 0 7px;
            color: rgba(219, 234, 254, 0.82);
            font-size: 0.72rem;
            font-weight: 900;
            letter-spacing: 0.13em;
            text-transform: uppercase;
        }
        .preview-checkout__title {
            margin: 0;
            color: #fff;
            font-size: clamp(1.45rem, 3vw, 1.95rem);
            font-weight: 900;
            letter-spacing: 0.015em;
            text-transform: uppercase;
        }
