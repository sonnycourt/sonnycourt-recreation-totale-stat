        .preview-seat-badge strong small { color: rgba(254, 202, 202, 0.65); font-size: 0.82rem; font-weight: 800; letter-spacing: 0; }
        .preview-checkout__body {
            padding: 24px 28px 28px;
            background: #08172b;
        }
        .preview-payment {
            scroll-margin-top: 20px;
            padding: 0;
            border: 0;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
            color: #f4f8ff;
        }
        .preview-spiffy-payment-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 13px 0 8px;
        }
