                                <img src="https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/e825f3b3-c3b4-49a5-9b69-7c2213b33a11/Melyssa.jpg" alt="" />
                                <img src="https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/b94c69cf-4317-41b0-9637-3f8b8b3d6f52/1-1-.png" alt="" />
                            </span>
                            <strong>Lire leurs témoignages <span aria-hidden="true">→</span></strong>
                        </span>
                    </button>
                </div>

                <dialog class="preview-reviews-dialog" id="preview-reviews-dialog" aria-labelledby="preview-reviews-dialog-title">
                    <div class="preview-reviews-dialog__top">
                        <div><span class="preview-reviews-dialog__eyebrow">Témoignages authentiques</span><h2 id="preview-reviews-dialog-title">Avis des participants</h2></div>
                        <button type="button" class="preview-reviews-dialog__close" id="preview-close-reviews" aria-label="Fermer">×</button>
                    </div>
                    <div class="preview-reviews-dialog__scorebar">
                        <strong>{previewReviewAverageLabel}<small>/5</small></strong>
