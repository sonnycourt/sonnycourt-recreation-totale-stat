            display: none;
            margin-top: 22px;
            margin-bottom: 12px;
            text-align: center;
        }
        .diagnostic-guide-zone.visible {
            display: block;
            animation: ctaFadeIn 0.35s ease forwards;
        }
        .diagnostic-guide-btn {
            width: 100%;
            max-width: 520px;
