---
import reviewsData from '../data/reviews.json';
import reviewConversionOrder from '../data/review-conversion-order.json';

const previewReviewOrder = new Map(reviewConversionOrder.filters.all.map((id, index) => [id, index]));
const previewCheckoutReviews = reviewsData.reviews
    .filter((review) => Boolean(review.first_name))
    .sort((a, b) => (previewReviewOrder.get(a.id) ?? Number.MAX_SAFE_INTEGER) - (previewReviewOrder.get(b.id) ?? Number.MAX_SAFE_INTEGER));
const previewRatedReviews = previewCheckoutReviews.filter((review) => Number.isFinite(review.rating));
const previewReviewAverage = previewRatedReviews.reduce((total, review) => total + review.rating, 0) / previewRatedReviews.length;
const previewReviewAverageLabel = previewReviewAverage.toFixed(1).replace('.', ',');
const previewReviewAveragePercent = (previewReviewAverage / 5) * 100;
const previewRatingCounts = previewRatedReviews.reduce((counts, review) => {
    counts[review.rating] = (counts[review.rating] || 0) + 1;
    return counts;
}, {});
const previewRatingFilterValues = Object.keys(previewRatingCounts).map(Number).sort((a, b) => b - a);
const previewReviewInitials = (name) => name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join('')
    .toUpperCase();
---

        <div id="offer-zone" class="offer-zone hidden">
            <div class="scarcity-card" id="scarcity-card" aria-hidden="true" hidden>
