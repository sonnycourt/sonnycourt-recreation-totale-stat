                                <span aria-hidden="true">★★★★★</span>
                                <span aria-hidden="true" style={`width: ${previewReviewAveragePercent}%`}>★★★★★</span>
                            </span>
                            <p>{previewRatedReviews.length} avis notés sur {previewCheckoutReviews.length} témoignages</p>
                        </div>
                    </div>
                    <div class="preview-reviews-dialog__filters" aria-label="Filtrer les témoignages">
                        <button type="button" class="is-active" data-preview-review-filter="all">Tous</button>
                        {previewRatingFilterValues.map((rating) => <button type="button" data-preview-review-filter={rating}>{rating} étoile{rating > 1 ? 's' : ''}</button>)}
                        <button type="button" data-preview-review-filter="unrated">Sans note</button>
                    </div>
                    <div class="preview-reviews-list">
                        {previewCheckoutReviews.map((review) => (
                            <article class="preview-review-item" data-preview-review-rating={review.rating ?? 'unrated'}>
                                <div class="preview-review-item__head">
                                    {review.source_photo_url ? <img src={review.source_photo_url} alt={review.first_name} loading="lazy" decoding="async" /> : <span class="preview-review-item__initials">{previewReviewInitials(review.first_name)}</span>}
                                    <span><strong>{review.first_name}</strong><small>{review.country || 'Participant vérifié'}</small></span>
                                    {review.rating ? <b aria-label={`${review.rating} étoiles`}>{'★'.repeat(review.rating)}<i>{'★'.repeat(5 - review.rating)}</i></b> : <b class="preview-review-item__unrated">Témoignage</b>}
                                </div>
                                <p>« {review.review} »</p>
                            </article>
                        ))}
                    </div>
                    <p class="preview-reviews-dialog__disclosure">Avis authentiques recueillis auprès de participants à des programmes désormais inclus dans Esprit Subconscient 2.0.</p>
                </dialog>
            <div id="offer-expired-state" class="offer-expired-state hidden" aria-live="polite">
                <p class="offer-expired-title">L’offre Esprit Subconscient 2.0 est désormais fermée</p>
                <p class="offer-expired-copy">Si vous avez des questions, contactez le support.</p>
                <a class="offer-expired-btn" href="/contact">Contacter le support</a>
                <p class="offer-expired-email"><a href="mailto:support@sonnycourt.com">support@sonnycourt.com</a></p>
            </div>
        </div>

<style>
        .offer-zone {
            min-height: 132px;
            display: flex;
