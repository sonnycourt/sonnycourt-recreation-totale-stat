            border-radius: 5px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, .16);
            line-height: 1;
        }
        .preview-payment-brand--mastercard { position: relative; min-width: 40px; padding: 0; }
        .preview-payment-brand--mastercard::before,
        .preview-payment-brand--mastercard::after {
            width: 14px;
            height: 14px;
            content: '';
            border-radius: 50%;
        }
        .preview-payment-brand--mastercard::before { margin-right: -4px; background: #eb001b; }
        .preview-payment-brand--mastercard::after { background: #f79e1b; mix-blend-mode: multiply; }
        .preview-payment-brand--visa { color: #1434cb; font-size: 12px; font-style: italic; font-weight: 950; letter-spacing: -.08em; }
        .preview-payment-brand--apple { color: #050505; font-size: 11px; font-weight: 800; letter-spacing: -.04em; }
        .preview-payment-brand--apple b { margin-right: 2px; font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 15px; font-weight: 700; }
        .preview-payment-brand--paypal { min-width: 43px; color: #003087; font-size: 10px; font-style: italic; font-weight: 900; letter-spacing: -.06em; }
        .preview-payment-brand--paypal em { color: #0070ba; font-style: inherit; }
        @media (max-width: 480px) {
            .preview-spiffy-payment-heading { gap: 8px; }
            .preview-payment-brands { gap: 3px; }
            .preview-payment-brand { height: 22px; min-width: 34px; padding: 0 4px; }
            .preview-payment-brand--mastercard { min-width: 35px; padding: 0; }
            .preview-payment-brand--paypal { min-width: 39px; }
        }
        .preview-identity {
            display: grid;
            grid-template-columns: 0.78fr 1.22fr;
            gap: 10px;
