<script is:inline>
    (function () {
        function initPreviewReviews() {
            var dialog = document.getElementById('preview-reviews-dialog');
            var openButton = document.getElementById('preview-open-reviews');
            var closeButton = document.getElementById('preview-close-reviews');
            if (!dialog || !openButton || openButton.dataset.reviewsReady === 'true') return;

            openButton.dataset.reviewsReady = 'true';
            openButton.addEventListener('click', function () { dialog.showModal(); });
            if (closeButton) closeButton.addEventListener('click', function () { dialog.close(); });
            dialog.addEventListener('click', function (event) {
                if (event.target === dialog) dialog.close();
            });

            var filters = Array.from(dialog.querySelectorAll('[data-preview-review-filter]'));
            var items = Array.from(dialog.querySelectorAll('[data-preview-review-rating]'));
            filters.forEach(function (button) {
                button.addEventListener('click', function () {
                    var rating = button.getAttribute('data-preview-review-filter');
                    filters.forEach(function (filter) { filter.classList.toggle('is-active', filter === button); });
                    items.forEach(function (item) {
                        item.hidden = rating !== 'all' && item.getAttribute('data-preview-review-rating') !== rating;
                    });
                });
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPreviewReviews, { once: true });
        } else {
            initPreviewReviews();
        }
    })();
</script>
