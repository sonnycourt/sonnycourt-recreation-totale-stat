        </form>
      </section>
    </div>

    <div class="toast" id="coach-toast" role="status" aria-live="polite"><span><svg><use href="#co-icon-check"></use></svg></span><p></p></div>

    <script>
      import '../scripts/coach-console.js';
    </script>
  </body>
</html>
