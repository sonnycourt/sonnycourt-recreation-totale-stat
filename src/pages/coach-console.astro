---
import '../styles/coach-console.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07162f" />
    <title>Espace Coaching — Romain</title>
    <meta
      name="description"
      content="Espace de préparation, de suivi et de gestion des accompagnements coaching."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body data-preview="false">
    <svg class="icon-sprite" aria-hidden="true">
      <symbol id="co-icon-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></symbol>
      <symbol id="co-icon-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M8 3v4M16 3v4M3 10h18"/></symbol>
      <symbol id="co-icon-users" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
      <symbol id="co-icon-folder" viewBox="0 0 24 24"><path d="M3 6a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M3 10h18"/></symbol>
      <symbol id="co-icon-check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></symbol>
      <symbol id="co-icon-book" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></symbol>
      <symbol id="co-icon-settings" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21H9.6v-.09A1.7 1.7 0 0 0 8.5 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3V9.6h.09A1.7 1.7 0 0 0 4.6 8.5a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3h4v.09A1.7 1.7 0 0 0 15.5 4.6a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.4 9c.15.39.36.74.6 1 .3.3.7.4 1.1.4h.9v4h-.09A1.7 1.7 0 0 0 19.4 15z"/></symbol>
      <symbol id="co-icon-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></symbol>
      <symbol id="co-icon-bell" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></symbol>
      <symbol id="co-icon-chevron" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
      <symbol id="co-icon-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
      <symbol id="co-icon-video" viewBox="0 0 24 24"><rect x="3" y="5" width="13" height="14" rx="3"/><path d="m16 10 5-3v10l-5-3z"/></symbol>
      <symbol id="co-icon-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
      <symbol id="co-icon-note" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></symbol>
      <symbol id="co-icon-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></symbol>
      <symbol id="co-icon-activity" viewBox="0 0 24 24"><path d="M3 12h4l2-7 4 14 2-7h6"/></symbol>
      <symbol id="co-icon-database" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5M4 11v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"/></symbol>
      <symbol id="co-icon-link" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.5.5l2-2a5 5 0 0 0-7-7l-1.15 1.15"/><path d="M14 11a5 5 0 0 0-7.5-.5l-2 2a5 5 0 0 0 7 7l1.15-1.15"/></symbol>
      <symbol id="co-icon-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
      <symbol id="co-icon-more" viewBox="0 0 24 24"><circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/></symbol>
      <symbol id="co-icon-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></symbol>
      <symbol id="co-icon-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
      <symbol id="co-icon-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3 7 9 6 9-6"/></symbol>
      <symbol id="co-icon-phone" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></symbol>
      <symbol id="co-icon-lock" viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></symbol>
      <symbol id="co-icon-sparkle" viewBox="0 0 24 24"><path d="m12 3 1.3 4.2L17.5 8.5l-4.2 1.3L12 14l-1.3-4.2-4.2-1.3 4.2-1.3zM19 15l.7 2.3L22 18l-2.3.7L19 21l-.7-2.3L16 18l2.3-.7z"/></symbol>
    </svg>

    <div class="ambient" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>

    <section class="coach-gate" id="coach-gate" aria-labelledby="coach-gate-title">
      <div class="gate-shell glass-panel">
        <div class="gate-brand"><span class="brand-mark">S</span><span>SONNY COURT · COACHING</span></div>
        <div class="gate-portrait">
          <img src="/media/coachs/romain.webp?v=ai-hd" alt="Romain" width="112" height="112" />
          <span aria-hidden="true"></span>
        </div>
        <p class="eyebrow">Espace sécurisé</p>
        <h1 id="coach-gate-title">Bienvenue Romain.</h1>
        <p class="gate-copy">Tes rendez-vous, tes dossiers clients et tes notes de séance, au même endroit.</p>
        <form class="gate-form" id="coach-gate-form">
          <label>
            <span>Adresse email</span>
            <span class="input-shell"><svg><use href="#co-icon-mail"></use></svg><input type="email" value="romain@sonnycourt.com" autocomplete="username" /></span>
          </label>
          <label>
            <span>Mot de passe</span>
            <span class="input-shell"><svg><use href="#co-icon-lock"></use></svg><input type="password" value="prototype" autocomplete="current-password" /></span>
          </label>
          <button class="primary-button" type="submit">
            <span id="gate-submit-label">Connexion bientôt disponible</span>
            <svg><use href="#co-icon-arrow"></use></svg>
          </button>
        </form>
        <p class="gate-note"><i></i><span id="gate-note-label">Authentification Supabase à connecter</span></p>
      </div>
    </section>

    <div class="coach-app" id="coach-app" hidden>
      <aside class="sidebar glass-panel" id="coach-sidebar">
        <div class="sidebar-brand">
          <a href="/coaching" aria-label="Retour à la connexion Coaching"><span class="brand-mark">S</span></a>
          <div><strong>Coaching</strong><span>Sonny Court</span></div>
          <button class="icon-button sidebar-close" id="sidebar-close" type="button" aria-label="Fermer le menu"><svg><use href="#co-icon-close"></use></svg></button>
        </div>

        <button class="coach-switcher" id="coach-switcher" type="button" aria-expanded="false">
          <img data-coach-avatar src="/media/coachs/romain.webp?v=ai-hd" alt="" width="48" height="48" />
          <span><small>Coach actif</small><strong data-coach-name>Romain</strong></span>
          <svg><use href="#co-icon-chevron"></use></svg>
        </button>
        <div class="coach-menu glass-popover" id="coach-menu" hidden>
          <button class="coach-option is-active" type="button"><img data-coach-avatar src="/media/coachs/romain.webp?v=ai-hd" alt="" /><span><strong data-coach-name>Romain</strong><small>Coach · actif</small></span><i></i></button>
          <button class="coach-option coach-option-add" type="button" data-view-target="settings"><span class="coach-add"><svg><use href="#co-icon-plus"></use></svg></span><span><strong>Ajouter un coach</strong><small>Après connexion Supabase</small></span></button>
        </div>

        <nav class="sidebar-nav" aria-label="Navigation de l’espace coaching">
          <p>Mon espace</p>
          <button class="nav-item is-active" type="button" data-view-target="dashboard"><svg><use href="#co-icon-grid"></use></svg><span>Vue d’ensemble</span></button>
          <button class="nav-item" type="button" data-view-target="agenda"><svg><use href="#co-icon-calendar"></use></svg><span>Agenda</span><b>5</b></button>
          <button class="nav-item" type="button" data-view-target="clients"><svg><use href="#co-icon-users"></use></svg><span>Clients</span></button>
          <button class="nav-item" type="button" data-view-target="dossiers"><svg><use href="#co-icon-folder"></use></svg><span>Dossiers</span></button>
          <button class="nav-item" type="button" data-view-target="suivi"><svg><use href="#co-icon-check"></use></svg><span>Suivi</span><b class="warm">4</b></button>
          <p>Ressources</p>
          <button class="nav-item" type="button" data-view-target="bibliotheque"><svg><use href="#co-icon-book"></use></svg><span>Bibliothèque</span></button>
          <button class="nav-item" type="button" data-view-target="settings"><svg><use href="#co-icon-settings"></use></svg><span>Configuration</span><i></i></button>
          <a class="nav-item" href="/coaching/compte?role=coach"><svg><use href="#co-icon-users"></use></svg><span>Mon compte</span></a>
          <button class="nav-item" type="button" data-coach-logout><svg><use href="#co-icon-lock"></use></svg><span>Se déconnecter</span></button>
        </nav>

        <div class="sidebar-status">
          <span class="status-orb"></span>
          <div><strong>Maquette locale</strong><small>Supabase non connecté</small></div>
          <button type="button" data-view-target="settings" aria-label="Voir la configuration"><svg><use href="#co-icon-chevron"></use></svg></button>
        </div>
      </aside>

      <main class="workspace">
        <header class="topbar">
          <div class="topbar-left">
            <button class="icon-button menu-button" id="menu-button" type="button" aria-label="Ouvrir le menu"><svg><use href="#co-icon-menu"></use></svg></button>
            <div><p id="view-kicker">Espace de Romain</p><h1 id="view-title">Vue d’ensemble</h1></div>
          </div>
          <div class="topbar-actions">
            <label class="global-search"><svg><use href="#co-icon-search"></use></svg><input id="global-search" type="search" placeholder="Rechercher un client…" autocomplete="off" /><kbd>⌘ K</kbd></label>
            <button class="icon-button notification-button" type="button" aria-label="Notifications"><svg><use href="#co-icon-bell"></use></svg><span></span></button>
            <a class="profile-button" href="/coaching/compte?role=coach" title="Ouvrir mon compte"><img data-coach-avatar src="/media/coachs/romain.webp?v=ai-hd" alt="Romain" /><span><strong data-coach-name>Romain</strong><small>Mon compte</small></span></a>
          </div>
          <div class="search-results glass-popover" id="search-results" hidden></div>
        </header>

        <div class="workspace-scroll">
          <section class="view-panel is-active" data-view-panel="dashboard">
            <div class="welcome-row">
              <div>
                <p class="eyebrow">Samedi 1er août · Lausanne</p>
                <h2>Bonjour <span data-coach-name>Romain</span>. <em>Ta journée est légère.</em></h2>
                <p>Deux consultations, une note à finaliser et aucun dossier urgent.</p>
              </div>
              <div class="preview-badge"><svg><use href="#co-icon-sparkle"></use></svg><span><strong>Mode maquette</strong><small>Données de démonstration</small></span></div>
            </div>

            <div class="metric-grid">
              <article class="metric-card glass-card blue"><span class="metric-icon"><svg><use href="#co-icon-calendar"></use></svg></span><div><small>Aujourd’hui</small><strong>2</strong><p>consultations · 1h30</p></div><b>Journée fluide</b></article>
              <article class="metric-card glass-card green"><span class="metric-icon"><svg><use href="#co-icon-users"></use></svg></span><div><small>Clients actifs</small><strong>12</strong><p>3 suivis premium</p></div><b>+2 ce mois</b></article>
              <article class="metric-card glass-card purple"><span class="metric-icon"><svg><use href="#co-icon-target"></use></svg></span><div><small>Actions ouvertes</small><strong>4</strong><p>dont 1 aujourd’hui</p></div><b>À traiter</b></article>
              <article class="metric-card glass-card amber"><span class="metric-icon"><svg><use href="#co-icon-activity"></use></svg></span><div><small>Satisfaction</small><strong>9,4</strong><p>sur les 30 derniers jours</p></div><b>Excellent</b></article>
            </div>

            <div class="dashboard-grid">
              <article class="next-session glass-card">
                <div class="card-heading"><div><p class="eyebrow">Prochaine consultation · dans 42 min</p><h3>Prépare l’essentiel, pas un script.</h3></div><button class="ghost-button" type="button" data-client-id="claire">Ouvrir le dossier<svg><use href="#co-icon-arrow"></use></svg></button></div>
                <div class="session-person">
                  <span class="avatar avatar-claire">CM</span>
                  <div><strong>Claire Martin</strong><p>Première consultation · 45 minutes</p><span><i></i> Questionnaire complété</span></div>
                  <div class="session-time"><small>Aujourd’hui</small><strong>14:00</strong><span>Europe/Zurich</span></div>
                </div>
                <div class="prep-grid">
                  <div><small>Priorité exprimée</small><strong>Prendre une décision</strong><p>« Je tourne en boucle entre deux directions professionnelles depuis plusieurs mois. »</p></div>
                  <div><small>Contexte utile</small><strong>À retenir avant l’appel</strong><ul><li>Suit ES2 depuis 4 mois</li><li>A déjà testé un coaching de groupe</li><li>Attend une décision concrète</li></ul></div>
                </div>
                <div class="session-actions">
                  <button class="primary-button meet-button" type="button" data-toast="Google Meet sera généré après connexion de Google Calendar."><svg><use href="#co-icon-video"></use></svg><span>Rejoindre sur Google Meet</span></button>
                  <button class="secondary-button" type="button" data-note-client="claire"><svg><use href="#co-icon-note"></use></svg><span>Préparer mes notes</span></button>
                  <span class="integration-hint"><i></i> Lien Meet à connecter</span>
                </div>
              </article>

              <article class="focus-card glass-card">
                <div class="card-heading compact"><div><p class="eyebrow">Focus du jour</p><h3>Ton fil conducteur</h3></div><span class="progress-ring">75%</span></div>
                <div class="focus-list">
                  <label><input type="checkbox" checked /><span><i><svg><use href="#co-icon-check"></use></svg></i><strong>Relire la préparation de Claire</strong><small>Terminé à 12:41</small></span></label>
                  <label><input type="checkbox" /><span><i><svg><use href="#co-icon-check"></use></svg></i><strong>Finaliser les notes de Manon</strong><small>8 minutes estimées</small></span></label>
                  <label><input type="checkbox" checked /><span><i><svg><use href="#co-icon-check"></use></svg></i><strong>Confirmer le suivi de Thomas</strong><small>Terminé à 10:16</small></span></label>
                  <label><input type="checkbox" checked /><span><i><svg><use href="#co-icon-check"></use></svg></i><strong>Bloquer les créneaux de la semaine</strong><small>Terminé hier</small></span></label>
                </div>
                <button class="text-button" type="button" data-view-target="suivi">Voir toutes les actions<svg><use href="#co-icon-arrow"></use></svg></button>
              </article>

              <article class="day-card glass-card">
                <div class="card-heading compact"><div><p class="eyebrow">Agenda</p><h3>Le reste de ta journée</h3></div><button class="icon-button" type="button" data-view-target="agenda" aria-label="Ouvrir l’agenda"><svg><use href="#co-icon-chevron"></use></svg></button></div>
                <div class="day-timeline">
                  <button class="timeline-row is-next" type="button" data-client-id="claire"><time>14:00</time><i></i><span><strong>Claire Martin</strong><small>Première consultation · 45 min</small></span><b>Préparé</b></button>
                  <button class="timeline-row" type="button" data-client-id="thomas"><time>16:30</time><i></i><span><strong>Thomas Rey</strong><small>Suivi premium · séance 3/6</small></span><b>À relire</b></button>
                  <div class="timeline-free"><time>17:15</time><i></i><span><strong>Fin de journée</strong><small>Aucun autre rendez-vous</small></span></div>
                </div>
              </article>

              <article class="attention-card glass-card">
                <div class="card-heading compact"><div><p class="eyebrow">À ne pas oublier</p><h3>4 éléments méritent ton attention</h3></div></div>
                <div class="attention-list">
                  <button type="button" data-note-client="manon"><span class="attention-icon amber"><svg><use href="#co-icon-note"></use></svg></span><span><strong>Note de séance incomplète</strong><small>Manon · séance d’hier</small></span><time>Aujourd’hui</time><svg><use href="#co-icon-chevron"></use></svg></button>
                  <button type="button" data-client-id="julien"><span class="attention-icon purple"><svg><use href="#co-icon-clock"></use></svg></span><span><strong>Relance à programmer</strong><small>Julien · sans nouvelles depuis 7 jours</small></span><time>Demain</time><svg><use href="#co-icon-chevron"></use></svg></button>
                  <button type="button" data-client-id="sarah"><span class="attention-icon blue"><svg><use href="#co-icon-target"></use></svg></span><span><strong>Objectif à réévaluer</strong><small>Sarah · fin du premier cycle</small></span><time>4 août</time><svg><use href="#co-icon-chevron"></use></svg></button>
                </div>
                <button class="text-button" type="button" data-view-target="suivi">Ouvrir le centre de suivi<svg><use href="#co-icon-arrow"></use></svg></button>
              </article>
            </div>
          </section>

          <section class="view-panel" data-view-panel="agenda">
            <div class="section-intro"><div><p class="eyebrow">Agenda personnel</p><h2>Ta semaine, <em>sans le bruit.</em></h2><p>Les rendez-vous confirmés, les temps de préparation et les créneaux disponibles.</p></div><button class="primary-button compact-button" type="button" data-toast="La gestion des disponibilités sera branchée à Google Calendar."><svg><use href="#co-icon-plus"></use></svg><span>Bloquer un créneau</span></button></div>
            <div class="calendar-toolbar glass-card"><button class="icon-button" type="button" aria-label="Semaine précédente"><svg class="flip"><use href="#co-icon-chevron"></use></svg></button><div><strong>3 — 9 août 2026</strong><span>Europe/Zurich</span></div><button class="today-button" type="button">Aujourd’hui</button><button class="icon-button" type="button" aria-label="Semaine suivante"><svg><use href="#co-icon-chevron"></use></svg></button></div>
            <div class="week-grid glass-card">
              <div class="week-hours"><span></span><time>09:00</time><time>11:00</time><time>13:00</time><time>15:00</time><time>17:00</time></div>
              <div class="week-day"><header><span>Lun.</span><strong>3</strong></header><button class="calendar-event blue e-0930" type="button" data-client-id="emma"><small>09:30 · 45 min</small><strong>Emma V.</strong><span>Première consultation</span></button><button class="calendar-event purple e-1400" type="button" data-client-id="sarah"><small>14:00 · 60 min</small><strong>Sarah D.</strong><span>Suivi premium</span></button></div>
              <div class="week-day"><header><span>Mar.</span><strong>4</strong></header><button class="calendar-event green e-1100" type="button" data-client-id="thomas"><small>11:00 · 60 min</small><strong>Thomas R.</strong><span>Suivi premium</span></button><div class="available-slot e-1530"><span>Disponible</span><small>15:30 — 17:00</small></div></div>
              <div class="week-day is-today"><header><span>Mer.</span><strong>5</strong><i>Aujourd’hui</i></header><button class="calendar-event blue e-1000" type="button" data-client-id="claire"><small>10:00 · 45 min</small><strong>Claire M.</strong><span>Première consultation</span></button><button class="calendar-event amber e-1630" type="button" data-client-id="manon"><small>16:30 · 60 min</small><strong>Manon L.</strong><span>Intégration</span></button></div>
              <div class="week-day"><header><span>Jeu.</span><strong>6</strong></header><div class="available-slot e-0930"><span>Disponible</span><small>09:30 — 12:00</small></div><button class="calendar-event purple e-1430" type="button" data-client-id="julien"><small>14:30 · 60 min</small><strong>Julien P.</strong><span>Suivi premium</span></button></div>
              <div class="week-day"><header><span>Ven.</span><strong>7</strong></header><button class="calendar-event green e-1100" type="button" data-client-id="nora"><small>11:00 · 45 min</small><strong>Nora B.</strong><span>Première consultation</span></button><div class="available-slot e-1500"><span>Disponible</span><small>15:00 — 17:30</small></div></div>
            </div>
          </section>

          <section class="view-panel" data-view-panel="clients">
            <div class="section-intro"><div><p class="eyebrow">Portefeuille clients</p><h2>Chaque personne, <em>avec son histoire.</em></h2><p>Une vue claire des accompagnements, sans transformer les humains en lignes de CRM.</p></div><button class="primary-button compact-button" type="button" data-toast="La création manuelle sera disponible après connexion de Supabase."><svg><use href="#co-icon-plus"></use></svg><span>Nouveau client</span></button></div>
