---
import GAConsentMode from '../../components/GAConsentMode.astro';
import Mc2SafetyGuard from '../../components/Mc2SafetyGuard.astro';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <title>Retrouve ton offre personnelle — Esprit Subconscient 2.0</title>
    <meta name="description" content="Retrouve l’offre personnelle présentée à la fin de la masterclass Esprit Subconscient 2.0." />
    <link rel="canonical" href="https://sonnycourt.com/offre/" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <GAConsentMode performanceMode />
    <Mc2SafetyGuard />
    <style>
      @font-face { font-family: Inter; font-style: normal; font-weight: 400 900; font-display: swap; src: url('/fonts/inter-latin.woff2') format('woff2'); }
      * { box-sizing: border-box; }
      :root { color-scheme: dark; --muted: rgba(255,255,255,.66); }
      html, body { min-height: 100%; }
      body { margin: 0; min-height: 100dvh; overflow-x: hidden; color: #fff; background: radial-gradient(circle at 16% 4%,rgba(37,99,235,.34),transparent 34%),radial-gradient(circle at 88% 82%,rgba(30,64,175,.17),transparent 32%),linear-gradient(145deg,#0b1735 0%,#050917 53%,#040712 100%); font-family: Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif; }
      body::before { position: fixed; inset: 0; z-index: -1; content: ''; opacity: .18; background-image: linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px); background-size: 44px 44px; mask-image: linear-gradient(to bottom,#000,transparent 82%); }
      .page { display: grid; min-height: 100dvh; grid-template-rows: 1fr auto; }
      main { display: grid; width: 100%; padding: clamp(24px,6vw,72px) 18px; place-items: center; }
      .card { position: relative; width: min(100%,590px); overflow: hidden; border: 1px solid rgba(96,165,250,.33); border-radius: 28px; background: linear-gradient(150deg,rgba(17,42,87,.96),rgba(5,17,40,.98)); box-shadow: 0 34px 100px rgba(0,0,0,.46),inset 0 1px rgba(255,255,255,.07); }
      .card::before { position: absolute; top: 0; left: 0; width: 100%; height: 4px; content: ''; background: linear-gradient(90deg,#60a5fa,#2563eb 55%,#1d4ed8); }
      .card-inner { padding: clamp(30px,7vw,54px); }
      .brand { margin: 0 0 24px; color: #93c5fd; font-size: .72rem; font-weight: 850; letter-spacing: .14em; text-transform: uppercase; }
      .status-icon { display: grid; width: 58px; height: 58px; margin-bottom: 22px; place-items: center; border: 1px solid rgba(147,197,253,.34); border-radius: 18px; color: #bfdbfe; background: rgba(37,99,235,.17); box-shadow: inset 0 1px rgba(255,255,255,.08),0 14px 34px rgba(0,0,0,.2); }
      .status-icon svg { width: 28px; height: 28px; }
      h1 { max-width: 510px; margin: 0 0 15px; font-size: clamp(2rem,7vw,3.35rem); font-weight: 850; letter-spacing: -.052em; line-height: 1.01; }
      .lead { max-width: 500px; margin: 0 0 28px; color: var(--muted); font-size: clamp(.96rem,2.5vw,1.08rem); line-height: 1.58; }
      .loading { display: flex; min-height: 112px; align-items: center; gap: 13px; color: rgba(255,255,255,.72); font-size: .88rem; font-weight: 700; }
      .spinner { width: 23px; height: 23px; flex: 0 0 auto; border: 2px solid rgba(147,197,253,.22); border-top-color: #60a5fa; border-radius: 50%; animation: spin .75s linear infinite; }
      @keyframes spin { to { transform: rotate(360deg); } }
      .recovery[hidden], .loading[hidden] { display: none !important; }
      label { display: block; margin: 0 0 9px; color: rgba(255,255,255,.82); font-size: .78rem; font-weight: 780; }
      input { width: 100%; height: 58px; padding: 0 17px; border: 1px solid rgba(147,197,253,.33); border-radius: 14px; outline: none; color: #0f172a; background: #fff; box-shadow: 0 9px 26px rgba(0,0,0,.15); font: inherit; font-size: 1rem; }
      input:focus { border-color: #60a5fa; box-shadow: 0 0 0 4px rgba(96,165,250,.19),0 9px 26px rgba(0,0,0,.15); }
      button { display: flex; width: 100%; min-height: 59px; margin-top: 13px; align-items: center; justify-content: center; gap: 10px; border: 0; border-radius: 14px; color: #fff; background: linear-gradient(135deg,#4f9cff,#2563eb 72%); box-shadow: 0 15px 40px rgba(37,99,235,.34),inset 0 1px rgba(255,255,255,.18); cursor: pointer; font: inherit; font-size: .84rem; font-weight: 850; letter-spacing: .025em; }
      button svg { width: 19px; height: 19px; }
      button:disabled { opacity: .7; cursor: wait; }
      .message { min-height: 0; margin: 10px 2px 0; font-size: .79rem; line-height: 1.45; }
      .message:not(:empty) { min-height: 22px; }
      .message.error { color: #fecaca; }
      .message.success { color: #bbf7d0; }
      .privacy { margin: 16px 0 0; color: rgba(255,255,255,.49); font-size: .7rem; line-height: 1.5; }
      .privacy a, footer a, noscript a { color: #bfdbfe; }
      footer { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px; padding: 0 20px 26px; color: rgba(255,255,255,.42); font-size: .69rem; }
      footer a { text-decoration-color: rgba(191,219,254,.35); }
      noscript { display: block; margin-top: 20px; padding: 14px; border: 1px solid rgba(251,191,36,.3); border-radius: 12px; color: #fde68a; background: rgba(146,64,14,.16); font-size: .82rem; line-height: 1.5; }
      @media (max-width:560px) { main { padding: 18px 13px 30px; } .card { border-radius: 22px; } .card-inner { padding: 29px 21px 27px; } .brand { margin-bottom: 20px; } .status-icon { width: 52px; height: 52px; border-radius: 16px; } h1 { font-size: clamp(2rem,12vw,2.75rem); } }
      @media (prefers-reduced-motion:reduce) { .spinner { animation: none; } }
    </style>
  </head>
  <body>
    <div class="page">
      <main>
        <section class="card" aria-labelledby="offer-title">
          <div class="card-inner">
            <p class="brand">Esprit Subconscient 2.0</p>
            <div class="status-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M7.5 10V8.2a4.5 4.5 0 0 1 9 0V10M6.4 10h11.2a1.4 1.4 0 0 1 1.4 1.4v7.2a1.4 1.4 0 0 1-1.4 1.4H6.4A1.4 1.4 0 0 1 5 18.6v-7.2A1.4 1.4 0 0 1 6.4 10Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M12 14v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></div>
            <h1 id="offer-title">Retrouve ton offre personnelle</h1>
            <p class="lead">Cette page retrouve l’accès lié à ton inscription et te ramène vers l’offre présentée après la masterclass.</p>
            <div class="loading" id="offer-loading" role="status"><span class="spinner" aria-hidden="true"></span><span>Recherche de ton accès personnel…</span></div>
            <div class="recovery" id="offer-recovery" hidden>
              <form id="offer-recovery-form" novalidate>
                <label for="offer-email">Adresse email utilisée lors de ton inscription</label>
                <input id="offer-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="ton@email.com" required />
                <p class="message error" id="offer-error" role="alert"></p>
                <p class="message success" id="offer-success" role="status"></p>
                <button type="submit" id="offer-submit"><span>RETROUVER MON OFFRE</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              </form>
              <p class="privacy">Nous utilisons ton email uniquement pour retrouver ton inscription et t’envoyer ton lien personnel. <a href="/confidentialite/">Politique de confidentialité</a>.</p>
            </div>
            <noscript>Active JavaScript pour retrouver automatiquement ton offre, ou écris-nous à <a href="mailto:support@sonnycourt.com">support@sonnycourt.com</a>.</noscript>
          </div>
        </section>
      </main>
      <footer><span>© Sonny Court</span><a href="/cgv/">Conditions générales de vente</a><a href="mailto:support@sonnycourt.com">Support</a></footer>
    </div>
    <script is:inline>
      (() => {
        const TOKEN_KEY = 'mc2_registration_token';
        const LEGACY_TOKEN_KEYS = ['masterclass_es2_token','webinaire_es2_token','mc2_registration_token_legacy'];
        const SESSION_PATH = '/mc2/session/';
        const loading = document.getElementById('offer-loading');
        const recovery = document.getElementById('offer-recovery');
        const form = document.getElementById('offer-recovery-form');
        const emailInput = document.getElementById('offer-email');
        const submit = document.getElementById('offer-submit');
        const errorNode = document.getElementById('offer-error');
        const successNode = document.getElementById('offer-success');

        function cookieValue(name) {
          const match = document.cookie.split(';').map((part) => part.trim()).find((part) => part.startsWith(`${name}=`));
          return match ? decodeURIComponent(match.slice(name.length + 1)) : '';
        }
        function tokenCandidates() {
          const params = new URLSearchParams(window.location.search);
          const values = [params.get('t'),params.get('token')];
          try { values.push(localStorage.getItem(TOKEN_KEY)); LEGACY_TOKEN_KEYS.forEach((key) => values.push(localStorage.getItem(key))); } catch (error) {}
          values.push(cookieValue(TOKEN_KEY)); LEGACY_TOKEN_KEYS.forEach((key) => values.push(cookieValue(key)));
          return [...new Set(values.map((value) => String(value || '').trim()).filter(Boolean))];
        }
        function persistToken(token) {
          try { localStorage.setItem(TOKEN_KEY,token); } catch (error) {}
          document.cookie = `${TOKEN_KEY}=${encodeURIComponent(token)}; Path=/; Max-Age=2592000; SameSite=Lax; Secure`;
        }
        function clearCandidate(token) {
          try { [TOKEN_KEY,...LEGACY_TOKEN_KEYS].forEach((key) => { if (localStorage.getItem(key) === token) localStorage.removeItem(key); }); } catch (error) {}
          [TOKEN_KEY,...LEGACY_TOKEN_KEYS].forEach((key) => { if (cookieValue(key) === token) document.cookie = `${key}=; Path=/; Max-Age=0; SameSite=Lax; Secure`; });
        }
        async function tokenIsValid(token) {
          const response = await fetch(`/.netlify/functions/get-mc2-registration?t=${encodeURIComponent(token)}`,{ headers: { Accept: 'application/json' },cache: 'no-store' });
          return response.ok;
        }
        function redirectToOffer(token) {
          persistToken(token);
          window.location.replace(`${SESSION_PATH}?t=${encodeURIComponent(token)}`);
        }
        function showRecovery() {
          if (loading) loading.hidden = true;
          if (recovery) recovery.hidden = false;
          window.setTimeout(() => emailInput?.focus(),50);
        }
        async function resolveStoredAccess() {
          for (const token of tokenCandidates()) {
            try { if (await tokenIsValid(token)) { redirectToOffer(token); return; } } catch (error) {}
            clearCandidate(token);
          }
          showRecovery();
        }
        form?.addEventListener('submit',async (event) => {
          event.preventDefault();
          const email = String(emailInput?.value || '').trim().toLowerCase();
          if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { if (errorNode) errorNode.textContent = 'Entre une adresse email valide.'; return; }
          if (errorNode) errorNode.textContent = '';
          if (successNode) successNode.textContent = '';
          if (submit) submit.disabled = true;
          try {
            const response = await fetch('/.netlify/functions/request-mc2-access',{ method: 'POST',headers: { 'Content-Type': 'application/json' },body: JSON.stringify({ email,page_path: '/offre/' }) });
            const data = await response.json().catch(() => ({}));
            if (!response.ok) throw new Error(data.error || 'Impossible d’envoyer ton lien.');
            if (successNode) successNode.textContent = String(data.message || 'Si cette adresse correspond à une inscription, ton lien personnel vient d’être envoyé.');
            if (emailInput) emailInput.disabled = true;
            if (submit) submit.hidden = true;
          } catch (error) {
            if (errorNode) errorNode.textContent = error instanceof Error ? error.message : 'Impossible d’envoyer ton lien.';
            if (submit) submit.disabled = false;
          }
        });
        resolveStoredAccess();
      })();
    </script>
  </body>
</html>
