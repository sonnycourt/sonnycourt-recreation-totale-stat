                  <linearGradient id="guided-route" x1="8" y1="116" x2="342" y2="36" gradientUnits="userSpaceOnUse"><stop stop-color="#3b82f6"/><stop offset="0.7" stop-color="#60a5fa"/><stop offset="1" stop-color="#f4cf79"/></linearGradient>
                  <marker id="route-arrow-gold" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" fill="#f4cf79" /></marker>
                </defs>
                <path d="M8 116 C72 116 78 92 130 92 C182 92 184 65 235 65 C286 65 292 36 342 36" fill="none" stroke="url(#guided-route)" stroke-width="3" marker-end="url(#route-arrow-gold)" />
                <circle cx="130" cy="92" r="6" fill="#0b1f3a" stroke="#60a5fa" stroke-width="2.5" />
                <circle cx="235" cy="65" r="6" fill="#0b1f3a" stroke="#60a5fa" stroke-width="2.5" />
                <circle cx="334" cy="36" r="10" fill="rgba(244,207,121,.12)" stroke="#f4cf79" stroke-width="2.5" />
                <text class="route-label" x="105" y="120" fill="#93c5fd">L’ÉTAT</text>
                <text class="route-label" x="202" y="48" fill="#93c5fd">MAINTENU</text>
                <text class="route-label" x="250" y="16" fill="#f4cf79">MANIFESTATION</text>
              </svg>
            </div>
