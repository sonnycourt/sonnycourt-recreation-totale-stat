    </main>
    <button class="deal-sticky-cta is-visible" id="deal-sticky-cta" type="button" aria-controls="deal-registration">
      Je m’inscris ⚡
    </button>
    <script is:inline>
      (() => {
        const stickyCta = document.getElementById('deal-sticky-cta');
        const twoPathsCta = document.getElementById('two-paths-registration-cta');
        const corePriceCta = document.getElementById('core-price-registration-cta');
        const registration = document.getElementById('deal-registration');
        const offerZone = document.getElementById('offer-zone');
        const isLocalPreview = ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname);
        const scrollToRegistration = () => {
          registration?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        };
        const syncStickyCta = () => {
          if (!stickyCta) return;
          const offerIsVisible = isLocalPreview || !offerZone || offerZone.classList.contains('visible');
          stickyCta.classList.toggle('is-visible', offerIsVisible);
        };

        if (stickyCta && registration) {
          stickyCta.addEventListener('click', scrollToRegistration);
        }
        if (twoPathsCta && registration) {
          twoPathsCta.addEventListener('click', scrollToRegistration);
        }
        if (corePriceCta && registration) {
          corePriceCta.addEventListener('click', scrollToRegistration);
        }

        if (offerZone) {
          new MutationObserver(syncStickyCta).observe(offerZone, {
            attributes: true,
            attributeFilter: ['class'],
          });
        }
        syncStickyCta();

        const countdown = document.getElementById('deal-countdown');
        if (!countdown) return;

        const units = {
          days: countdown.querySelector('[data-unit="days"]'),
          hours: countdown.querySelector('[data-unit="hours"]'),
          minutes: countdown.querySelector('[data-unit="minutes"]'),
          seconds: countdown.querySelector('[data-unit="seconds"]'),
        };
        const scarcity = document.querySelector('.deal-scarcity');
        const totalPlaces = Number(scarcity?.dataset.totalPlaces || 0);
        const remainingPlaces = Number(scarcity?.dataset.remainingPlaces || 0);
        const attributedPlaces = Math.max(0, totalPlaces - remainingPlaces);

        document.querySelectorAll('[data-limited-bonus]').forEach((bonus) => {
          const limit = Number(bonus.dataset.bonusLimit || 0);
          const available = Math.max(0, limit - attributedPlaces);
          const availability = bonus.querySelector('.es2-bonus-availability');
          const text = bonus.querySelector('[data-bonus-availability-text]');
          const count = bonus.querySelector('[data-bonus-availability-count]');
          if (!availability || !text || !count) return;

          if (available === 0) {
            bonus.classList.add('is-sold-out');
            availability.classList.add('is-sold-out');
            text.textContent = `Les ${limit} places de ce bonus ont déjà été attribuées.`;
            count.textContent = 'Épuisé';
            return;
          }

          bonus.classList.remove('is-sold-out');
          availability.classList.remove('is-sold-out');
          text.textContent = `Plus que ${available} place${available > 1 ? 's' : ''} disponible${available > 1 ? 's' : ''} pour ce bonus.`;
          count.textContent = `${available} / ${limit}`;
        });

        const reviewsDialog = document.getElementById('preview-reviews-dialog');
        const openReviews = document.getElementById('preview-open-reviews');
        const openReviewsShowcase = document.getElementById('preview-open-reviews-showcase');
        const closeReviews = document.getElementById('preview-close-reviews');
        const reviewFilters = Array.from(document.querySelectorAll('[data-preview-review-filter]'));
        const reviewItems = Array.from(document.querySelectorAll('[data-preview-review-rating]'));
        [openReviews, openReviewsShowcase].forEach((button) => {
          if (button && reviewsDialog) button.addEventListener('click', () => reviewsDialog.showModal());
        });
        if (closeReviews && reviewsDialog) closeReviews.addEventListener('click', () => reviewsDialog.close());
        if (reviewsDialog) reviewsDialog.addEventListener('click', (event) => {
          if (event.target === reviewsDialog) reviewsDialog.close();
        });
        reviewFilters.forEach((button) => {
          button.addEventListener('click', () => {
            const rating = button.getAttribute('data-preview-review-filter');
            reviewFilters.forEach((filter) => filter.classList.toggle('is-active', filter === button));
            reviewItems.forEach((item) => {
              item.hidden = rating !== 'all' && item.getAttribute('data-preview-review-rating') !== rating;
            });
          });
        });

        let remaining = Number(countdown.dataset.seconds || 0);
        const pad = (value) => String(value).padStart(2, '0');
        const updateUnit = (unit, value) => {
          const node = units[unit];
          if (!node || node.textContent === value) return;
          node.textContent = value;
          node.classList.remove('is-ticking');
          void node.offsetWidth;
          node.classList.add('is-ticking');
        };
        const render = () => {
          const days = Math.floor(remaining / 86400);
          const hours = Math.floor((remaining % 86400) / 3600);
          const minutes = Math.floor((remaining % 3600) / 60);
          const seconds = remaining % 60;
          updateUnit('days', pad(days));
          updateUnit('hours', pad(hours));
          updateUnit('minutes', pad(minutes));
          updateUnit('seconds', pad(seconds));
          countdown.setAttribute('aria-label', `${days} jours, ${hours} heures, ${minutes} minutes et ${seconds} secondes restantes`);
        };

        render();
        window.setInterval(() => {
          if (remaining <= 0) return;
          remaining -= 1;
          render();
        }, 1000);
      })();
    </script>
    <script is:inline>
      (() => {
        const slot = document.getElementById('deal-spiffy-checkout');
        const planButtons = Array.from(document.querySelectorAll('[data-payment-plan]'));
        const paymentBrands = slot?.querySelector('.checkout-payment-brands');
        if (!slot || planButtons.length !== 2) return;

        const visitor = new URLSearchParams(window.location.search);

        const plans = {
          three: {
            url: slot.dataset.monthlyCheckout || '',
          },
          once: {
            url: slot.dataset.onceCheckout || '',
          },
        };
        let activePlan = 'once';
        let activeFrame = null;

        const replaceCheckoutChildren = (...children) => {
          slot.replaceChildren(...(paymentBrands ? [paymentBrands, ...children] : children));
        };

        const checkoutUrl = (base) => {
          const url = new URL(base);
          url.searchParams.set('code', slot.dataset.discountCode || 'OFFRE50POURCENT');
          if (visitor.get('country')) url.searchParams.set('country', visitor.get('country'));
          return url;
        };

        const mountCheckout = () => {
          const plan = plans[activePlan];
          const url = checkoutUrl(plan.url);
          planButtons.forEach((button) => {
            const selected = button.dataset.paymentPlan === activePlan;
            button.classList.toggle('is-selected', selected);
            button.setAttribute('aria-pressed', selected ? 'true' : 'false');
          });
          slot.setAttribute('aria-busy', 'true');

          if (window.location.protocol === 'http:') {
            url.searchParams.set('elements', btoa(JSON.stringify({
              modality: 'inline',
              uid: 1,
              from: window.location.href,
              handles: {},
            })));
            const loading = document.createElement('div');
            loading.className = 'deal-spiffy-checkout__loading';
            loading.textContent = 'Connexion au paiement sécurisé…';
            const frame = document.createElement('iframe');
            activeFrame = frame;
            frame.src = url.toString();
            frame.title = activePlan === 'once'
              ? 'Paiement sécurisé en une fois'
              : 'Paiement sécurisé en trois fois';
            frame.setAttribute('allow', 'payment');
            frame.setAttribute('loading', 'eager');
            frame.setAttribute('width', '100%');
            frame.style.display = 'block';
            frame.style.width = '100%';
            frame.style.minWidth = '100%';
            frame.style.maxWidth = 'none';
            frame.style.border = '0';
            frame.style.background = 'transparent';
            frame.style.height = window.matchMedia('(max-width: 700px)').matches ? '520px' : '420px';
            frame.style.opacity = '0';
            frame.style.transition = 'opacity 180ms ease';
            frame.addEventListener('load', () => {
              loading.remove();
              frame.style.opacity = '1';
              slot.setAttribute('aria-busy', 'false');
            }, { once: true });
            replaceCheckoutChildren(loading, frame);
            return;
          }

          activeFrame = null;
          const checkout = document.createElement('spiffy-checkout');
          checkout.setAttribute('url', url.toString());
          checkout.style.display = 'block';
          checkout.style.width = '100%';
          checkout.style.maxWidth = 'none';
          replaceCheckoutChildren(checkout);
          slot.setAttribute('aria-busy', 'false');
        };

        window.addEventListener('message', (event) => {
          if (!activeFrame || event.origin !== 'https://sonnycourt.spiffy.co') return;
          let payload = event.data;
          if (typeof payload === 'string') {
            try { payload = JSON.parse(payload); } catch { return; }
          }
          if (!payload || (payload.event !== 'form:size' && payload.type !== 'es2:spiffy-height')) return;
          const height = Number(payload.height || (payload.data && payload.data.height));
          if (!Number.isFinite(height) || height < 180) return;
          const maxHeight = window.matchMedia('(max-width: 700px)').matches ? 720 : 620;
          activeFrame.style.height = Math.min(Math.ceil(height), maxHeight) + 'px';
        });

        planButtons.forEach((button) => button.addEventListener('click', () => {
          const requestedPlan = button.dataset.paymentPlan;
          if (!requestedPlan || requestedPlan === activePlan || !plans[requestedPlan]) return;
          activePlan = requestedPlan;
          mountCheckout();
        }));

        mountCheckout();
      })();
    </script>
    <script>
      import Hls from 'hls.js';

      const media = document.getElementById('video-reviews-media');
      const video = document.getElementById('video-reviews-video');

      if (media instanceof HTMLElement && video instanceof HTMLVideoElement) {
        const source = media.dataset.source || '';
        const progress = media.querySelector('[data-video-progress]');
        const volume = media.querySelector('[data-video-volume]');
        const time = media.querySelector('[data-video-time]');
        const toggleButtons = Array.from(media.querySelectorAll('[data-video-action="toggle"]'));
        const muteButton = media.querySelector('[data-video-action="mute"]');
        const pipButton = media.querySelector('[data-video-action="pip"]');
        const fullscreenButton = media.querySelector('[data-video-action="fullscreen"]');
        let hls: Hls | null = null;

        if (video.canPlayType('application/vnd.apple.mpegurl')) {
          video.src = source;
        } else if (Hls.isSupported()) {
          hls = new Hls({ enableWorker: true, startLevel: -1 });
          hls.loadSource(source);
          hls.attachMedia(video);
        }

        const formatTime = (seconds: number) => {
          if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
          const rounded = Math.floor(seconds);
          const minutes = Math.floor(rounded / 60);
          return `${minutes}:${String(rounded % 60).padStart(2, '0')}`;
        };

        const paintRange = (range: HTMLInputElement, ratio: number) => {
          const bounded = Math.max(0, Math.min(1, ratio));
          range.style.setProperty('--range-progress', `${bounded * 100}%`);
        };

        const syncPlayback = () => {
          const isPlaying = !video.paused && !video.ended;
          media.classList.toggle('is-playing', isPlaying);
          toggleButtons.forEach((button) => {
            button.setAttribute('aria-label', isPlaying ? 'Mettre la vidéo en pause' : 'Lire la vidéo');
          });
        };

        const syncTime = () => {
          const duration = Number.isFinite(video.duration) ? video.duration : 691;
          const ratio = duration > 0 ? video.currentTime / duration : 0;
          if (progress instanceof HTMLInputElement) {
            progress.value = String(Math.round(ratio * 1000));
            paintRange(progress, ratio);
          }
          if (time) time.textContent = `${formatTime(video.currentTime)} / ${formatTime(duration)}`;
        };

        const syncVolume = () => {
          const isMuted = video.muted || video.volume === 0;
          media.classList.toggle('is-muted', isMuted);
          muteButton?.setAttribute('aria-label', isMuted ? 'Rétablir le son' : 'Couper le son');
          if (volume instanceof HTMLInputElement) {
            volume.value = String(isMuted ? 0 : video.volume);
            paintRange(volume, isMuted ? 0 : video.volume);
          }
        };

        const togglePlayback = () => {
          if (video.paused || video.ended) video.play().catch(() => {});
          else video.pause();
        };

        toggleButtons.forEach((button) => button.addEventListener('click', togglePlayback));
        video.addEventListener('click', togglePlayback);
        video.addEventListener('play', syncPlayback);
        video.addEventListener('pause', syncPlayback);
        video.addEventListener('ended', syncPlayback);
        video.addEventListener('timeupdate', syncTime);
        video.addEventListener('durationchange', syncTime);
        video.addEventListener('volumechange', syncVolume);

        if (progress instanceof HTMLInputElement) {
          progress.addEventListener('input', () => {
            const duration = Number.isFinite(video.duration) ? video.duration : 0;
            if (duration > 0) video.currentTime = (Number(progress.value) / 1000) * duration;
            paintRange(progress, Number(progress.value) / 1000);
          });
        }

        if (volume instanceof HTMLInputElement) {
          volume.addEventListener('input', () => {
            video.muted = false;
            video.volume = Number(volume.value);
            syncVolume();
          });
        }

        muteButton?.addEventListener('click', () => {
          video.muted = !video.muted;
          if (!video.muted && video.volume === 0) video.volume = 1;
        });

        if (!document.pictureInPictureEnabled || !('requestPictureInPicture' in video)) {
          if (pipButton instanceof HTMLElement) pipButton.hidden = true;
        } else {
          pipButton?.addEventListener('click', async () => {
            try {
              if (document.pictureInPictureElement) await document.exitPictureInPicture();
              else await video.requestPictureInPicture();
            } catch {}
          });
        }

        fullscreenButton?.addEventListener('click', async () => {
          try {
            if (document.fullscreenElement) await document.exitFullscreen();
            else await media.requestFullscreen();
          } catch {}
        });

        if (volume instanceof HTMLInputElement) paintRange(volume, 1);
        syncPlayback();
        syncTime();
        syncVolume();
        window.addEventListener('pagehide', () => hls?.destroy(), { once: true });
      }
    </script>
  </body>
