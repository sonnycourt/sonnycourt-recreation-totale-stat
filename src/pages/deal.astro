          <div><span class="preview-reviews-dialog__eyebrow">Témoignages authentiques</span><h2 id="preview-reviews-dialog-title">Avis des participants</h2></div>
          <button type="button" class="preview-reviews-dialog__close" id="preview-close-reviews" aria-label="Fermer">×</button>
        </div>
        <div class="preview-reviews-dialog__scorebar">
          <strong>{previewReviewAverageLabel}<small>/5</small></strong>
          <div>
            <span class="preview-star-meter" aria-label={`Note moyenne : ${previewReviewAverageLabel} sur 5`}>
              <span aria-hidden="true">★★★★★</span>
              <span aria-hidden="true" style={`width: ${previewReviewAveragePercent}%`}>★★★★★</span>
            </span>
            <p>{previewRatedReviews.length} avis notés sur {previewCheckoutReviews.length} témoignages</p>
          </div>
        </div>
        <div class="preview-reviews-dialog__filters" aria-label="Filtrer les témoignages">
          <button type="button" class="is-active" data-preview-review-filter="all">Tous</button>
          {previewRatingFilterValues.map((rating) => <button type="button" data-preview-review-filter={rating}>{rating} étoile{rating > 1 ? 's' : ''}</button>)}
          <button type="button" data-preview-review-filter="unrated">Sans note</button>
