        <div class="preview-reviews-list">
          {previewCheckoutReviews.map((review) => (
            <article class="preview-review-item" data-preview-review-rating={review.rating ?? 'unrated'}>
              <div class="preview-review-item__head">
                {review.source_photo_url ? <img src={review.source_photo_url} alt={review.first_name} loading="lazy" decoding="async" /> : <span class="preview-review-item__initials">{previewReviewInitials(review.first_name)}</span>}
