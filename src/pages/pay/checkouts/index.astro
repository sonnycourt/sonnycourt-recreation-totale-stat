---
import PayAppShell from '../../../components/PayAppShell.astro';
import PayResourcePage from '../../../components/PayResourcePage.astro';
---

<PayAppShell active="checkouts" eyebrow="Conversion" title="Checkouts" description="Retrouve les liens de paiement réels et leurs statuts.">
  <div slot="actions" class="pay-action-group">
    <button class="pay-button pay-button--ghost" type="button" data-resource-export>↓ Exporter</button>
    <a class="pay-button pay-button--primary" data-pay-route="/checkouts/new" href="/pay/checkouts/new">＋ Nouveau checkout</a>
  </div>
  <PayResourcePage screen="checkouts" columns={['Checkout', 'Passerelle', 'Prix', 'Statut', 'Lien']} searchPlaceholder="Rechercher un checkout…" emptyTitle="Aucun checkout" emptyText="Aucun lien de paiement réel n’a été trouvé." />
</PayAppShell>

<script>
  import '../../../scripts/pay-resource-pages.js';
</script>
