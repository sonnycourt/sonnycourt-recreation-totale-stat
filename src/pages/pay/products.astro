---
import PayAppShell from '../../components/PayAppShell.astro';
import PayResourcePage from '../../components/PayResourcePage.astro';
---

<PayAppShell active="products" eyebrow="Catalogue" title="Produits" description="Retrouve les produits et prix réels utilisés par tes passerelles.">
  <Fragment slot="actions">
    <button class="pay-button pay-button--ghost" type="button" data-resource-export>↓ Exporter</button>
    <a class="pay-button pay-button--primary" data-pay-route="/products/new" href="/pay/products/new">＋ Nouveau produit</a>
  </Fragment>
  <PayResourcePage screen="products" columns={['Produit', 'Passerelle', 'Facturation', 'Prix', 'Statut']} searchPlaceholder="Rechercher un produit…" emptyTitle="Aucun produit" emptyText="Aucun produit réel n’a été trouvé sur les passerelles connectées." />
</PayAppShell>

<script>
  import '../../scripts/pay-resource-pages.js';
</script>
