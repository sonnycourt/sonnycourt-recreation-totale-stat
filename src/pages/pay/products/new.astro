---
import PayAppShell from '../../../components/PayAppShell.astro';
---

<PayAppShell active="products" eyebrow="Nouveau produit" title="Ajoute une offre au catalogue." description="Paiement unique ou abonnement, avec vérification avant l’enregistrement du brouillon.">
  <a slot="actions" class="pay-button pay-button--ghost" data-pay-route="/products" href="/pay/products">← Annuler</a>

  <form class="product-builder pay-panel" id="productBuilder">
    <header><div><p class="pay-kicker">Étape 1 sur 2</p><h2>Informations du produit</h2><p>Commence par choisir son mode de facturation.</p></div><span class="pay-badge pay-badge--draft">Brouillon</span></header>
    <div class="product-grid">
      <fieldset class="product-field product-field--wide"><legend>Type de produit</legend><div class="product-types" role="radiogroup" aria-label="Type de produit">
        <label class="is-selected"><input type="radio" name="productType" value="one_time" checked /><span>01</span><div><strong>Paiement unique</strong><small>Un achat encaissé une seule fois.</small></div></label>
        <label><input type="radio" name="productType" value="recurring" /><span>↻</span><div><strong>Abonnement</strong><small>Une facturation automatique récurrente.</small></div></label>
      </div></fieldset>
      <label class="product-field product-field--wide"><span>Nom du produit</span><input class="pay-input" id="productName" type="text" maxlength="120" placeholder="Ex. Esprit Subconscient 2.0" autocomplete="off" required /></label>
      <label class="product-field product-field--wide"><span>Description</span><textarea class="pay-textarea" id="productDescription" rows="4" maxlength="600" placeholder="Ce que le client reçoit après l’achat."></textarea></label>
      <label class="product-field"><span>Prix</span><div class="product-amount"><input class="pay-input" id="productAmount" type="number" min="0.01" step="0.01" placeholder="197.00" required /><b id="productCurrencyUnit">EUR</b></div></label>
      <label class="product-field"><span>Devise</span><select class="pay-select" id="productCurrency"><option value="eur">EUR · Euro</option><option value="chf">CHF · Franc suisse</option><option value="usd">USD · Dollar</option></select></label>
      <div class="product-recurring product-field--wide" id="productRecurring" hidden>
        <label class="product-field"><span>Fréquence</span><select class="pay-select" id="productInterval"><option value="month">Mois</option><option value="year">Année</option><option value="week">Semaine</option></select></label>
        <label class="product-field"><span>Tous les</span><input class="pay-input" id="productIntervalCount" type="number" min="1" max="36" step="1" value="1" /></label>
      </div>
    </div>
    <footer><p>Aucun produit Stripe ou PayPal n’est créé depuis ce brouillon local.</p><button class="pay-button pay-button--primary" type="submit">Vérifier le produit →</button></footer>
  </form>

  <dialog class="product-confirm pay-panel" id="productConfirm" aria-labelledby="productConfirmTitle">
    <div><p class="pay-kicker">Confirmation · étape 2 sur 2</p><h2 id="productConfirmTitle">Enregistrer ce produit ?</h2><div class="product-summary"><span><small>Produit</small><strong id="productSummaryName"></strong></span><span><small>Facturation</small><strong id="productSummaryBilling"></strong></span><span><small>Prix</small><strong id="productSummaryPrice"></strong></span><span><small>Statut</small><strong>Brouillon local</strong></span></div><label class="product-check"><input id="productAcknowledgement" type="checkbox" /><span>Je confirme que le nom, la facturation et le prix sont corrects.</span></label><div class="product-actions"><button class="pay-button pay-button--ghost" id="productBack" type="button">Retour</button><button class="pay-button pay-button--primary" id="productSave" type="button" disabled>Créer le brouillon ✓</button></div></div>
  </dialog>
</PayAppShell>

<script>
  import { findPayDraft, upsertPayDraft } from '../../../scripts/pay-draft-store.js';

  const form = document.getElementById('productBuilder');
  const recurring = document.getElementById('productRecurring');
  const currency = document.getElementById('productCurrency');
  const dialog = document.getElementById('productConfirm');
  const editingId = new URLSearchParams(location.search).get('draft');
  let editingDraft = null;
  try { editingDraft = editingId ? findPayDraft(localStorage, 'products', editingId) : null; } catch {}

  function selectedType() { return form.querySelector('input[name="productType"]:checked').value; }
  function updateType() {
    const isRecurring = selectedType() === 'recurring';
    recurring.hidden = !isRecurring;
    recurring.querySelectorAll('input,select').forEach((field) => { field.disabled = !isRecurring; });
    document.querySelectorAll('.product-types label').forEach((label) => label.classList.toggle('is-selected', label.querySelector('input').checked));
  }
  document.querySelectorAll('input[name="productType"]').forEach((radio) => radio.addEventListener('change', updateType));
  currency.addEventListener('change', () => { document.getElementById('productCurrencyUnit').textContent = currency.value.toUpperCase(); });
  function draft() {
    return {
      id: editingDraft?.id || Date.now(), name: document.getElementById('productName').value.trim(), description: document.getElementById('productDescription').value.trim(),
      billingType: selectedType(), amount: Number(document.getElementById('productAmount').value), currency: currency.value,
      intervalUnit: selectedType() === 'recurring' ? document.getElementById('productInterval').value : null,
      intervalCount: selectedType() === 'recurring' ? Number(document.getElementById('productIntervalCount').value) || 1 : null,
      status: 'draft', createdAt: editingDraft?.createdAt || new Date().toISOString(), updatedAt: new Date().toISOString(),
    };
  }

  if (editingDraft) {
    const selected = form.querySelector(`input[name="productType"][value="${editingDraft.billingType === 'recurring' ? 'recurring' : 'one_time'}"]`);
    if (selected) selected.checked = true;
    document.getElementById('productName').value = editingDraft.name || '';
    document.getElementById('productDescription').value = editingDraft.description || '';
    document.getElementById('productAmount').value = editingDraft.amount ?? '';
    currency.value = editingDraft.currency || 'eur';
    document.getElementById('productCurrencyUnit').textContent = currency.value.toUpperCase();
    document.getElementById('productInterval').value = editingDraft.intervalUnit || 'month';
    document.getElementById('productIntervalCount').value = editingDraft.intervalCount || 1;
    document.getElementById('productSave').textContent = 'Enregistrer les modifications ✓';
    document.getElementById('productConfirmTitle').textContent = 'Mettre à jour ce produit ?';
  }
  updateType();

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const item = draft();
    document.getElementById('productSummaryName').textContent = item.name;
    document.getElementById('productSummaryBilling').textContent = item.billingType === 'recurring' ? `Tous les ${item.intervalCount} ${item.intervalUnit}` : 'Paiement unique';
    document.getElementById('productSummaryPrice').textContent = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: item.currency.toUpperCase() }).format(item.amount);
    document.getElementById('productAcknowledgement').checked = false;
    document.getElementById('productSave').disabled = true;
    dialog.showModal();
  });
  document.getElementById('productAcknowledgement').addEventListener('change', (event) => { document.getElementById('productSave').disabled = !event.target.checked; });
  document.getElementById('productBack').addEventListener('click', () => dialog.close());
  document.getElementById('productSave').addEventListener('click', () => {
    upsertPayDraft(localStorage, 'products', draft());
    window.payToast?.(editingDraft ? 'Produit mis à jour en brouillon.' : 'Produit enregistré en brouillon.');
    const outcome = editingDraft ? 'updated=1' : 'created=1';
    const preview = new URLSearchParams(location.search).has('preview') ? `?preview=1&${outcome}` : `?${outcome}`;
    setTimeout(() => { location.href = `${location.hostname === 'pay.sonnycourt.com' ? '' : '/pay'}/products${preview}`; }, 450);
  });
</script>

<style>
  .product-builder { overflow: hidden; }
  .product-builder > header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; padding: 22px; border-bottom: 1px solid var(--pay-line); }
  .product-builder h2, .product-confirm h2 { margin: 6px 0 0; font-size: 21px; letter-spacing: -.035em; }
  .product-builder header p:not(.pay-kicker) { margin: 7px 0 0; color: var(--pay-muted); font-size: 9px; }
  .product-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 17px; padding: 25px; }
  .product-field { min-width: 0; display: grid; gap: 8px; margin: 0; padding: 0; border: 0; color: var(--pay-soft); font-size: 9px; }
  .product-field--wide { grid-column: 1 / -1; }
  .product-field .pay-input, .product-field .pay-select { min-height: 47px; padding: 0 13px; font-size: 10px; }
  .product-field .pay-textarea { min-height: 96px; padding: 13px; resize: vertical; }
  .product-types { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 10px; }
  .product-types label { display: grid; grid-template-columns: 34px 1fr; align-items: center; gap: 11px; min-height: 74px; padding: 14px; border: 1px solid var(--pay-line); border-radius: 15px; background: rgba(2,12,24,.25); cursor: pointer; transition: .16s ease; }
  .product-types label.is-selected { border-color: rgba(112,231,255,.48); background: rgba(112,231,255,.06); box-shadow: inset 0 0 28px rgba(112,231,255,.03); }
  .product-types input { position: absolute; opacity: 0; pointer-events: none; }
  .product-types label > span { width: 32px; height: 32px; display: grid; place-items: center; border: 1px solid var(--pay-line); border-radius: 10px; color: var(--pay-cyan); }
  .product-types strong, .product-types small { display: block; } .product-types small { margin-top: 4px; color: var(--pay-muted); font-size: 8px; }
  .product-amount { display: flex; align-items: center; border: 1px solid var(--pay-line); border-radius: 15px; overflow: hidden; background: rgba(3,12,24,.48); }
  .product-amount .pay-input { border: 0; background: transparent; } .product-amount b { padding-right: 13px; color: var(--pay-cyan); font-size: 10px; }
  .product-recurring { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 17px; padding: 16px; border: 1px solid rgba(112,231,255,.16); border-radius: 16px; background: rgba(112,231,255,.035); }
  .product-builder > footer { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 14px 22px; border-top: 1px solid var(--pay-line); }
  .product-builder footer p { color: var(--pay-muted); font-size: 8px; }
  .product-confirm { width: min(590px, calc(100% - 28px)); padding: 0; border-radius: 25px; color: var(--pay-text); }
  .product-confirm::backdrop { background: rgba(0,5,14,.78); backdrop-filter: blur(10px); }
  .product-confirm > div { padding: 24px; }
  .product-summary { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 20px 0; }
  .product-summary span { padding: 13px; border: 1px solid var(--pay-line); border-radius: 13px; background: rgba(2,12,24,.28); }
  .product-summary small, .product-summary strong { display: block; } .product-summary small { margin-bottom: 7px; color: var(--pay-muted); font-size: 8px; } .product-summary strong { font-size: 10px; }
  .product-check { display: flex; align-items: center; gap: 9px; color: var(--pay-soft); font-size: 9px; } .product-check input { accent-color: var(--pay-cyan); }
  .product-actions { display: flex; justify-content: flex-end; gap: 9px; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--pay-line); }
  @media (max-width: 650px) { .product-grid, .product-types, .product-recurring, .product-summary { grid-template-columns: 1fr; } .product-field--wide { grid-column: auto; } .product-builder > footer { align-items: stretch; flex-direction: column; } }
</style>
