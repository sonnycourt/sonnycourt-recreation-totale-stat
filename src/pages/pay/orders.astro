---
import PayAppShell from '../../components/PayAppShell.astro';
import PayResourcePage from '../../components/PayResourcePage.astro';
---

<PayAppShell active="orders" eyebrow="Ventes" title="Commandes" description="Toutes les commandes Stripe et PayPal dans une seule chronologie.">
  <Fragment slot="actions">
    <button class="pay-button pay-button--ghost" type="button" data-resource-export>↓ Exporter</button>
    <a class="pay-button pay-button--primary" data-pay-route="/orders/new" href="/pay/orders/new">＋ Nouvelle commande</a>
  </Fragment>
  <PayResourcePage screen="orders" columns={['Commande', 'Client', 'Date', 'Passerelle', 'Statut', 'Total']} searchPlaceholder="Email, produit ou identifiant…" emptyTitle="Aucune commande" />
</PayAppShell>

<script>
  import '../../scripts/pay-resource-pages.js';
</script>
