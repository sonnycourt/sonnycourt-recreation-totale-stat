---
import PayAppShell from '../../components/PayAppShell.astro';
import PayResourcePage from '../../components/PayResourcePage.astro';
---

<PayAppShell active="discounts" eyebrow="Utilitaires" title="Réductions" description="Codes promotionnels, valeur, échéance et utilisation.">
  <div slot="actions" class="pay-action-group">
    <button class="pay-button pay-button--ghost" type="button" data-resource-export>↓ Exporter</button>
    <button class="pay-button pay-button--primary" type="button" data-demo-disabled>＋ Nouvelle réduction</button>
  </div>
  <PayResourcePage screen="discounts" columns={['Code', 'Passerelle', 'Réduction', 'Expiration', 'Utilisations', 'Statut']} searchPlaceholder="Rechercher un code…" emptyTitle="Aucune réduction" />
</PayAppShell>

<script>
  import '../../scripts/pay-resource-pages.js';
</script>
