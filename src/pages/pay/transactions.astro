---
import PayAppShell from '../../components/PayAppShell.astro';

const transactions = [
  { client: 'Amélie Martin', checkout: 'ES2.0 · Standard', date: 'Aujourd’hui · 14:32', provider: 'Stripe', amount: '98,17 €', status: 'Réussi' },
  { client: 'Julien Laurent', checkout: 'Coaching · Première consultation', date: 'Aujourd’hui · 11:08', provider: 'PayPal', amount: '97,00 €', status: 'Réussi' },
  { client: 'Chloé Morel', checkout: 'Formation Manifest', date: 'Hier · 18:47', provider: 'Stripe', amount: '197,00 €', status: 'En attente' },
  { client: 'Léa Roux', checkout: 'ES2.0 · Standard', date: 'Hier · 09:21', provider: 'Stripe', amount: '98,17 €', status: 'Remboursé' },
];
---

<PayAppShell active="transactions" eyebrow="Ventes" title="Transactions" description="Retrouve les paiements, remboursements et statuts au même endroit.">
  <button slot="actions" class="pay-button pay-button--ghost" type="button" data-demo-disabled>↓ Exporter</button>

  <section class="transaction-summary">
    <article class="pay-panel"><small>Encaissé · 30 jours</small><strong id="transactionRevenue">3 122,35 €</strong><span id="transactionSuccessCount">27 transactions</span></article>
    <article class="pay-panel"><small>Remboursé</small><strong id="transactionRefunded">98,17 €</strong><span id="transactionRefundCount">1 transaction</span></article>
    <article class="pay-panel"><small>En attente</small><strong id="transactionPending">197,00 €</strong><span id="transactionPendingCount">1 transaction</span></article>
  </section>

  <section class="pay-panel transaction-panel">
    <div class="pay-panel-header"><div><h2>Historique</h2><p id="transactionDescription">Connexion à Stripe en cours…</p></div><span class="pay-badge" id="transactionMode">Prototype</span></div>
    <div class="transaction-table" id="stripeTransactionTable">
      <div class="transaction-row transaction-head"><span>Client</span><span>Checkout</span><span>Date</span><span>Passerelle</span><span>Statut</span><span>Montant</span></div>
      {transactions.map((item) => (
        <div class="transaction-row">
          <span class="transaction-client"><i>{item.client.split(' ').map((part) => part[0]).join('')}</i><strong>{item.client}</strong></span>
          <span>{item.checkout}</span><span>{item.date}</span><span>{item.provider}</span>
          <span><b class:list={['pay-badge', item.status === 'Réussi' ? 'pay-badge--success' : item.status === 'En attente' ? 'pay-badge--warning' : 'pay-badge--draft']}>{item.status}</b></span>
          <strong>{item.amount}</strong>
        </div>
      ))}
    </div>
  </section>
</PayAppShell>

<script>
  function escapeTransactionText(value) {
    return String(value || '').replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character]);
  }

  function transactionMoney(cents, currency = 'eur') {
    return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: String(currency).toUpperCase() }).format(Number(cents || 0) / 100);
  }

  function transactionDate(timestamp) {
    return new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(Number(timestamp || 0) * 1000));
  }

  function transactionBadge(status) {
    if (status === 'Réussi') return 'pay-badge--success';
    if (status === 'En attente' || status === 'Action requise') return 'pay-badge--warning';
    return 'pay-badge--draft';
  }

  function renderStripeTransactions(data) {
    if (!data?.connected) return;
    const currency = data.account?.currency || 'eur';
    const items = Array.isArray(data.transactions) ? data.transactions : [];
    document.getElementById('transactionRevenue').textContent = transactionMoney(data.metrics?.revenue?.[currency] || 0, currency);
    document.getElementById('transactionSuccessCount').textContent = `${data.metrics?.successful || 0} paiement${data.metrics?.successful === 1 ? '' : 's'} réussi${data.metrics?.successful === 1 ? '' : 's'}`;
    document.getElementById('transactionRefunded').textContent = transactionMoney(data.metrics?.refunded_amount?.[currency] || 0, currency);
    document.getElementById('transactionRefundCount').textContent = `${data.metrics?.refunded || 0} remboursement${data.metrics?.refunded === 1 ? '' : 's'}`;
    document.getElementById('transactionPending').textContent = transactionMoney(data.metrics?.pending_amount?.[currency] || 0, currency);
    document.getElementById('transactionPendingCount').textContent = `${data.metrics?.pending || 0} paiement${data.metrics?.pending === 1 ? '' : 's'}`;
    document.getElementById('transactionDescription').textContent = 'Données Stripe · 30 derniers jours';
    const mode = document.getElementById('transactionMode');
    mode.textContent = data.mode === 'live' ? 'Stripe réel' : 'Stripe test';
    mode.className = 'pay-badge pay-badge--success';

    const table = document.getElementById('stripeTransactionTable');
    const head = '<div class="transaction-row transaction-head"><span>Client</span><span>Description</span><span>Date</span><span>Moyen</span><span>Statut</span><span>Montant</span></div>';
    if (!items.length) {
      table.innerHTML = `${head}<div class="transaction-empty">Aucune transaction Stripe sur les 30 derniers jours.</div>`;
      return;
    }
    table.innerHTML = head + items.map((item) => {
      const customer = item.customer || item.email || 'Client Stripe';
      const initials = customer.split(/\s+/).slice(0, 2).map((part) => part[0]).join('').toUpperCase() || 'S';
      return `<div class="transaction-row"><span class="transaction-client"><i>${escapeTransactionText(initials)}</i><span><strong>${escapeTransactionText(customer)}</strong><small>${escapeTransactionText(item.email)}</small></span></span><span>${escapeTransactionText(item.description)}</span><span>${escapeTransactionText(transactionDate(item.created))}</span><span>${escapeTransactionText(item.payment_method || 'Stripe')}</span><span><b class="pay-badge ${transactionBadge(item.status)}">${escapeTransactionText(item.status)}</b></span><strong>${escapeTransactionText(transactionMoney(item.amount, item.currency))}</strong></div>`;
    }).join('');
  }

  document.addEventListener('pay:stripe', (event) => renderStripeTransactions(event.detail));
  const stripeTransactionsPromise = window.getPayStripeOverview?.();
  stripeTransactionsPromise?.then(renderStripeTransactions);
</script>

<style>
  .transaction-summary { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 12px; margin-bottom: 12px; }
  .transaction-summary article { padding: 18px; }
  .transaction-summary small, .transaction-summary strong, .transaction-summary span { display: block; }
  .transaction-summary small { color: var(--pay-muted); font-size: 8px; }
  .transaction-summary strong { margin: 15px 0 8px; font-size: 24px; letter-spacing: -.04em; }
  .transaction-summary span { color: var(--pay-soft); font-size: 8px; }
  .transaction-panel { overflow: hidden; }
  .transaction-table { overflow-x: auto; }
  .transaction-row { min-width: 850px; display: grid; grid-template-columns: 1.1fr 1.4fr .8fr .6fr .65fr .65fr; align-items: center; gap: 14px; padding: 14px 20px; border-bottom: 1px solid rgba(169,216,255,.075); color: var(--pay-soft); font-size: 9px; }
  .transaction-row:last-child { border-bottom: 0; }
  .transaction-head { color: var(--pay-muted); background: rgba(2,10,20,.18); font-size: 8px; font-weight: 700; }
  .transaction-row > strong:last-child { color: #fff; text-align: right; }
  .transaction-client { display: flex; align-items: center; gap: 9px; color: #fff; }
  .transaction-client i { width: 30px; height: 30px; display: grid; flex: 0 0 auto; place-items: center; border: 1px solid rgba(112,231,255,.16); border-radius: 10px; color: var(--pay-cyan); background: rgba(112,231,255,.05); font-size: 8px; font-style: normal; font-weight: 800; }
  .transaction-client span { min-width: 0; }
  .transaction-client strong, .transaction-client small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .transaction-client small { max-width: 150px; margin-top: 3px; color: var(--pay-muted); font-size: 7px; }
  .transaction-empty { padding: 40px 20px; color: var(--pay-muted); font-size: 10px; text-align: center; }
  @media (max-width: 700px) { .transaction-summary { grid-template-columns: 1fr; } }
</style>
