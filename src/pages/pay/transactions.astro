---
import PayAppShell from '../../components/PayAppShell.astro';

const transactions = [];
---

<PayAppShell active="transactions" eyebrow="Ventes" title="Transactions" description="Retrouve les paiements, remboursements et statuts au même endroit.">
  <button slot="actions" class="pay-button pay-button--ghost" id="transactionExport" type="button">↓ Exporter</button>

  <section class="transaction-summary">
    <article class="pay-panel"><small>Encaissé · 30 jours</small><strong id="transactionRevenue">—</strong><span id="transactionSuccessCount">En attente de Stripe</span></article>
    <article class="pay-panel"><small>Remboursé</small><strong id="transactionRefunded">—</strong><span id="transactionRefundCount">En attente de Stripe</span></article>
    <article class="pay-panel"><small>En attente</small><strong id="transactionPending">—</strong><span id="transactionPendingCount">En attente de Stripe</span></article>
  </section>

  <section class="pay-panel transaction-panel">
    <div class="pay-panel-header"><div><h2>Historique</h2><p id="transactionDescription">Connexion à Stripe en cours…</p></div><span class="pay-badge" id="transactionMode">Prototype</span></div>
    <div class="transaction-table" id="stripeTransactionTable">
      <div class="transaction-row transaction-head"><span>Client</span><span>Checkout</span><span>Date</span><span>Passerelle</span><span>Statut</span><span>Montant</span><span>Action</span></div>
      {transactions.map((item) => (
        <div class="transaction-row">
          <span class="transaction-client"><i>{item.client.split(' ').map((part) => part[0]).join('')}</i><strong>{item.client}</strong></span>
          <span>{item.checkout}</span><span>{item.date}</span><span>{item.provider}</span>
          <span><b class:list={['pay-badge', item.status === 'Réussi' ? 'pay-badge--success' : item.status === 'En attente' ? 'pay-badge--warning' : 'pay-badge--draft']}>{item.status}</b></span>
          <strong>{item.amount}</strong><span>—</span>
        </div>
      ))}
      <div class="transaction-empty">Aucune donnée fictive affichée. L’historique apparaîtra dès que Stripe répond.</div>
    </div>
    <footer class="transaction-history-footer" id="transactionHistoryFooter" hidden>
      <span id="transactionHistoryState">Chargement de l’historique Stripe…</span>
      <button class="pay-button" id="transactionLoadMore" type="button" hidden>Charger 100 de plus</button>
    </footer>
  </section>

  <dialog class="refund-dialog pay-glass" id="refundDialog" aria-labelledby="refundTitle">
    <form id="refundForm">
      <header class="refund-header">
        <div><p class="pay-kicker">Confirmation · étape 2 sur 2</p><h2 id="refundTitle">Rembourser ce paiement</h2></div>
        <button class="refund-close" id="refundClose" type="button" aria-label="Fermer">×</button>
      </header>

      <div class="refund-transaction">
        <span><small>Client</small><strong id="refundCustomer">—</strong></span>
        <span><small>Paiement</small><strong id="refundPaymentAmount">—</strong></span>
        <span><small>Remboursable</small><strong id="refundRemaining">—</strong></span>
      </div>

      <div class="refund-fields">
        <label><span>Montant à rembourser</span><input class="pay-input" id="refundAmount" type="number" inputmode="decimal" min="0.01" step="0.01" required /></label>
        <label><span>Motif</span><select class="pay-select" id="refundReason"><option value="requested_by_customer">Demandé par le client</option><option value="duplicate">Paiement en double</option><option value="fraudulent">Paiement frauduleux</option></select></label>
      </div>

      <div class="refund-lock" id="refundLock" hidden><strong>Remboursements réels verrouillés</strong><span>Le garde-fou du compte live doit être activé une seule fois avant utilisation.</span></div>
      <p class="refund-note" id="refundNote">Relis le montant et le motif. Seul un clic explicite sur le bouton de confirmation enverra la demande à la passerelle.</p>
      <p class="refund-error" id="refundError" role="alert"></p>

      <footer class="refund-actions">
        <button class="pay-button" id="refundCancel" type="button">Annuler</button>
        <button class="pay-button refund-submit" id="refundSubmit" type="button" disabled>Confirmer le remboursement</button>
      </footer>
    </form>
  </dialog>
</PayAppShell>

<script>
  import { mergePayTransactions, payTransactionMetrics, payTransactionProviderLabel } from '../../scripts/pay-transaction-metrics.js';

  const REFUND_API = '/.netlify/functions/pay-stripe-refund';
  const PAYPAL_REFUND_API = '/.netlify/functions/pay-paypal-refund';
  const STRIPE_DATA_API = '/.netlify/functions/pay-stripe-data';
  const PAYPAL_DATA_API = '/.netlify/functions/pay-paypal-data';
  const HISTORY_API = '/.netlify/functions/pay-history';
  let stripeTransactionsData = null;
  let recentStripeItems = [];
  let paypalTransactionsData = [];
  let storedHistoryItems = [];
  let storedHistoryReady = false;
  let paypalWritesEnabled = false;
  let fullHistoryItems = [];
  let fullHistoryCursor = '';
  let fullHistoryLoading = false;
  let fullHistoryInitialized = false;
  let refundItem = null;
  let refundIdempotencyKey = null;

  function escapeTransactionText(value) {
    return String(value || '').replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character]);
  }

  function currencyDivisor(currency = 'eur') {
    const digits = new Intl.NumberFormat('fr-FR', { style: 'currency', currency: String(currency).toUpperCase() }).resolvedOptions().maximumFractionDigits;
    return 10 ** digits;
  }

  function transactionMoney(minorUnits, currency = 'eur') {
    return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: String(currency).toUpperCase() }).format(Number(minorUnits || 0) / currencyDivisor(currency));
  }

  function transactionDate(timestamp) {
    return new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(Number(timestamp || 0) * 1000));
  }

  function transactionBadge(status) {
    if (status === 'Réussi') return 'pay-badge--success';
    if (status === 'En attente' || status === 'Action requise' || status === 'Partiel') return 'pay-badge--warning';
    return 'pay-badge--draft';
  }

  function refundAction(item) {
    if (!item.can_refund) return item.refundable === 0 && item.refunded > 0 ? '<span class="refund-complete">Terminé</span>' : '<span>—</span>';
    return `<button class="refund-button" type="button" data-refund-id="${escapeTransactionText(item.id)}" data-refund-provider="${escapeTransactionText(item.provider || 'stripe')}">Rembourser</button>`;
  }

  function normalizedIntentStatus(intent, refunded, refundable) {
    if (refunded > 0) return refundable > 0 ? 'Partiel' : 'Remboursé';
    if (intent.status === 'succeeded') return 'Réussi';
    if (intent.status === 'processing' || intent.status === 'requires_capture') return 'En attente';
    if (intent.status === 'canceled') return 'Annulé';
    if (intent.status === 'requires_action') return 'Action requise';
    return 'Incomplet';
  }

  function normalizePaymentIntent(intent) {
    const charge = intent.latest_charge && typeof intent.latest_charge === 'object' ? intent.latest_charge : null;
    const billing = charge?.billing_details || {};
    const metadata = intent.metadata || {};
    const card = charge?.payment_method_details?.card;
    const amount = Number(intent.amount_received || intent.amount || 0);
    const refunded = Number(charge?.amount_refunded || 0);
    const refundable = Math.max(0, amount - refunded);
    const customer = billing.name || metadata.customer_name || metadata.customer_first_name || billing.email || intent.receipt_email || metadata.customer_email || 'Client Stripe';
    return {
      id: intent.id,
      provider: 'stripe',
      created: intent.created,
      amount,
      refunded,
      refundable,
      can_refund: intent.status === 'succeeded' && refundable > 0,
      currency: intent.currency || 'eur',
      status: normalizedIntentStatus(intent, refunded, refundable),
      description: intent.description || metadata.offer_name || metadata.offer_slug || 'Paiement Stripe',
      customer,
      email: billing.email || intent.receipt_email || metadata.customer_email || '',
      payment_method: card ? `Stripe · ${card.brand || 'carte'} •••• ${card.last4 || ''}` : `Stripe · ${charge?.payment_method_details?.type || 'paiement'}`,
    };
  }

  function normalizedHistoryStatus(payment) {
    const status = String(payment.status || '').toLowerCase();
    const refunded = Number(payment.refunded || 0);
    if (refunded > 0) return refunded < Number(payment.amount || 0) ? 'Partiel' : 'Remboursé';
    if (['succeeded', 'paid', 'complete', 'completed'].includes(status)) return 'Réussi';
    if (['processing', 'pending', 'open'].includes(status)) return 'En attente';
    if (['requires_action', 'action_required'].includes(status)) return 'Action requise';
    if (['cancelled', 'canceled', 'expired'].includes(status)) return 'Annulé';
    if (status === 'refunded') return 'Remboursé';
    return 'Incomplet';
  }

  function normalizeHistoryPayment(payment) {
    const paidAt = new Date(payment.paid_at || payment.created_at || 0);
    const provider = ['stripe', 'paypal'].includes(payment.provider) ? payment.provider : 'spiffy';
    const amount = Number(payment.amount || 0);
    const refunded = Number(payment.refunded || 0);
    return {
      id: String(payment.id || ''),
      provider,
      created: Number.isFinite(paidAt.getTime()) ? Math.floor(paidAt.getTime() / 1_000) : 0,
      amount,
      refunded,
      refundable: Math.max(0, amount - refunded),
      can_refund: false,
      currency: payment.currency || 'eur',
      status: normalizedHistoryStatus(payment),
      description: payment.description || 'Paiement historique',
      customer: payment.customer || payment.email || 'Client',
      email: payment.email || '',
      payment_method: payment.payment_method || (provider === 'paypal' ? 'PayPal' : provider === 'stripe' ? 'Stripe' : 'Spiffy'),
      historical: true,
    };
  }

  function combinedItems(stripeItems = recentStripeItems) {
    return mergePayTransactions({
      history: storedHistoryItems,
      stripeArchive: stripeItems,
      stripeLive: recentStripeItems,
      paypalLive: paypalTransactionsData,
    });
  }

  function renderCombinedSummary() {
    const cutoff = Math.floor((Date.now() - 30 * 86_400_000) / 1_000);
    const items = combinedItems(recentStripeItems).filter((item) => Number(item.created || 0) >= cutoff);
    const currency = stripeTransactionsData?.account?.currency || items[0]?.currency || 'eur';
    const metrics = payTransactionMetrics(items, { currency, cutoff });
    document.getElementById('transactionRevenue').textContent = transactionMoney(metrics.revenue, currency);
    document.getElementById('transactionSuccessCount').textContent = `${metrics.successfulCount} paiement${metrics.successfulCount === 1 ? '' : 's'} réussi${metrics.successfulCount === 1 ? '' : 's'}`;
    document.getElementById('transactionRefunded').textContent = transactionMoney(metrics.refunded, currency);
    document.getElementById('transactionRefundCount').textContent = `${metrics.refundCount} remboursement${metrics.refundCount === 1 ? '' : 's'}`;
    document.getElementById('transactionPending').textContent = transactionMoney(metrics.pending, currency);
    document.getElementById('transactionPendingCount').textContent = `${metrics.pendingCount} paiement${metrics.pendingCount === 1 ? '' : 's'}`;
  }

  function renderStoredHistory() {
    renderCombinedSummary();
    renderTransactionTable(combinedItems(fullHistoryItems.length ? fullHistoryItems : recentStripeItems), 'Aucune transaction Stripe, PayPal ou Spiffy.');
    const description = document.getElementById('transactionDescription');
    description.textContent = storedHistoryReady
      ? `Historique unifié · ${storedHistoryItems.length} paiement${storedHistoryItems.length === 1 ? '' : 's'} archivé${storedHistoryItems.length === 1 ? '' : 's'} + données live`
      : 'Stripe + PayPal · 30 derniers jours';
    const footer = document.getElementById('transactionHistoryFooter');
    const state = document.getElementById('transactionHistoryState');
    if (storedHistoryReady) {
      footer.hidden = false;
      state.textContent = `Archive Spiffy disponible · ${storedHistoryItems.length} paiement${storedHistoryItems.length === 1 ? '' : 's'}`;
      document.getElementById('transactionLoadMore').hidden = true;
    }
  }

  async function loadStoredHistory() {
    try {
      const response = await fetch(`${HISTORY_API}?resource=payments`, { credentials: 'same-origin', headers: { Accept: 'application/json' } });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.ready || !Array.isArray(data.rows) || data.rows.length === 0) return;
      storedHistoryItems = data.rows.map(normalizeHistoryPayment).filter((item) => item.id && item.created > 0);
      storedHistoryReady = storedHistoryItems.length > 0;
      renderStoredHistory();
    } catch (error) {
      console.error('Pay history:', error);
    }
  }

  function renderTransactionTable(items, emptyText = 'Aucune transaction Stripe.') {
    const table = document.getElementById('stripeTransactionTable');
    const head = '<div class="transaction-row transaction-head"><span>Client</span><span>Description</span><span>Date</span><span>Moyen</span><span>Statut</span><span>Montant</span><span>Action</span></div>';
    if (!items.length) {
      table.innerHTML = `${head}<div class="transaction-empty">${escapeTransactionText(emptyText)}</div>`;
      return;
    }
    table.innerHTML = head + items.map((item) => {
      const customer = item.customer || item.email || 'Client Stripe';
      const initials = customer.split(/\s+/).slice(0, 2).map((part) => part[0]).join('').toUpperCase() || 'S';
      const customerControl = item.email
        ? `<button class="transaction-client transaction-client-button" type="button" data-customer-email="${escapeTransactionText(item.email)}" title="Ouvrir le dossier client"><i>${escapeTransactionText(initials)}</i><span><strong>${escapeTransactionText(customer)}</strong><small>${escapeTransactionText(item.email)}</small></span></button>`
        : `<span class="transaction-client"><i>${escapeTransactionText(initials)}</i><span><strong>${escapeTransactionText(customer)}</strong><small>—</small></span></span>`;
      return `<div class="transaction-row">${customerControl}<span>${escapeTransactionText(item.description)}</span><span>${escapeTransactionText(transactionDate(item.created))}</span><span>${escapeTransactionText(item.payment_method || 'Stripe')}</span><span><b class="pay-badge ${transactionBadge(item.status)}">${escapeTransactionText(item.status)}</b></span><strong>${escapeTransactionText(transactionMoney(item.amount, item.currency))}</strong>${refundAction(item)}</div>`;
    }).join('');
  }

  async function loadFullStripeHistory(reset = false) {
    if (['localhost', '127.0.0.1'].includes(window.location.hostname) || fullHistoryLoading) return;
    if (storedHistoryReady) {
      renderStoredHistory();
      return;
    }
    if (reset && fullHistoryInitialized) return;
    fullHistoryLoading = true;
    const footer = document.getElementById('transactionHistoryFooter');
    const state = document.getElementById('transactionHistoryState');
    const button = document.getElementById('transactionLoadMore');
    footer.hidden = false;
    button.disabled = true;
    state.textContent = reset ? 'Chargement de l’historique Stripe complet…' : 'Chargement de 100 transactions supplémentaires…';
    try {
      const parameters = new URLSearchParams({ resource: 'payment_intents', limit: '100' });
      if (!reset && fullHistoryCursor) parameters.set('starting_after', fullHistoryCursor);
      const response = await fetch(`${STRIPE_DATA_API}?${parameters.toString()}`, { credentials: 'same-origin', headers: { Accept: 'application/json' } });
      const page = await response.json().catch(() => ({}));
      if (!response.ok || !page.connected) throw new Error(page.error || 'stripe_history_failed');
      const nextItems = (Array.isArray(page.data) ? page.data : []).map(normalizePaymentIntent);
      fullHistoryItems = reset ? nextItems : [...fullHistoryItems, ...nextItems];
      fullHistoryCursor = page.next_cursor || '';
      fullHistoryInitialized = true;
      stripeTransactionsData = { ...stripeTransactionsData, transactions: fullHistoryItems };
      renderTransactionTable(combinedItems(fullHistoryItems), 'Aucune transaction Stripe, PayPal ou Spiffy.');
      document.getElementById('transactionDescription').textContent = `Historique Stripe · ${fullHistoryItems.length} transaction${fullHistoryItems.length === 1 ? '' : 's'} chargée${fullHistoryItems.length === 1 ? '' : 's'}`;
      state.textContent = page.has_more ? `${fullHistoryItems.length} transactions chargées · historique disponible par pages de 100` : `Historique complet · ${fullHistoryItems.length} transactions`;
      button.hidden = !page.has_more;
    } catch (error) {
      console.error('Pay Stripe history:', error);
      state.textContent = 'L’historique complet n’a pas pu être chargé. L’aperçu reste disponible.';
      button.hidden = true;
    } finally {
      fullHistoryLoading = false;
      button.disabled = false;
    }
  }

  function renderStripeTransactions(data) {
    if (!data?.connected) return;
    stripeTransactionsData = data;
    const currency = data.account?.currency || 'eur';
    const items = Array.isArray(data.transactions) ? data.transactions : [];
    recentStripeItems = items.map((item) => ({ ...item, provider: 'stripe', payment_method: item.payment_method?.startsWith('Stripe') ? item.payment_method : `Stripe · ${item.payment_method || 'paiement'}` }));
    document.getElementById('transactionDescription').textContent = 'Stripe + PayPal · 30 derniers jours';
    const mode = document.getElementById('transactionMode');
    mode.textContent = data.mode === 'live' ? (data.writes_enabled ? 'Stripe réel · actions actives' : 'Stripe réel · actions verrouillées') : 'Stripe test';
    mode.className = `pay-badge ${data.writes_enabled ? 'pay-badge--success' : 'pay-badge--warning'}`;

    renderCombinedSummary();
    renderTransactionTable(combinedItems(), 'Aucune transaction Stripe, PayPal ou Spiffy sur les 30 derniers jours.');
    loadFullStripeHistory(true);
  }

  async function loadPayPalTransactions() {
    const end = new Date(Date.now() - 3 * 60 * 60 * 1_000);
    const start = new Date(end.getTime() - 30 * 86_400_000);
    try {
      const response = await fetch(`${PAYPAL_DATA_API}?${new URLSearchParams({ start: start.toISOString(), end: end.toISOString() })}`, { credentials: 'same-origin' });
      const data = await response.json().catch(() => ({}));
      if (!response.ok || !data.connected) throw new Error(data.error || 'paypal_data_failed');
      paypalWritesEnabled = Boolean(data.writes_enabled);
      paypalTransactionsData = (Array.isArray(data.transactions) ? data.transactions : []).map((item) => ({ ...item, provider: 'paypal', payment_method: 'PayPal' }));
      renderCombinedSummary();
      renderTransactionTable(combinedItems(fullHistoryItems.length ? fullHistoryItems : recentStripeItems), 'Aucune transaction Stripe, PayPal ou Spiffy.');
    } catch (error) {
      console.error('PayPal transactions:', error);
    }
  }

  function exportTransactions() {
    const items = combinedItems(fullHistoryItems.length ? fullHistoryItems : recentStripeItems);
    const rows = [['Client', 'Email', 'Description', 'Date', 'Passerelle', 'Statut', 'Montant', 'Devise'], ...items.map((item) => [item.customer, item.email, item.description, transactionDate(item.created), payTransactionProviderLabel(item.provider), item.status, String(Number(item.amount || 0) / currencyDivisor(item.currency)), String(item.currency || 'eur').toUpperCase()])];
    const quote = (value) => `"${String(value ?? '').replace(/"/g, '""')}"`;
    const csv = rows.map((line) => line.map(quote).join(';')).join('\n');
    const url = URL.createObjectURL(new Blob([`\uFEFF${csv}`], { type: 'text/csv;charset=utf-8' }));
    const link = document.createElement('a');
    link.href = url;
    link.download = `pay-transactions-${new Date().toISOString().slice(0, 10)}.csv`;
    link.click();
    URL.revokeObjectURL(url);
    window.payToast?.('Export CSV préparé.');
  }

  function validateRefundForm() {
    const amount = Number(document.getElementById('refundAmount').value);
    const divisor = currencyDivisor(refundItem?.currency || 'eur');
    const amountMinor = Math.round(amount * divisor);
    const validAmount = refundItem && Number.isSafeInteger(amountMinor) && amountMinor > 0 && amountMinor <= refundItem.refundable;
    const writesEnabled = refundItem?.provider === 'paypal' ? paypalWritesEnabled : stripeTransactionsData?.writes_enabled;
    document.getElementById('refundSubmit').disabled = !validAmount || !writesEnabled;
    return validAmount ? amountMinor : null;
  }

  function openRefundDialog(item) {
    refundItem = item;
    refundIdempotencyKey = crypto.randomUUID();
    const divisor = currencyDivisor(item.currency);
    const input = document.getElementById('refundAmount');
    input.value = String(item.refundable / divisor);
    input.max = String(item.refundable / divisor);
    input.step = String(1 / divisor);
    const providerLabel = item.provider === 'paypal' ? 'PayPal' : 'Stripe';
    document.getElementById('refundCustomer').textContent = item.customer || item.email || `Client ${providerLabel}`;
    document.getElementById('refundPaymentAmount').textContent = transactionMoney(item.amount, item.currency);
    document.getElementById('refundRemaining').textContent = transactionMoney(item.refundable, item.currency);
    document.getElementById('refundReason').value = 'requested_by_customer';
    document.getElementById('refundError').textContent = '';
    const writesEnabled = item.provider === 'paypal' ? paypalWritesEnabled : stripeTransactionsData?.writes_enabled;
    document.getElementById('refundLock').hidden = Boolean(writesEnabled);
    document.getElementById('refundLock').querySelector('span').textContent = `Le garde-fou ${providerLabel} Live doit être activé une seule fois avant utilisation.`;
    document.getElementById('refundNote').textContent = `Relis le montant et le motif. Seul un clic explicite sur le bouton de confirmation enverra la demande à ${providerLabel}.`;
    validateRefundForm();
    document.getElementById('refundDialog').showModal();
  }

  function closeRefundDialog() {
    document.getElementById('refundDialog').close();
    refundItem = null;
    refundIdempotencyKey = null;
  }

  document.getElementById('stripeTransactionTable')?.addEventListener('click', (event) => {
    const customerButton = event.target.closest('[data-customer-email]');
    if (customerButton) {
      const query = new URLSearchParams({ q: customerButton.dataset.customerEmail });
      if (new URLSearchParams(location.search).has('preview')) query.set('preview', '1');
      location.href = `/pay/customers?${query}`;
      return;
    }
    const button = event.target.closest('[data-refund-id]');
    if (!button) return;
    const item = combinedItems(fullHistoryItems.length ? fullHistoryItems : recentStripeItems).find((transaction) => transaction.id === button.dataset.refundId && transaction.provider === button.dataset.refundProvider);
    if (item) openRefundDialog(item);
  });

  document.getElementById('refundAmount')?.addEventListener('input', validateRefundForm);
  document.getElementById('refundClose')?.addEventListener('click', closeRefundDialog);
  document.getElementById('refundCancel')?.addEventListener('click', closeRefundDialog);
  document.getElementById('refundForm')?.addEventListener('submit', (event) => event.preventDefault());
  document.getElementById('transactionLoadMore')?.addEventListener('click', () => loadFullStripeHistory(false));
  document.getElementById('transactionExport')?.addEventListener('click', exportTransactions);

  document.getElementById('refundSubmit')?.addEventListener('click', async () => {
    const amount = validateRefundForm();
    if (!refundItem || !amount) return;
    const submit = document.getElementById('refundSubmit');
    const error = document.getElementById('refundError');
    submit.disabled = true;
    submit.textContent = 'Remboursement en cours…';
    error.textContent = '';

    const isPayPal = refundItem.provider === 'paypal';
    const response = await fetch(isPayPal ? PAYPAL_REFUND_API : REFUND_API, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(isPayPal ? {
        capture_id: refundItem.id, amount, currency: String(refundItem.currency || 'eur').toUpperCase(),
        confirmation: 'REMBOURSER PAYPAL', idempotency_key: refundIdempotencyKey,
      } : {
        payment_intent: refundItem.id, amount, reason: document.getElementById('refundReason').value,
        confirmation: 'REMBOURSER', idempotency_key: refundIdempotencyKey,
      }),
    }).catch(() => null);
    const result = await response?.json().catch(() => ({}));

    if (!response?.ok) {
      error.textContent = ['stripe_writes_disabled', 'paypal_writes_disabled'].includes(result?.error)
        ? 'Les remboursements réels sont encore verrouillés par le garde-fou de sécurité.'
        : result?.error || `${isPayPal ? 'PayPal' : 'Stripe'} n’a pas pu effectuer ce remboursement.`;
      submit.textContent = 'Confirmer le remboursement';
      validateRefundForm();
      return;
    }

    closeRefundDialog();
    window.payToast?.(`Remboursement de ${transactionMoney(result.refund.amount, result.refund.currency)} envoyé à ${isPayPal ? 'PayPal' : 'Stripe'}.`);
    submit.textContent = 'Confirmer le remboursement';
    if (isPayPal) await loadPayPalTransactions();
    else await window.refreshPayStripeOverview?.();
  });

  document.addEventListener('pay:stripe', (event) => renderStripeTransactions(event.detail));
  const stripeTransactionsPromise = window.getPayStripeOverview?.();
  stripeTransactionsPromise?.then(renderStripeTransactions);
  document.addEventListener('pay:authenticated', () => {
    loadStoredHistory();
    loadPayPalTransactions();
  }, { once: true });
  loadStoredHistory();
  loadPayPalTransactions();
</script>

