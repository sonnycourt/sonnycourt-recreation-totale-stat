---
import '../../styles/coaching-portal.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#06142d" />
    <title>Réserver ma séance — Sonny Court Coaching</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="cp-ambient" aria-hidden="true"><span></span><span></span><span></span></div>
    <main class="journey-shell">
      <header class="journey-top"><a class="cp-brand" href="/coaching/eleve"><span class="cp-mark">S</span><span>MON COACHING</span></a><a href="/coaching/eleve">Retour à mon espace</a></header>
      <div class="journey-progress" aria-label="Étape 2 sur 2"><span style="width:100%"></span></div>

      <div class="booking-layout">
        <section class="booking-summary cp-glass">
          <p class="cp-eyebrow">Étape 2 sur 2 · Réservation</p>
          <h1>Choisis le moment <em>où tu seras vraiment disponible.</em></h1>
          <p>Ta préparation est enregistrée. <span data-coach-name>Romain</span> pourra la relire avant votre rendez-vous et entrer plus vite dans le sujet.</p>
          <div class="booking-coach"><img data-coach-avatar src="/media/coachs/romain.webp?v=ai-hd" alt="Romain" width="56" height="56" /><span><strong data-coach-name>Romain</strong><small>Coaching individuel · visioconférence Google Meet</small></span></div>
          <div class="booking-facts"><div><strong>60 minutes</strong><small>Durée proposée</small></div><div><strong><span data-booking-credits>—</span> crédit(s)</strong><small>Avant réservation</small></div><div><strong>Europe/Zurich</strong><small>Fuseau affiché</small></div></div>
          <footer><strong>Sujet transmis :</strong> <span data-prep-subject>—</span><br /><span data-booking-source>Les disponibilités affichées sont fictives jusqu’à la connexion de Google Calendar.</span></footer>
        </section>

        <section class="booking-calendar cp-glass">
          <header><div><p class="cp-eyebrow">Disponibilités</p><h2>Un créneau calme.</h2><p>Chaque horaire consomme un seul crédit après confirmation.</p></div><span class="timezone">Europe/Zurich</span></header>
          <div class="slot-days" data-slot-days>
            <section class="slot-day" aria-label="Disponibilités du lundi 3 août"><h3>Lundi 3 août</h3><div class="slot-grid"><button class="slot" type="button" data-slot="2026-08-03T09:30:00+02:00">09:30</button><button class="slot" type="button" data-slot="2026-08-03T11:00:00+02:00">11:00</button><button class="slot" type="button" data-slot="2026-08-03T16:30:00+02:00">16:30</button></div></section>
            <section class="slot-day" aria-label="Disponibilités du mardi 4 août"><h3>Mardi 4 août</h3><div class="slot-grid"><button class="slot" type="button" data-slot="2026-08-04T09:30:00+02:00">09:30</button><button class="slot" type="button" data-slot="2026-08-04T14:00:00+02:00">14:00</button><button class="slot" type="button" data-slot="2026-08-04T16:30:00+02:00">16:30</button></div></section>
            <section class="slot-day" aria-label="Disponibilités du mercredi 5 août"><h3>Mercredi 5 août</h3><div class="slot-grid"><button class="slot" type="button" data-slot="2026-08-05T11:00:00+02:00">11:00</button><button class="slot" type="button" data-slot="2026-08-05T14:00:00+02:00">14:00</button><button class="slot" type="button" data-slot="2026-08-05T16:30:00+02:00">16:30</button></div></section>
          </div>
          <p class="form-error" data-booking-error hidden></p>
          <div class="booking-selection"><span><strong data-selection-title>Choisis un horaire</strong><small data-selection-copy>Aucun créneau sélectionné</small></span><button class="cp-button green" type="button" data-confirm-booking disabled>Confirmer la séance</button></div>
        </section>
      </div>
    </main>
    <script>
      import '../../scripts/coaching-booking.js';
    </script>
  </body>
</html>
