---
import '../../styles/coaching-portal.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#06142d" />
    <title>Préparer ma séance — Sonny Court Coaching</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="cp-ambient" aria-hidden="true"><span></span><span></span><span></span></div>
    <main class="journey-shell">
      <header class="journey-top">
        <a class="cp-brand" href="/coaching/eleve"><span class="cp-mark">S</span><span>MON COACHING</span></a>
        <a href="/coaching/eleve">Retour à mon espace</a>
      </header>
      <div class="journey-progress" aria-label="Étape 1 sur 2"><span style="width:50%"></span></div>

      <div class="journey-layout">
        <section class="journey-copy">
          <p class="cp-eyebrow">Étape 1 sur 2 · Préparation</p>
          <h1>Romain doit comprendre <em>où tu en es maintenant.</em></h1>
          <p>Pas besoin de tout raconter. Quelques repères précis suffisent pour reprendre le fil et consacrer la séance à ce qui peut réellement avancer.</p>
          <div class="journey-reassurance">
            <div><i>✓</i> Environ trois minutes</div>
            <div><i>✓</i> Tes réponses peuvent rester courtes</div>
            <div><i>✓</i> Le brouillon est enregistré automatiquement</div>
            <div><i>✓</i> Version de travail à affiner avec Romain</div>
          </div>
        </section>

        <form class="journey-form cp-glass" data-preparation-form>
          <header><p class="cp-eyebrow">Ta prochaine séance</p><h2>Aller directement à l’essentiel.</h2><p>Ces réponses seront visibles par Romain dans ton dossier de préparation, jamais sur une page publique.</p></header>

          <div class="form-field"><label for="subject">Quel est le sujet principal que tu veux travailler ?</label><textarea id="subject" name="subject" required placeholder="Le point précis que tu ne veux plus laisser en suspens…"></textarea></div>
          <div class="form-field"><label for="progress">Qu’est-ce qui a bougé depuis votre dernière séance ? <span>— même légèrement</span></label><textarea id="progress" name="progress" required placeholder="Une décision, une prise de conscience, une action, une réaction différente…"></textarea></div>
          <div class="form-field"><label for="obstacle">Qu’est-ce qui te bloque ou revient en boucle aujourd’hui ?</label><textarea id="obstacle" name="obstacle" required placeholder="Le doute, la peur ou la situation qui te fait perdre le mouvement…"></textarea></div>
          <div class="form-field"><label for="outcome">À la fin de la séance, qu’aimerais-tu avoir obtenu ?</label><textarea id="outcome" name="outcome" required placeholder="Une décision, un plan, un soulagement, une nouvelle manière de voir…"></textarea></div>
          <div class="form-field"><label for="context">Y a-t-il un contexte important à connaître ? <span>— facultatif</span></label><textarea id="context" name="context" placeholder="Seulement ce qui aidera Romain à comprendre la situation actuelle."></textarea></div>

          <div class="form-meta"><small class="autosave" data-autosave-label>Brouillon enregistré automatiquement</small><small>Questions modifiables avant production</small></div>
          <div class="form-actions"><button class="cp-button secondary" type="button" data-save-later>Terminer plus tard</button><button class="cp-button green" type="submit">Continuer vers les créneaux <svg class="cp-icon" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button></div>
        </form>
      </div>
    </main>
    <script>
      import '../../scripts/coaching-preparation.js';
    </script>
  </body>
</html>
