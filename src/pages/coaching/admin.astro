---
import '../../styles/coaching-portal.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#06142d" />
    <title>Pilotage Coaching — Sonny Court</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="cp-ambient" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="app-layout">
      <aside class="app-sidebar cp-glass">
        <a class="cp-brand" href="/hub"><span class="cp-mark">S</span><span>COACHING</span></a>
        <div class="role-identity">
          <span class="role-avatar owner"><svg class="cp-icon" viewBox="0 0 24 24"><path d="M12 3 4 7v5c0 5 3.4 8 8 9 4.6-1 8-4 8-9V7z"></path><path d="m9 12 2 2 4-5"></path></svg></span>
          <span><small>Vue propriétaire</small><strong>Sonny</strong></span>
        </div>
        <nav class="app-nav" aria-label="Navigation propriétaire">
          <p>Pilotage</p>
          <a class="active" href="#vue"><svg class="cp-icon" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"></rect><rect x="14" y="3" width="7" height="7" rx="2"></rect><rect x="3" y="14" width="7" height="7" rx="2"></rect><rect x="14" y="14" width="7" height="7" rx="2"></rect></svg>Vue générale</a>
          <a href="#coachs"><svg class="cp-icon" viewBox="0 0 24 24"><circle cx="9" cy="7" r="4"></circle><path d="M2 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2M17 11h5M19.5 8.5v5"></path></svg>Coachs</a>
          <a href="#clients"><svg class="cp-icon" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path></svg>Clients</a>
          <a href="#activite"><svg class="cp-icon" viewBox="0 0 24 24"><path d="M3 12h4l2-7 4 14 2-7h6"></path></svg>Activité</a>
          <a href="#credits"><svg class="cp-icon" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7H14a3.5 3.5 0 0 1 0 7H6"></path></svg>Économie crédits</a>
          <p>Espaces</p>
          <a href="#coachs" data-demo-link="/coach-console?preview=1"><svg class="cp-icon" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3"></rect><path d="M8 3v4M16 3v4M3 10h18"></path></svg>Espace Romain</a>
          <a href="#clients" data-demo-link="/coaching/eleve?preview=1"><svg class="cp-icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>Vue élève</a>
          <a href="/coaching/compte?role=owner"><svg class="cp-icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>Mon compte</a>
        </nav>
        <div class="sidebar-foot"><strong>Infrastructure coaching</strong><small>La source active est indiquée en haut de l’espace.</small><a href="#" data-reset-demo>Réinitialiser les données</a><a href="#" data-logout>Se déconnecter</a></div>
      </aside>

      <main class="app-main" id="vue">
        <header class="app-topbar">
          <div><p>Direction · Coaching</p><h1>Pilotage</h1></div>
          <div class="top-actions">
            <span class="cp-status amber" data-infra-status>Vérification Supabase</span>
            <a class="top-profile" href="/coaching/compte?role=owner"><span class="role-avatar owner">S</span><span><strong>Sonny</strong><small>Mon compte</small></span></a>
          </div>
        </header>

        <div class="app-content">
          <div class="content-wrap">
            <section class="page-intro">
              <div><p class="cp-eyebrow">Samedi 1er août · Vue entreprise</p><h2>Tu pilotes l’activité. <em>Les coachs gardent leur espace.</em></h2><p>Une vue synthétique sur la capacité, l’expérience client et les points qui réclament ton attention — sans exposer les notes privées des coachs.</p></div>
              <div class="page-actions"><a class="cp-button secondary" href="/coaching">Changer de rôle</a><a class="cp-button" href="#coachs" data-demo-link="/coach-console?preview=1">Voir l’activité de Romain</a></div>
            </section>

            <section class="metric-row" aria-label="Indicateurs coaching">
              <article class="metric cp-glass"><header><span><svg class="cp-icon" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg></span><b>+2 ce mois</b></header><small>Clients actifs</small><strong data-admin-active-clients>—</strong><p>accompagnements en cours</p></article>
              <article class="metric green cp-glass"><header><span><svg class="cp-icon" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"></path></svg></span><b>Engagement client</b></header><small>Crédits en circulation</small><strong data-admin-credits>—</strong><p>15 minutes par crédit</p></article>
              <article class="metric purple cp-glass"><header><span><svg class="cp-icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg></span><b>Structure ouverte</b></header><small>Coachs actifs</small><strong data-admin-coaches>—</strong><p>Romain pour le lancement</p></article>
              <article class="metric amber cp-glass"><header><span><svg class="cp-icon" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7H14a3.5 3.5 0 0 1 0 7H6"></path></svg></span><b>Encaissé</b></header><small>Valeur suivie</small><strong data-admin-revenue>—</strong><p>commandes payées</p></article>
            </section>

            <section class="credit-economy cp-card cp-glass" id="credits">
              <header class="card-head"><div><p class="cp-eyebrow">Économie du wallet</p><h3>Ce qui est vendu, consommé et dû.</h3></div><span class="cp-status">Vue propriétaire</span></header>
              <div class="economy-grid">
                <div><small>Crédits achetés</small><strong data-economy-purchased>—</strong><p>depuis le lancement</p></div>
                <div><small>Crédits consommés</small><strong data-economy-consumed>—</strong><p>temps de coaching livré</p></div>
                <div><small>Memberships actifs</small><strong data-economy-memberships>—</strong><p>revenu récurrent</p></div>
                <div><small>Dû aux coachs</small><strong data-economy-payout>—</strong><p>base + bonus approuvés</p></div>
              </div>
              <footer><span><i></i> Les crédits non utilisés restent une dette de prestation, pas un revenu opérationnel disponible.</span><b>1 crédit = 15 min</b></footer>
            </section>

            <div class="dashboard-columns">
              <section class="cp-card cp-glass" id="coachs">
                <header class="card-head"><div><p class="cp-eyebrow">Équipe</p><h3>Coachs et capacité</h3></div><a href="#coachs" data-demo-link="/coach-console?preview=1">Voir l’activité →</a></header>
                <div style="overflow-x:auto"><table class="coach-table"><thead><tr><th>Coach</th><th>État</th><th>Clients</th><th>Ce mois</th><th>À payer</th><th></th></tr></thead><tbody data-coach-rows></tbody></table></div>
              </section>
              <section class="cp-card cp-glass" id="activite">
                <header class="card-head"><div><p class="cp-eyebrow">Temps réel</p><h3>Activité récente</h3></div></header>
                <div class="activity-list" data-admin-activity></div>
              </section>
            </div>

            <div class="admin-lower">
              <section class="cp-card cp-glass" id="clients">
                <header class="card-head"><div><p class="cp-eyebrow">Portefeuille</p><h3>Clients et crédits</h3></div><a href="#clients" data-demo-link="/coaching/eleve?preview=1">Voir les dossiers →</a></header>
                <div style="overflow-x:auto"><table class="coach-table"><thead><tr><th>Client</th><th>Formule</th><th>Solde</th><th>Membership</th><th>Prochaine étape</th><th></th></tr></thead><tbody data-client-rows></tbody></table></div>
              </section>
              <section class="cp-card cp-glass">
                <header class="card-head"><div><p class="cp-eyebrow">État technique</p><h3>Infrastructure</h3></div></header>
                <div class="data-map">
                  <div><i></i><span><strong>Interfaces</strong><small>Propriétaire · coach · élève</small></span><b>PRÊTES</b></div>
                  <div><i style="background:var(--cp-amber)"></i><span><strong>Supabase</strong><small>Wallet · memberships · rémunérations · profils</small></span><b>EXTENSION PRÊTE</b></div>
                  <div><i style="background:var(--cp-amber)"></i><span><strong>Google Calendar</strong><small>OAuth · disponibilités · Meet</small></span><b>ACCÈS À ACTIVER</b></div>
                  <div><i style="background:var(--cp-blue)"></i><span><strong>Spiffy</strong><small>Paiements · packs · remboursements</small></span><b>URLS À RENSEIGNER</b></div>
                </div>
              </section>
            </div>
          </div>
        </div>
      </main>
    </div>
    <nav class="mobile-nav cp-glass"><a class="active" href="#vue"><svg class="cp-icon" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2"></rect><rect x="14" y="3" width="7" height="7" rx="2"></rect></svg>Vue</a><a href="#credits"><svg class="cp-icon" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7H14"></path></svg>Crédits</a><a href="#clients"><svg class="cp-icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>Clients</a><a href="/coaching/compte?role=owner"><svg class="cp-icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>Compte</a></nav>
    <script>
      import '../../scripts/coaching-admin.js';
    </script>
  </body>
</html>
