---
import '../../styles/coaching-portal.css';
---
<!doctype html>
<html lang="fr">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>Activer mon espace coaching</title></head>
  <body>
    <div class="cp-ambient" aria-hidden="true"><span></span><span></span><span></span></div>
    <main class="confirmation-shell"><section class="confirmation-card cp-glass" style="text-align:left"><p class="cp-eyebrow">Ton espace personnel</p><h1 style="font-size:clamp(40px,6vw,58px)">Choisis ton mot de passe.</h1><p style="margin-left:0">Ton achat est confirmé. Ce mot de passe te donnera accès à tes séances, tes préparations et tes liens Google Meet.</p><form class="login-form" data-activation-form><label><span>Mot de passe · 10 caractères minimum</span><span class="cp-input"><input name="password" type="password" autocomplete="new-password" required minlength="10" /></span></label><label><span>Confirmer le mot de passe</span><span class="cp-input"><input name="confirmation" type="password" autocomplete="new-password" required minlength="10" /></span></label><button class="cp-button" type="submit">Activer mon espace</button><p class="login-feedback" data-activation-feedback></p></form></section></main>
    <script>import '../../scripts/coaching-activate-account.js';</script>
  </body>
</html>
