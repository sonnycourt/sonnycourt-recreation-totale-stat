---
import '../../styles/coaching-portal.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#06142d" />
    <title>Paiement sécurisé — Sonny Court Coaching</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="https://js.stripe.com/basil/stripe.js"></script>
  </head>
  <body>
    <div class="cp-ambient" aria-hidden="true"><span></span><span></span><span></span></div>
    <main class="stripe-checkout-page">
      <nav class="stripe-nav cp-glass"><a href="/coaching/credits">Retour à mes crédits</a><span><i></i>Paiement chiffré par Stripe</span></nav>
      <section class="stripe-shell">
        <aside class="stripe-summary cp-glass">
          <p class="cp-eyebrow">Ton choix</p>
          <h1 data-checkout-title>Finaliser mon coaching</h1>
          <p data-checkout-description>Les crédits seront ajoutés automatiquement après confirmation du paiement.</p>
          <div class="stripe-credit-visual"><strong data-checkout-credits>•</strong><span>crédits coaching</span></div>
          <div class="stripe-total"><span>Total</span><strong data-checkout-price>••• €</strong></div>
          <ul><li>Paiement sécurisé par Stripe</li><li>Solde mis à jour automatiquement</li><li>Aucune donnée bancaire stockée chez Sonny Court</li></ul>
        </aside>

        <section class="stripe-form-card cp-glass" data-stripe-checkout>
          <header><div><p class="cp-eyebrow">Paiement</p><h2>Plus qu’une étape.</h2></div><span class="secure-pill">Sécurisé</span></header>
          <div class="loading-state" id="loading-state"><span></span>Préparation du paiement sécurisé…</div>
          <form class="stripe-payment-form" id="checkout-slot" hidden>
            <div data-stripe-payment-element></div>
            <p class="stripe-error" data-stripe-error role="alert"></p>
            <button class="stripe-submit" type="submit" data-stripe-submit disabled><span data-stripe-submit-label>Confirmer le paiement</span><i></i></button>
          </form>
          <div class="error-state" id="error-state" hidden><strong>Le paiement n’a pas pu charger.</strong><p>Réessaie dans quelques instants.</p><button type="button" id="retry-button">Réessayer</button></div>
        </section>
      </section>
    </main>
    <script>import '../../scripts/coaching-stripe-payment.js';</script>
  </body>
</html>

<style>
  :global(body){margin:0;background:#020817;color:#f8fbff;font-family:Inter,ui-sans-serif,system-ui,sans-serif}
  .stripe-checkout-page{min-height:100vh;padding:34px 20px 80px;background:radial-gradient(circle at 72% 0%,rgba(39,119,255,.24),transparent 35rem),linear-gradient(145deg,#020817,#071a37 55%,#0a3065)}
  .stripe-nav{width:min(1050px,100%);min-height:48px;margin:0 auto;padding:0 17px;display:flex;align-items:center;justify-content:space-between;border-radius:16px}
  .stripe-nav a{color:rgba(219,234,254,.7);font-size:11px;text-decoration:none}.stripe-nav a::before{content:'‹';margin-right:8px;color:#7dc0ff;font-size:18px}.stripe-nav span{display:flex;align-items:center;gap:8px;color:rgba(191,219,254,.48);font-size:9px;text-transform:uppercase}.stripe-nav i{width:7px;height:7px;border-radius:50%;background:#58d8ae;box-shadow:0 0 13px rgba(88,216,174,.6)}
  .stripe-shell{width:min(1050px,100%);margin:52px auto 0;display:grid;grid-template-columns:minmax(300px,.8fr) minmax(430px,1.2fr);gap:18px;align-items:start}
  .stripe-summary,.stripe-form-card{padding:30px;border-radius:30px}.stripe-summary h1{margin:10px 0 13px;font-size:clamp(34px,4vw,52px);line-height:1;letter-spacing:-.055em}.stripe-summary>p:not(.cp-eyebrow){color:rgba(219,234,254,.58);font-size:13px;line-height:1.65}.stripe-credit-visual{margin:28px 0;padding:21px;display:flex;align-items:baseline;gap:10px;border:1px solid rgba(125,192,255,.18);border-radius:20px;background:rgba(23,114,224,.08)}.stripe-credit-visual strong{color:#80c5ff;font-size:50px;line-height:1}.stripe-credit-visual span{color:rgba(219,234,254,.55);font-size:11px;text-transform:uppercase}.stripe-total{padding:20px 0;display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(191,219,254,.1);border-bottom:1px solid rgba(191,219,254,.1)}.stripe-total span{color:rgba(219,234,254,.56);font-size:12px}.stripe-total strong{font-size:27px}.stripe-summary ul{margin:22px 0 0;padding:0;display:grid;gap:10px;list-style:none}.stripe-summary li{color:rgba(219,234,254,.48);font-size:10px}.stripe-summary li::before{content:'•';margin-right:9px;color:#58d8ae}
  .stripe-form-card header{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:25px}.stripe-form-card h2{margin:7px 0 0;font-size:34px;letter-spacing:-.045em}.secure-pill{padding:8px 10px;color:rgba(167,231,208,.78);border:1px solid rgba(85,230,178,.15);border-radius:11px;background:rgba(85,230,178,.06);font-size:9px;text-transform:uppercase}
  .loading-state{min-height:380px;display:flex;align-items:center;justify-content:center;gap:11px;color:rgba(191,219,254,.45);font-size:11px}.loading-state[hidden],.stripe-payment-form[hidden],.error-state[hidden]{display:none!important}.loading-state span{width:20px;height:20px;border:2px solid rgba(191,219,254,.12);border-top-color:#69b7ff;border-radius:50%;animation:spin .7s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
  .stripe-payment-form{display:grid;gap:18px}.stripe-error{min-height:17px;margin:0;color:#ff9aa8;font-size:11px}.stripe-submit{min-height:55px;display:flex;align-items:center;justify-content:center;gap:10px;color:#fff;border:1px solid rgba(147,197,253,.42);border-radius:16px;background:linear-gradient(135deg,#1580f5,#2867e8);box-shadow:0 14px 34px rgba(20,121,232,.28),inset 0 1px 0 rgba(255,255,255,.25);font:inherit;font-size:13px;font-weight:760;cursor:pointer}.stripe-submit:disabled{opacity:.55;cursor:wait}.stripe-submit i{display:none;width:16px;height:16px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .65s linear infinite}.stripe-submit.is-loading i{display:block}.error-state{min-height:320px;padding:30px;text-align:center}.error-state strong{display:block;margin-top:70px}.error-state p{color:rgba(219,234,254,.5);font-size:12px}.error-state button{padding:11px 16px;color:#fff;border:1px solid rgba(96,165,250,.32);border-radius:12px;background:rgba(20,121,232,.22)}
  .stripe-preview{padding:5px;display:grid;gap:14px}.stripe-preview-wallets{display:grid;grid-template-columns:1fr 1fr;gap:9px}.stripe-preview-wallets span,.stripe-preview-field{min-height:48px;display:flex;align-items:center;padding:0 14px;border:1px solid rgba(191,219,254,.17);border-radius:13px;background:rgba(3,12,29,.28);color:rgba(239,246,255,.72);font-size:11px}.stripe-preview-wallets span{justify-content:center;color:#fff;font-weight:700}.stripe-preview-row{display:grid;grid-template-columns:1fr 1fr;gap:9px}
  @media(max-width:800px){.stripe-checkout-page{padding:20px 13px 60px}.stripe-nav span{display:none}.stripe-shell{margin-top:25px;grid-template-columns:1fr}.stripe-summary,.stripe-form-card{padding:22px;border-radius:24px}.stripe-summary h1{font-size:38px}}
</style>
