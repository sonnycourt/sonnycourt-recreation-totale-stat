---
import '../../styles/coaching-portal.css';
---
<!doctype html>
<html lang="fr">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>Nouveau mot de passe — Coaching</title></head>
  <body>
    <div class="cp-ambient" aria-hidden="true"><span></span><span></span><span></span></div>
    <main class="confirmation-shell"><section class="confirmation-card cp-glass" style="text-align:left"><p class="cp-eyebrow">Sécurité du compte</p><h1 style="font-size:clamp(40px,6vw,58px)">Choisis un nouveau mot de passe.</h1><p style="margin-left:0">Au moins 10 caractères. Évite un mot de passe déjà utilisé ailleurs.</p><form class="login-form" data-reset-form><label><span>Nouveau mot de passe</span><span class="cp-input"><input name="password" type="password" autocomplete="new-password" required minlength="10" /></span></label><label><span>Confirmer</span><span class="cp-input"><input name="confirmation" type="password" autocomplete="new-password" required minlength="10" /></span></label><button class="cp-button" type="submit">Enregistrer le mot de passe</button><p class="login-feedback" data-reset-feedback></p></form></section></main>
    <script>import '../../scripts/coaching-reset-password.js';</script>
  </body>
</html>
