---
import '../../styles/coaching-portal.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#06142d" />
    <title>Connexion — Espace Coaching Sonny Court</title>
    <meta name="description" content="Accès sécurisé aux espaces propriétaire, coach et élève de Sonny Court Coaching." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="cp-ambient" aria-hidden="true"><span></span><span></span><span></span></div>
    <main class="portal-shell">
      <section class="portal-copy">
        <a class="cp-brand" href="/"><span class="cp-mark">S</span><span>SONNY COURT · COACHING</span></a>
        <p class="cp-eyebrow">Un accompagnement. Un seul espace.</p>
        <h1>Tout ce qui compte, <em>sans le bruit autour.</em></h1>
        <p>Ton prochain rendez-vous, les éléments utiles pour le préparer et le fil de ton accompagnement. Chaque personne retrouve uniquement ce qui lui appartient.</p>
        <div class="portal-trust" aria-label="Garanties de l’espace">
          <span>Accès personnel</span>
          <span>Notes privées séparées</span>
          <span>Email et mot de passe</span>
        </div>
      </section>

      <section class="login-panel cp-glass" aria-labelledby="login-title">
        <header>
          <div>
            <p class="cp-eyebrow">Espace personnel</p>
            <h2 id="login-title">Se connecter.</h2>
            <p>Utilise ton email et ton mot de passe, ou continue simplement avec Google.</p>
          </div>
          <span class="cp-status amber">Mode maquette</span>
        </header>

        <form class="login-form" data-login-form>
          <label>
            <span>Adresse email</span>
            <span class="cp-input">
              <svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="m3 7 9 6 9-6"></path></svg>
              <input data-login-email type="email" autocomplete="email" placeholder="toi@exemple.com" required />
            </span>
          </label>
          <label>
            <span>Mot de passe</span>
            <span class="cp-input">
              <svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="3"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
              <input data-login-password type="password" autocomplete="current-password" placeholder="Ton mot de passe" required />
            </span>
          </label>
          <button class="cp-button" type="submit">
            Se connecter
            <svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </button>
          <button class="cp-button secondary" type="button" data-google-login>
            <svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h6v4h-6"></path><path d="M18 12a6 6 0 1 1-1.76-4.24"></path></svg>
            Continuer avec Google
          </button>
          <button class="forgot-password" type="button" data-forgot-password>Mot de passe oublié ?</button>
          <p class="login-feedback" data-login-feedback hidden></p>
        </form>

        <p class="account-entry">
          Pas encore de compte ?
          <a href="https://sonnycourt.com/coach">Réserver une première consultation</a>
        </p>

        <div class="role-divider" data-demo-only><span>Explorer la maquette locale</span></div>
        <div class="role-list" data-demo-only>
          <button class="role-card" type="button" data-demo-role="owner" data-demo-name="Sonny" data-demo-email="sonnycourt@gmail.com">
            <span class="role-avatar owner"><svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 7v5c0 5 3.4 8 8 9 4.6-1 8-4 8-9V7z"></path><path d="m9 12 2 2 4-5"></path></svg></span>
            <span><strong>Sonny · propriétaire</strong><small>Supervision des coachs, clients et opérations</small></span>
            <svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
          <button class="role-card" type="button" data-demo-role="coach" data-demo-name="Romain" data-demo-email="romain@sonnycourt.com">
            <span class="role-avatar"><img src="/media/coachs/romain.webp?v=ai-hd" alt="" width="42" height="42" /></span>
            <span><strong>Romain · coach</strong><small>Agenda, dossiers, préparation et notes privées</small></span>
            <svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
          <button class="role-card" type="button" data-demo-role="student" data-demo-name="Claire" data-demo-email="claire@exemple.fr">
            <span class="role-avatar student"><svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg></span>
            <span><strong>Claire · élève</strong><small>Rendez-vous, préparation et crédits de séances</small></span>
            <svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
          </button>
        </div>
        <button class="resume-session" type="button" data-resume-session hidden></button>
      </section>
    </main>
    <script>
      import '../../scripts/coaching-portal.js';
    </script>
  </body>
</html>
