---
import '../../styles/coaching-portal.css';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#06142d" />
    <title>Connexion — Espace Coaching Sonny Court</title>
    <meta name="description" content="Accès sécurisé aux espaces propriétaire, coach et élève de Sonny Court Coaching." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="coaching-login-page">
    <div class="cp-ambient" aria-hidden="true"><span></span><span></span><span></span></div>
    <main class="portal-shell">
      <a class="cp-brand portal-brand" href="https://sonnycourt.com/">
        <span class="cp-mark">S</span>
        <span class="portal-brand-copy"><strong>SONNY COURT</strong><small>ESPACE COACHING</small></span>
      </a>

      <section class="login-panel cp-glass" aria-labelledby="login-title">
        <header class="login-intro">
          <span class="login-orbit" aria-hidden="true">
            <svg class="cp-icon" viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.6 2.8 7.8 7 9 4.2-1.2 7-4.4 7-9V6z"></path><path d="m9 12 2 2 4-5"></path></svg>
          </span>
          <h1 id="login-title">Accède à ton espace.</h1>
          <p>Retrouve tes séances et ton accompagnement.</p>
        </header>

        <form class="login-form" data-login-form>
          <div class="login-field">
            <label for="login-email">Adresse email</label>
            <span class="cp-input">
              <svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="m3 7 9 6 9-6"></path></svg>
              <input id="login-email" data-login-email type="email" autocomplete="email" placeholder="toi@exemple.com" required />
            </span>
            <span class="login-email-help">Utilise l’adresse email renseignée lors de ta réservation.</span>
          </div>
          <div class="login-field">
            <div class="login-label-row">
              <label for="login-password">Mot de passe</label>
              <button class="forgot-password" type="button" data-forgot-password>Mot de passe oublié ?</button>
            </div>
            <span class="cp-input">
              <svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="3"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
              <input id="login-password" data-login-password type="password" autocomplete="current-password" placeholder="Ton mot de passe" required />
            </span>
          </div>
          <button class="cp-button" type="submit">
            Se connecter
            <svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </button>
          <button class="resend-activation" type="button" data-resend-activation>Première connexion ? Renvoyer mon lien d’activation</button>
          <p class="login-feedback" data-login-feedback hidden></p>
        </form>

        <p class="login-security">
          <svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="3"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
          Connexion privée et sécurisée
        </p>

        <details class="demo-access" data-demo-only>
          <summary>Accès de démonstration</summary>
          <div class="role-list">
            <button class="role-card" type="button" data-demo-role="owner" data-demo-name="Sonny" data-demo-email="sonnycourt@gmail.com">
              <span class="role-avatar owner"><svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 7v5c0 5 3.4 8 8 9 4.6-1 8-4 8-9V7z"></path><path d="m9 12 2 2 4-5"></path></svg></span>
              <span><strong>Sonny · propriétaire</strong><small>Supervision de l’Institut</small></span>
              <svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
            </button>
            <button class="role-card" type="button" data-demo-role="coach" data-demo-name="Romain" data-demo-email="romain@sonnycourt.com">
              <span class="role-avatar"><img src="/media/coachs/romain.webp?v=ai-hd" alt="" width="42" height="42" /></span>
              <span><strong>Romain · coach</strong><small>Agenda et dossiers clients</small></span>
              <svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
            </button>
            <button class="role-card" type="button" data-demo-role="student" data-demo-name="Claire" data-demo-email="claire@exemple.fr">
              <span class="role-avatar student"><svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg></span>
              <span><strong>Claire · élève</strong><small>Séances et accompagnement</small></span>
              <svg class="cp-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
            </button>
          </div>
        </details>
        <button class="resume-session" type="button" data-resume-session hidden></button>
      </section>

      <p class="account-entry">
        Nouveau dans l’Institut ?
        <a href="https://sonnycourt.com/coach">Réserver une première consultation</a>
      </p>
    </main>
    <script>
      import '../../scripts/coaching-portal.js';
    </script>
  </body>
</html>
