                <span class="buy-button__label">
                  <strong>Je commence ma transformation pour 47&nbsp;€ aujourd’hui</strong>
                </span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
              </button>

              <div class="trust-row">
                <span>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="5" y="10" width="14" height="11" rx="2"></rect>
                    <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"></path>
                  </svg>
                  Paiement sécurisé
                </span>
                <span>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M13.5 2 5 13h6l-1 9 9-12h-6.5l1-8Z"></path>
                  </svg>
                  Accès immédiat
                </span>
                <span>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 13v-1a8 8 0 0 1 16 0v1M4 13h3v6H5a2 2 0 0 1-2-2v-2a2 2 0 0 1 1-2Zm16 0h-3v6h2a2 2 0 0 0 2-2v-2a2 2 0 0 0-1-2ZM17 19c-1 2-3 2-5 2"></path>
                  </svg>
                  Support humain
                </span>
              </div>
            </form>
          </aside>
        </div>
      </section>
    </main>

    <p class="legal-note legal-note--page-bottom">
      <a href="/confidentialite/" target="_blank" rel="noopener">Politique de confidentialité</a>
    </p>

    <section
      class="expired-offer"
      id="expired-offer"
      role="alertdialog"
      aria-modal="true"
      aria-labelledby="expired-offer-title"
      aria-describedby="expired-offer-copy"
      aria-hidden="true"
      hidden
    >
      <div class="expired-offer__card">
        <span class="expired-offer__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <rect x="5" y="10" width="14" height="11" rx="2"></rect>
            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
          </svg>
        </span>
        <span class="expired-offer__eyebrow">ESPRIT SUBCONSCIENT 2.0</span>
        <h1 id="expired-offer-title">Cette offre a été retirée.</h1>
        <p id="expired-offer-copy">
          Le délai accordé après la masterclass est terminé. Cette page n’est plus accessible.
        </p>
        <a href="mailto:support@sonnycourt.com?subject=Offre%20Esprit%20Subconscient%202.0">
          Contacter le support
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </a>
        <small>support@sonnycourt.com</small>
      </div>
    </section>

    <dialog class="reviews-dialog" id="reviews-dialog" aria-labelledby="reviews-dialog-title">
      <div class="reviews-dialog__top">
        <div>
          <span class="reviews-dialog__eyebrow">Témoignages authentiques</span>
          <h2 id="reviews-dialog-title">Avis des participants</h2>
        </div>
        <button type="button" class="reviews-dialog__close" id="close-reviews" aria-label="Fermer">×</button>
      </div>

      <div class="reviews-dialog__scorebar">
        <strong>{reviewAverageLabel}<small>/5</small></strong>
        <div>
          <span class="star-meter" aria-label={`Note moyenne : ${reviewAverageLabel} sur 5`}>
            <span aria-hidden="true">★★★★★</span>
            <span aria-hidden="true" style={`width: ${reviewAveragePercent}%`}>★★★★★</span>
          </span>
          <p>{ratedReviews.length} avis notés sur {checkoutReviews.length} témoignages</p>
        </div>
      </div>

      <div class="reviews-dialog__filters" aria-label="Filtrer les témoignages">
        <button type="button" class="is-active" data-review-filter="all">Tous</button>
        {ratingFilterValues.map((rating) => (
          <button type="button" data-review-filter={rating}>{rating} étoile{rating > 1 ? 's' : ''}</button>
        ))}
        <button type="button" data-review-filter="unrated">Sans note</button>
      </div>

      <div class="reviews-list">
        {checkoutReviews.map((review) => (
          <article class="review-item" data-review-id={review.id} data-review-rating={review.rating ?? 'unrated'}>
            <div class="review-item__head">
              {review.source_photo_url ? (
                <img src={review.source_photo_url} alt={review.first_name} loading="lazy" decoding="async" />
              ) : (
                <span class="review-item__initials">{reviewInitials(review.first_name)}</span>
              )}
              <span>
                <strong>{review.first_name}</strong>
                <small>{review.country || 'Participant vérifié'}</small>
              </span>
              {review.rating ? (
                <b aria-label={`${review.rating} étoiles`}>
                  {'★'.repeat(review.rating)}<i>{'★'.repeat(5 - review.rating)}</i>
                </b>
              ) : (
                <b class="review-item__unrated">Témoignage</b>
              )}
            </div>
            <p>« {review.review} »</p>
            {reviewResponses[review.id] && (
              <div class="review-response">
                <strong>Réponse de Sonny Court</strong>
                <p>{reviewResponses[review.id]}</p>
              </div>
            )}
          </article>
        ))}
      </div>

      <p class="reviews-dialog__disclosure">Avis authentiques recueillis auprès de participants à des programmes désormais inclus dans Esprit Subconscient 2.0.</p>
    </dialog>

    <dialog id="prototype-dialog">
      <div class="dialog-icon">✓</div>
      <h2>Le geste d’achat fonctionne.</h2>
      <p>Dans la vraie version, le paiement sécurisé s’ouvrirait ici. Sur ce prototype local, rien n’a été débité et aucune donnée n’a été transmise.</p>
      <button type="button" id="close-dialog">Fermer le prototype</button>
    </dialog>

    <script
      type="application/json"
      id="review-conversion-orders"
      set:html={JSON.stringify(reviewConversionOrder.filters)}
    ></script>

    <script is:inline>
      const form = document.querySelector('#checkout-form');
      const checkbox = document.querySelector('#commitment');
      const dialog = document.querySelector('#prototype-dialog');
      const closeDialog = document.querySelector('#close-dialog');
      const reviewsDialog = document.querySelector('#reviews-dialog');
      const openReviews = document.querySelector('#open-reviews');
      const closeReviews = document.querySelector('#close-reviews');
      const reviewFilters = document.querySelectorAll('[data-review-filter]');
      const reviewItems = document.querySelectorAll('[data-review-rating]');
      const reviewList = document.querySelector('.reviews-list');
      const reviewOrdersNode = document.querySelector('#review-conversion-orders');
      const reviewOrders = JSON.parse(reviewOrdersNode?.textContent || '{"all":[]}');
      const reviewsById = new Map([...reviewItems].map((item) => [item.dataset.reviewId, item]));
      const firstNameInput = document.querySelector('#customer-first-name');
      const emailInput = document.querySelector('#customer-email');
      const submitButton = document.querySelector('#buy-button');
      const stripeError = document.querySelector('#stripe-error');
      const stripeElement = document.querySelector('#stripe-payment-element');
      const expressCheckout = document.querySelector('#express-checkout');
      const expressCheckoutElement = document.querySelector('#stripe-express-checkout-element');
      const paymentLoading = document.querySelector('#payment-loading');
      const previewPayment = document.querySelector('#payment-preview-local');
      const sessionScarcity = document.querySelector('#session-scarcity');
      const sessionScarcityCopy = document.querySelector('#session-scarcity-copy');
      const installmentDates = [14, 35, 56, 77];
      const countdownHours = document.querySelector('#countdown-hours');
      const countdownMinutes = document.querySelector('#countdown-minutes');
      const countdownSeconds = document.querySelector('#countdown-seconds');
      const countdownMobileMinutes = document.querySelector('#countdown-mobile-minutes');
      const countdownMobileSeconds = document.querySelector('#countdown-mobile-seconds');
      const countdownProgress = document.querySelector('#countdown-progress');
      const expiredOffer = document.querySelector('#expired-offer');
      const params = new URLSearchParams(window.location.search);
      let token = '';
      const localPreview = location.hostname === '127.0.0.1'
        || location.hostname === 'localhost'
        || params.get('preview') === 'dev';
      let stripeCheckout = null;
      let stripeCanConfirm = false;
      let sessionCapacityBlocked = false;
      let checkoutEngagedSent = false;
      let checkoutSessionId = '';
      let stripeReady = false;
      let paymentDetailsStarted = false;
      let paymentDetailsComplete = false;
      let paymentConfirmationStarted = false;
      let lastCheckoutStage = 'page_opened';
      let checkoutActiveSeconds = 0;
      let lastUserActivityAt = Date.now();
      const telemetrySent = new Set();
      const activeActivityWindowMs = 30 * 1000;
      const activeSecondsCap = 2 * 60 * 60;

      function markUserActivity() {
        lastUserActivityAt = Date.now();
      }

      window.setInterval(() => {
        if (
          document.visibilityState === 'visible'
          && Date.now() - lastUserActivityAt <= activeActivityWindowMs
          && checkoutActiveSeconds < activeSecondsCap
        ) checkoutActiveSeconds += 1;
      }, 1000);

      ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach((eventName) => {
        window.addEventListener(eventName, markUserActivity, { passive: true });
      });
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') markUserActivity();
      });

      function trackingPayload(event, value, meta = {}) {
        return {
          token,
          event,
          value,
          meta: {
            page_path: '/commencer/',
            route: '/commencer/',
            plan: 'advanced',
            payment_mode: 'deposit_47_then_4x297_days_14_35_56_77',
            ...meta,
          },
        };
      }

      function track(event, value = null, meta = {}) {
        if (!token || localPreview) return;
        fetch('/.netlify/functions/track-mc2-event', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          keepalive: true,
          body: JSON.stringify(trackingPayload(event, value, meta)),
        }).catch(() => {});
      }

      function trackOnce(event, value = null, meta = {}) {
        if (telemetrySent.has(event)) return;
        telemetrySent.add(event);
        track(event, value, { visit_id: checkoutNonce(), ...meta });
      }

      function safePaymentErrorMeta(error, buttonId = '') {
        const paymentIntent = error?.payment_intent && typeof error.payment_intent === 'object'
          ? error.payment_intent
          : null;
        return {
          button_id: buttonId,
          error_type: String(error?.type || '').slice(0, 64),
          error_code: String(error?.code || '').slice(0, 100),
          decline_code: String(error?.decline_code || '').slice(0, 100),
          intent_status: String(paymentIntent?.status || '').slice(0, 48),
        };
      }

      function trackAuthentication(authentication) {
        if (!authentication || (!authentication.attempted && authentication.state !== 'required')) return;
        trackOnce('payment_authentication_outcome', null, {
          authentication_state: authentication.state,
          authentication_result: authentication.result,
          authentication_flow: authentication.flow,
          authentication_reason: authentication.reason,
          intent_status: authentication.intent_status,
        });
      }

      async function inspectPaymentAuthentication() {
        if (!checkoutSessionId || !token || localPreview) return;
        const response = await fetch(`/.netlify/functions/mc2-stripe-status?session_id=${encodeURIComponent(checkoutSessionId)}&t=${encodeURIComponent(token)}`);
        if (!response.ok) return;
        const data = await response.json().catch(() => ({}));
        trackAuthentication(data.authentication);
      }

      function checkoutNonce() {
        const key = `mc2_checkout_nonce_${token || 'preview'}`;
        let nonce = sessionStorage.getItem(key);
        if (!nonce) {
          nonce = window.crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(36).slice(2)}`;
          sessionStorage.setItem(key, nonce);
        }
        return nonce;
      }

      function renderSessionCapacity(data = {}) {
        if (!sessionScarcity || !sessionScarcityCopy) return;
        if (data.enabled !== true) {
          sessionScarcity.hidden = true;
          sessionCapacityBlocked = false;
          updateSubmitState();
          return;
        }

        const remaining = Math.max(0, Math.min(20, Number(data.remaining) || 0));
        const reserved = data.reserved === true || data.accepted === true;
        sessionCapacityBlocked = remaining <= 0 && !reserved;
        sessionScarcity.hidden = false;
        sessionScarcity.classList.toggle('is-full', sessionCapacityBlocked);
        sessionScarcity.classList.toggle('is-reserved', reserved);

        if (reserved) {
          sessionScarcityCopy.innerHTML = '<strong>Ta place est réservée</strong> pendant la finalisation du paiement';
        } else if (sessionCapacityBlocked) {
          sessionScarcityCopy.innerHTML = '<strong>Cette session est complète.</strong>';
        } else if (remaining === 1) {
          sessionScarcityCopy.innerHTML = 'Plus qu’<strong>1 place</strong> disponible pour cette session';
        } else {
          sessionScarcityCopy.innerHTML = `Plus que <strong>${remaining} places</strong> disponibles pour cette session`;
        }
        sessionScarcity.setAttribute('aria-label', sessionScarcityCopy.textContent || 'Places disponibles');
        updateSubmitState();
      }

      async function sessionCapacityRequest({ reserve = false } = {}) {
        if (localPreview) {
          const preview = { enabled: true, capacity: 3, occupied: 0, remaining: 3, reserved: false };
          renderSessionCapacity(preview);
          return preview;
        }
        const response = await fetch(
          reserve
            ? '/.netlify/functions/mc2-session-capacity'
            : `/.netlify/functions/mc2-session-capacity?t=${encodeURIComponent(token)}`,
          reserve
            ? {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ token }),
              }
            : { headers: { Accept: 'application/json' }, cache: 'no-store' },
        );
        const data = await response.json().catch(() => ({}));
        renderSessionCapacity(data);
        if (!response.ok) {
          const error = new Error(data.error || 'La disponibilité de cette session a changé.');
          error.code = data.reason || 'session_capacity_error';
          throw error;
        }
        return data;
      }

      function updateSubmitState() {
        if (!submitButton) return;
        submitButton.disabled = sessionCapacityBlocked
          || !(checkbox?.checked && (localPreview || stripeCanConfirm));
        if (expressCheckout && !expressCheckout.hidden) {
          const unlocked = Boolean(checkbox?.checked) && !sessionCapacityBlocked;
          expressCheckout.classList.toggle('is-locked', !unlocked);
          expressCheckout.setAttribute('aria-disabled', String(!unlocked));
        }
      }

      function showError(message) {
        if (stripeError) stripeError.textContent = message || '';
      }

      function markEngaged() {
        if (checkoutEngagedSent) return;
        checkoutEngagedSent = true;
        lastCheckoutStage = 'checkout_engaged';
        track('checkout_engaged', null, { visit_id: checkoutNonce() });
      }

      const checkoutDate = new Date();
      const installmentDateFormatter = new Intl.DateTimeFormat('fr-FR', {
          day: '2-digit',
          month: '2-digit',
          year: 'numeric',
      });
      installmentDates.forEach((days) => {
        const node = document.querySelector(`#installment-date-${days}`);
        if (!node) return;
        const dueDate = new Date(checkoutDate);
        dueDate.setDate(dueDate.getDate() + days);
        node.textContent = installmentDateFormatter.format(dueDate);
      });

      const countdownDuration = 60 * 60 * 1000;
      let countdownStorageKey = '';
      const previewExpired = params.get('preview_expired') === '1';

      function resolveCountdownEnd() {
        if (previewExpired) return Date.now();
        if (!countdownStorageKey) return Date.now() + countdownDuration;
        const storedEnd = Number(window.localStorage.getItem(countdownStorageKey));
        if (Number.isFinite(storedEnd) && storedEnd > 0) return storedEnd;
        // Affichage transitoire uniquement : la vraie échéance est créée au CTA
        // et revient du serveur avec l'inscription. Cette page ne l'initialise jamais.
        return Date.now() + countdownDuration;
      }

      function showExpiredOffer() {
        if (!expiredOffer || document.body.classList.contains('offer-expired')) return;
        document.body.classList.add('offer-expired');
        document.querySelector('main')?.setAttribute('inert', '');
        form?.querySelectorAll('input, button, select, textarea').forEach((control) => {
          control.disabled = true;
        });
        if (reviewsDialog?.open) reviewsDialog.close();
        if (dialog?.open) dialog.close();
        expiredOffer.hidden = false;
        expiredOffer.setAttribute('aria-hidden', 'false');
        expiredOffer.querySelector('a')?.focus();
        track('offer_expired', null, { countdown_seconds: 0 });
      }

      let countdownEnd = Date.now() + countdownDuration;
      function syncCountdownEnd(value) {
        const serverEnd = new Date(value || '').getTime();
        if (!Number.isFinite(serverEnd)) return;
        countdownEnd = serverEnd;
        if (countdownStorageKey) window.localStorage.setItem(countdownStorageKey, String(serverEnd));
        updateCountdown();
      }

      const updateCountdown = () => {
        const remaining = Math.max(0, countdownEnd - Date.now());
        const totalSeconds = Math.ceil(remaining / 1000);
        const hours = Math.floor(totalSeconds / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        if (countdownHours) countdownHours.textContent = String(hours).padStart(2, '0');
        if (countdownMinutes) countdownMinutes.textContent = String(minutes).padStart(2, '0');
        if (countdownSeconds) countdownSeconds.textContent = String(seconds).padStart(2, '0');
        if (countdownMobileMinutes) countdownMobileMinutes.textContent = String(Math.floor(totalSeconds / 60)).padStart(2, '0');
        if (countdownMobileSeconds) countdownMobileSeconds.textContent = String(seconds).padStart(2, '0');
        if (countdownProgress) countdownProgress.style.transform = `scaleX(${remaining / countdownDuration})`;
        if (remaining <= 0) showExpiredOffer();
        return remaining;
      };

      function mountPreview() {
        paymentLoading.hidden = true;
        previewPayment.hidden = false;
        previewPayment.innerHTML = `
          <div class="fake-field">Numéro de carte <span>•••• •••• •••• ••••</span></div>
          <div class="fake-field-row">
            <div class="fake-field">Expiration <span>MM / AA</span></div>
            <div class="fake-field">CVC <span>•••</span></div>
          </div>`;
        firstNameInput.value = params.get('name') || 'Sonny';
        emailInput.value = params.get('email') || 'sonny@example.com';
        stripeCanConfirm = true;
        updateSubmitState();
      }

      const stripeAppearance = {
        theme: 'stripe',
        inputs: 'spaced',
        labels: 'above',
        variables: {
          colorPrimary: '#126de0',
          colorBackground: '#ffffff',
          colorText: '#17243b',
          colorDanger: '#c8394f',
          colorSuccess: '#08745a',
          fontFamily: 'Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
          fontSizeBase: '16px',
          spacingUnit: '3px',
          borderRadius: '7px',
        },
        rules: {
          '.AccordionItem': {
            backgroundColor: '#f7f9fd',
            border: '0px solid transparent',
            borderRadius: '0px',
            boxShadow: 'none',
            color: '#445169',
            fontSize: '11px',
            fontWeight: '700',
            padding: '7px 0px',
          },
          '.AccordionItem--selected': {
            borderColor: 'transparent',
            boxShadow: 'none',
          },
          '.Input': {
            backgroundColor: '#ffffff',
            border: '1px solid #dce2ec',
            boxShadow: 'none',
            color: '#17243b',
            padding: '10px 11px',
          },
          '.Input:focus': {
            borderColor: '#3a8fff',
            boxShadow: '0 0 0 3px rgba(40, 126, 255, 0.12)',
          },
          '.Input--invalid': {
            borderColor: '#c8394f',
            boxShadow: '0 0 0 2px rgba(200, 57, 79, 0.10)',
          },
          '.Input::placeholder': {
            color: '#a0a8b6',
          },
          '.Label': {
            color: '#5f6b7d',
            fontSize: '11px',
            fontWeight: '650',
          },
          '.Error': {
            color: '#c8394f',
            fontSize: '10px',
          },
          '.TermsText': {
            color: '#7a8497',
            fontSize: '9px',
            lineHeight: '1.45',
          },
        },
      };

      async function createCheckout() {
        const response = await fetch('/.netlify/functions/mc2-stripe-checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, nonce: checkoutNonce() }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          const error = new Error(data.error || 'Le paiement ne peut pas être préparé.');
          error.code = data.code || '';
          throw error;
        }
        return data;
      }

      async function recordContractAcceptance() {
        const evidenceResponse = await fetch('/.netlify/functions/mc2-contract-acceptance', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, checkout_session_id: checkoutSessionId, accepted: checkbox?.checked === true }),
        });
        if (!evidenceResponse.ok) {
          throw new Error('La confirmation contractuelle n’a pas pu être enregistrée. Réessaie.');
        }
      }

      function handlePaymentError(result, buttonId) {
        if (result?.type !== 'error' && !result?.error) return false;
        const error = result.error || result;
        showError(error?.message || 'Vérifie les informations de paiement.');
        paymentConfirmationStarted = false;
        lastCheckoutStage = 'payment_error';
        track('payment_error', null, {
          visit_id: checkoutNonce(),
          ...safePaymentErrorMeta(error, buttonId),
        });
        inspectPaymentAuthentication().catch(() => {});
        return true;
      }

      async function mountStripe() {
        if (!token) throw new Error('Reviens depuis la masterclass pour accéder à cette offre.');
        if (!window.Stripe) throw new Error('Stripe ne peut pas être chargé. Recharge la page.');
        const data = await createCheckout();
        checkoutSessionId = data.checkout_session_id || '';
        syncCountdownEnd(data.offer_expires_at);
        if (Date.now() >= countdownEnd) return;
        firstNameInput.value = data.customer?.name || '';
        emailInput.value = data.customer?.email || '';
        firstNameInput.readOnly = true;
        emailInput.readOnly = true;
        const stripe = window.Stripe(data.publishable_key);
        stripeCheckout = await stripe.initCheckout({
          fetchClientSecret: () => Promise.resolve(data.client_secret),
          elementsOptions: { appearance: stripeAppearance },
        });
        const paymentElement = stripeCheckout.createPaymentElement({
          layout: {
            type: 'accordion',
            defaultCollapsed: false,
            radios: 'never',
            spacedAccordionItems: false,
          },
          fields: {
            billingDetails: {
              address: 'if_required',
            },
          },
          // Le consentement explicite aux quatre débits futurs est recueilli
          // dans la case CGV ci-dessus et enregistré avant la confirmation.
          terms: { card: 'never' },
        });
        const walletElement = stripeCheckout.createExpressCheckoutElement({
          buttonHeight: 48,
          layout: {
            maxColumns: 2,
            maxRows: 1,
            overflow: 'never',
          },
          buttonType: {
            applePay: 'buy',
            googlePay: 'buy',
          },
          paymentMethods: {
            applePay: 'auto',
            googlePay: 'auto',
            link: 'never',
            paypal: 'never',
            amazonPay: 'never',
            klarna: 'never',
          },
        });
        walletElement.on('ready', ({ availablePaymentMethods }) => {
          const availableWallets = [
            availablePaymentMethods?.applePay ? 'apple_pay' : '',
            availablePaymentMethods?.googlePay ? 'google_pay' : '',
          ].filter(Boolean);
          const walletAvailable = Boolean(
            availablePaymentMethods?.applePay || availablePaymentMethods?.googlePay,
          );
          if (walletAvailable) {
            trackOnce('wallet_available', null, { payment_method: availableWallets.join('_') });
          }
          if (!expressCheckout || !walletAvailable) return;
          expressCheckout.hidden = false;
          updateSubmitState();
        });
        walletElement.on('confirm', async (event) => {
          markUserActivity();
          lastCheckoutStage = 'wallet_selected';
          trackOnce('wallet_selected', null, { payment_method: 'express_checkout' });
          if (!checkbox?.checked || !form.reportValidity()) {
            showError('Accepte les CGV et l’échéancier avant de payer.');
            return;
          }
          showError('');
          try {
            await sessionCapacityRequest({ reserve: true });
            await recordContractAcceptance();
          } catch (error) {
            showError(error.message || 'Réessaie dans un instant.');
            return;
          }
          track('payment_submitted', 4700, {
            button_id: 'express-checkout',
            active_seconds: checkoutActiveSeconds,
          });
          paymentConfirmationStarted = true;
          lastCheckoutStage = 'payment_confirmation_started';
          trackOnce('payment_confirmation_started', 4700, {
            button_id: 'express-checkout',
            active_seconds: checkoutActiveSeconds,
          });
          const result = await stripeCheckout
            .confirm({ expressCheckoutConfirmEvent: event })
            .catch((error) => ({ type: 'error', error }));
          handlePaymentError(result, 'express-checkout');
        });
        paymentLoading.hidden = true;
        stripeElement.hidden = false;
        paymentElement.on('ready', () => {
          stripeReady = true;
          lastCheckoutStage = 'stripe_element_ready';
          trackOnce('stripe_element_ready', null, { stripe_ready: true, element_state: 'ready' });
        });
        paymentElement.on('focus', () => {
          markUserActivity();
          lastCheckoutStage = 'payment_element_focused';
          markEngaged();
        });
        paymentElement.on('change', (event) => {
          markUserActivity();
          if (event?.empty === false || event?.complete) {
            paymentDetailsStarted = true;
            lastCheckoutStage = 'payment_details_started';
            trackOnce('payment_details_started', null, { element_state: 'non_empty' });
          }
          paymentDetailsComplete = Boolean(event?.complete);
          if (!paymentDetailsComplete) return;
          paymentDetailsStarted = true;
          lastCheckoutStage = 'payment_details_completed';
          trackOnce('payment_details_completed', null, {
            element_state: 'complete',
            payment_details_complete: true,
          });
        });
        paymentElement.mount(stripeElement);
        walletElement.mount(expressCheckoutElement);
        stripeCheckout.on('change', (session) => {
          stripeCanConfirm = Boolean(session.canConfirm);
          if (stripeCanConfirm) markEngaged();
          updateSubmitState();
        });
      }

      form?.addEventListener('focusin', markEngaged, { once: true });
      checkbox?.addEventListener('change', () => {
        markEngaged();
        lastCheckoutStage = checkbox.checked ? 'terms_accepted' : 'terms_unchecked';
        if (checkbox.checked) {
          trackOnce('terms_accepted', null, { terms_checked: true });
        } else {
          track('terms_unchecked', null, { visit_id: checkoutNonce(), terms_checked: false });
        }
        updateSubmitState();
      });
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        markUserActivity();
        if (!form.reportValidity() || !checkbox?.checked) return;
        if (localPreview) {
          dialog?.showModal();
          return;
        }
        if (!stripeCheckout || !stripeCanConfirm) return;
        submitButton.disabled = true;
        submitButton.classList.add('is-loading');
        showError('');
        try {
          await sessionCapacityRequest({ reserve: true });
          await recordContractAcceptance();
        } catch (error) {
          showError(error.message || 'Réessaie dans un instant.');
          submitButton.classList.remove('is-loading');
          stripeCanConfirm = true;
          updateSubmitState();
          return;
        }
        track('payment_submitted', 4700, {
          button_id: 'buy-button',
          active_seconds: checkoutActiveSeconds,
        });
        paymentConfirmationStarted = true;
        lastCheckoutStage = 'payment_confirmation_started';
        trackOnce('payment_confirmation_started', 4700, {
          button_id: 'buy-button',
          active_seconds: checkoutActiveSeconds,
        });
        const result = await stripeCheckout.confirm().catch((error) => ({ type: 'error', error }));
        if (handlePaymentError(result, 'buy-button')) {
          submitButton.classList.remove('is-loading');
          stripeCanConfirm = true;
          updateSubmitState();
        }
      });

      window.addEventListener('pagehide', () => {
        if (!token || localPreview || paymentConfirmationStarted || document.body.classList.contains('offer-expired')) return;
        const payload = trackingPayload('checkout_abandoned', null, {
          visit_id: checkoutNonce(),
          last_stage: lastCheckoutStage,
          active_seconds: checkoutActiveSeconds,
          stripe_ready: stripeReady,
          payment_details_started: paymentDetailsStarted,
          payment_details_complete: paymentDetailsComplete,
          terms_checked: Boolean(checkbox?.checked),
        });
        const body = JSON.stringify(payload);
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/.netlify/functions/track-mc2-event', new Blob([body], { type: 'application/json' }));
        } else {
          track('checkout_abandoned', null, payload.meta);
        }
      });

      const scrollMilestones = new Set();
      window.addEventListener('scroll', () => {
        if (localPreview) return;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const percent = height > 0 ? Math.round((window.scrollY / height) * 100) : 100;
        [25, 50, 75, 90].forEach((milestone) => {
          if (percent >= milestone && !scrollMilestones.has(milestone)) {
            scrollMilestones.add(milestone);
            track('sales_scroll', milestone, { percent: milestone });
          }
        });
      }, { passive: true });

      closeDialog?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      openReviews?.addEventListener('click', () => reviewsDialog?.showModal());
      closeReviews?.addEventListener('click', () => reviewsDialog?.close());
      reviewsDialog?.addEventListener('click', (event) => {
        if (event.target === reviewsDialog) reviewsDialog.close();
      });
      reviewFilters.forEach((button) => {
        button.addEventListener('click', () => {
          const rating = button.dataset.reviewFilter;
          reviewFilters.forEach((filter) => filter.classList.toggle('is-active', filter === button));
          (reviewOrders[rating] || reviewOrders.all).forEach((id) => {
            const item = reviewsById.get(id);
            if (item) reviewList?.append(item);
          });
          reviewItems.forEach((item) => {
            item.hidden = rating !== 'all' && item.dataset.reviewRating !== rating;
          });
          reviewList?.scrollTo({ top: 0, behavior: 'instant' });
        });
      });

      async function initCheckoutPage() {
        token = await window.__MC2_ACCESS__.resolve();
        countdownStorageKey = token ? `mc2_offer_expires_at_${token}` : '';
        countdownEnd = resolveCountdownEnd();
        const initialCountdownRemaining = updateCountdown();
        if (initialCountdownRemaining > 0) {
          const countdownInterval = window.setInterval(() => {
            if (updateCountdown() <= 0) window.clearInterval(countdownInterval);
          }, 1000);
        }
        if (initialCountdownRemaining <= 0) {
          showExpiredOffer();
        } else if (localPreview) {
          await sessionCapacityRequest();
          mountPreview();
        } else {
          trackOnce('checkout_viewed', 4700, { checkout_enabled: true });
          await sessionCapacityRequest();
          if (sessionCapacityBlocked) {
            paymentLoading.hidden = true;
            showError('Cette session est complète. Aucune nouvelle place ne peut être réservée.');
            return;
          }
          await mountStripe();
        }
      }

      initCheckoutPage().catch((error) => {
        if (error.code === 'offer_expired') {
          showExpiredOffer();
          return;
        }
        paymentLoading.hidden = true;
        showError(error.message || 'Le paiement ne peut pas être préparé.');
        track('payment_error', null, {
          section: 'initialization',
          visit_id: checkoutNonce(),
          ...safePaymentErrorMeta(error),
        });
      });
    </script>
  </body>
</html>

<style is:global>
