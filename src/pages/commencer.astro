---
import reviewsData from '../data/reviews.json';
import reviewConversionOrder from '../data/review-conversion-order.json';
import Mc2AccessGate from '../components/Mc2AccessGate.astro';

const allReviewOrder = new Map(reviewConversionOrder.filters.all.map((id, index) => [id, index]));
const checkoutReviews = reviewsData.reviews
  .filter((review) => Boolean(review.first_name))
  .sort((a, b) => (allReviewOrder.get(a.id) ?? Number.MAX_SAFE_INTEGER) - (allReviewOrder.get(b.id) ?? Number.MAX_SAFE_INTEGER));
const ratedReviews = checkoutReviews.filter((review) => Number.isFinite(review.rating));
const reviewAverage = ratedReviews.reduce((total, review) => total + review.rating, 0) / ratedReviews.length;
const reviewAverageLabel = reviewAverage.toFixed(1).replace('.', ',');
const reviewAveragePercent = (reviewAverage / 5) * 100;
const ratingCounts = ratedReviews.reduce((counts, review) => {
  counts[review.rating] = (counts[review.rating] || 0) + 1;
  return counts;
}, {});
const ratingFilterValues = Object.keys(ratingCounts).map(Number).sort((a, b) => b - a);
const reviewInitials = (name) => name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0])
  .join('')
  .toUpperCase();
const reviewResponses: Record<string, string> = {
  'historique-es2-kevin-3-etoiles': `Merci Kevin. Ta coach a raison sur un point : le rapport humain compte, et c'est pour ça qu'on ajoute du coaching à nos services en septembre. Mais soyons honnêtes : aucun coach ne peut faire le travail à ta place. La transformation vient de la pratique quotidienne, 15 minutes par jour, et c'est exactement ce que le programme installe. Le coaching accélère. La pratique transforme. Les deux se complètent.`,
  'historique-es2-cedric-1-etoile': `Bonjour Cédric. On a vérifié ton espace membre avant de te répondre : aucun module ouvert à ce jour. Difficile de ne pas aimer un programme qu'on n'a pas commencé. Si quelque chose te bloque pour démarrer, écris-nous et on regarde ensemble ce qui coince vraiment.`,
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <title>Commencer Esprit Subconscient 2.0</title>
    <meta
      name="description"
      content="Commence Esprit Subconscient 2.0 aujourd’hui avec un échéancier fixe et clairement annoncé."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline src="https://js.stripe.com/basil/stripe.js"></script>
  </head>

  <body>
    <Mc2AccessGate pagePath="/commencer/" />
    <main>
      <section class="hero">
        <div class="ambient ambient--one"></div>
        <div class="ambient ambient--two"></div>

        <div class="shell hero-grid" id="top">
          <div class="hero-copy">
            <section class="offer-summary" aria-labelledby="offer-summary-title">
              <div class="offer-summary__head">
                <h2 id="offer-summary-title">CE QUE TU OBTIENS</h2>
              </div>
              <div class="offer-summary__visual">
                <img
                  src="/media/pages/es2-bundle.webp"
                  alt="Esprit Subconscient 2.0 avec la formation, Morpho et la communauté Volt"
                />
              </div>
              <div class="page-countdown" role="timer" aria-label="Temps restant : une heure">
                <div class="page-countdown__digits" aria-hidden="true">
                  <div><strong>00</strong><small>jours</small></div>
                  <b>:</b>
                  <div><strong id="countdown-hours">01</strong><small>heures</small></div>
                  <b>:</b>
                  <div><strong id="countdown-minutes">00</strong><small>minutes</small></div>
                  <b>:</b>
                  <div><strong id="countdown-seconds">00</strong><small>secondes</small></div>
                </div>
                <div class="page-countdown__progress" aria-hidden="true">
                  <span id="countdown-progress"></span>
                </div>
                <span class="page-countdown__note">Après le compteur, cette offre te sera retirée.</span>
              </div>
              <div class="offer-summary__details">
                <p class="offer-summary__training-volume"><span>✓</span> <strong>5 modules et plus de 36 heures de formation</strong></p>
                <p><span>✓</span> 15 minutes par jour pendant 6 mois</p>
                <p><span>✓</span> Tes premiers changements visibles dès les 14 premiers jours</p>
                <p><span>✓</span> App Morpho, ton coach IA personnel pendant 12 mois</p>
                <p><span>✓</span> Ton plan d’action sur mesure dès J+30</p>
                <p><span>✓</span> La communauté privée Volt</p>
                <p><span>✓</span> Toutes les futures mises à jour incluses à vie</p>
                <p class="offer-summary__result">
                  <span class="offer-summary__result-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M8 3h8v4.5a4 4 0 0 1-8 0V3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                      <path d="M8 5H5v1.5A3.5 3.5 0 0 0 8.5 10M16 5h3v1.5a3.5 3.5 0 0 1-3.5 3.5M12 11.5V16m-3 4h6m-5-4h4v4h-4v-4Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                  <span class="offer-summary__result-copy">
                    Tout ce qu’il te faut pour <strong>réveiller le meilleur en toi</strong> et
                    <strong class="offer-summary__result-underline">obtenir ce que tu veux</strong>&nbsp;!
                  </span>
                </p>
              </div>
            </section>

            <button type="button" class="reviews-summary" id="open-reviews" aria-haspopup="dialog">
              <span class="reviews-summary__eyebrow">Avis des participants</span>
              <span class="reviews-summary__main">
                <span class="reviews-summary__score">{reviewAverageLabel}<small>/5</small></span>
                <span class="reviews-summary__rating">
                  <span class="star-meter" aria-label={`Note moyenne : ${reviewAverageLabel} sur 5`}>
                    <span aria-hidden="true">★★★★★</span>
                    <span aria-hidden="true" style={`width: ${reviewAveragePercent}%`}>★★★★★</span>
                  </span>
                  <strong>{checkoutReviews.length} avis authentiques</strong>
                </span>
              </span>
              <span class="reviews-summary__footer">
                <span class="reviews-summary__avatars" aria-hidden="true">
                  <img src="https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/7a97c502-a682-47a4-aec4-2aa2ac563908/malika-modified.png" alt="" />
                  <img src="https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/e825f3b3-c3b4-49a5-9b69-7c2213b33a11/Melyssa.jpg" alt="" />
                  <img src="https://files.elfsightcdn.com/eafe4a4d-3436-495d-b748-5bdce62d911d/b94c69cf-4317-41b0-9637-3f8b8b3d6f52/1-1-.png" alt="" />
                </span>
                <strong>Lire leurs témoignages <span aria-hidden="true">→</span></strong>
              </span>
            </button>
          </div>

          <aside class="order-card" aria-labelledby="order-title">
            <div class="order-head">
              <h2 class="order-product" id="order-title">Esprit Subconscient 2.0</h2>
