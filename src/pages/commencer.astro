  .expired-offer a svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.3; }
  .expired-offer small { margin-top: 13px; color: rgba(199,216,238,.5); font-size: 9px; }

  button, input { font: inherit; }

  .shell { width: min(1180px, calc(100% - 40px)); margin-inline: auto; }
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(circle at 14% 30%, rgba(20,104,255,.28), transparent 32%),
      radial-gradient(circle at 80% 8%, rgba(60,185,255,.16), transparent 28%),
      linear-gradient(145deg, #061124 0%, #071a36 55%, #061225 100%);
  }
  .hero::before {
    content: '';
    position: absolute;
