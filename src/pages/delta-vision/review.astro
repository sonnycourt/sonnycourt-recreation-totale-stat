<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow">

<title>Ton expérience — Delta Vision</title>
<style is:global>
@font-face{font-family:Inter;src:url('/fonts/inter-latin.woff2') format('woff2');font-weight:100 900;font-display:swap}
:root{--paper:#faf8f4;--ink:#2c2d26;--muted:#746e63;--rust:#b54e36;--line:#ded5c7;--gold:#b58a49}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,Arial,sans-serif;-webkit-font-smoothing:antialiased}button,input,textarea{font:inherit}button{cursor:pointer}a{color:inherit}header{max-width:1260px;margin:auto;padding:27px 42px;display:flex;justify-content:space-between;align-items:center}.brand{display:flex;gap:11px;align-items:center;text-decoration:none;font-size:21px;font-weight:600;letter-spacing:-.8px}.brand svg{width:35px;height:40px;color:var(--rust)}.header-note{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--muted)}main{max-width:1180px;margin:14px auto 28px;display:grid;grid-template-columns:1fr 1.12fr;border:1px solid var(--line);border-radius:26px;overflow:hidden;background:#fffdf9;box-shadow:0 20px 70px #44371e08}.story{position:relative;min-height:780px;background:#253c2c;isolation:isolate;overflow:hidden;color:#fff8eb}.scene{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50%;z-index:-3}.story:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#12271e85 0%,#14261c08 40%,#17271edb 80%,#17271e 100%);z-index:-2}.story-top{padding:45px 40px}.eyebrow{font-size:10px;font-weight:600;letter-spacing:2.4px;text-transform:uppercase;margin:0 0 18px}.story h1{font-size:45px;line-height:1.08;font-weight:450;letter-spacing:-2px;margin:0}.story h1 em{display:block;font-family:Georgia,serif;font-weight:400;color:#ead6a7}.story-bottom{position:absolute;bottom:44px;left:40px;right:40px}.story-bottom p{font-size:15px;line-height:1.8;margin:0 0 16px;max-width:360px}.signature{font-family:Georgia,serif;font-style:italic;font-size:26px;color:#e4c697}.leaf{position:absolute;bottom:-100px;right:-115px;width:290px;opacity:.55;pointer-events:none;z-index:-1}.form-panel{padding:42px 48px}.form-panel>.eyebrow{color:var(--rust);margin-bottom:13px}.form-panel h2{font-size:29px;letter-spacing:-1.1px;font-weight:500;line-height:1.2;margin:0 0 12px}.intro{font-size:14px;line-height:1.65;color:var(--muted);margin:0 0 26px}fieldset{border:0;padding:0;margin:0 0 24px}legend,.label{font-size:13px;font-weight:550;margin:0 0 10px;display:block}.stars{display:flex;gap:8px;width:max-content;max-width:100%;margin-top:8px}.star-option{position:relative}.star-option input{position:absolute;opacity:0;width:1px;height:1px}.star-option label{display:grid;place-items:center;width:55px;height:53px;border:1px solid var(--line);border-radius:12px;background:#fbf8f2;cursor:pointer;color:#cbbda9;transition:background .15s,color .15s,border-color .15s}.star-option svg{width:29px;height:29px;fill:none;stroke:currentColor;stroke-width:1.3}.star-option label.lit{background:#f3e8d5;color:var(--gold);border-color:#cdb38a}.star-option label.lit svg{fill:currentColor}.star-option input:focus-visible+label{outline:3px solid var(--rust);outline-offset:3px}.rating-caption{font-size:12px;color:var(--muted);min-height:18px;margin:10px 0 0}.identity{display:grid;grid-template-columns:1fr 1.5fr;gap:14px;margin-bottom:22px}input[type=text],input[type=email],textarea{width:100%;background:#fff;border:1px solid var(--line);border-radius:10px;padding:14px;color:var(--ink);font-size:14px;line-height:1.5}input::placeholder,textarea::placeholder{color:#9b958c}input:focus,textarea:focus{outline:2px solid #ba7356;outline-offset:2px}textarea{min-height:133px;resize:vertical}.hint{font-size:11px;line-height:1.5;color:var(--muted);margin:8px 0 21px}.permission{display:flex;align-items:flex-start;gap:10px;font-size:11px;line-height:1.65;color:var(--muted);margin:18px 0}.permission input{flex:none;width:17px;height:17px;margin:1px 0 0;accent-color:var(--rust)}.submit{background:var(--rust);color:#fff;width:100%;border:0;border-radius:40px;padding:17px 22px;font-size:15px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:18px}.submit:hover{background:#9e402d}.submit:focus-visible{outline:3px solid #292923;outline-offset:4px}.privacy{font-size:10px;color:var(--muted);text-align:center;line-height:1.6;margin:13px 0 0}.preview{max-width:1180px;margin:0 auto 25px;text-align:center;font-size:11px;color:var(--muted);padding:0 20px}.preview strong{font-weight:600;color:var(--rust)}[hidden]{display:none!important}.success{padding:70px 0;text-align:center}.success-mark{display:grid;place-items:center;margin:0 auto 28px;border:1px solid #c9d4c3;border-radius:50%;width:66px;height:66px;background:#eef2e9;color:#4c6947;font-size:28px}.success h2{font-family:Georgia,serif;font-size:40px;font-weight:400}.success p{font-size:14px;line-height:1.8;color:var(--muted)}.success button{margin-top:22px;border:0;border-bottom:1px solid var(--line);padding:10px;background:none;color:var(--rust)}
@media(min-width:1500px){main{margin-top:35px}}@media(max-width:900px){header{padding:24px}.header-note{font-size:9px}main{margin:0 20px 22px;grid-template-columns:.85fr 1fr}.form-panel{padding:34px 27px}.story-top{padding:35px 28px}.story h1{font-size:37px}.story-bottom{left:28px;right:28px}.identity{grid-template-columns:1fr}.star-option label{width:47px;height:48px}.stars{gap:6px}}@media(max-width:650px){header{padding:20px}.header-note{display:none}main{display:block;margin:0 14px 20px;border-radius:20px}.story{min-height:290px}.scene{object-position:50% 43%}.story:after{background:linear-gradient(90deg,#15271ee0,#15271e0a)}.story-top{padding:30px 24px}.story h1{font-size:37px;max-width:270px}.story-bottom{position:static;padding:0 24px 24px}.story-bottom p{display:none}.signature{font-size:23px}.leaf{display:none}.form-panel{padding:28px 24px}.form-panel h2{font-size:26px}.identity{grid-template-columns:1fr}.stars{gap:9px}.star-option label{width:48px;height:49px}.intro{margin-bottom:24px}.success{padding:35px 0}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}
.trap{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}#form-status{font-size:13px;color:#a8412d;line-height:1.6;margin:12px 0}.submit:disabled{opacity:.65;cursor:wait}#forget-identity{border:0;background:none;font-size:inherit;color:inherit;text-decoration:underline;padding:0 2px}.form-panel{min-width:0}</style>
<meta name="referrer" content="no-referrer" /></head>
<body>
<header><a class="brand" href="https://sonnycourt.com/delta-vision/"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M32 19 24 5 4 40h40l-6-10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="m25 18 2.4 6.6L34 27l-6.6 2.4L25 36l-2.4-6.6L16 27l6.6-2.4Z" fill="currentColor"/></svg>Delta Vision</a><span class="header-note">Une respiration. Un autre horizon.</span></header>
<main>
<section class="story" aria-labelledby="story-title"><img class="scene" src="/media/pages/delta-responsive/inspira-vsl-jungle-v2-800.webp" alt="Sonny en méditation dans une jungle baignée de lumière"><div class="story-top"><p class="eyebrow">Après l’expérience</p><h1 id="story-title">Tu as vécu le voyage.<em>Raconte le tien.</em></h1></div><img class="leaf" src="/media/pages/delta-responsive/delta-jungle-wrap-v2-480.webp" alt=""><div class="story-bottom"><p>J’ai créé Delta Vision pour que tu puisses vivre cette expérience, à ta façon. Ton retour m’aide à la faire grandir.</p><span class="signature">Merci à toi, Sonny.</span></div></section>
<section class="form-panel" aria-label="Donner mon avis"><p class="eyebrow">Ton avis compte</p><h2 id="title">Comment as-tu vécu<br>Delta Vision ?</h2><p class="intro">Une première séance ou déjà un rituel : partage simplement ton expérience, avec tes mots.</p>
<form id="review-form"><div class="trap" aria-hidden="true"><label>Site internet<input name="website" tabindex="-1" autocomplete="off" /></label></div>
<fieldset><legend>Quelle note donnes-tu à ton expérience ?</legend><div class="stars" id="stars"></div><p class="rating-caption" id="rating-caption" aria-live="polite">Choisis entre 1 et 5 étoiles.</p></fieldset>
<div class="identity"><label><span class="label">Ton prénom</span><input type="text" name="firstName" autocomplete="given-name" placeholder="Prénom" maxlength="80" required></label><label><span class="label">Ton adresse email</span><input type="email" name="email" autocomplete="email" placeholder="toi@exemple.com" maxlength="254" required></label></div>
<label for="review"><span class="label">Ton expérience, avec tes mots</span></label><textarea id="review" name="review" placeholder="Qu’as-tu le plus aimé dans Delta Vision ? Comment t’es-tu senti après la séance ?" maxlength="10000" required></textarea><p class="hint">Raconte ce que tu as vécu, simplement, à ta façon.</p>
<label for="improvements"><span class="label">Que pourrait-on améliorer ? <span style="font-weight:400;color:var(--muted)">(Facultatif)</span></span></label><textarea id="improvements" name="improvements" placeholder="Une suggestion pour rendre l’expérience encore meilleure…" maxlength="10000" style="min-height:88px"></textarea><p class="hint">Cet espace est dédié à tes suggestions pour l’équipe.</p>
<p id="form-status" role="status" aria-live="polite"></p><button class="submit" type="submit">Partager mon expérience <span aria-hidden="true">→</span></button><p class="privacy">Ton email sert à identifier ton retour. Il reste privé. Prénom et email mémorisés sur ce navigateur uniquement. <button type="button" id="forget-identity">Effacer mes coordonnées</button></p>
</form>
<section class="success" id="success" hidden tabindex="-1"><div class="success-mark" aria-hidden="true">✓</div><h2>Merci pour ce partage.</h2><p id="confirmation"></p><p>Ton avis a bien été enregistré. Merci d’avoir pris ce temps pour partager ton expérience.</p><a href="/delta-vision/">Revenir à Delta Vision →</a></section>
</section>
</main>

<script>import "../../lib/delta-review-client.mjs";</script></body>
</html>
<style is:global>
.form-panel fieldset{min-width:0}
.form-panel .stars{width:100%;max-width:307px}
.form-panel .star-option{flex:1;min-width:0}
.form-panel .star-option label{width:100%}
</style>
