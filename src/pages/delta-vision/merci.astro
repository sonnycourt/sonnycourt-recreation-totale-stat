---
// Post-purchase presentation only. Payment and access provisioning stay in Spiffy/AutoKit.
const invitationUrl = 'https://volt.sonnycourt.com/join?invitation_token=86ceb29a23d9bdd2b063de7fbe21925bb6dfbf2d-7194cdb8-ab94-4753-8304-8baf84e7b5de';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#faf8f4" />
    <title>Bienvenue dans Delta Vision</title>
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header>
      <span class="brand" aria-label="Delta Vision">Delta<br />Vision</span>
      <span class="signature">UNE RESPIRATION. UN AUTRE HORIZON.</span>
    </header>
    <main>
      <section class="welcome" aria-labelledby="welcome-title">
        <div class="copy">
          <p class="eyebrow"><span class="check" aria-hidden="true">✓</span> TON INSCRIPTION EST VALIDÉE</p>
          <h1 id="welcome-title">Bienvenue dans<br /><em>l’expérience.</em></h1>
          <p class="intro">Merci pour ta confiance.<br />Delta Vision commence maintenant.</p>
          <div class="access-note">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg>
            <div><p>Tes accès t’ont été envoyés par email.</p><span>Pense à vérifier tes spams si tu ne le vois pas.</span></div>
          </div>
          <p class="instruction">Tu peux aussi créer ton compte sur Volt<br class="desktop-break" /> et retrouver directement ton expérience ici.</p>
          <a class="cta" href={invitationUrl} rel="noreferrer" referrerpolicy="no-referrer">J’accède à Delta Vision <span aria-hidden="true">↗</span></a>
          <p class="account-note">Utilise la même adresse email que lors de ton achat.</p>
          <p class="signoff">Rendez-vous de l’autre côté,<br /><span>Sonny</span></p>
        </div>
        <div class="visual" aria-hidden="true">
          <img src="/media/pages/inspira-vsl-jungle-v2.webp" width="1672" height="941" alt="" fetchpriority="high" />
          <div class="visual-caption"><span>TON NOUVEAU RENDEZ-VOUS AVEC TOI.</span><p>Une inspiration.<br /><em>Un nouvel horizon.</em></p><div class="rule"></div><span>RESPIRE. VISUALISE. MANIFESTE.</span></div>
        </div>
      </section>
    </main>
    <footer><span>UNE CRÉATION SONNY COURT</span><a href="mailto:info@sonnycourt.com">Besoin d’aide ? Écris-nous <span aria-hidden="true">↗</span></a></footer>
  </body>
</html>
<style is:global>
  @font-face{font-family:Delta;src:url('/fonts/inter-latin.woff2') format('woff2');font-weight:100 900;font-display:swap}
  *{box-sizing:border-box}body{margin:0;background:#faf8f4;color:#292923;font-family:Delta,Arial,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit}header,footer{max-width:1240px;margin:auto;padding:28px 36px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{font-size:26px;font-weight:600;letter-spacing:-1.1px;line-height:.95}.signature,footer>span{font-size:9px;letter-spacing:2px;color:#887d6b}.welcome{max-width:1168px;margin:20px auto 36px;display:grid;grid-template-columns:1.07fr 1fr;border:1px solid #e5dbce;border-radius:28px;overflow:hidden;background:#fffdf9;min-height:655px}.copy{padding:50px 48px 38px}.eyebrow{display:flex;align-items:center;gap:10px;color:#8a6b4d;font-size:10px;font-weight:600;letter-spacing:1.5px;margin:0 0 27px}.check{display:grid;place-items:center;width:26px;height:26px;border:1px solid #d9c5ad;border-radius:50%;font-size:14px;flex-shrink:0}h1{font-size:clamp(42px,4.1vw,58px);line-height:1.07;letter-spacing:-2.7px;font-weight:500;margin:0 0 24px}em{font-family:Georgia,serif;font-weight:400;color:#b34f39}.intro{font-size:16px;line-height:1.8;color:#716b60;margin:0}.access-note{display:flex;gap:13px;margin:26px 0 22px;padding:20px 0;border-block:1px solid #e9e0d4}.access-note svg{width:23px;height:23px;flex-shrink:0;color:#967958;margin-top:1px}.access-note p{font-size:14px;font-weight:500;line-height:1.65;margin:0}.access-note span{display:block;font-size:11px;line-height:1.7;color:#8c8171;margin-top:3px}.instruction{font-size:14px;line-height:1.8;color:#716b60;margin:0 0 19px}.cta{display:flex;align-items:center;justify-content:center;position:relative;gap:20px;min-height:58px;border-radius:100px;background:#b34f39;color:white;text-decoration:none;font-size:16px;font-weight:600;padding:18px 42px;text-align:center;transition:background .2s}.cta span{position:absolute;right:23px;font-size:22px;font-weight:400}.cta:hover{background:#9c422f}.cta:focus-visible,footer a:focus-visible{outline:3px solid #8a6b4d;outline-offset:5px}.account-note{text-align:center;color:#8c8171;font-size:10px;line-height:1.6;margin:11px 0 0}.signoff{font-size:12px;line-height:1.6;color:#81776a;margin:24px 0 0}.signoff span{display:inline-block;font-family:Georgia,serif;font-style:italic;color:#b34f39;font-size:26px;margin-top:3px}.visual{position:relative;min-height:100%;background:#263a29;isolation:isolate}.visual img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 50%}.visual:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,rgba(12,31,22,.15) 50%,rgba(12,31,22,.91) 100%);z-index:0}.visual-caption{position:absolute;bottom:44px;left:35px;right:35px;text-align:center;z-index:1;color:#f7eedb}.visual-caption>span{font-size:8px;letter-spacing:2.4px;line-height:1.7}.visual-caption p{font-family:Georgia,serif;font-size:36px;line-height:1.15;margin:18px 0}.visual-caption em{color:#e5cda7}.rule{height:1px;width:38px;background:#d0b58a;margin:23px auto}footer{padding-top:0;padding-bottom:30px}footer a{font-size:11px;text-decoration:none;color:#827664}footer a span{margin-left:8px}astro-dev-toolbar{display:none!important}
  @media(max-width:1239px){.welcome{margin-inline:36px}.copy{padding:40px 34px}.visual-caption p{font-size:32px}}
  @media(max-width:760px){header{padding:25px 24px}.signature{font-size:7px;line-height:1.8;max-width:130px;text-align:right}.welcome{margin:12px 20px 26px;grid-template-columns:1fr;border-radius:22px;min-height:0}.copy{padding:30px 25px}.eyebrow{font-size:8px;letter-spacing:1.1px;margin-bottom:23px}h1{font-size:43px;letter-spacing:-2px}.intro{font-size:14px}.access-note p{font-size:13px}.access-note span{font-size:10px}.instruction{font-size:13px}.desktop-break{display:none}.cta{font-size:14px;padding-inline:30px}.cta span{right:17px}.account-note{font-size:9px}.visual{min-height:300px}.visual img{object-position:center 49%}.visual-caption{bottom:25px}.visual-caption p{font-size:29px;margin:12px 0}.visual-caption>span{font-size:7px}.rule{margin:14px auto}.visual:after{background:linear-gradient(180deg,transparent 15%,rgba(12,31,22,.9) 100%)}footer{padding:0 24px 28px;gap:18px;flex-wrap:wrap}footer>span{font-size:7px;letter-spacing:1.5px}footer a{font-size:10px}}
  @media(max-width:760px){.cta{padding-inline:18px;gap:12px}.cta span{position:static;flex-shrink:0}.signature{flex-shrink:1}}
  @media(prefers-reduced-motion:reduce){.cta{transition:none}}
</style>
