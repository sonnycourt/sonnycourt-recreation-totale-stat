    name: 'Olympe',
    role: 'Directrice SEO & Visibilité organique',
    shortRole: 'Direction SEO',
    division: 'Direction',
    task: 'Arbitre les priorités entre potentiel de trafic, autorité et valeur commerciale.',
    state: 'ready',
    stateLabel: '3 arbitrages à préparer',
    progress: 78,
    color: 'blue',
    image: '/media/seo/agents/agent-olympe-v1.png',
    reasoning: 'Élevé',
    liveResearch: false,
  },
  {
    id: 'orso',
    name: 'Orso',
    role: 'Analyste Performance, Veille & Content Refresh',
    shortRole: 'Veille & refresh',
    division: 'Pilotage',
    task: 'Surveille la performance, les changements des moteurs et les contenus qui vieillissent.',
    state: 'watch',
    stateLabel: 'Baseline à connecter',
    progress: 24,
    color: 'lime',
    image: '/media/seo/agents/agent-orso-v1.png',
    reasoning: 'Standard',
