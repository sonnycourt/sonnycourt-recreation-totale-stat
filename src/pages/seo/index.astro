    state: 'working',
    stateLabel: 'Carte sémantique à lancer',
    progress: 35,
    color: 'cyan',
    image: '/media/seo/agents/agent-basile-v1.png',
    reasoning: 'Élevé',
    liveResearch: true,
  },
  {
    id: 'numa',
    name: 'Numa',
    role: 'Responsable Offres & Conversion',
    shortRole: 'Offres & conversion',
    division: 'Intelligence & marché',
    task: 'Relie chaque intention au bon produit, au bon parcours et au CTA le plus cohérent.',
    state: 'review',
    stateLabel: '2 offres à valider',
    progress: 64,
    color: 'amber',
    image: '/media/seo/agents/agent-numa-v1.png',
    reasoning: 'Standard',
    liveResearch: false,
  },
  {
    id: 'romy',
    name: 'Romy',
    role: 'Rédactrice en chef SEO',
    shortRole: 'Rédaction en chef',
    division: 'Production éditoriale',
    task: 'Transforme les opportunités validées en briefs et articles utiles dans la voix de Sonny.',
    state: 'ready',
    stateLabel: 'Brief éditorial en attente',
    progress: 18,
    color: 'coral',
    image: '/media/seo/agents/agent-romy-v1.png',
    reasoning: 'Standard',
    liveResearch: false,
  },
  {
    id: 'thea',
    name: 'Théa',
    role: 'Éditrice & Fact-checker',
    shortRole: 'Édition & fiabilité',
    division: 'Production éditoriale',
    task: 'Vérifie les faits, les sources, l’originalité, la lisibilité et la crédibilité éditoriale.',
    state: 'clear',
    stateLabel: 'Contrôles prêts',
    progress: 12,
    color: 'jade',
    image: '/media/seo/agents/agent-thea-v1.png',
    reasoning: 'Élevé',
    liveResearch: true,
  },
  {
    id: 'come',
    name: 'Côme',
    role: 'Architecte SEO technique & On-page',
    shortRole: 'SEO technique',
    division: 'Architecture & autorité',
    task: 'Contrôle indexation, structure, métadonnées, maillage interne, données structurées et performance.',
    state: 'watch',
    stateLabel: 'Audit technique à lancer',
    progress: 29,
    color: 'cobalt',
    image: '/media/seo/agents/agent-come-v1.png',
    reasoning: 'Élevé',
    liveResearch: true,
  },
  {
    id: 'lyra',
    name: 'Lyra',
    role: 'Responsable Autorité & Visibilité IA',
    shortRole: 'Autorité & IA',
    division: 'Architecture & autorité',
    task: 'Renforce les mentions, citations et signaux qui rendent Sonny recommandable par les moteurs IA.',
    state: 'working',
    stateLabel: 'Protocole de mesure à définir',
    progress: 31,
    color: 'indigo',
    image: '/media/seo/agents/agent-lyra-v1.png',
    reasoning: 'Élevé',
    liveResearch: true,
  },
];

const offers = [
  {
    id: 'esprit-subconscient-2',
    number: '01',
    name: 'Esprit Subconscient 2.0',
    type: 'Webinaire',
    action: 'Rejoindre le webinaire',
    url: 'https://sonnycourt.com/masterclass',
    path: '/masterclass',
  },
  {
    id: 'service-coaching',
    number: '02',
    name: 'Service Coaching',
    type: 'Service',
    action: 'Découvrir le coaching',
    url: 'https://sonnycourt.com/coach',
    path: '/coach',
  },
];

const decisions = [
  { title: 'Confier la première mission à l’IA', meta: 'GPT-5.6 Sol · sous contrôle', target: 'aiStudio' },
  { title: 'Valider le catalogue produits', meta: 'Numa · 2 offres à confirmer', target: 'productCatalog' },
  { title: 'Choisir le premier cluster', meta: 'Olympe · arbitrage business', target: 'articlePipeline' },
];

const pipeline = [
  ['01', 'Opportunité', 'Basile', 'current'],
  ['02', 'Brief', 'Romy', 'waiting'],
  ['03', 'Rédaction', 'Romy', 'waiting'],
  ['04', 'Édition', 'Théa', 'waiting'],
  ['05', 'SEO', 'Côme', 'waiting'],
  ['06', 'Autorité IA', 'Lyra', 'waiting'],
  ['07', 'Arbitrage', 'Olympe', 'waiting'],
  ['08', 'Publication', 'Sonny', 'locked'],
];

const missions = [
  {
    agentId: 'basile',
    priority: 'P1',
    owner: 'Basile',
    state: 'Prête à démarrer',
    title: 'Construire la première carte de mots-clés',
    description: 'Identifier les requêtes françaises liées à la manifestation, au subconscient et à la transformation personnelle.',
    evidence: 'Short tail + long tail + intentions + difficulté + valeur business',
  },
  {
    agentId: 'numa',
    priority: 'P1',
    owner: 'Numa',
    state: 'À cadrer',
    title: 'Cartographier les offres et les parcours',
    description: 'Cadrer les deux parcours MVP : le webinaire Esprit Subconscient 2.0 et le service Coaching.',
    evidence: '/masterclass + /coach comme source de vérité initiale',
  },
  {
    agentId: 'come',
    priority: 'P2',
    owner: 'Côme',
    state: 'En attente',
    title: 'Établir la baseline technique SEO',
    description: 'Auditer indexation, canonicals, sitemap, données structurées, vitesse et maillage interne.',
    evidence: 'Aucune correction appliquée sans validation',
  },
  {
    agentId: 'lyra',
    priority: 'P2',
    owner: 'Lyra + Orso',
    state: 'À concevoir',
    title: 'Mesurer la visibilité dans les moteurs IA',
    description: 'Créer un panel de questions réelles et suivre citations, mentions de marque et pages recommandées.',
    evidence: 'ChatGPT, Gemini, Claude, Copilot et Google AI',
  },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#051119" />
    <link rel="icon" type="image/png" sizes="64x64" href="/media/seo/brand/favicon-64.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/media/seo/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/media/seo/brand/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/media/seo/brand/apple-touch-icon.png" />
    <title>SEO Division — Sonny Court</title>
    <meta name="description" content="Cockpit interne de la division SEO et visibilité IA de Sonny Court." />
  </head>
  <body>
    <div class="seo-ambient seo-ambient--one" aria-hidden="true"></div>
    <div class="seo-ambient seo-ambient--two" aria-hidden="true"></div>

    <div class="seo-shell">
      <header class="seo-topbar">
        <a class="seo-brand" href="/seo" aria-label="Accueil SEO Division">
          <span class="seo-brand-mark" aria-hidden="true">
            <img src="/media/seo/brand/seo-division-logo.png" alt="" width="42" height="42" />
          </span>
          <span><strong>SEO Division</strong><small>Sonny Court · Search &amp; AI</small></span>
        </a>
        <nav class="seo-topbar-actions" aria-label="Navigation du cockpit">
          <span class="prototype-pill" id="openAiTopStatus"><i></i> GPT-5.6 Sol · en pause</span>
          <button class="ghost-button" id="validatorModeButton" type="button">Mode validateur</button>
          <a class="ghost-button" href="/hub">← Hub</a>
        </nav>
      </header>

      <div class="safety-banner">
        <span class="safety-icon" aria-hidden="true">⌾</span>
        <p><strong>Division SEO en pause.</strong> Aucun appel à OpenAI ne peut être lancé et aucun crédit IA ne sera dépensé jusqu’à la réactivation volontaire.</p>
        <small>Appels OpenAI bloqués · 0 crédit</small>
      </div>

      <main>
        <section class="validator-home" id="validatorView" aria-labelledby="validatorTitle">
          <div class="validator-welcome">
            <div>
              <div class="section-kicker"><span class="live-dot"></span> Mode validateur</div>
              <h1 id="validatorTitle">Bonjour Sonny.</h1>
              <p><strong>La construction est conservée en l’état.</strong> Tu pourras reprendre ici dans quelques jours.</p>
            </div>
            <button class="outline-button" id="openDepartmentButton" type="button">Voir tout le département <span>→</span></button>
          </div>

          <div class="validator-layout">
            <article class="validator-primary-card" id="validatorPrimaryCard" data-state="paused">
              <div class="validator-card-topline">
                <span>Construction en attente</span>
                <span class="safe-label">0 crédit IA</span>
              </div>
              <div class="validator-primary-copy">
                <h2 id="validatorPrimaryHeading">La division SEO est en pause.</h2>
                <p id="validatorPrimaryText">Les huit spécialistes, leurs rôles et les offres de Numa restent enregistrés, mais aucun agent IA ne peut travailler.</p>
                <div class="validator-reason" id="validatorPrimaryReason">Le serveur bloque les missions avant tout contact avec OpenAI. Ouvrir ou consulter cette interface ne dépense aucun crédit IA.</div>
              </div>
              <div class="validator-primary-footer">
                <span><small>Temps estimé</small><strong>3 min</strong></span>
                <button class="primary-button" id="launchSeoCycle" type="button">Consulter le studio en pause</button>
              </div>
            </article>

            <aside class="validator-side">
              <section class="validator-decisions" aria-labelledby="decisionsTitle">
                <div class="section-heading">
                  <div><span>Aujourd’hui</span><h2 id="decisionsTitle">Tes décisions</h2></div>
                  <strong id="decisionCount">3</strong>
                </div>
                <div class="decision-list">
                  {decisions.map((decision) => (
                    <article class="decision-item">
                      <i aria-hidden="true"></i>
                      <span><strong>{decision.title}</strong><small>{decision.meta}</small></span>
                      <button type="button" data-open-target={decision.target}>Ouvrir</button>
                    </article>
                  ))}
                </div>
              </section>

              <section class="validator-team-status" aria-labelledby="teamStatusTitle">
                <div>
                  <span>Équipe en arrière-plan</span>
                  <h2 id="teamStatusTitle">Olympe et l’équipe sont en pause</h2>
                  <p id="teamStatusText">Les 8 agents attendent ta réactivation.</p>
                </div>
                <div class="validator-agent-strip" aria-label="Agents actifs">
                  {agents.slice(0, 5).map((agent) => (
                    <span
                      class="mini-agent"
                      style={`--agent-image: url('${agent.image}')`}
                      title={`${agent.name} · ${agent.shortRole}`}
                    ><i></i></span>
                  ))}
                </div>
              </section>
            </aside>
          </div>

          <footer class="validator-signal">
            <span aria-hidden="true">◎</span>
            <p><strong>Actif SEO inexploité</strong><small>Le site possède déjà des produits, des pages et une expertise forte : la première priorité est de cartographier les opportunités avant de produire.</small></p>
          </footer>
        </section>

        <section class="department-view" id="departmentView" hidden aria-labelledby="departmentTitle">
          <div class="department-view-heading">
            <div>
              <div class="section-kicker">Salle de contrôle approfondie</div>
              <h1 id="departmentTitle">Tout le département</h1>
              <p>Équipe, opportunités, production, autorité, veille et décisions.</p>
            </div>
            <button class="outline-button" id="backToValidatorButton" type="button"><span>←</span> Revenir au mode validateur</button>
          </div>

          <section class="panel team-panel" aria-labelledby="teamMapTitle">
            <div class="eyebrow"><span class="live-dot"></span> Carte de l’équipe · 8 agents en service</div>
            <div class="hero-heading">
              <h2 id="teamMapTitle">Ton équipe SEO<br /><span>travaille sous tes yeux.</span></h2>
              <p>Une petite équipe, des responsabilités nettes. Sélectionne un agent pour suivre sa mission du moment.</p>
            </div>

            <div class="team-map" aria-label="Carte hiérarchique de la division SEO">
              <div class="team-grid" aria-hidden="true">
                <div class="team-zone team-zone--direction"></div>
                <div class="team-zone team-zone--market"></div>
                <div class="team-zone team-zone--editorial"></div>
                <div class="team-zone team-zone--authority"></div>
              </div>
              <span class="team-label team-label--direction">Direction &amp; pilotage</span>
              <span class="team-label team-label--market">Intelligence &amp; marché</span>
              <span class="team-label team-label--editorial">Production éditoriale</span>
              <span class="team-label team-label--authority">Architecture &amp; autorité</span>

              <div class="agent-layer">
                {agents.map((agent, index) => (
                  <button
                    class="agent-card"
                    type="button"
                    data-agent={agent.id}
                    data-color={agent.color}
                    data-state={agent.state}
                    data-name={agent.name}
                    data-role={agent.role}
                    data-division={agent.division}
                    data-task={agent.task}
                    data-state-label={agent.stateLabel}
                    data-progress={agent.progress}
                    style={`--agent-image: url('${agent.image}'); --agent-delay: -${(index * .17).toFixed(2)}s`}
                    aria-label={`${agent.name}, ${agent.role}. ${agent.stateLabel}.`}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                  >
                    <span class="agent-avatar" aria-hidden="true"><i class="agent-pulse"></i></span>
                    <span class="agent-info"><strong>{agent.name}</strong><small>{agent.shortRole}</small></span>
                  </button>
                ))}
              </div>
              <div class="map-sign" aria-hidden="true">SEO DIVISION · SEARCH &amp; AI TEAM</div>
            </div>

            <div class="agent-focus" id="agentFocus" data-color="blue" aria-live="polite">
              <div class="agent-focus-identity">
                <span id="focusDivision">Direction</span>
                <h3><strong id="focusName">Olympe</strong><small id="focusRole">Directrice SEO &amp; Visibilité organique</small></h3>
              </div>
              <div class="agent-focus-mission">
                <span id="focusState">3 arbitrages à préparer</span>
                <p id="focusTask">Arbitre les priorités entre potentiel de trafic, autorité et valeur commerciale.</p>
              </div>
              <div class="agent-focus-progress">
                <span><small>Progression</small><strong id="focusProgressValue">78 %</strong></span>
                <div><i id="focusProgressBar" style="width: 78%"></i></div>
              </div>
            </div>
          </section>

          <section class="metrics-grid" aria-label="Indicateurs du prototype">
            <article><small>Agents opérationnels</small><strong>8</strong><span>Responsabilités définies</span></article>
            <article><small>Requêtes suivies</small><strong>0</strong><span>Search Console à connecter</span></article>
            <article><small>Articles en production</small><strong>0</strong><span>Pipeline prêt</span></article>
            <article><small>Citations IA mesurées</small><strong>0</strong><span>Baseline à créer</span></article>
            <article><small>Publications automatiques</small><strong>0</strong><span>Verrou permanent</span></article>
          </section>

          <section class="panel ai-studio-panel" id="aiStudio" aria-labelledby="aiStudioTitle">
            <div class="ai-studio-heading">
              <div>
                <div class="section-kicker"><span class="live-dot"></span> Moteur central OpenAI</div>
                <h2 id="aiStudioTitle">Un cerveau. Huit expertises.</h2>
                <p>Choisis l’agent, donne-lui une mission précise et récupère un livrable interne. Aucune réponse ne peut publier ou modifier le site.</p>
              </div>
              <div class="ai-model-card" id="aiModelCard" data-state="paused">
                <span class="ai-model-mark" aria-hidden="true">AI</span>
                <span><small>Modèle unique</small><strong>GPT-5.6 Sol</strong><em id="aiConnectionLabel">En pause · aucun appel autorisé</em></span>
              </div>
            </div>

            <div class="ai-roster" aria-label="Configuration IA des agents">
              {agents.map((agent) => (
                <button
                  type="button"
                  class="ai-roster-agent"
                  data-ai-agent={agent.id}
                  data-agent-name={agent.name}
                  data-agent-role={agent.role}
                  data-agent-reasoning={agent.reasoning}
                  data-agent-research={String(agent.liveResearch)}
                  aria-pressed={agent.id === 'olympe' ? 'true' : 'false'}
                >
                  <span style={`--agent-image: url('${agent.image}')`}></span>
                  <strong>{agent.name}</strong>
                  <small>{agent.reasoning} · {agent.liveResearch ? 'Web actif' : 'Sources internes'}</small>
                </button>
              ))}
            </div>

            <div class="ai-workbench">
              <form class="ai-mission-form" id="aiMissionForm">
                <div class="ai-selected-agent">
                  <span class="ai-selected-avatar" id="aiSelectedAvatar" style="--agent-image: url('/media/seo/agents/agent-olympe-v1.png')"></span>
                  <span><small>Agent sélectionné</small><strong id="aiSelectedName">Olympe</strong><em id="aiSelectedRole">Directrice SEO &amp; Visibilité organique</em></span>
                  <span class="ai-tool-state" id="aiToolState">Raisonnement élevé · Sources internes</span>
                </div>
                <label for="aiMission">Mission</label>
                <textarea id="aiMission" name="mission" rows="5" maxlength="10000" placeholder="Ex. Construis le plan de la première cartographie sémantique française autour du subconscient…" required></textarea>
                <details class="ai-context-details">
                  <summary>Ajouter du contexte <span>facultatif</span></summary>
                  <label for="aiContext">Notes, brief, extrait ou contraintes à analyser</label>
                  <textarea id="aiContext" name="context" rows="4" maxlength="20000" placeholder="Colle ici les informations que l’agent doit traiter comme source de travail."></textarea>
                </details>
                <div class="ai-form-footer">
                  <p><span aria-hidden="true">⌾</span> Division en pause · 0 crédit IA</p>
                  <button class="primary-button" id="runAiMission" type="submit" disabled>Division en pause</button>
                </div>
              </form>

              <aside class="ai-output" id="aiOutput" data-state="empty" aria-live="polite">
                <div class="ai-output-empty" id="aiOutputEmpty">
                  <span aria-hidden="true">✦</span>
                  <h3>Les missions sont temporairement suspendues.</h3>
                  <p>Le studio restera inactif jusqu’à ta réactivation volontaire.</p>
                </div>
                <div class="ai-output-result" id="aiOutputResult" hidden>
                  <header><span><small id="aiOutputAgent">Olympe</small><strong>Livrable interne</strong></span><em id="aiOutputMeta">GPT-5.6 Sol</em></header>
                  <div class="ai-output-text" id="aiOutputText"></div>
                  <div class="ai-output-sources" id="aiOutputSources" hidden><strong>Sources consultées</strong><ul></ul></div>
                </div>
              </aside>
            </div>

            <div class="ai-auth-card" id="aiAuthCard" hidden>
              <div><span aria-hidden="true">⌁</span><p><strong>Connexion administrateur requise</strong><small>La clé OpenAI reste côté serveur. Connecte-toi pour autoriser les appels privés.</small></p></div>
              <form id="aiLoginForm">
                <label for="aiAdminPassword">Mot de passe administrateur</label>
                <input id="aiAdminPassword" name="password" type="password" autocomplete="current-password" required />
                <button type="submit">Connecter le studio IA</button>
              </form>
              <p class="ai-auth-error" id="aiAuthError" role="alert"></p>
            </div>
          </section>

          <section class="panel catalog-panel" id="productCatalog" aria-labelledby="catalogTitle">
            <div class="catalog-heading">
              <div>
                <div class="section-kicker">Source de vérité commerciale · MVP</div>
                <h2 id="catalogTitle">Le catalogue de Numa tient en deux offres.</h2>
                <p>Ce référentiel empêchera les agents d’inventer une offre ou d’envoyer un lecteur vers un parcours qui n’existe pas.</p>
              </div>
              <div class="catalog-owner">
                <span class="catalog-owner-avatar" aria-hidden="true"></span>
                <span><small>Responsable du catalogue</small><strong>Numa</strong><em>Offres &amp; conversion</em></span>
              </div>
            </div>

            <div class="offer-grid">
              {offers.map((offer) => (
                <article class="offer-card" data-offer-state="draft">
                  <div class="offer-topline">
                    <span>{offer.number}</span>
                    <small data-catalog-status>À valider</small>
                  </div>
                  <div class="offer-identity">
                    <span>{offer.type}</span>
                    <h3>{offer.name}</h3>
                    <p>{offer.action}</p>
                  </div>
                  <dl>
                    <div><dt>URL canonique</dt><dd><a href={offer.url} target="_blank" rel="noreferrer">{offer.path}<span aria-hidden="true">↗</span></a></dd></div>
                    <div><dt>Audience</dt><dd>À définir plus tard</dd></div>
                    <div><dt>Promesse</dt><dd>À définir plus tard</dd></div>
                  </dl>
                </article>
              ))}
            </div>

            <footer class="catalog-validation" id="catalogValidation" data-state="draft">
              <p><strong id="catalogState">Catalogue non validé</strong><span>Numa connaît les deux destinations, mais aucune association mot-clé → offre ne sera activée pour l’instant.</span></p>
              <button id="validateProductCatalog" type="button">Valider ces 2 offres pour le MVP <span>→</span></button>
            </footer>
          </section>

          <section class="panel autonomy-panel" aria-labelledby="autonomyTitle">
            <div class="autonomy-heading">
              <div>
                <div class="section-kicker"><span class="live-dot"></span> Moteur autonome · MVP</div>
                <h2 id="autonomyTitle">Le travail commence avant ton arrivée.</h2>
                <p>À terme, la division scannera les opportunités, préparera les dossiers et signalera les contenus à mettre à jour sans attendre un prompt.</p>
              </div>
              <span class="autonomy-state">En pause · 0 crédit</span>
            </div>
            <div class="autonomy-grid">
              <article><small>Zone verte</small><strong>Analyser &amp; préparer</strong><span>Automatique, sans effet externe</span></article>
              <article><small>Zone orange</small><strong>Modifier le site</strong><span>Validation humaine requise</span></article>
              <article><small>Zone rouge</small><strong>Publier</strong><span>Double confirmation de Sonny</span></article>
              <article><small>Dépense IA</small><strong>0 crédit</strong><span>Appels OpenAI bloqués côté serveur</span></article>
            </div>
          </section>

          <section class="panel pipeline-panel" id="articlePipeline" aria-labelledby="pipelineTitle">
            <div class="panel-heading">
              <div>
                <div class="section-kicker">Premier vol · Article SEO</div>
                <h2 id="pipelineTitle">Un article, huit contrôles visibles.</h2>
                <p>Chaque étape possède un responsable et une sortie vérifiable. La publication reste la dernière décision humaine.</p>
              </div>
              <span class="state-pill">Prêt à démarrer</span>
            </div>
            <div class="pipeline-track" id="pipelineTrack">
              {pipeline.map(([number, title, owner, state]) => (
                <article data-stage-state={state}>
                  <span>{number}</span>
                  <strong>{title}</strong>
                  <small>{owner}</small>
                </article>
              ))}
            </div>
            <div class="pipeline-brief">
              <article><small>Entrée</small><strong>Opportunité sémantique validée</strong><span>Intention, potentiel, difficulté et lien commercial.</span></article>
              <article><small>Sortie</small><strong>Article utile, fiable et distribuable</strong><span>Optimisé pour les humains, Google et les moteurs de réponse.</span></article>
              <article><small>Dernier verrou</small><strong>Validation de Sonny</strong><span>Publication impossible sans action explicite.</span></article>
            </div>
          </section>

          <section class="panel mission-panel" id="missionRoom" aria-labelledby="missionTitle">
            <div class="panel-heading">
              <div>
                <div class="section-kicker">Salle des missions</div>
                <h2 id="missionTitle">Le premier backlog de la division.</h2>
                <p>Des missions concrètes, ordonnées par dépendances et valeur potentielle.</p>
              </div>
              <span class="state-pill">4 missions</span>
            </div>
            <div class="mission-grid">
              {missions.map((mission) => (
                <article class="mission-card">
                  <div class="mission-topline"><span>{mission.priority}</span><small>{mission.state}</small></div>
                  <p>Mission pilotée par <strong>{mission.owner}</strong></p>
                  <h3>{mission.title}</h3>
                  <p>{mission.description}</p>
                  <div class="mission-output"><small>Livrable attendu</small><strong>{mission.evidence}</strong></div>
                  <button type="button" data-ai-mission={mission.title} data-ai-agent-id={mission.agentId}>Confier à {mission.owner} <span>→</span></button>
                </article>
              ))}
            </div>
          </section>

          <section class="department-bottom-grid">
            <article class="panel compact-panel">
              <div class="section-kicker">Visibilité IA</div>
              <h2>Être cité avant d’être vendu.</h2>
              <p>Lyra suivra un panel de questions, les marques citées, les sources utilisées et les pages de Sonny recommandées.</p>
              <ul>
                <li><span>ChatGPT</span><strong>À connecter</strong></li>
                <li><span>Gemini &amp; Google AI</span><strong>À connecter</strong></li>
                <li><span>Claude &amp; Copilot</span><strong>À connecter</strong></li>
              </ul>
            </article>
            <article class="panel compact-panel">
              <div class="section-kicker">Journal de bord</div>
              <h2>Chaque décision reste traçable.</h2>
              <div class="activity-list">
                <p><i>OL</i><span><strong>Olympe a structuré l’équipe</strong><small>8 responsabilités sans doublon.</small></span><time>maintenant</time></p>
                <p><i>BA</i><span><strong>Basile a accès à la recherche web</strong><small>Les volumes propriétaires restent à connecter.</small></span><time>-1 min</time></p>
                <p><i>AI</i><span><strong>GPT-5.6 Sol est le moteur unique</strong><small>8 mandats spécialisés, aucune publication.</small></span><time>-2 min</time></p>
              </div>
            </article>
          </section>
        </section>
      </main>
    </div>

    <div class="seo-toast" id="seoToast" role="status" aria-live="polite"></div>

    <script>
      const validatorView = document.getElementById('validatorView');
      const departmentView = document.getElementById('departmentView');
      const toast = document.getElementById('seoToast');
      const SEO_AGENT_API = '/.netlify/functions/seo-agent';
      const ADMIN_LOGIN_API = '/.netlify/functions/admin-es2-login';
      const SEO_AGENTS_PAUSED = true;
      let activeAiAgentId = 'olympe';
      let aiReady = false;

      function showValidator() {
        validatorView.hidden = false;
        departmentView.hidden = true;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function showDepartment(targetId) {
        validatorView.hidden = true;
        departmentView.hidden = false;
        requestAnimationFrame(() => {
          const target = targetId ? document.getElementById(targetId) : departmentView;
          target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      function notify(message) {
        if (!toast) return;
        toast.textContent = message;
        toast.classList.add('is-visible');
        window.clearTimeout(window.seoToastTimer);
        window.seoToastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 2600);
      }

      document.getElementById('openDepartmentButton')?.addEventListener('click', () => showDepartment());
      document.getElementById('backToValidatorButton')?.addEventListener('click', showValidator);
      document.getElementById('validatorModeButton')?.addEventListener('click', showValidator);

      document.querySelectorAll('[data-open-target]').forEach((button) => {
        button.addEventListener('click', () => showDepartment(button.dataset.openTarget));
      });

      document.querySelectorAll('.agent-card').forEach((card) => {
        card.addEventListener('click', () => {
          document.querySelectorAll('.agent-card').forEach((candidate) => {
            candidate.setAttribute('aria-pressed', String(candidate === card));
          });
          const focus = document.getElementById('agentFocus');
          focus.dataset.color = card.dataset.color;
          document.getElementById('focusDivision').textContent = card.dataset.division;
          document.getElementById('focusName').textContent = card.dataset.name;
          document.getElementById('focusRole').textContent = card.dataset.role;
          document.getElementById('focusState').textContent = card.dataset.stateLabel;
          document.getElementById('focusTask').textContent = card.dataset.task;
          const progress = Math.max(0, Math.min(100, Number(card.dataset.progress) || 0));
          document.getElementById('focusProgressValue').textContent = `${progress} %`;
          document.getElementById('focusProgressBar').style.width = `${progress}%`;
          selectAiAgent(card.dataset.agent);
        });
      });

      function setAiConnectionState(state, label) {
        const card = document.getElementById('aiModelCard');
        const topStatus = document.getElementById('openAiTopStatus');
        card.dataset.state = state;
        topStatus.dataset.state = state;
        document.getElementById('aiConnectionLabel').textContent = label;
        const dot = document.createElement('i');
        topStatus.replaceChildren(dot, document.createTextNode(`GPT-5.6 Sol · ${state === 'ready' ? 'connecté' : label}`));
        aiReady = state === 'ready';
        document.getElementById('runAiMission').disabled = !aiReady;
      }

      function selectAiAgent(agentId) {
        const button = document.querySelector(`[data-ai-agent="${agentId}"]`);
        if (!button) return;
        activeAiAgentId = agentId;
        document.querySelectorAll('[data-ai-agent]').forEach((candidate) => {
          candidate.setAttribute('aria-pressed', String(candidate === button));
        });
        document.getElementById('aiSelectedName').textContent = button.dataset.agentName;
        document.getElementById('aiSelectedRole').textContent = button.dataset.agentRole;
        document.getElementById('aiOutputAgent').textContent = button.dataset.agentName;
        document.getElementById('aiToolState').textContent = `Raisonnement ${button.dataset.agentReasoning.toLowerCase()} · ${button.dataset.agentResearch === 'true' ? 'Recherche web autorisée' : 'Sources internes'}`;
        const imageValue = button.querySelector('span')?.style.getPropertyValue('--agent-image');
        if (imageValue) document.getElementById('aiSelectedAvatar').style.setProperty('--agent-image', imageValue);
      }

      function showAiAuth(message = '') {
        document.getElementById('aiAuthCard').hidden = false;
        document.getElementById('aiAuthError').textContent = message;
        setAiConnectionState('locked', 'connexion requise');
      }

      async function checkAiConnection() {
        setAiConnectionState('checking', 'vérification…');
        try {
          const response = await fetch(SEO_AGENT_API, { credentials: 'same-origin' });
          const data = await response.json().catch(() => ({}));
          if (response.status === 401) {
            showAiAuth();
            return;
          }
          if (data.paused) {
            document.getElementById('aiAuthCard').hidden = true;
            setAiConnectionState('paused', 'en pause · 0 crédit');
            return;
          }
          if (!response.ok || !data.ready) {
            document.getElementById('aiAuthCard').hidden = true;
            setAiConnectionState('error', data.error || 'indisponible');
            return;
          }
          document.getElementById('aiAuthCard').hidden = true;
          setAiConnectionState('ready', 'connecté · 8 agents prêts');
        } catch {
          document.getElementById('aiAuthCard').hidden = true;
          setAiConnectionState('local', 'preview Netlify requise');
        }
      }

      function renderAiResult(data) {
        const sourcesBox = document.getElementById('aiOutputSources');
        const sourcesList = sourcesBox.querySelector('ul');
        document.getElementById('aiOutput').dataset.state = 'complete';
        document.getElementById('aiOutputEmpty').hidden = true;
        document.getElementById('aiOutputResult').hidden = false;
        document.getElementById('aiOutputAgent').textContent = data.agent?.name || 'Agent SEO';
        document.getElementById('aiOutputText').textContent = data.answer || '';
        const totalTokens = Number(data.usage?.totalTokens || 0);
        document.getElementById('aiOutputMeta').textContent = `${data.model || 'GPT-5.6 Sol'}${totalTokens ? ` · ${totalTokens.toLocaleString('fr-FR')} tokens` : ''}`;
        sourcesList.replaceChildren();
        (data.sources || []).forEach((source) => {
          try {
            const url = new URL(source.url);
            if (!['http:', 'https:'].includes(url.protocol)) return;
            const item = document.createElement('li');
            const link = document.createElement('a');
            link.href = url.href;
            link.target = '_blank';
            link.rel = 'noreferrer';
            link.textContent = source.title || url.hostname;
            item.append(link);
            sourcesList.append(item);
          } catch {}
        });
        sourcesBox.hidden = !sourcesList.children.length;
      }

      function renderAiError(message) {
        document.getElementById('aiOutput').dataset.state = 'error';
        document.getElementById('aiOutputEmpty').hidden = true;
        document.getElementById('aiOutputResult').hidden = false;
        document.getElementById('aiOutputAgent').textContent = 'Mission interrompue';
        document.getElementById('aiOutputMeta').textContent = 'Aucun contenu publié';
        document.getElementById('aiOutputText').textContent = message;
        document.getElementById('aiOutputSources').hidden = true;
      }

      document.querySelectorAll('[data-ai-agent]').forEach((button) => {
        button.addEventListener('click', () => selectAiAgent(button.dataset.aiAgent));
      });

      document.getElementById('launchSeoCycle')?.addEventListener('click', () => {
        selectAiAgent('basile');
        document.getElementById('aiMission').value = 'Construis le plan de la première cartographie sémantique française autour du subconscient, de la manifestation et de la transformation personnelle. Commence par définir la méthode, les familles d’intentions et les preuves nécessaires. N’invente aucun volume de recherche.';
        showDepartment('aiStudio');
        window.setTimeout(() => document.getElementById('aiMission').focus(), 500);
      });

      document.querySelectorAll('[data-ai-mission]').forEach((button) => {
        button.addEventListener('click', () => {
          selectAiAgent(button.dataset.aiAgentId);
          document.getElementById('aiMission').value = button.dataset.aiMission;
          showDepartment('aiStudio');
          window.setTimeout(() => document.getElementById('aiMission').focus(), 500);
        });
      });

      document.getElementById('aiLoginForm')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (SEO_AGENTS_PAUSED) {
          notify('Division SEO en pause : aucun appel OpenAI autorisé.');
          return;
        }
        const form = event.currentTarget;
        const button = form.querySelector('button');
        const password = document.getElementById('aiAdminPassword').value;
        document.getElementById('aiAuthError').textContent = '';
        button.disabled = true;
        button.textContent = 'Connexion…';
        try {
          const response = await fetch(ADMIN_LOGIN_API, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password }),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || 'Connexion refusée');
          document.getElementById('aiAdminPassword').value = '';
          await checkAiConnection();
          notify('Studio GPT-5.6 Sol connecté.');
        } catch (error) {
          document.getElementById('aiAuthError').textContent = error.message || 'Connexion impossible';
        } finally {
          button.disabled = false;
          button.textContent = 'Connecter le studio IA';
        }
      });

      document.getElementById('aiMissionForm')?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (SEO_AGENTS_PAUSED) {
          notify('Division SEO en pause : aucun crédit IA ne sera dépensé.');
          return;
        }
        if (!aiReady) {
          showAiAuth('Connecte-toi avant de lancer une mission.');
          return;
        }
        const mission = document.getElementById('aiMission').value.trim();
        const context = document.getElementById('aiContext').value.trim();
        if (!mission) return;
        const button = document.getElementById('runAiMission');
        button.disabled = true;
        button.textContent = 'GPT-5.6 Sol travaille…';
        document.getElementById('aiOutput').dataset.state = 'loading';
        document.getElementById('aiOutputEmpty').hidden = false;
        document.getElementById('aiOutputEmpty').querySelector('h3').textContent = 'Mission en cours…';
        document.getElementById('aiOutputEmpty').querySelector('p').textContent = 'L’agent analyse la demande et prépare un livrable vérifiable.';
        document.getElementById('aiOutputResult').hidden = true;
        try {
          const response = await fetch(SEO_AGENT_API, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ agentId: activeAiAgentId, mission, context }),
          });
          const data = await response.json().catch(() => ({}));
          if (response.status === 401) {
            showAiAuth('Ta session a expiré. Reconnecte-toi.');
            throw new Error('Connexion administrateur requise.');
          }
          if (!response.ok) throw new Error(data.error || 'La mission a échoué.');
          renderAiResult(data);
          notify(`${data.agent?.name || 'L’agent'} a terminé son livrable.`);
        } catch (error) {
          renderAiError(error.message || 'La mission n’a pas pu être terminée.');
        } finally {
          button.disabled = !aiReady;
          button.textContent = 'Lancer la mission';
        }
      });

      document.getElementById('validateProductCatalog')?.addEventListener('click', (event) => {
        const button = event.currentTarget;
        document.getElementById('catalogValidation').dataset.state = 'validated';
        document.getElementById('catalogState').textContent = 'Catalogue MVP validé';
        document.querySelectorAll('[data-catalog-status]').forEach((status) => {
          status.textContent = 'Validée dans le MVP';
        });
        document.querySelectorAll('.offer-card').forEach((card) => {
          card.dataset.offerState = 'validated';
        });
        button.textContent = 'Catalogue MVP validé ✓';
        button.disabled = true;
        notify('Numa dispose maintenant de 2 offres validées dans ce prototype.');
      });

      selectAiAgent('olympe');
      if (SEO_AGENTS_PAUSED) {
        document.getElementById('aiAuthCard').hidden = true;
        setAiConnectionState('paused', 'en pause · 0 crédit');
        document.getElementById('runAiMission').textContent = 'Division en pause';
      } else {
        checkAiConnection();
      }
    </script>
  </body>
</html>
