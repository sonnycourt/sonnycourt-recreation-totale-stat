---
const packs = [
  { count: 1, unit: 47, total: 47, title: 'Une belle attention.', subtitle: 'Pour cette personne à qui tu penses.', label: 'Offrir une expérience' },
  { count: 3, unit: 27, total: 81, title: 'Un cercle plus proche.', subtitle: 'Pour ceux avec qui tu veux partager.', label: 'Offrir 3 expériences' },
  { count: 5, unit: 17, total: 85, title: 'Une onde qui se propage.', subtitle: 'Pour faire voyager l’expérience.', label: 'Offrir 5 expériences' },
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Offrir Delta Vision — Une expérience à partager</title>
    <meta name="description" content="Offre Delta Vision à quelqu’un qui compte. Une leçon pour comprendre et une séance guidée de 15 minutes pour vivre l’expérience." />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <svg class="symbols" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <symbol id="mark" viewBox="0 0 48 48"><path d="M32 19 24 5 4 40h40l-6-10" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/><path d="m25 18 2.4 6.6L34 27l-6.6 2.4L25 36l-2.4-6.6L16 27l6.6-2.4Z" fill="currentColor"/></symbol>
      <symbol id="arrow" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="gift" viewBox="0 0 32 32"><path d="M5 15h22v13H5zm-2-6h26v6H3zm13 0v19M16 9C6 10 6 2 10 3c3 0 6 6 6 6Zm0 0c10 1 10-7 6-6-3 0-6 6-6 6Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></symbol>
    </svg>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="wrap header">
      <a class="brand" href="/delta-vision/" aria-label="Delta Vision, la méthode"><svg><use href="#mark" /></svg><span>Delta<br />Vision</span></a>
      <span class="header-note">UNE EXPÉRIENCE À PARTAGER</span>
      <a class="header-link" href="#cadeaux">Offrir <svg><use href="#arrow" /></svg></a>
    </header>
    <main id="contenu">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> POUR QUELQU’UN QUI COMPTE</p>
          <h1 id="hero-title">Tu l’as vécu.<br /><em>Et si tu l’offrais ?</em></h1>
          <p class="intro">Certains cadeaux se déballent.<br />Celui-ci se vit, les yeux fermés.</p>
          <p class="hero-description">Fais découvrir Delta Vision à tes proches. Une respiration, une vision, un moment rien qu’à eux.</p>
          <a class="button primary" href="#cadeaux">Choisir mes cadeaux <svg><use href="#arrow" /></svg></a>
          <p class="hero-footnote">1, 3 ou 5 expériences à offrir.</p>
        </div>
        <div class="gift-scene">
          <div class="scene-halo" aria-hidden="true"></div>
          <div class="gift-card">
            <div class="gift-photo"><img src="/media/pages/inspira-vsl-jungle-v2.webp" alt="Sonny, assis en méditation dans une jungle baignée de lumière." width="1672" height="941" fetchpriority="high" /></div>
            <div class="gift-caption"><div><span class="eyebrow">UNE INVITATION À</span><strong>un autre horizon.</strong></div><svg><use href="#mark" /></svg></div>
          </div>
          <img class="canopy" src="/media/pages/delta-jungle-canopy-v1.webp" alt="" width="1200" height="800" aria-hidden="true" />
          <div class="gift-tag"><svg><use href="#gift" /></svg><span>Pour toi.<br /><em>De ma part.</em></span></div>
          <span class="scene-signature">Une attention. Une nouvelle perspective.</span>
        </div>
      </section>

      <section class="included wrap" aria-label="Ce que contient chaque cadeau">
        <p>Le même cadeau.<br /><em>Toute l’expérience.</em></p>
        <div><span class="small-number">01</span><span>La leçon théorique<small>Pour comprendre la méthode.</small></span></div>
        <div><span class="small-number">02</span><span>La vidéo guidée de 15 minutes<small>Pour respirer ensemble et vivre son souhait.</small></span></div>
      </section>

      <section class="packs wrap" id="cadeaux" aria-labelledby="packs-title">
        <div class="section-heading"><p class="eyebrow">LES CADEAUX DELTA VISION</p><h2 id="packs-title">À qui as-tu <em>pensé ?</em></h2><p>Une personne. Quelques proches. Tout ton petit cercle.<br />Choisis combien d’expériences tu veux offrir.</p></div>
        <div class="pack-grid">
          {packs.map(pack => (
            <article class:list={['pack', { 'pack-featured': pack.count === 5 }]}>
              <div class="pack-top"><span class="eyebrow">{pack.count === 1 ? 'UNE PERSONNE' : `${pack.count} PERSONNES`}</span><svg aria-hidden="true"><use href="#gift" /></svg></div>
              <h3>{pack.title}</h3><p class="pack-subtitle">{pack.subtitle}</p>
              <div class="pack-price"><strong>{pack.unit}<span> €</span></strong><span>par cadeau</span></div>
              <p class="pack-total">{pack.count} {pack.count === 1 ? 'cadeau' : 'cadeaux'} · <strong>{pack.total} € au total</strong></p>
              <div class="pack-details"><span>La méthode complète pour chaque proche</span><span>Une invitation personnelle par email</span><span>Les destinataires à choisir à ton rythme</span></div>
              <button class:list={['button', pack.count === 5 ? 'primary' : 'outline']} type="button" data-pack={pack.count} data-total={pack.total}>{pack.label}<svg aria-hidden="true"><use href="#arrow" /></svg></button>
            </article>
          ))}
        </div>
        <p class="pack-note">Un cadeau = un accès personnel à Delta Vision. Aucun abonnement.</p>
      </section>

      <section class="journey" aria-labelledby="journey-title">
        <div class="wrap journey-inner">
          <div class="journey-heading"><p class="eyebrow">DE TOI À EUX</p><h2 id="journey-title">Tu offres l’invitation.<br /><em>Ils vivent l’expérience.</em></h2><p>Pas besoin de tout expliquer.<br />La découverte fait aussi partie du cadeau.</p><svg class="journey-mark" aria-hidden="true"><use href="#mark" /></svg></div>
          <ol class="steps">
            <li><span>01</span><div><h3>Tu choisis tes cadeaux.</h3><p>Un pack, puis les adresses email des personnes à qui tu souhaites l’offrir. Tu pourras aussi les renseigner plus tard.</p></div></li>
            <li><span>02</span><div><h3>Ils reçoivent ton invitation.</h3><p>Un email personnel les invite à découvrir Delta Vision. La vidéo leur présente l’expérience que tu as choisie pour eux.</p></div></li>
            <li><span>03</span><div><h3>Leur voyage commence.</h3><p>Leur cadeau est déjà payé. Ils activent leur accès personnel, puis découvrent la méthode et leur première séance.</p></div></li>
          </ol>
        </div>
      </section>

      <section class="questions wrap" aria-labelledby="questions-title">
        <div><p class="eyebrow">EN TOUTE SIMPLICITÉ</p><h2 id="questions-title">Quelques détails.<br /><em>Et beaucoup d’attention.</em></h2></div>
        <div class="faq">
          <details><summary>Dois-je choisir tous les destinataires maintenant ?<span>+</span></summary><p>Non. Tu choisis ton pack, puis tu offres tes accès à ton rythme. Chaque cadeau est destiné à une personne différente.</p></details>
          <details><summary>Que reçoit exactement mon proche ?<span>+</span></summary><p>Un accès personnel à Delta Vision : la leçon théorique et la vidéo guidée de 15 minutes, à retrouver pour sa pratique.</p></details>
          <details><summary>La personne devra-t-elle payer quelque chose ?<span>+</span></summary><p>Non. Tu as déjà payé son expérience. Son invitation lui permet d’activer le cadeau sans frais supplémentaires.</p></details>
          <details><summary>Faut-il avoir déjà pratiqué pour en profiter ?<span>+</span></summary><p>La leçon présente la méthode avant la séance guidée. Chaque personne devra prendre connaissance des consignes et des contre-indications avant de pratiquer.</p></details>
        </div>
      </section>
      <section class="closing wrap"><svg aria-hidden="true"><use href="#gift" /></svg><h2>Tu sais déjà <em>à qui l’offrir.</em></h2><a class="button primary" href="#cadeaux">Choisir mes cadeaux <svg><use href="#arrow" /></svg></a></section>
    </main>
    <footer class="wrap footer"><a class="brand" href="/delta-vision/"><svg aria-hidden="true"><use href="#mark" /></svg><span>Delta<br />Vision</span></a><span>UNE RESPIRATION. UN AUTRE HORIZON.</span><p>Aperçu · Paiement et invitations non activés.</p></footer>

    <dialog id="gift-preview" aria-labelledby="preview-title" aria-describedby="preview-description">
      <button type="button" class="dialog-close" aria-label="Fermer l’aperçu">×</button>
      <svg class="dialog-icon" aria-hidden="true"><use href="#gift" /></svg>
      <p class="eyebrow">TON ATTENTION PREND FORME</p><h2 id="preview-title">Un cadeau.<br /><em>Tout un possible.</em></h2>
      <div class="selection"><span id="selected-count"></span><strong id="selected-total"></strong></div>
      <p id="preview-description">Ceci est un aperçu de la page cadeau. Le paiement Spiffy et l’envoi des invitations ne sont pas encore raccordés. Aucun achat ne sera effectué.</p>
      <button type="button" class="button primary dialog-return">Revenir aux cadeaux <svg aria-hidden="true"><use href="#arrow" /></svg></button>
    </dialog>
    <script>
      const dialog = document.querySelector<HTMLDialogElement>('#gift-preview');
      const countLabel = document.querySelector('#selected-count');
      const totalLabel = document.querySelector('#selected-total');
      if (dialog && countLabel && totalLabel) {
        document.querySelectorAll<HTMLButtonElement>('[data-pack]').forEach(button => {
          button.addEventListener('click', () => {
            const count = Number(button.dataset.pack);
            countLabel.textContent = `${count} ${count === 1 ? 'cadeau Delta Vision' : 'cadeaux Delta Vision'}`;
            totalLabel.textContent = `${button.dataset.total} €`;
            dialog.showModal();
            document.body.classList.add('dialog-open');
          });
        });
        dialog.querySelectorAll('button').forEach(button => button.addEventListener('click', () => dialog.close()));
        dialog.addEventListener('close', () => document.body.classList.remove('dialog-open'));
        dialog.addEventListener('click', event => { if (event.target === dialog) {
          const r = dialog.getBoundingClientRect();
          if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) dialog.close();
        }});
      }
    </script>
  </body>
</html>

<style is:global>
  @font-face{font-family:Delta Inter;src:url('/fonts/inter-latin.woff2') format('woff2');font-style:normal;font-weight:100 900;font-display:swap}
  :root{--paper:#faf8f4;--ink:#292923;--muted:#77756d;--coral:#b34f39;--line:#e4dfd7;--serif:Georgia,'Times New Roman',serif}
  *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:32px}body{margin:0;background:var(--paper);color:var(--ink);font-family:'Delta Inter',Arial,sans-serif;-webkit-font-smoothing:antialiased}.dialog-open{overflow:hidden}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}button,a,summary{-webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid var(--coral);outline-offset:5px}svg{display:block;flex-shrink:0;width:24px;height:24px}p,h1,h2,h3{margin:0}em{font-family:var(--serif);font-weight:400}::selection{background:#f0c9b6}.wrap{width:min(1200px,calc(100% - 96px));margin-inline:auto}.symbols{position:absolute;width:0;height:0;overflow:hidden}.skip{position:fixed;top:-100px;left:16px;z-index:20;background:var(--ink);color:white;padding:12px}.skip:focus{top:12px}.eyebrow{font-size:10px;letter-spacing:2px;line-height:1.7;font-weight:600;color:var(--muted)}
  .header{height:106px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:11px}.brand svg{width:44px;height:44px;color:var(--coral)}.brand span{font-size:14px;letter-spacing:2px;text-transform:uppercase;line-height:1.3;font-weight:500}.header-note{font-size:9px;letter-spacing:2px;color:var(--muted)}.header-link{display:flex;align-items:center;gap:25px;font-size:12px;border-bottom:1px solid #bab5a9;padding-block:8px}
  .hero{display:grid;grid-template-columns:1fr 1fr;gap:35px;align-items:center;padding-block:87px 99px}.hero-copy{position:relative;z-index:2}.hero .eyebrow{display:flex;align-items:center;gap:9px}.hero .eyebrow>span{width:5px;height:5px;border-radius:50%;background:var(--coral)}h1{font-size:clamp(44px,4.7vw,68px);font-weight:450;line-height:1.08;letter-spacing:-2.9px;margin:24px 0}h1 em{color:var(--coral);white-space:nowrap}.intro{font-size:19px;line-height:1.7;letter-spacing:-.4px}.hero-description{font-size:14px;line-height:1.9;color:var(--muted);max-width:355px;margin-top:16px}.button{display:inline-flex;align-items:center;justify-content:center;gap:25px;min-height:54px;padding:16px 23px;border-radius:50px;border:1px solid transparent;font-size:12px;font-weight:550;transition:background .2s,transform .2s}.button svg{width:20px;height:20px}.primary{background:var(--coral);color:white}.primary:hover{background:#973e2b;transform:translateY(-2px)}.hero .button{margin-top:29px}.hero-footnote{font-size:10px;color:var(--muted);margin:15px 0 0 7px}
  .gift-scene{position:relative;isolation:isolate;padding:35px 10px 40px 15px;margin-top:16px}.scene-halo{position:absolute;z-index:-1;inset:-80px -35px;background:radial-gradient(ellipse,#c5c7a868,transparent 69%)}.gift-card{transform:rotate(-5deg);border:7px solid #fffcf6;border-radius:12px;background:#fffcf6;box-shadow:0 25px 55px -22px #34402966;overflow:hidden}.gift-photo{aspect-ratio:1.48;overflow:hidden;border-radius:6px}.gift-photo img{width:100%;height:100%;object-fit:cover;object-position:50% 50%;display:block}.gift-caption{display:flex;justify-content:space-between;align-items:center;padding:22px 20px 18px}.gift-caption .eyebrow{font-size:8px;letter-spacing:2px}.gift-caption strong{display:block;font-family:var(--serif);font-style:italic;font-size:28px;font-weight:400;color:#5b634b;margin-top:6px}.gift-caption svg{width:37px;height:37px;color:var(--coral)}.canopy{position:absolute;z-index:2;right:-34px;top:-69px;width:62%;height:auto;pointer-events:none;filter:drop-shadow(0 11px 8px #28332026)}.gift-tag{position:absolute;z-index:3;right:-10px;bottom:12px;display:flex;align-items:center;gap:15px;background:#f0e6d8;border:1px solid #ded3c2;padding:21px 26px;transform:rotate(6deg);box-shadow:0 12px 35px -20px #49443666;border-radius:3px}.gift-tag svg{width:32px;height:32px;color:var(--coral)}.gift-tag span{font-size:11px;line-height:1.7}.gift-tag em{font-size:21px}.scene-signature{display:block;font-family:var(--serif);font-style:italic;font-size:15px;color:#8b8576;transform:rotate(-5deg);margin:27px 0 0 22px}
  .included{display:grid;grid-template-columns:1fr 1.1fr 1.3fr;gap:25px;align-items:center;border-block:1px solid var(--line);padding-block:30px}.included>p{font-size:14px;line-height:1.55}.included>p em{font-size:20px;color:var(--coral)}.included>div{display:flex;gap:17px;align-items:center}.small-number{font-family:var(--serif);font-size:24px;color:#a69881}.included>div>span:last-child{font-size:13px;line-height:1.6}.included small{display:block;color:var(--muted);font-size:11px;margin-top:3px}
  .packs{padding-block:91px 80px}.section-heading{text-align:center}h2{font-size:clamp(32px,3.4vw,46px);letter-spacing:-1.8px;line-height:1.17;font-weight:450}h2 em{color:var(--coral)}.section-heading h2{margin:16px 0}.section-heading>p:last-child{font-size:14px;line-height:1.9;color:var(--muted)}.pack-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:19px;margin-top:42px}.pack{border:1px solid var(--line);border-radius:18px;padding:27px;background:#fefcf8;display:flex;flex-direction:column}.pack-featured{background:#f1ede3;border-color:#c6b397;box-shadow:0 14px 40px -32px #63523666}.pack-top{display:flex;justify-content:space-between;align-items:center}.pack-top .eyebrow{font-size:9px;letter-spacing:1.6px}.pack-top svg{width:29px;height:29px;color:var(--coral)}.pack h3{font-family:var(--serif);font-weight:400;font-size:25px;letter-spacing:-.7px;line-height:1.2;margin-top:28px}.pack-subtitle{font-size:11px;line-height:1.6;color:var(--muted);margin-top:8px}.pack-price{margin-top:27px;display:flex;align-items:baseline;gap:12px}.pack-price>strong{font-size:62px;line-height:1.1;letter-spacing:-3px;font-weight:450;color:var(--coral)}.pack-price>strong>span{font-size:29px;letter-spacing:-1px}.pack-price>span{font-size:11px;color:var(--muted)}.pack-total{font-size:11px;margin-top:8px;color:var(--muted)}.pack-total strong{font-weight:500;color:var(--ink)}.pack-details{display:grid;gap:12px;border-top:1px solid var(--line);padding-top:24px;margin-block:24px 30px}.pack-details span{font-size:11px;line-height:1.6;display:flex;gap:9px}.pack-details span:before{content:'✓';color:#767f62}.pack .button{width:100%;margin-top:auto;gap:12px;font-size:11px;padding-inline:13px}.outline{background:transparent;border-color:#c9c1b2;color:var(--ink)}.outline:hover{background:#f1ece4;transform:translateY(-2px)}.pack-note{text-align:center;color:var(--muted);font-size:10px;line-height:1.7;margin-top:23px}
  .journey{background:#303b30;color:#f8f4e9;position:relative;overflow:hidden}.journey:after{content:'';position:absolute;width:440px;height:440px;border-radius:50%;border:1px solid #ffffff08;left:-200px;bottom:-230px;box-shadow:0 0 0 55px #ffffff03,0 0 0 110px #ffffff02;pointer-events:none}.journey-inner{display:grid;grid-template-columns:1fr 1fr;gap:100px;padding-block:73px}.journey .eyebrow{color:#bfc5af}.journey h2{font-size:40px;margin:23px 0}.journey h2 em{color:#d5c5a6}.journey-heading>p:last-of-type{font-size:13px;line-height:1.9;color:#c3c7bc}.journey-mark{width:55px;height:55px;color:#a4ae8f;margin-top:39px}.steps{list-style:none;margin:0;padding:0}.steps li{display:flex;gap:25px;padding-block:25px;border-bottom:1px solid #c5cab52e}.steps li:first-child{padding-top:0}.steps li:last-child{padding-bottom:0;border:0}.steps li>span{font-family:var(--serif);font-size:24px;color:#b9ba97;margin-top:2px}.steps h3{font-size:18px;font-weight:450;letter-spacing:-.4px}.steps p{font-size:12px;line-height:1.9;color:#c3c7bc;margin-top:12px}
  .questions{display:grid;grid-template-columns:1fr 1.1fr;gap:80px;padding-block:87px;border-bottom:1px solid var(--line)}.questions h2{font-size:32px;margin-top:19px}.faq details{border-bottom:1px solid var(--line)}.faq details:first-child{border-top:1px solid var(--line)}.faq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:20px;padding:23px 0;font-size:13px;line-height:1.6}.faq summary::-webkit-details-marker{display:none}.faq summary span{color:var(--coral);font-size:22px;font-weight:300}.faq details[open] summary span{transform:rotate(45deg)}.faq details p{font-size:12px;color:var(--muted);line-height:1.9;padding:0 25px 23px 0}.closing{text-align:center;padding-block:68px}.closing>svg{margin:0 auto 23px;width:35px;height:35px;color:var(--coral)}.closing h2{font-size:36px}.closing .button{margin-top:28px}.footer{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-block:27px;border-top:1px solid var(--line)}.footer .brand svg{width:32px;height:32px}.footer .brand span{font-size:10px}.footer>span{font-size:8px;letter-spacing:1.7px;color:var(--muted)}.footer>p{font-size:9px;line-height:1.7;color:var(--muted)}
  dialog{border:1px solid var(--line);border-radius:22px;background:var(--paper);color:var(--ink);padding:45px;width:min(510px,calc(100% - 32px));max-height:calc(100dvh - 40px);overflow:auto;box-shadow:0 30px 100px #0003}dialog::backdrop{background:#18241988;backdrop-filter:blur(7px)}.dialog-close{position:absolute;right:17px;top:12px;width:36px;height:36px;background:transparent;border:0;color:var(--muted);font-size:29px}.dialog-icon{width:39px;height:39px;color:var(--coral);margin-bottom:24px}dialog h2{font-size:38px;margin-top:15px}.selection{display:flex;align-items:center;justify-content:space-between;border-block:1px solid var(--line);padding-block:20px;margin-block:25px;gap:15px;font-size:14px}.selection strong{font-size:26px;font-weight:500}#preview-description{font-size:13px;line-height:1.9;color:var(--muted)}.dialog-return{margin-top:25px;width:100%}
