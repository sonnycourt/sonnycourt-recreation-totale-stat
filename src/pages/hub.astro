---
// HUB — point d'entrée central du back-office Sonny Court
// Protégé par la session admin (admin-es2-login), même mot de passe que les pages admin.
// Page autonome : n'importe aucun composant, ne modifie rien d'existant.
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HUB - Sonny Court</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <style>
        :root {
            color-scheme: dark;
            --blue: #007aff;
            --blue-light: #66b5ff;
            --blue-deep: #0051d5;
            --text: #f7fbff;
            --text-soft: rgba(226, 239, 255, 0.66);
            --text-muted: rgba(205, 225, 248, 0.43);
            --glass: rgba(255, 255, 255, 0.068);
            --glass-strong: rgba(255, 255, 255, 0.1);
            --glass-border: rgba(191, 219, 254, 0.16);
            --glass-highlight: rgba(255, 255, 255, 0.2);
            --shadow: 0 30px 80px rgba(0, 5, 18, 0.38);
        }

        * { box-sizing: border-box; }

        html {
            min-height: 100%;
            background: #02050c;
        }

        body {
            min-height: 100vh;
            min-height: 100dvh;
            margin: 0;
            overflow-x: hidden;
            color: var(--text);
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", Inter, sans-serif;
            -webkit-font-smoothing: antialiased;
            background:
                radial-gradient(circle at 51% 5%, rgba(0, 122, 255, 0.24), transparent 27rem),
                radial-gradient(circle at 4% 42%, rgba(45, 154, 255, 0.17), transparent 25rem),
                radial-gradient(circle at 96% 75%, rgba(0, 81, 213, 0.22), transparent 28rem),
                linear-gradient(125deg, #02050c 0%, #061226 42%, #092755 76%, #0b356f 100%);
        }

        body::before,
        body::after {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
        }

        body::before {
            opacity: 0.2;
            background-image:
                linear-gradient(rgba(191, 219, 254, 0.07) 1px, transparent 1px),
                linear-gradient(90deg, rgba(191, 219, 254, 0.07) 1px, transparent 1px);
            background-size: 88px 88px;
            mask-image: radial-gradient(circle at 50% 40%, #000 0%, transparent 72%);
            -webkit-mask-image: radial-gradient(circle at 50% 40%, #000 0%, transparent 72%);
        }

        body::after {
            opacity: 0.58;
            background: linear-gradient(112deg, transparent 24%, rgba(219, 234, 254, 0.07) 49%, transparent 72%);
        }

        button,
        input { font: inherit; }

        button { -webkit-tap-highlight-color: transparent; }

        .login-box {
            width: 100%;
            min-height: 100vh;
            min-height: 100dvh;
            display: grid;
            place-items: center;
            padding: 32px 20px;
        }

        .login-shell {
            width: min(430px, 100%);
            position: relative;
        }

        .login-shell::before {
            content: "";
            position: absolute;
            z-index: -1;
            inset: 18% 8% -9%;
            border-radius: 48px;
            background: rgba(0, 122, 255, 0.26);
            filter: blur(58px);
        }

        .login-card,
        .hub-header,
        .dim {
            border: 1px solid var(--glass-border);
            background:
                radial-gradient(circle at 16% 0%, rgba(255, 255, 255, 0.12), transparent 29%),
                linear-gradient(145deg, rgba(255, 255, 255, 0.095), rgba(255, 255, 255, 0.035));
            box-shadow:
                var(--shadow),
                inset 0 1px 0 var(--glass-highlight),
                inset 0 -1px 0 rgba(96, 165, 250, 0.06);
            backdrop-filter: blur(30px) saturate(155%);
            -webkit-backdrop-filter: blur(30px) saturate(155%);
        }

        .login-card {
            position: relative;
            overflow: hidden;
            padding: 46px 38px 38px;
            text-align: center;
            border-radius: 34px;
            animation: reveal 620ms cubic-bezier(.2, .8, .2, 1) both;
        }

        .login-card::before,
        .hub-header::before,
        .dim::before {
            content: "";
            position: absolute;
            inset: 0 10% auto;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.58), transparent);
            pointer-events: none;
        }

        .login-brand {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 24px;
            padding: 7px 11px;
            border: 1px solid rgba(191, 219, 254, 0.14);
            border-radius: 999px;
            color: rgba(219, 234, 254, 0.68);
            background: rgba(255, 255, 255, 0.045);
            font-size: 11px;
            font-weight: 720;
            letter-spacing: 0.13em;
            text-transform: uppercase;
        }

        .login-brand::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #39d98a;
            box-shadow: 0 0 0 4px rgba(57, 217, 138, 0.09), 0 0 14px rgba(57, 217, 138, 0.55);
        }

        .login-icon {
            width: 70px;
            height: 70px;
            display: grid;
            place-items: center;
            margin: 0 auto 23px;
            border: 1px solid rgba(191, 219, 254, 0.22);
            border-radius: 23px;
            background:
                radial-gradient(circle at 28% 12%, rgba(255, 255, 255, 0.28), transparent 38%),
                linear-gradient(145deg, rgba(60, 157, 255, 0.25), rgba(0, 81, 213, 0.09));
            box-shadow: 0 18px 42px rgba(0, 8, 28, 0.34), inset 0 1px 0 rgba(255, 255, 255, 0.22);
        }

        .login-icon svg {
            width: 31px;
            height: 31px;
            fill: none;
            stroke: rgba(239, 246, 255, 0.94);
            stroke-width: 1.65;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .login-card h1 {
            margin: 0;
            font-size: clamp(36px, 8vw, 48px);
            font-weight: 780;
            line-height: 0.95;
            letter-spacing: -0.055em;
            background: linear-gradient(180deg, #fff 0%, #e3f0ff 52%, #9bc4f5 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .login-subtitle {
            margin: 13px 0 30px;
            color: var(--text-soft);
            font-size: 14px;
            line-height: 1.5;
        }

        .field {
            position: relative;
        }

        .field svg {
            position: absolute;
            top: 50%;
            left: 17px;
            width: 18px;
            height: 18px;
            transform: translateY(-50%);
            fill: none;
            stroke: rgba(191, 219, 254, 0.48);
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
            pointer-events: none;
        }

        .login-card input {
            width: 100%;
            height: 56px;
            padding: 0 18px 0 48px;
            border: 1px solid rgba(191, 219, 254, 0.14);
            border-radius: 17px;
            outline: none;
            color: #fff;
            background: rgba(2, 8, 22, 0.4);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.045);
            font-size: 16px;
            letter-spacing: 0.12em;
            transition: border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
        }

        .login-card input::placeholder {
            color: rgba(191, 219, 254, 0.34);
            letter-spacing: 0;
        }

        .login-card input:focus {
            border-color: rgba(102, 181, 255, 0.72);
            background: rgba(4, 18, 42, 0.54);
            box-shadow: 0 0 0 4px rgba(0, 122, 255, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.06);
        }

        .login-card button {
            width: 100%;
            height: 56px;
            margin-top: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            border: 1px solid rgba(147, 197, 253, 0.36);
            border-radius: 17px;
            color: #fff;
            background:
                radial-gradient(circle at 28% 0%, rgba(255, 255, 255, 0.23), transparent 38%),
                linear-gradient(135deg, #1684ff 0%, #0763df 50%, #074ebd 100%);
            box-shadow: 0 16px 34px rgba(0, 93, 219, 0.31), inset 0 1px 0 rgba(255, 255, 255, 0.22);
            font-size: 15px;
            font-weight: 720;
            cursor: pointer;
            transition: transform 180ms ease, box-shadow 180ms ease;
        }

        .login-card button svg {
            width: 18px;
            height: 18px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: transform 180ms ease;
        }

        .login-card button:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 42px rgba(0, 93, 219, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.28);
        }

        .login-card button:hover svg { transform: translateX(3px); }

        #loginError {
            display: none;
            margin: 15px 0 0;
            color: #ff9b9b;
            font-size: 13px;
            font-weight: 580;
        }

        .hub {
            display: none;
            width: min(1180px, calc(100% - 40px));
            margin: 0 auto;
            padding: 38px 0 72px;
            animation: reveal 520ms cubic-bezier(.2, .8, .2, 1) both;
        }

        .hub-header {
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            margin-bottom: 22px;
            padding: 24px 26px;
            border-radius: 27px;
        }

        .hub-identity {
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .hub-mark {
            flex: 0 0 auto;
            width: 53px;
            height: 53px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(191, 219, 254, 0.2);
            border-radius: 18px;
            background:
                radial-gradient(circle at 30% 10%, rgba(255, 255, 255, 0.25), transparent 38%),
                linear-gradient(145deg, rgba(45, 154, 255, 0.24), rgba(0, 81, 213, 0.08));
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 13px 30px rgba(1, 8, 24, 0.25);
            font-size: 25px;
        }

        .hub-eyebrow {
            margin: 0 0 3px;
            color: rgba(147, 197, 253, 0.7);
            font-size: 10px;
            font-weight: 760;
            letter-spacing: 0.15em;
            text-transform: uppercase;
        }

        .hub-header h1 {
            margin: 0;
            font-size: clamp(25px, 4vw, 34px);
            font-weight: 780;
            line-height: 1;
            letter-spacing: -0.045em;
        }

        .hub-header p:last-child {
            margin: 7px 0 0;
            overflow: hidden;
            color: var(--text-soft);
            font-size: 13px;
            line-height: 1.35;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .logout-btn {
            flex: 0 0 auto;
            min-height: 42px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0 15px;
            border: 1px solid rgba(191, 219, 254, 0.14);
            border-radius: 14px;
            color: rgba(226, 239, 255, 0.67);
            background: rgba(255, 255, 255, 0.045);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
            font-size: 12px;
            font-weight: 650;
            cursor: pointer;
            transition: color 180ms ease, border-color 180ms ease, background 180ms ease, transform 180ms ease;
        }

        .logout-btn svg {
            width: 16px;
            height: 16px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .logout-btn:hover {
            color: #fff;
            border-color: rgba(191, 219, 254, 0.28);
            background: rgba(255, 255, 255, 0.075);
            transform: translateY(-1px);
        }

        .hub-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .dim {
            --accent: #66b5ff;
            position: relative;
            overflow: hidden;
            padding: 20px;
            border-radius: 25px;
        }

        .dim--wide { grid-column: 1 / -1; }
        .dim--closers { --accent: #63e6be; }
        .dim--coachs { --accent: #c4a7ff; }
        .dim--analytics { --accent: #ffcc66; }
        .dim--email { --accent: #ff8e9e; }
        .dim--infra { --accent: #79c6ff; }

        .dim-heading {
            display: flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 15px;
        }

        .dim-icon {
            width: 35px;
            height: 35px;
            display: grid;
            place-items: center;
            border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
            border-radius: 12px;
            background: color-mix(in srgb, var(--accent) 11%, transparent);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
            font-size: 17px;
        }

        .dim h2 {
            margin: 0;
            color: rgba(240, 247, 255, 0.9);
            font-size: 13px;
            font-weight: 760;
            letter-spacing: 0.075em;
            text-transform: uppercase;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .dim--wide .cards {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .card {
            position: relative;
            min-height: 92px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            overflow: hidden;
            padding: 16px 42px 16px 16px;
            border: 1px solid rgba(191, 219, 254, 0.11);
            border-radius: 18px;
            color: #fff;
            background:
                radial-gradient(circle at 12% 0%, rgba(255, 255, 255, 0.08), transparent 35%),
                rgba(2, 10, 25, 0.25);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.055);
            text-decoration: none;
            transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
        }

        a.card::after {
            content: "→";
            position: absolute;
            top: 50%;
            right: 16px;
            color: color-mix(in srgb, var(--accent) 75%, #fff);
            font-size: 17px;
            transform: translateY(-50%);
            transition: transform 180ms ease;
        }

        .card.ext::after { content: "↗"; }

        .card::before {
            content: "";
            position: absolute;
            inset: 12px auto 12px 0;
            width: 2px;
            border-radius: 999px;
            background: var(--accent);
            opacity: 0;
            box-shadow: 0 0 18px color-mix(in srgb, var(--accent) 55%, transparent);
            transition: opacity 180ms ease;
        }

        a.card:hover {
            z-index: 1;
            border-color: color-mix(in srgb, var(--accent) 35%, transparent);
            background:
                radial-gradient(circle at 12% 0%, rgba(255, 255, 255, 0.13), transparent 38%),
                color-mix(in srgb, var(--accent) 8%, rgba(2, 10, 25, 0.35));
            box-shadow: 0 16px 34px rgba(0, 5, 20, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.09);
            transform: translateY(-2px);
        }

        a.card:hover::before { opacity: 1; }
        a.card:hover::after { transform: translate(3px, -50%); }

        .card .name {
            margin-bottom: 5px;
            font-size: 14px;
            font-weight: 700;
            line-height: 1.2;
            letter-spacing: -0.015em;
        }

        .card .desc {
            color: var(--text-muted);
            font-size: 11px;
            font-weight: 480;
            line-height: 1.4;
        }

        .card.soon {
            min-height: 92px;
            opacity: 0.55;
            pointer-events: none;
        }

        .card.soon::after {
            content: "Bientôt";
            position: absolute;
            top: 12px;
            right: 12px;
            padding: 4px 7px;
            border: 1px solid rgba(191, 219, 254, 0.1);
            border-radius: 999px;
            color: rgba(219, 234, 254, 0.5);
            background: rgba(255, 255, 255, 0.045);
            font-size: 8px;
            font-weight: 730;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        @keyframes reveal {
            from { opacity: 0; transform: translateY(14px) scale(.987); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        @media (max-width: 900px) {
            .hub-grid { grid-template-columns: 1fr; }
            .dim--wide { grid-column: auto; }
            .dim--wide .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        }

        @media (max-width: 620px) {
            .login-card { padding: 38px 20px 24px; border-radius: 28px; }
            .login-icon { width: 62px; height: 62px; border-radius: 21px; }
            .hub { width: calc(100% - 24px); max-width: 1180px; padding: 12px 0 36px; }
            .hub-header { align-items: flex-start; padding: 18px; border-radius: 23px; }
            .hub-mark { width: 46px; height: 46px; border-radius: 16px; font-size: 21px; }
            .hub-header p:last-child { max-width: 210px; }
            .logout-btn { width: 42px; min-height: 42px; justify-content: center; padding: 0; }
            .logout-btn span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
            .dim { padding: 16px; border-radius: 22px; }
            .cards,
            .dim--wide .cards { grid-template-columns: 1fr; }
            .card { min-height: 82px; }
        }

        @media (prefers-reduced-motion: reduce) {
            .login-card,
            .hub { animation: none; }
            .login-card button,
            .login-card button svg,
            .logout-btn,
            .card,
            .card::before,
            .card::after { transition: none; }
        }

    </style>
</head>
<body>

    <div id="loginScreen" class="login-box">
        <div class="login-shell">
            <div class="login-card">
                <div class="login-brand">Sonny Court · espace privé</div>
                <div class="login-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <rect width="17" height="11" x="3.5" y="10.5" rx="3" />
                        <path d="M7.5 10.5V7.7a4.5 4.5 0 0 1 9 0v2.8" />
                        <path d="M12 15v2" />
                    </svg>
                </div>
                <h1>HUB</h1>
                <p class="login-subtitle">Point d'entrée du back-office</p>
                <form id="loginForm">
                    <div class="field">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V7.8a5 5 0 0 1 10 0V10"/><rect x="4" y="10" width="16" height="11" rx="3"/></svg>
                        <input id="password" type="password" autocomplete="current-password" placeholder="Mot de passe" required />
                    </div>
                    <button type="submit">
                        <span>Entrer</span>
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5"/></svg>
                    </button>
                </form>
                <p id="loginError" role="alert">Mot de passe incorrect</p>
            </div>
        </div>
    </div>

    <main id="hub" class="hub">
        <header class="hub-header">
            <div class="hub-identity">
                <div class="hub-mark" aria-hidden="true">🧠</div>
                <div>
                    <p class="hub-eyebrow">Sonny Court · Back-office</p>
                    <h1>HUB</h1>
                    <p>Toutes tes dimensions back-end, un seul point d'entrée.</p>
                </div>
            </div>
            <button class="logout-btn" id="logoutBtn">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h5"/><path d="m15 16 4-4-4-4M19 12H9"/></svg>
                <span>Déconnexion</span>
            </button>
        </header>

        <div class="hub-grid">
            <section class="dim dim--webinar">
                <div class="dim-heading"><div class="dim-icon" aria-hidden="true">🎥</div><h2>Webinaire</h2></div>
                <div class="cards">
                    <a class="card" href="/es-cockpit/" target="_blank" rel="noopener"><div class="name">Cockpit live</div><div class="desc">Pilotage pendant les sessions</div></a>
                    <a class="card" href="/es-cockpit/dashboard" target="_blank" rel="noopener"><div class="name">Cockpit dashboard</div><div class="desc">Vue d'ensemble des sessions</div></a>
                    <a class="card" href="/dashboard/retention" target="_blank" rel="noopener"><div class="name">Rétention</div><div class="desc">Courbes live et replay par session</div></a>
                    <a class="card" href="/admin/masterclass-optin/" target="_blank" rel="noopener"><div class="name">Optin masterclass</div><div class="desc">Funnel d'inscription, A/B, sources</div></a>
                </div>
            </section>

            <section class="dim dim--closers">
                <div class="dim-heading"><div class="dim-icon" aria-hidden="true">📞</div><h2>Closers</h2></div>
                <div class="cards">
                    <a class="card" href="/closer-admin" target="_blank" rel="noopener"><div class="name">Admin closers</div><div class="desc">Assignations et pilotage</div></a>
                    <a class="card" href="/closer-console" target="_blank" rel="noopener"><div class="name">Console closer</div><div class="desc">Espace de travail closer</div></a>
                    <a class="card" href="/closer-documentation" target="_blank" rel="noopener"><div class="name">Documentation</div><div class="desc">Méthodes et scripts</div></a>
                    <a class="card" href="/closer-formulaire" target="_blank" rel="noopener"><div class="name">Recrutement</div><div class="desc">Formulaire candidats closers</div></a>
                    <a class="card" href="/closer-feedback-pro" target="_blank" rel="noopener"><div class="name">Feedback pro</div><div class="desc">Retours des closers</div></a>
                    <a class="card" href="/setter" target="_blank" rel="noopener"><div class="name">Setter</div><div class="desc">Espace setter</div></a>
                </div>
            </section>

            <section class="dim dim--coachs">
                <div class="dim-heading"><div class="dim-icon" aria-hidden="true">🧑‍🏫</div><h2>Coachs</h2></div>
                <div class="cards">
                    <a class="card" href="/coach" target="_blank" rel="noopener"><div class="name">Page coaching</div><div class="desc">Vitrine publique du coaching 1-1</div></a>
                    <a class="card" href="/coach-romain" target="_blank" rel="noopener"><div class="name">Coach Romain</div><div class="desc">Page publique de Romain</div></a>
                    <div class="card soon"><div class="name">CRM coachs</div><div class="desc">Agendas, séances, rémunérations (à venir)</div></div>
                </div>
            </section>

            <section class="dim dim--analytics">
                <div class="dim-heading"><div class="dim-icon" aria-hidden="true">📊</div><h2>Analytics</h2></div>
                <div class="cards">
                    <a class="card" href="/admin/stats" target="_blank" rel="noopener"><div class="name">Stats newsletter</div><div class="desc">Clics Court-Circuit</div></a>
                    <a class="card" href="/admin/monitoring-cc-pack" target="_blank" rel="noopener"><div class="name">Monitoring CC pack</div><div class="desc">Suivi du pack Court-Circuit</div></a>
