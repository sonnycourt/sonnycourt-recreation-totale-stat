---
// HUB — point d'entrée central du back-office Sonny Court
// Protégé par la session admin (admin-es2-login), même mot de passe que les pages admin.
// Page autonome : n'importe aucun composant, ne modifie rien d'existant.
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HUB - Sonny Court</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <style>
        * { box-sizing: border-box; }
        body { margin:0; padding:40px 20px; font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display',sans-serif; background:#0a0a0f; color:#fff; min-height:100vh; }
        .login-box { max-width:400px; margin:100px auto; text-align:center; }
        .login-card { background:#1C1C1E; border:1px solid rgba(255,255,255,0.08); border-radius:16px; padding:40px; }
        .login-card input { width:100%; padding:14px 16px; border:1px solid rgba(255,255,255,0.1); border-radius:10px; background:#0a0a0f; color:#fff; font-size:1rem; text-align:center; letter-spacing:4px; outline:none; }
        .login-card button { width:100%; margin-top:16px; padding:14px; background:#007AFF; color:#fff; border:none; border-radius:10px; font-size:1rem; font-weight:600; cursor:pointer; }
        .hub { display:none; max-width:1100px; margin:0 auto; }
        .hub-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:36px; flex-wrap:wrap; gap:12px; }
        .hub-header h1 { font-size:1.8rem; font-weight:700; margin:0; }
        .hub-header p { color:#6b7280; margin:4px 0 0 0; font-size:0.9rem; }
        .logout-btn { background:transparent; color:#6b7280; border:1px solid rgba(255,255,255,0.15); padding:8px 16px; border-radius:8px; font-size:0.85rem; cursor:pointer; }
        .dim { margin-bottom:34px; }
        .dim h2 { font-size:1.05rem; font-weight:600; color:#9ca3af; margin:0 0 14px 0; display:flex; align-items:center; gap:8px; text-transform:uppercase; letter-spacing:1px; }
        .cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:12px; }
        .card { display:block; background:#1C1C1E; border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:16px 18px; text-decoration:none; color:#fff; transition:border-color .15s, transform .15s; }
        .card:hover { border-color:#007AFF; transform:translateY(-1px); }
        .card .name { font-weight:600; font-size:0.95rem; margin-bottom:3px; }
        .card .desc { color:#6b7280; font-size:0.8rem; line-height:1.35; }
        .card.ext .name::after { content:' ↗'; color:#007AFF; font-size:0.8rem; }
        .card.soon { opacity:0.45; pointer-events:none; }
        #loginError { color:#ef4444; margin-top:16px; font-size:0.85rem; display:none; }
    </style>
</head>
<body>

    <div id="loginScreen" class="login-box">
        <div class="login-card">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#007AFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:20px;">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <h1 style="font-size:1.5rem;font-weight:700;margin:0 0 8px 0;">HUB</h1>
            <p style="color:#6b7280;margin:0 0 24px 0;font-size:0.9rem;">Point d'entrée du back-office</p>
            <form id="loginForm">
                <input id="password" type="password" autocomplete="current-password" placeholder="Mot de passe" required />
                <button type="submit">Entrer</button>
            </form>
            <p id="loginError">Mot de passe incorrect</p>
        </div>
    </div>

    <div id="hub" class="hub">
        <div class="hub-header">
            <div>
                <h1>🧠 HUB</h1>
                <p>Toutes tes dimensions back-end, un seul point d'entrée.</p>
            </div>
            <button class="logout-btn" id="logoutBtn">Déconnexion</button>
        </div>

        <div class="dim">
            <h2>🎥 Webinaire</h2>
            <div class="cards">
                <a class="card" href="/es-cockpit/" target="_blank" rel="noopener"><div class="name">Cockpit live</div><div class="desc">Pilotage pendant les sessions</div></a>
                <a class="card" href="/es-cockpit/dashboard" target="_blank" rel="noopener"><div class="name">Cockpit dashboard</div><div class="desc">Vue d'ensemble des sessions</div></a>
                <a class="card" href="/dashboard/retention" target="_blank" rel="noopener"><div class="name">Rétention</div><div class="desc">Courbes live et replay par session</div></a>
                <a class="card" href="/admin/masterclass-optin/" target="_blank" rel="noopener"><div class="name">Optin masterclass</div><div class="desc">Funnel d'inscription, A/B, sources</div></a>
            </div>
        </div>

        <div class="dim">
            <h2>📞 Closers</h2>
            <div class="cards">
                <a class="card" href="/closer-admin" target="_blank" rel="noopener"><div class="name">Admin closers</div><div class="desc">Assignations et pilotage</div></a>
                <a class="card" href="/closer-console" target="_blank" rel="noopener"><div class="name">Console closer</div><div class="desc">Espace de travail closer</div></a>
                <a class="card" href="/closer-documentation" target="_blank" rel="noopener"><div class="name">Documentation</div><div class="desc">Méthodes et scripts</div></a>
                <a class="card" href="/closer-formulaire" target="_blank" rel="noopener"><div class="name">Recrutement</div><div class="desc">Formulaire candidats closers</div></a>
                <a class="card" href="/closer-feedback-pro" target="_blank" rel="noopener"><div class="name">Feedback pro</div><div class="desc">Retours des closers</div></a>
                <a class="card" href="/setter" target="_blank" rel="noopener"><div class="name">Setter</div><div class="desc">Espace setter</div></a>
            </div>
        </div>

        <div class="dim">
            <h2>🧑‍🏫 Coachs</h2>
            <div class="cards">
                <a class="card" href="/coach" target="_blank" rel="noopener"><div class="name">Page coaching</div><div class="desc">Vitrine publique du coaching 1-1</div></a>
                <a class="card" href="/coach-romain" target="_blank" rel="noopener"><div class="name">Coach Romain</div><div class="desc">Page publique de Romain</div></a>
                <div class="card soon"><div class="name">CRM coachs</div><div class="desc">Agendas, séances, rémunérations (à venir)</div></div>
            </div>
        </div>

        <div class="dim">
            <h2>📊 Analytics</h2>
            <div class="cards">
                <a class="card" href="/admin/stats" target="_blank" rel="noopener"><div class="name">Stats newsletter</div><div class="desc">Clics Court-Circuit</div></a>
                <a class="card" href="/admin/monitoring-cc-pack" target="_blank" rel="noopener"><div class="name">Monitoring CC pack</div><div class="desc">Suivi du pack Court-Circuit</div></a>
                <a class="card" href="/es2/feedback" target="_blank" rel="noopener"><div class="name">Feedback élèves</div><div class="desc">Retours des membres ES2</div></a>
                <a class="card" href="/oracle-es2" target="_blank" rel="noopener"><div class="name">Oracle ES2</div><div class="desc">Analyse des données ES2</div></a>
            </div>
        </div>

        <div class="dim">
            <h2>📧 Email marketing</h2>
            <div class="cards">
                <div class="card soon"><div class="name">Tracking emails</div><div class="desc">Points de tracking du service email (à venir)</div></div>
            </div>
        </div>

        <div class="dim">
            <h2>⚙️ Infra et sous-domaines</h2>
            <div class="cards">
                <a class="card ext" href="https://stats.sonnycourt.com" target="_blank" rel="noopener"><div class="name">Umami</div><div class="desc">stats.sonnycourt.com : analytics site</div></a>
                <a class="card ext" href="https://n8n.sonnycourt.com" target="_blank" rel="noopener"><div class="name">n8n</div><div class="desc">n8n.sonnycourt.com : automatisations</div></a>
                <a class="card ext" href="https://tracker.sonnycourt.com" target="_blank" rel="noopener"><div class="name">Tracker</div><div class="desc">tracker.sonnycourt.com</div></a>
                <a class="card ext" href="https://app.netlify.com" target="_blank" rel="noopener"><div class="name">Netlify</div><div class="desc">Déploiements et fonctions</div></a>
                <a class="card ext" href="https://supabase.com/dashboard" target="_blank" rel="noopener"><div class="name">Supabase</div><div class="desc">Base de données</div></a>
                <a class="card ext" href="https://app.spiffy.co" target="_blank" rel="noopener"><div class="name">Spiffy</div><div class="desc">Paiements et commandes</div></a>
                <a class="card ext" href="https://dashboard.mailerlite.com" target="_blank" rel="noopener"><div class="name">MailerLite</div><div class="desc">Email et automatisations</div></a>
                <a class="card ext" href="https://adsmanager.facebook.com/adsmanager/manage/campaigns?act=1424723921423167" target="_blank" rel="noopener"><div class="name">Meta Ads</div><div class="desc">Gestionnaire de publicités</div></a>
            </div>
        </div>
    </div>

    <script>
        const SESSION_API = '/.netlify/functions/admin-es2-session';
        const LOGIN_API = '/.netlify/functions/admin-es2-login';
        const LOGOUT_API = '/.netlify/functions/admin-es2-logout';

        async function checkSession() {
            const r = await fetch(SESSION_API, { credentials: 'same-origin' }).catch(() => null);
            if (r && r.ok) showHub();
        }

        function showHub() {
            document.getElementById('loginScreen').style.display = 'none';
            document.getElementById('hub').style.display = 'block';
        }

        document.getElementById('loginForm').addEventListener('submit', async (ev) => {
            ev.preventDefault();
            const password = document.getElementById('password').value;
            const err = document.getElementById('loginError');
            err.style.display = 'none';
            try {
                const r = await fetch(LOGIN_API, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ password }),
                });
                if (r.ok) { showHub(); }
                else { err.style.display = 'block'; }
            } catch (e) { err.style.display = 'block'; }
            document.getElementById('password').value = '';
        });

        document.getElementById('logoutBtn').addEventListener('click', async () => {
            try { await fetch(LOGOUT_API, { method: 'POST', credentials: 'same-origin' }); } catch (e) {}
            document.getElementById('hub').style.display = 'none';
            document.getElementById('loginScreen').style.display = 'block';
        });

        checkSession();
    </script>
</body>
</html>
