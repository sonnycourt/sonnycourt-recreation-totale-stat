    <script>
        const SESSION_API = '/.netlify/functions/admin-es2-session';
        const LOGIN_API = '/.netlify/functions/admin-es2-login';
        const LOGOUT_API = '/.netlify/functions/admin-es2-logout';
        const LOCAL_PREVIEW = import.meta.env.DEV && new URLSearchParams(window.location.search).has('preview');

        async function checkSession() {
            const r = await fetch(SESSION_API, { credentials: 'same-origin' }).catch(() => null);
            if (r && r.ok) showHub();
        }

        function showHub() {
            document.getElementById('loginScreen').style.display = 'none';
            document.getElementById('hub').style.display = 'block';
        }

        document.getElementById('loginForm').addEventListener('submit', async (ev) => {
            ev.preventDefault();
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const err = document.getElementById('loginError');
            err.style.display = 'none';
            try {
                const r = await fetch(LOGIN_API, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ email, password }),
                });
                if (r.ok) { showHub(); }
                else if (r.status === 429) {
                    let mins = 15;
                    try {
                        const d = await r.json();
                        const ra = Number(d?.retryAfterSec) || Number(r.headers.get('Retry-After')) || 900;
                        mins = Math.max(1, Math.ceil(ra / 60));
                    } catch (e) {}
                    err.textContent = 'Trop de tentatives. Réessaie dans ' + mins + ' min.';
                    err.style.display = 'block';
                } else {
                    err.textContent = 'Email ou mot de passe incorrect';
                    err.style.display = 'block';
                }
            } catch (e) {
                err.textContent = 'Erreur réseau. Réessaie.';
                err.style.display = 'block';
            }
            document.getElementById('password').value = '';
        });

        document.getElementById('logoutBtn').addEventListener('click', async () => {
            try { await fetch(LOGOUT_API, { method: 'POST', credentials: 'same-origin' }); } catch (e) {}
            document.getElementById('hub').style.display = 'none';
            document.getElementById('loginScreen').style.display = 'grid';
        });

        if (LOCAL_PREVIEW) showHub();
        else checkSession();
    </script>
