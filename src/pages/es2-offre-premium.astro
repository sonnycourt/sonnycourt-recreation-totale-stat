---
import DealOffer from '../components/mc2/DealOfferDraftX.astro';
import PurchaseChoices from '../components/es2-premium/PurchaseChoices.astro';
// Native one-click offer; independent monthly checkout.
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="Content-Security-Policy" content="frame-src https://player.mediadelivery.net https://sonnycourt.spiffy.co https://*.spiffy.co https://*.stripe.com https://*.paypal.com; form-action 'none'; object-src 'none'; base-uri 'self'" />
    <title>Ton inscription est validée — Esprit Subconscient 2.0</title>
    <link rel="preload" as="image" href="/media/es2-upsell-thumbnail-v1.webp" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Caveat:wght@600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Capture before the shared offer handlers; only the monthly CTA opens checkout.
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const choice = target?.closest('[data-premium-plan], .premium-choices__decline');
        if (!choice) return;
        if (choice.matches('[data-premium-plan]') && (document.documentElement.dataset.premiumExpired === 'true' || Date.now() >= Number(document.documentElement.dataset.premiumDeadline || Infinity))) {
          event.preventDefault();
          event.stopImmediatePropagation();
          return;
        }
        const monthly = choice.dataset.premiumPlan === 'twelve';
        if (window.__premiumMonthlyReady) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        window.dispatchEvent(new CustomEvent('premium-monthly-open', { detail: choice }));
      }, true);
    </script>
  </head>
  <body class="premium-page">
    <aside id="premium-dev-panel" class="premium-dev-panel" aria-label="Outils de prévisualisation" hidden>
      <span>DEV · TIMER</span>
      <button type="button" id="premium-dev-reset">Repartir à 15:00</button>
      <button type="button" id="premium-dev-offer">Juste avant l’offre · 10:05</button>
      <button type="button" id="premium-dev-expiry">Tester la fin · 00:05</button>
    </aside>
    <canvas id="premium-confetti" aria-hidden="true"></canvas>
    <section id="bienvenue" class="premium-hero" aria-labelledby="premium-title">
      <div class="purchase-confirmation">
        <span class="confirmation-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m6 12 4 4 8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
        <div><strong>Ton inscription à Delta Vision est validée.</strong></div>
      </div>
      <h1 id="premium-title"><span>REGARDE CETTE VIDÉO <span class="premium-title-now">MAINTENANT</span></span></h1>
      <p class="premium-intro">Donne-moi seulement 5 minutes pour te proposer une opportunité qui va littéralement changer ta vie.</p>
      <div class="premium-video" aria-label="Vidéo de présentation">
        <iframe
          src="https://player.mediadelivery.net/embed/779556/54a00277-48c6-4ffa-9884-8092a3b90546?autoplay=false&muted=false&preload=true&responsive=true&playsinline=true&showSpeed=false&chromecast=false&disableAirPlay=true&rememberPosition=false&rememberSettings=false"
          title="Présentation de l’accompagnement Esprit Subconscient 2.0"
          allow="autoplay; encrypted-media; fullscreen 'none'; picture-in-picture 'none'"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
      <div id="premium-video-choices" hidden>
        <PurchaseChoices />
      </div>
    </section>
    <div id="accompagnement" class="premium-offer" hidden>
      <DealOffer checkoutEmbedMode="iframe" premiumUpsellPreview={true} />
    </div>
    <div class="premium-sticky-countdown" role="timer" aria-label="Temps restant" aria-live="off">
      <span>TEMPS RESTANT</span>
      <strong id="premium-sticky-time">15:00</strong>
    </div>
    <p id="premium-expiry-status" role="status" hidden></p>
    <dialog id="premium-monthly-dialog" aria-labelledby="premium-monthly-title">
      <button type="button" id="premium-monthly-close" aria-label="Fermer">×</button>
      <h2 id="premium-monthly-title">Ton accompagnement en 12 fois.</h2>
      <p>197 € aujourd’hui, puis 11 mensualités de 197 €.<br />Total : 2 364 €.</p>
      <p id="premium-monthly-status" role="status">Ouverture du paiement sécurisé…</p>
      <a href="https://sonnycourt.spiffy.co/checkout/offre-delta-es2?locale=fr" target="_blank" rel="noopener noreferrer">Ouvrir le paiement dans un nouvel onglet</a>
    </dialog>
    <script is:inline>
      (() => {
        window.addEventListener('message', event => {
          if (event.origin !== 'https://sonnycourt.spiffy.co' || event.data?.type !== 'es2:spiffy-height') return;
          const frame = [...document.querySelectorAll('spiffy-checkout-modal iframe')].find(frame => frame.contentWindow === event.source);
          const height = Number(event.data.height);
          if (!frame || !Number.isFinite(height) || height < 100 || height > 10000) return;
          frame.closest('spiffy-checkout-modal').style.setProperty('--monthly-checkout-height', `${Math.min(1800, Math.max(400, Math.ceil(height)))}px`);
        });
        let ready;
        let opening = false;
        let cancelled = false;
        const dialog = document.getElementById('premium-monthly-dialog');
        const status = document.getElementById('premium-monthly-status');
        const load = () => {
          if (window.spiffy?.checkout) return Promise.resolve();
          if (ready) return ready;
          ready = new Promise((resolve, reject) => {
            const timeout = setTimeout(() => reject(new Error('Spiffy timeout')), 15000);
            const spiffy = window.spiffy = window.spiffy || [];
            if (!spiffy.invoked) {
              spiffy.invoked = true;
              ['identify', 'config', 'debug', 'off', 'on'].forEach(method => {
                spiffy[method] = (...args) => { spiffy.push([method, ...args]); return spiffy; };
              });
              spiffy.ACCOUNT = 'sonnycourt';
              spiffy.SNIPPET_VERSION = '1.1.0';
              spiffy.config({ popupEnabled: true, popupPrefetch: false, hideSidebar: false, trackingEnabled: false, autoIdentify: false });
              spiffy.on('ready', () => { clearTimeout(timeout); resolve(); });
              const script = document.createElement('script');
              script.src = 'https://js.static.spiffy.co/spiffy.js?a=sonnycourt';
              script.async = true;
              script.onload = () => {
                clearTimeout(timeout);
                if (window.spiffy?.checkout) resolve();
                else reject(new Error('Spiffy initialization failed'));
              };
              script.onerror = () => { clearTimeout(timeout); reject(new Error('Spiffy unavailable')); };
              document.head.appendChild(script);
            } else {
              spiffy.on('ready', () => { clearTimeout(timeout); resolve(); });
            }
          });
          return ready;
        };
        dialog.addEventListener('close', () => { cancelled = true; });
        document.getElementById('premium-monthly-close').addEventListener('click', () => dialog.close());
        window.addEventListener('premium-monthly-open', async (event) => {
          if (opening) return;
          opening = true;
          cancelled = false;
          const monthly = event.detail.dataset.premiumPlan === 'twelve';
          const decline = event.detail.matches('.premium-choices__decline');
          document.getElementById('premium-monthly-title').textContent = decline ? 'Tu vas retrouver Delta Vision.' : monthly ? 'Ton accompagnement en 12 fois.' : 'Ton accompagnement en un clic.';
          dialog.querySelector('h2 + p').hidden = !monthly;
          dialog.querySelector('a').hidden = !monthly;
          status.textContent = 'Connexion sécurisée…';
          dialog.showModal();
          try {
            await load();
            if (cancelled || !dialog.open) return;
            if (!decline && (document.documentElement.dataset.premiumExpired === 'true' || Date.now() >= Number(document.documentElement.dataset.premiumDeadline || Infinity))) return;
            dialog.close();
            // Let Spiffy handle its own native link and create the modal instance.
            window.__premiumMonthlyReady = true;
            event.detail.click();
          } catch {
            status.textContent = monthly ? 'Le paiement met plus de temps à charger. Utilise le lien ci-dessous pour continuer.' : 'La connexion à Spiffy est indisponible. Ferme cette fenêtre et réessaie, sans repayer.';
          } finally { opening = false; }
        });
        // Initialize the native offer context before the visitor chooses. Never accept an offer here.
        load().then(() => { window.__premiumMonthlyReady = true; }).catch(() => { ready = undefined; });
      })();
    </script>
    <script>
      import { createPremiumExpiry } from '../lib/es2-premium-expiry.mjs';
      const expiry = createPremiumExpiry({ document, navigate: (destination: string) => {
        const decline = document.querySelector<HTMLAnchorElement>('.premium-choices__decline');
        if (decline) decline.click(); else location.replace('/delta-vision/merci/');
      } });
      const countdownKey = 'es2-premium-countdown-v1';
      const countdownDuration = 15 * 60 * 1000;
      let countdownDeadline = Date.now() + countdownDuration;
      try {
        const saved = Number(localStorage.getItem(countdownKey));
        if (Number.isFinite(saved) && saved > 0 && saved <= countdownDeadline) {
          countdownDeadline = saved;
        } else {
          localStorage.setItem(countdownKey, String(countdownDeadline));
        }
      } catch { /* Continue in memory if storage is unavailable. */ }
      const stickyTimeNode = document.getElementById('premium-sticky-time');
      const timedOffer = document.getElementById('accompagnement');
      const videoChoices = document.getElementById('premium-video-choices');
      const videoRevealKey = 'es2-premium-video-revealed-v1';
      let videoOfferReached = false;
      try { videoOfferReached = localStorage.getItem(videoRevealKey) === String(countdownDeadline); } catch {}
      let countdownInterval: ReturnType<typeof setInterval> | undefined;
      const renderCountdown = () => {
        document.documentElement.dataset.premiumDeadline = String(countdownDeadline);
        const remaining = Math.max(0, Math.ceil((countdownDeadline - Date.now()) / 1000));
        const hideOffer = !videoOfferReached && remaining > 10 * 60;
        if (timedOffer) timedOffer.hidden = hideOffer;
        if (videoChoices) videoChoices.hidden = hideOffer;
        if (stickyTimeNode) stickyTimeNode.textContent = `${String(Math.floor(remaining / 60)).padStart(2, '0')}:${String(remaining % 60).padStart(2, '0')}`;
        if (!remaining) { clearInterval(countdownInterval); expiry.expire(); }
      };
      const startCountdown = () => {
        clearInterval(countdownInterval);
        countdownInterval = setInterval(renderCountdown, 250);
        renderCountdown();
      };
      startCountdown();
      // Use Bunny's playback position, not time spent with a paused video.
      const frame = document.querySelector<HTMLIFrameElement>('.premium-video iframe');
      type BunnyPlayer = { on: (event: string, callback: (data?: { seconds?: number }) => void) => void; pause: () => void; setCurrentTime: (seconds: number) => void };
      const bunnyWindow = window as typeof window & { playerjs?: { Player: new (frame: HTMLIFrameElement) => BunnyPlayer } };
      let videoPlayer: BunnyPlayer | undefined;
      const connectVideo = () => {
        if (!frame || !bunnyWindow.playerjs?.Player || videoPlayer) return;
        videoPlayer = new bunnyWindow.playerjs.Player(frame);
        videoPlayer.on('ready', () => {
          videoPlayer?.on('timeupdate', data => {
            if (videoOfferReached || !Number.isFinite(data?.seconds) || Number(data?.seconds) < 164) return;
            videoOfferReached = true;
            try { localStorage.setItem(videoRevealKey, String(countdownDeadline)); } catch {}
            renderCountdown();
          });
        });
      };
      if (bunnyWindow.playerjs?.Player) connectVideo();
      else {
        const playerScript = document.createElement('script');
        playerScript.src = 'https://assets.mediadelivery.net/playerjs/player-0.1.0.min.js';
        playerScript.async = true;
        playerScript.onload = connectVideo;
        document.head.appendChild(playerScript);
      }
      const localPreview = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname);
      const devPreview = new URLSearchParams(location.search).get('preview') === 'dev';
      if (localPreview || devPreview) {
        const devPanel = document.getElementById('premium-dev-panel');
        if (devPanel) devPanel.hidden = false;
        const setPreviewCountdown = (seconds: number) => {
          expiry.reset();
          videoOfferReached = false;
          videoPlayer?.pause();
          videoPlayer?.setCurrentTime(0);
          try { localStorage.removeItem(videoRevealKey); } catch {}
          countdownDeadline = Date.now() + seconds * 1000;
          try { localStorage.setItem(countdownKey, String(countdownDeadline)); } catch {}
          startCountdown();
        };
        document.getElementById('premium-dev-reset')?.addEventListener('click', () => setPreviewCountdown(900));
        document.getElementById('premium-dev-offer')?.addEventListener('click', () => setPreviewCountdown(605));
        document.getElementById('premium-dev-expiry')?.addEventListener('click', () => setPreviewCountdown(5));
      }
      document.addEventListener('visibilitychange', renderCountdown);
      window.addEventListener('pageshow', startCountdown);
      window.addEventListener('pagehide', () => clearInterval(countdownInterval));
      window.addEventListener('storage', event => {
        if (event.key !== countdownKey) return;
        const saved = Number(event.newValue);
        if (Number.isFinite(saved) && saved > 0 && saved < countdownDeadline) {
          countdownDeadline = saved;
          renderCountdown();
        }
      });
      // A short, silent celebration, with no dependency and no persistent animation.
      const canvas = document.querySelector<HTMLCanvasElement>('#premium-confetti');
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      const ctx = canvas?.getContext('2d');
      if (canvas && ctx && !motion.matches) {
        const width = innerWidth, height = innerHeight, ratio = Math.min(devicePixelRatio || 1, 2);
        canvas.width = width * ratio; canvas.height = height * ratio;
        ctx.scale(ratio, ratio);
        const colors = ['#8bb9ff', '#3978ff', '#d2b982', '#f2e5ca', '#ffffff'];
        const pieces = Array.from({ length: width < 600 ? 55 : 95 }, () => ({
          x: Math.random() * width, y: -Math.random() * height * .8 - 20,
          speed: 90 + Math.random() * 110, sway: Math.random() * 50,
          angle: Math.random() * Math.PI, turn: Math.random() * 3 - 1.5,
          size: 4 + Math.random() * 5, color: colors[Math.floor(Math.random() * colors.length)],
        }));
        let previous = performance.now(), start = previous, frame = 0;
        const cleanup = () => { cancelAnimationFrame(frame); canvas.remove(); };
        const draw = (now: number) => {
          const elapsed = (now - start) / 1000, dt = Math.min((now - previous) / 1000, .04); previous = now;
          if (elapsed > 5 || motion.matches || document.hidden) { cleanup(); return; }
          ctx.clearRect(0, 0, width, height);
          ctx.globalAlpha = Math.min(1, (5 - elapsed) / 1.3);
          for (const p of pieces) {
            p.y += p.speed * dt; p.x += Math.sin(elapsed + p.angle) * p.sway * dt; p.angle += p.turn * dt;
            ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.angle); ctx.fillStyle = p.color;
            ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * .5); ctx.restore();
          }
          frame = requestAnimationFrame(draw);
        };
        frame = requestAnimationFrame(draw);
        window.addEventListener('pagehide', cleanup, { once: true });
      } else canvas?.remove();
    </script>
  </body>
</html>

<style is:global>
  html[data-premium-expired="true"] [data-premium-plan] { background: #454a53 !important; border-color: #606570 !important; color: #a9adb5 !important; box-shadow: none !important; cursor: not-allowed !important; pointer-events: none !important; filter: grayscale(1); }
  html[data-premium-expired="true"] spiffy-checkout-modal { display: none !important; }
  #premium-expiry-status:not([hidden]) { position: fixed; z-index: 2147483647; bottom: 24px; left: 50%; transform: translateX(-50%); max-width: calc(100% - 32px); padding: 16px 24px; border-radius: 12px; background: #172336; color: white; text-align: center; }
  /* Keep Spiffy's payment iframe intact; only style its outer modal shell. */
  spiffy-checkout-modal .spiffy-modal #modal { background: #030713d9 !important; backdrop-filter: blur(8px); }
  spiffy-checkout-modal .spiffy-modal #modal-content { width: min(760px, calc(100% - 32px)) !important; height: min(var(--monthly-checkout-height, 820px), calc(100dvh - 32px)) !important; margin: 0 auto !important; top: 50% !important; transform: translateY(-50%); border: 1px solid #d6e4f5; border-radius: 24px; background: #f7f9fc; box-shadow: 0 30px 100px #0008; }
  spiffy-checkout-modal .spiffy-iframe,
  spiffy-checkout-modal .form-container--modal,
  spiffy-checkout-modal iframe#checkout { width: 100% !important; height: 100% !important; }
  spiffy-checkout-modal .spiffy-modal .modal__close { position: fixed !important; top: calc((100dvh - min(var(--monthly-checkout-height, 820px), 100dvh - 32px)) / 2 + 12px) !important; right: max(28px, calc((100vw - 760px) / 2 + 20px)) !important; left: auto !important; width: 32px !important; height: 32px !important; z-index: 10 !important; color: #52657d !important; }
  spiffy-checkout-modal .spiffy-modal .modal__close span { color: #52657d !important; background: #fff; border-radius: 50%; }
  html { scroll-behavior: smooth; background: #070b16; }
  body.premium-page { margin: 0; color: #f5f7fc; font-family: 'Inter', sans-serif; background: radial-gradient(ellipse 65% 650px at 50% 390px, #132a534d, transparent), #070b16; }
  #premium-monthly-dialog { width: min(480px, calc(100% - 40px)); box-sizing: border-box; padding: 32px; border: 1px solid #53617a; border-radius: 18px; background: #101a2d; color: #eef3fc; text-align: center; }
  #premium-monthly-dialog::backdrop { background: #030713cc; }
  #premium-monthly-dialog p { line-height: 1.7; }
  #premium-monthly-dialog a { color: #b9d0ff; }
  #premium-monthly-close { position: absolute; right: 10px; top: 6px; border: 0; background: transparent; color: white; font-size: 28px; cursor: pointer; }
  .premium-page *, .premium-page *::before, .premium-page *::after { box-sizing: border-box; }
  .premium-page a { -webkit-tap-highlight-color: transparent; }
  .premium-page :focus-visible { outline: 3px solid #96bfff; outline-offset: 5px; }
  .premium-dev-panel { position: fixed; top: calc(12px + env(safe-area-inset-top)); right: max(12px, env(safe-area-inset-right)); z-index: 100; display: grid; gap: 7px; width: 195px; padding: 12px; border: 1px solid #53617a; border-radius: 12px; background: #0d1421f5; box-shadow: 0 6px 25px #0005; }
  .premium-dev-panel[hidden] { display: none; }
  .premium-dev-panel > span { color: #aab6ca; font-size: 9px; font-weight: 700; letter-spacing: .14em; }
  .premium-dev-panel button { padding: 9px 8px; border: 1px solid #53617a; border-radius: 7px; background: #1b2940; color: #fff; font: 600 11px 'Inter', sans-serif; cursor: pointer; }
  .premium-dev-panel button:hover { background: #294266; }
  .preview-note { padding: 8px 16px; background: #101828; text-align: center; color: #9bacc6; font-size: 10px; letter-spacing: .04em; }
  .preview-note span { padding: 0 8px; }
  .premium-header { max-width: 1140px; margin: auto; padding: 28px 28px 0; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .signature { color: #e8ecf4; text-decoration: none; font-size: 11px; letter-spacing: .4em; }
  .header-mark { color: #8c9bb5; font-size: 10px; letter-spacing: .13em; }
  .header-mark b { color: #94baff; margin-left: 4px; }
  .premium-hero { max-width: 1060px; margin: auto; padding: 42px 28px 66px; text-align: center; }
  .purchase-confirmation { display: flex; gap: 14px; align-items: center; justify-content: center; max-width: 660px; margin: 0 auto 52px; padding: 18px 25px; text-align: left; background: linear-gradient(115deg, #123b373d, #12263e66); border: 1px solid #76b9ad30; border-radius: 16px; }
  .confirmation-icon { display: grid; place-items: center; color: #b6edcf; background: #8ce2ba13; border: 1px solid #8ce2ba35; border-radius: 50%; width: 38px; height: 38px; flex-shrink: 0; }
  .confirmation-icon svg { width: 24px; height: 24px; }
  .purchase-confirmation strong { font-size: 15px; font-weight: 600; color: #e5f7ed; }
  .purchase-confirmation p { color: #97b2b6; font-size: 12px; margin: 7px 0 0; line-height: 1.5; }
  .premium-eyebrow { font-size: 10px; font-weight: 600; letter-spacing: .22em; color: #b7ccef; margin: 0 0 20px; }
  .premium-hero h1 { font-size: clamp(31px, 4.5vw, 54px); font-weight: 700; line-height: 1.13; letter-spacing: -.045em; margin: 0; }
  .premium-hero h1 span { color: #fff; }
  .premium-hero h1 .premium-title-now { color: #ff514b; }
  .premium-offer[hidden] { display: none !important; }
  #premium-video-choices[hidden] { display: none !important; }
  .premium-countdown { width: fit-content; margin: 28px auto 38px; padding: 22px 32px; text-align: center; border: 1px solid #e33b3b80; border-radius: 18px; background: linear-gradient(135deg, #351419, #1c0d13); box-shadow: 0 8px 32px #e3292914; }
  .countdown-caption { color: #ffaaa5; font-size: 10px; font-weight: 700; letter-spacing: .18em; }
  .countdown-digits { display: flex; align-items: flex-start; justify-content: center; gap: 18px; margin-top: 14px; }
  .countdown-digits strong { display: block; color: #ff514b; font-size: 44px; line-height: 1.1; font-weight: 700; font-variant-numeric: tabular-nums; }
  .countdown-digits small { display: block; margin-top: 8px; color: #dca9a8; font-size: 9px; letter-spacing: .12em; }
  .countdown-colon { color: #ff514b; font-size: 32px; line-height: 1.2; }
  .premium-sticky-countdown { position: fixed; right: max(20px, env(safe-area-inset-right)); bottom: calc(20px + env(safe-area-inset-bottom)); z-index: 50; display: flex; flex-direction: column; align-items: center; gap: 5px; padding: 13px 20px; border: 1px solid #e33b3b80; border-radius: 14px; background: linear-gradient(135deg, #351419, #1c0d13); box-shadow: 0 8px 28px #0006; pointer-events: none; }
  .premium-sticky-countdown > span { color: #ffaaa5; font-size: 9px; font-weight: 700; letter-spacing: .12em; }
  .premium-sticky-countdown > strong { color: #ff514b; font-size: 30px; font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
  @media (max-width: 650px) {
    .premium-sticky-countdown { right: max(12px, env(safe-area-inset-right)); bottom: calc(12px + env(safe-area-inset-bottom)); padding: 10px 14px; border-radius: 11px; }
    .premium-sticky-countdown > strong { font-size: 26px; }
  }
  .premium-intro { max-width: 650px; margin: 23px auto 32px; color: #a4b0c6; font-size: 16px; line-height: 1.8; }
  .premium-intro strong { font-weight: 500; color: #e7edf9; }
  .premium-video { position: relative; aspect-ratio: 16 / 9; max-width: 900px; margin: auto; overflow: hidden; border-radius: 20px; border: 1px solid #719ceb36; background: radial-gradient(ellipse at 50% 70%, #193b73 0%, #101e38 37%, #0b1222 75%); box-shadow: 0 32px 90px #0005, 0 0 60px #3168cb0d; }
