---
import DealOffer from '../components/mc2/DealOfferDraftX.astro';
// Design preview only: no purchase verification, customer writes, or live checkout.
// Before launch: verify the Delta Vision purchase server-side and connect the approved upsell.
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="Content-Security-Policy" content="frame-src 'none'; form-action 'none'; object-src 'none'; base-uri 'self'" />
    <title>Ton inscription est validée — Esprit Subconscient 2.0</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Caveat:wght@600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Capture before the shared offer handlers. Nothing can mount a live payment here.
      document.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (!target?.closest('[data-core-plan-cta], [data-checkout-open], #deal-sticky-cta, #core-price-registration-cta, #two-paths-registration-cta')) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        document.getElementById('premium-preview-dialog')?.showModal();
      }, true);
    </script>
  </head>
  <body class="premium-page">
    <canvas id="premium-confetti" aria-hidden="true"></canvas>
    <div class="preview-note">APERÇU LOCAL <span>·</span> Confirmation simulée · aucun paiement activé</div>
    <header class="premium-header">
      <a class="signature" href="#bienvenue" aria-label="Sonny Court — accueil de l’offre">SONNY COURT</a>
      <span class="header-mark">ESPRIT SUBCONSCIENT <b>2.0</b></span>
    </header>
    <section id="bienvenue" class="premium-hero" aria-labelledby="premium-title">
      <div class="purchase-confirmation">
        <span class="confirmation-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m6 12 4 4 8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
        <div><strong>Ton inscription à Delta Vision est validée.</strong><p>Bienvenue dans l’expérience. Une nouvelle étape commence.</p></div>
      </div>
      <p class="premium-eyebrow">UNE INVITATION SPÉCIALE POUR TOI</p>
      <h1 id="premium-title">Tu viens de faire le premier pas.<br /><span>Et si on allait plus loin ?</span></h1>
      <p class="premium-intro">Avant de commencer Delta Vision, découvre l’offre que je te réserve pour rejoindre mon accompagnement complet <strong>Esprit Subconscient 2.0.</strong></p>
      <div class="premium-video" aria-label="Emplacement de la future vidéo de présentation">
        <div class="video-grid" aria-hidden="true"></div>
        <span class="video-corner">UN MESSAGE DE SONNY</span>
        <div class="video-content">
          <span class="play-placeholder" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 5 11 7-11 7Z" fill="currentColor" /></svg></span>
          <p>La suite de ton<br /><strong>expérience commence ici.</strong></p>
          <span class="video-placeholder-label">Emplacement réservé à ta vidéo</span>
        </div>
        <span class="video-brand" aria-hidden="true">ESPRIT SUBCONSCIENT <b>2.0</b></span>
      </div>
      <a class="premium-discover" href="#accompagnement">Découvrir l’accompagnement <span aria-hidden="true">↓</span></a>
      <a class="premium-skip" href="/delta-vision/merci/">Je préfère commencer par Delta Vision</a>
    </section>
    <div id="accompagnement" class="premium-offer">
      <div class="offer-divider"><span>TON PROCHAIN CHAPITRE</span></div>
      <DealOffer checkoutEmbedMode="iframe" />
    </div>
    <footer class="premium-footer">
      <a href="/delta-vision/merci/">Accéder à Delta Vision</a>
      <div><a href="/cgv/">Conditions générales de vente</a><span>·</span><a href="/contact/">Nous contacter</a></div>
      <small>© Sonny Court</small>
    </footer>
    <dialog id="premium-preview-dialog" aria-labelledby="preview-dialog-title">
      <span class="dialog-eyebrow">APERÇU DE L’OFFRE</span>
      <h2 id="preview-dialog-title">Prêt à aller plus loin ?</h2>
      <p>Les tarifs de MC2 sont conservés pour cette première version.</p>
      <div class="preview-plans"><div><strong>1 297 €</strong><span>en une fois</span></div><div><strong>12 × 197 €</strong><span>en douze mensualités</span></div></div>
      <p class="preview-safety">Le paiement de cette nouvelle page n’est pas encore branché. Aucun débit ni envoi d’email n’est possible ici.</p>
      <button type="button" id="preview-dialog-close">Continuer la découverte</button>
    </dialog>
    <script>
      const dialog = document.querySelector<HTMLDialogElement>('#premium-preview-dialog');
      document.getElementById('preview-dialog-close')?.addEventListener('click', () => dialog?.close());
      dialog?.addEventListener('click', event => { if (event.target === dialog) { const r = dialog.getBoundingClientRect(); if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) dialog.close(); } });
      const hero = document.querySelector('.premium-hero');
      if (hero) new IntersectionObserver(([entry]) => document.body.classList.toggle('past-premium-hero', !entry.isIntersecting)).observe(hero);

      // A short, silent celebration, with no dependency and no persistent animation.
      const canvas = document.querySelector<HTMLCanvasElement>('#premium-confetti');
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      const ctx = canvas?.getContext('2d');
      if (canvas && ctx && !motion.matches) {
        const width = innerWidth, height = innerHeight, ratio = Math.min(devicePixelRatio || 1, 2);
        canvas.width = width * ratio; canvas.height = height * ratio;
        ctx.scale(ratio, ratio);
        const colors = ['#8bb9ff', '#3978ff', '#d2b982', '#f2e5ca', '#ffffff'];
        const pieces = Array.from({ length: width < 600 ? 55 : 95 }, () => ({
          x: Math.random() * width, y: -Math.random() * height * .8 - 20,
          speed: 90 + Math.random() * 110, sway: Math.random() * 50,
          angle: Math.random() * Math.PI, turn: Math.random() * 3 - 1.5,
          size: 4 + Math.random() * 5, color: colors[Math.floor(Math.random() * colors.length)],
        }));
        let previous = performance.now(), start = previous, frame = 0;
        const cleanup = () => { cancelAnimationFrame(frame); canvas.remove(); };
        const draw = (now: number) => {
          const elapsed = (now - start) / 1000, dt = Math.min((now - previous) / 1000, .04); previous = now;
          if (elapsed > 5 || motion.matches || document.hidden) { cleanup(); return; }
          ctx.clearRect(0, 0, width, height);
          ctx.globalAlpha = Math.min(1, (5 - elapsed) / 1.3);
          for (const p of pieces) {
            p.y += p.speed * dt; p.x += Math.sin(elapsed + p.angle) * p.sway * dt; p.angle += p.turn * dt;
            ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.angle); ctx.fillStyle = p.color;
            ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * .5); ctx.restore();
          }
          frame = requestAnimationFrame(draw);
        };
        frame = requestAnimationFrame(draw);
        window.addEventListener('pagehide', cleanup, { once: true });
      } else canvas?.remove();
    </script>
  </body>
</html>

<style is:global>
  html { scroll-behavior: smooth; background: #070b16; }
  body.premium-page { margin: 0; color: #f5f7fc; font-family: 'Inter', sans-serif; background: radial-gradient(ellipse 65% 650px at 50% 390px, #132a534d, transparent), #070b16; }
  .premium-page *, .premium-page *::before, .premium-page *::after { box-sizing: border-box; }
  .premium-page a { -webkit-tap-highlight-color: transparent; }
  .premium-page :focus-visible { outline: 3px solid #96bfff; outline-offset: 5px; }
  .preview-note { padding: 8px 16px; background: #101828; text-align: center; color: #9bacc6; font-size: 10px; letter-spacing: .04em; }
  .preview-note span { padding: 0 8px; }
  .premium-header { max-width: 1140px; margin: auto; padding: 28px 28px 0; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .signature { color: #e8ecf4; text-decoration: none; font-size: 11px; letter-spacing: .4em; }
  .header-mark { color: #8c9bb5; font-size: 10px; letter-spacing: .13em; }
  .header-mark b { color: #94baff; margin-left: 4px; }
  .premium-hero { max-width: 1060px; margin: auto; padding: 42px 28px 66px; text-align: center; }
  .purchase-confirmation { display: flex; gap: 14px; align-items: center; justify-content: center; max-width: 660px; margin: 0 auto 52px; padding: 18px 25px; text-align: left; background: linear-gradient(115deg, #123b373d, #12263e66); border: 1px solid #76b9ad30; border-radius: 16px; }
  .confirmation-icon { display: grid; place-items: center; color: #b6edcf; background: #8ce2ba13; border: 1px solid #8ce2ba35; border-radius: 50%; width: 38px; height: 38px; flex-shrink: 0; }
  .confirmation-icon svg { width: 24px; height: 24px; }
  .purchase-confirmation strong { font-size: 15px; font-weight: 600; color: #e5f7ed; }
  .purchase-confirmation p { color: #97b2b6; font-size: 12px; margin: 7px 0 0; line-height: 1.5; }
  .premium-eyebrow { font-size: 10px; font-weight: 600; letter-spacing: .22em; color: #b7ccef; margin: 0 0 20px; }
  .premium-hero h1 { font-size: clamp(31px, 4.5vw, 54px); font-weight: 700; line-height: 1.13; letter-spacing: -.045em; margin: 0; }
  .premium-hero h1 span { color: #90b9ff; }
  .premium-intro { max-width: 650px; margin: 23px auto 32px; color: #a4b0c6; font-size: 16px; line-height: 1.8; }
  .premium-intro strong { font-weight: 500; color: #e7edf9; }
  .premium-video { position: relative; aspect-ratio: 16 / 9; max-width: 900px; margin: auto; overflow: hidden; border-radius: 20px; border: 1px solid #719ceb36; background: radial-gradient(ellipse at 50% 70%, #193b73 0%, #101e38 37%, #0b1222 75%); box-shadow: 0 32px 90px #0005, 0 0 60px #3168cb0d; }
  .video-grid { position: absolute; inset: 0; opacity: .23; background: linear-gradient(#7b9dd71a 1px, transparent 1px), linear-gradient(90deg, #7b9dd71a 1px, transparent 1px); background-size: 58px 58px; mask-image: radial-gradient(ellipse, black, transparent 75%); }
  .video-content { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .play-placeholder { width: 72px; height: 72px; display: grid; place-items: center; border: 1px solid #a0c3ff66; background: #82aaff10; border-radius: 50%; box-shadow: 0 0 0 10px #8ab5ff05; }
  .play-placeholder svg { width: 28px; height: 28px; color: #dbe8ff; margin-left: 2px; }
  .video-content p { font-size: clamp(18px, 3vw, 31px); line-height: 1.35; font-weight: 400; letter-spacing: -.025em; margin: 26px 10px 18px; color: #a4bbdd; }
  .video-content strong { color: #e9f0fc; font-weight: 500; }
  .video-placeholder-label { color: #8fa4c4; font-size: 11px; }
  .video-corner, .video-brand { position: absolute; font-size: 9px; letter-spacing: .15em; color: #6e84a7; }
  .video-corner { top: 24px; left: 26px; }
  .video-brand { bottom: 22px; right: 26px; }
  .video-brand b { color: #b0c9f1; }
  .premium-discover { display: inline-flex; align-items: center; gap: 28px; color: #fff; background: linear-gradient(135deg, #3877f1, #2554bb); padding: 18px 26px; border: 1px solid #79a0ff55; border-radius: 12px; font-size: 14px; font-weight: 600; text-decoration: none; margin: 29px auto 18px; box-shadow: 0 8px 30px #2563eb18; transition: filter .2s; }
  .premium-discover:hover { filter: brightness(1.12); }
  .premium-skip { display: block; width: fit-content; margin: auto; color: #8694ab; font-size: 11px; text-underline-offset: 4px; }
  .premium-offer { scroll-margin-top: 24px; }
  .offer-divider { display: flex; align-items: center; gap: 25px; max-width: 900px; padding: 0 28px; margin: auto; color: #7185a4; font-size: 9px; letter-spacing: .2em; }
  .offer-divider::before, .offer-divider::after { content: ''; height: 1px; background: #93b2ed25; flex: 1; }
  /* MC2 scarcity depends on its session; never fabricate it for this independent preview. */
  .premium-page .deal-scarcity, .premium-page [data-limited-bonus] .es2-bonus-availability { display: none !important; }
  .premium-page:not(.past-premium-hero) #deal-sticky-cta { opacity: 0; visibility: hidden; pointer-events: none; }
  #premium-confetti { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 30; pointer-events: none; }
  .premium-footer { max-width: 900px; margin: 70px auto 0; padding: 30px 24px 95px; border-top: 1px solid #ffffff15; text-align: center; }
  .premium-footer a { color: #a8b7ce; font-size: 12px; text-underline-offset: 4px; }
  .premium-footer div { margin: 22px 0 15px; display: flex; justify-content: center; gap: 14px; color: #506381; }
  .premium-footer small { font-size: 10px; color: #6f7f99; }
  #premium-preview-dialog { width: min(520px, calc(100% - 32px)); padding: 36px; color: #e9effc; background: #101a2d; border: 1px solid #6e98d64d; border-radius: 22px; text-align: center; }
  #premium-preview-dialog::backdrop { background: #02050dd9; backdrop-filter: blur(7px); }
  .dialog-eyebrow { color: #9dbcf0; font-size: 10px; letter-spacing: .15em; }
  #premium-preview-dialog h2 { font-size: 26px; letter-spacing: -.03em; margin: 18px 0; }
  #premium-preview-dialog p { font-size: 14px; color: #a4b4cf; line-height: 1.7; }
  .preview-plans { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 25px 0; }
  .preview-plans div { padding: 20px 8px; background: #182946; border: 1px solid #82aaff30; border-radius: 12px; }
  .preview-plans strong { display: block; font-size: 23px; }
  .preview-plans span { display: block; font-size: 11px; margin-top: 8px; color: #a8bcda; }
  #premium-preview-dialog .preview-safety { font-size: 12px; }
  #preview-dialog-close { margin-top: 10px; width: 100%; border: 0; border-radius: 10px; padding: 16px; background: #2e65d8; color: white; font: 600 13px 'Inter', sans-serif; cursor: pointer; }
  @media (max-width: 600px) {
    .premium-header { padding: 23px 20px 0; }
    .signature { font-size: 9px; letter-spacing: .27em; }
    .header-mark { font-size: 8px; letter-spacing: .04em; }
    .premium-hero { padding: 27px 18px 45px; }
    .purchase-confirmation { padding: 15px; gap: 11px; margin-bottom: 37px; border-radius: 13px; }
    .purchase-confirmation strong { font-size: 12px; line-height: 1.5; display: block; }
    .purchase-confirmation p { font-size: 10px; margin-top: 3px; }
    .confirmation-icon { width: 30px; height: 30px; }
    .premium-eyebrow { font-size: 8px; letter-spacing: .14em; }
    .premium-hero h1 { font-size: clamp(27px, 7.8vw, 44px); }
    .premium-intro { font-size: 13px; line-height: 1.75; margin: 19px auto 25px; }
    .premium-video { border-radius: 13px; }
    .play-placeholder { width: 42px; height: 42px; }
    .play-placeholder svg { width: 20px; height: 20px; }
    .video-content p { font-size: 17px; margin: 14px 10px 10px; }
    .video-corner { top: 12px; left: 14px; font-size: 6px; }
    .video-brand { bottom: 11px; right: 14px; font-size: 6px; }
    .video-placeholder-label { font-size: 8px; }
    .premium-discover { font-size: 12px; padding: 16px 22px; margin-top: 24px; }
    #premium-preview-dialog { padding: 28px 20px; }
  }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .premium-discover { transition: none; } }
</style>
