<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'" />
    <title>Ouverture de la division…</title>
    <style>
      :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
      body { display: grid; min-height: 100vh; margin: 0; place-items: center; color: #effff7; background: #06100d; }
      main { width: min(420px, calc(100% - 40px)); padding: 34px; border: 1px solid rgba(85,230,178,.2); border-radius: 24px; background: #0d1c17; text-align: center; }
      i { display: block; width: 18px; height: 18px; margin: 0 auto 18px; border: 2px solid rgba(85,230,178,.2); border-top-color: #55e6b2; border-radius: 50%; animation: spin .8s linear infinite; }
      h1 { margin: 0 0 9px; font-size: 23px; }
      p { margin: 0; color: #8eaa9e; font-size: 13px; line-height: 1.6; }
      a { display: inline-block; margin-top: 18px; color: #55e6b2; }
      @keyframes spin { to { transform: rotate(360deg); } }
    </style>
  </head>
  <body>
    <main>
      <i aria-hidden="true"></i>
      <h1>Ouverture de la division…</h1>
      <p id="status">Transmission sécurisée de ta session du Hub.</p>
      <a id="fallback" href="https://sonnycourt.com/hub" hidden>Retourner au Hub</a>
    </main>
    <script is:inline>
      const status = document.getElementById('status');
      const fallback = document.getElementById('fallback');
      const token = decodeURIComponent(window.location.hash.slice(1));
      history.replaceState(null, '', '/sso');
      (async () => {
        try {
          if (!token) throw new Error('missing');
          const response = await fetch('/.netlify/functions/admin-emd-sso-complete', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token }),
          });
          if (!response.ok) throw new Error('expired');
          window.location.replace('/');
        } catch {
          status.textContent = 'Le passage sécurisé a expiré. Reviens au Hub pour rouvrir la division.';
          fallback.hidden = false;
        }
      })();
    </script>
  </body>
</html>

