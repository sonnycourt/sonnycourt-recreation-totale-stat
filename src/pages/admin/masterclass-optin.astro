---
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Opt-in Masterclass — Analytics</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
        * { box-sizing: border-box; }
        :root {
            --bg: #f4f7fb;
            --surface: #fff;
            --ink: #10213d;
            --muted: #68758a;
            --line: #dce4ef;
            --blue: #2563eb;
            --blue-soft: #eff6ff;
            --green: #15803d;
            --red: #b91c1c;
        }
        body {
            margin: 0;
            min-height: 100vh;
            background: var(--bg);
            color: var(--ink);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }
        button, input { font: inherit; }
        button { cursor: pointer; }
        [hidden] { display: none !important; }
        .shell { width: min(1180px, calc(100% - 32px)); margin: 0 auto; padding: 32px 0 56px; }
        .boot { display: grid; min-height: 70vh; place-items: center; color: var(--muted); }
        .login { display: grid; min-height: 80vh; place-items: center; }
        .login-card, .panel, .metric {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 18px;
            box-shadow: 0 8px 30px rgba(16, 33, 61, 0.06);
        }
        .login-card { width: min(390px, 100%); padding: 30px; text-align: center; }
        .login-card h1 { margin: 0 0 8px; font-size: 1.35rem; }
        .login-card p { margin: 0 0 20px; color: var(--muted); }
        input {
            width: 100%;
            min-height: 44px;
            padding: 10px 12px;
            border: 1px solid var(--line);
            border-radius: 10px;
            background: #fff;
            color: var(--ink);
        }
        input:focus { outline: 3px solid rgba(37, 99, 235, 0.16); border-color: var(--blue); }
        .btn {
            min-height: 44px;
            border: 0;
            border-radius: 10px;
            padding: 10px 16px;
            background: var(--blue);
            color: #fff;
            font-weight: 750;
        }
        .login-card .btn { width: 100%; margin-top: 12px; }
        .btn-ghost { background: #fff; color: var(--ink); border: 1px solid var(--line); }
        .error { min-height: 1.2em; margin-top: 10px; color: var(--red); font-size: .88rem; }
        .header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
        .header h1 { margin: 0; font-size: clamp(1.55rem, 3vw, 2.2rem); letter-spacing: -.03em; }
        .header p { margin: 5px 0 0; color: var(--muted); }
        .panel { padding: 18px; margin-bottom: 20px; }
        .filters { display: grid; grid-template-columns: repeat(2, minmax(150px, 220px)) auto; gap: 12px; align-items: end; }
        .field label { display: block; margin-bottom: 6px; color: var(--muted); font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
        .status { margin: 0 0 14px; color: var(--muted); font-size: .9rem; }
        .variant { margin-top: 28px; }
        .variant:first-child { margin-top: 0; }
        .variant h2 { margin: 0 0 14px; font-size: 1.15rem; }
        .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
        .metric { padding: 18px; }
        .metric h3 { margin: 0 0 12px; font-size: .9rem; }
        .metric-rate { font-size: 1.8rem; font-weight: 850; letter-spacing: -.04em; color: var(--blue); }
        .metric-volume { margin-top: 4px; color: var(--muted); font-size: .84rem; }
        .steps { display: grid; gap: 8px; margin-top: 16px; }
        .step { display: grid; grid-template-columns: 1fr auto; gap: 12px; padding-top: 8px; border-top: 1px solid var(--line); font-size: .82rem; }
        .step span:last-child { font-weight: 750; }
        .empty { padding: 34px; text-align: center; color: var(--muted); }
        .notice { padding: 12px 14px; border-radius: 10px; background: var(--blue-soft); color: #1e40af; font-size: .86rem; margin-bottom: 16px; }
        @media (max-width: 760px) {
            .header, .filters { grid-template-columns: 1fr; display: grid; }
            .metrics { grid-template-columns: 1fr; }
            .header .btn { width: fit-content; }
        }
    </style>
</head>
<body>
    <main class="shell">
        <section id="boot" class="boot">Chargement…</section>

        <section id="login-view" class="login" hidden>
            <form id="login-form" class="login-card">
                <h1>Analytics Masterclass</h1>
                <p>Utilise le mot de passe de l’admin ES2.</p>
                <input id="password" type="password" autocomplete="current-password" placeholder="Mot de passe" required />
                <button class="btn" type="submit">Se connecter</button>
                <div id="login-error" class="error" role="alert"></div>
            </form>
        </section>

        <section id="dashboard-view" hidden>
            <header class="header">
                <div>
                    <h1>Opt-in Masterclass</h1>
                    <p>Funnel interne pseudonyme, par variante et par segment pays.</p>
                </div>
                <button id="logout" class="btn btn-ghost" type="button">Déconnexion</button>
            </header>

            <div class="notice">
                Une « inscription » correspond ici uniquement à la confirmation finale réussie, pas à la capture de l’email à l’étape 1.
            </div>

            <section class="panel filters">
                <div class="field">
                    <label for="from">Depuis</label>
                    <input id="from" type="date" />
                </div>
                <div class="field">
                    <label for="to">Jusqu’au</label>
                    <input id="to" type="date" />
                </div>
                <button id="refresh" class="btn" type="button">Actualiser</button>
            </section>

            <p id="status" class="status"></p>
            <div id="results"></div>
        </section>
    </main>

    <script>
        // @ts-nocheck
        const SESSION_API = '/.netlify/functions/admin-es2-session';
        const LOGIN_API = '/.netlify/functions/admin-es2-login';
        const LOGOUT_API = '/.netlify/functions/admin-es2-logout';
        const DATA_API = '/.netlify/functions/admin-masterclass-optin';
        const STEP_LABELS = {
            page_view: 'Vue page',
            popup_opened: 'Popup ouverte',
            step_1_completed: 'Étape 1',
            step_2_completed: 'Étape 2',
            registration_completed: 'Inscription finale',
        };
        const SEGMENT_LABELS = {
            global: 'Global',
            pays_forts: 'Pays forts',
            autres: 'Autres pays',
            inconnu: 'Pays inconnu',
        };

        function setView(name) {
            document.getElementById('boot').hidden = name !== 'boot';
            document.getElementById('login-view').hidden = name !== 'login';
            document.getElementById('dashboard-view').hidden = name !== 'dashboard';
        }

        function localDateValue(date) {
            const offset = date.getTimezoneOffset() * 60000;
            return new Date(date.getTime() - offset).toISOString().slice(0, 10);
        }

        function formatRate(value) {
            return Number.isFinite(value) ? value.toLocaleString('fr-FR', { maximumFractionDigits: 1 }) + ' %' : '—';
        }

        function make(tag, className, text) {
            const element = document.createElement(tag);
            if (className) element.className = className;
            if (text !== undefined) element.textContent = text;
            return element;
        }

        function renderGroup(group) {
            const card = make('article', 'metric');
            card.appendChild(make('h3', '', SEGMENT_LABELS[group.segment] || group.segment));
            card.appendChild(make('div', 'metric-rate', formatRate(group.conversion_rate)));
            card.appendChild(
                make(
                    'div',
                    'metric-volume',
                    `${group.counts.page_view || 0} vues → ${group.counts.registration_completed || 0} inscriptions`,
                ),
            );
            const steps = make('div', 'steps');
            for (const step of group.steps) {
                const row = make('div', 'step');
                row.appendChild(make('span', '', STEP_LABELS[step.name] || step.name));
                row.appendChild(
                    make(
                        'span',
                        '',
                        `${step.count} · ${formatRate(step.from_view_rate)}`,
                    ),
                );
                steps.appendChild(row);
            }
            card.appendChild(steps);
            return card;
        }

        function render(data) {
            const root = document.getElementById('results');
            root.replaceChildren();
            const groups = Array.isArray(data.groups) ? data.groups : [];
            if (!groups.length) {
                root.appendChild(make('div', 'panel empty', 'Aucune donnée sur cette période.'));
                return;
            }

            const variants = new Map();
            for (const group of groups) {
                if (!variants.has(group.variant)) variants.set(group.variant, []);
                variants.get(group.variant).push(group);
            }
            for (const [variant, variantGroups] of variants) {
                const section = make('section', 'variant');
                section.appendChild(make('h2', '', `Variante ${variant}`));
                const grid = make('div', 'metrics');
                const order = ['global', 'pays_forts', 'autres', 'inconnu'];
                variantGroups.sort((a, b) => order.indexOf(a.segment) - order.indexOf(b.segment));
                for (const group of variantGroups) grid.appendChild(renderGroup(group));
                section.appendChild(grid);
                root.appendChild(section);
            }
        }

        async function loadData() {
            const status = document.getElementById('status');
            const fromValue = document.getElementById('from').value;
            const toValue = document.getElementById('to').value;
            const from = new Date(`${fromValue}T00:00:00`).toISOString();
            const to = new Date(`${toValue}T23:59:59.999`).toISOString();
            status.textContent = 'Chargement…';
            const response = await fetch(
                `${DATA_API}?from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`,
                { credentials: 'same-origin' },
            );
            if (response.status === 401) {
                setView('login');
                return;
            }
            const body = await response.json();
            if (!response.ok) throw new Error(body.error || 'Lecture impossible');
            render(body);
            status.textContent = `${body.tracked_funnels} parcours suivis · actualisé à ${new Date(body.generated_at).toLocaleString('fr-FR')}`;
        }

        async function showDashboard() {
            setView('dashboard');
            try {
                await loadData();
            } catch (error) {
                document.getElementById('status').textContent = error.message || 'Lecture impossible';
            }
        }

        document.getElementById('login-form').addEventListener('submit', async function (event) {
            event.preventDefault();
            const error = document.getElementById('login-error');
            error.textContent = '';
            const password = document.getElementById('password').value;
            const response = await fetch(LOGIN_API, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ password }),
            });
            const body = await response.json().catch(() => ({}));
            if (!response.ok) {
                error.textContent = body.error || 'Connexion impossible';
                return;
            }
            document.getElementById('password').value = '';
            await showDashboard();
        });

        document.getElementById('refresh').addEventListener('click', function () {
            loadData().catch(function (error) {
                document.getElementById('status').textContent = error.message || 'Lecture impossible';
            });
        });

        document.getElementById('logout').addEventListener('click', async function () {
            await fetch(LOGOUT_API, { method: 'POST', credentials: 'same-origin' }).catch(() => {});
            setView('login');
        });

        async function boot() {
            const today = new Date();
            const w9Start = new Date('2026-07-23T17:21:32+02:00');
            document.getElementById('from').value = localDateValue(w9Start);
            document.getElementById('to').value = localDateValue(today);
            const response = await fetch(SESSION_API, { credentials: 'same-origin' }).catch(() => null);
            if (response && response.ok) {
                await showDashboard();
            } else {
                setView('login');
            }
        }

        boot();
    </script>
</body>
</html>
