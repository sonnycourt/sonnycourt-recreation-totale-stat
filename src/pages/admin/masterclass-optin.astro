---
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light only" />
    <title>Opt-in Masterclass — Cockpit KPI</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
        * { box-sizing: border-box; }
        [hidden] { display: none !important; }

        :root {
            color-scheme: light only;
            --canvas: #f3f6fb;
            --surface: #ffffff;
            --surface-soft: #f8fafc;
            --ink: #10213d;
            --ink-2: #334155;
            --muted: #6b7890;
            --line: #dfe7f1;
            --line-strong: #ccd8e7;
            --blue: #2563eb;
            --blue-dark: #1d4ed8;
            --blue-soft: #edf4ff;
            --cyan: #0891b2;
            --green: #0f9f6e;
            --green-soft: #eafaf4;
            --amber: #d97706;
            --amber-soft: #fff7e8;
            --red: #dc2626;
            --shadow: 0 12px 36px rgba(30, 55, 90, 0.07);
        }

        body {
            margin: 0;
            min-height: 100vh;
            background:
                radial-gradient(circle at 10% 0%, rgba(37, 99, 235, 0.07), transparent 28rem),
                var(--canvas);
            color: var(--ink);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        button, input { font: inherit; }
        button { cursor: pointer; }

        .shell {
            width: min(1240px, calc(100% - 40px));
            margin: 0 auto;
            padding: 30px 0 60px;
        }

        .boot {
            min-height: 70vh;
            display: grid;
            place-items: center;
            color: var(--muted);
            font-weight: 650;
        }

        .login {
            min-height: 82vh;
            display: grid;
            place-items: center;
        }

        .login-card,
        .panel,
        .kpi-card,
        .decision-card {
            background: var(--surface);
            border: 1px solid var(--line);
            box-shadow: var(--shadow);
        }

        .login-card {
            width: min(400px, 100%);
            padding: 34px;
            border-radius: 22px;
            text-align: center;
        }

        .login-mark {
            width: 46px;
            height: 46px;
            margin: 0 auto 18px;
            border-radius: 14px;
            background: linear-gradient(145deg, var(--blue), #60a5fa);
            box-shadow: 0 12px 26px rgba(37, 99, 235, 0.24);
        }

        .login-card h1 { margin: 0 0 8px; font-size: 1.45rem; letter-spacing: -0.025em; }
        .login-card p { margin: 0 0 22px; color: var(--muted); line-height: 1.55; }

        input {
            width: 100%;
            min-height: 46px;
            padding: 10px 13px;
            border: 1px solid var(--line-strong);
            border-radius: 11px;
            background: #fff;
            color: var(--ink);
        }

        input:focus {
            outline: 3px solid rgba(37, 99, 235, 0.14);
            border-color: var(--blue);
        }

        .btn {
            min-height: 44px;
            border: 0;
            border-radius: 11px;
            padding: 10px 17px;
            background: linear-gradient(135deg, var(--blue), var(--blue-dark));
            color: #fff;
            font-weight: 780;
            box-shadow: 0 8px 18px rgba(37, 99, 235, 0.19);
            transition: transform 0.16s ease, box-shadow 0.16s ease, opacity 0.16s ease;
        }

        .btn:hover { transform: translateY(-1px); box-shadow: 0 10px 22px rgba(37, 99, 235, 0.24); }
        .btn:disabled { opacity: 0.58; cursor: default; transform: none; }
        .btn-ghost { background: #fff; color: var(--ink-2); border: 1px solid var(--line); box-shadow: none; }
        .login-card .btn { width: 100%; margin-top: 13px; }
        .error { min-height: 1.2em; margin-top: 11px; color: var(--red); font-size: 0.86rem; font-weight: 650; }

        .topbar {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 24px;
        }

        .eyebrow {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 8px;
            color: var(--blue);
            font-size: 0.76rem;
            font-weight: 820;
            letter-spacing: 0.09em;
            text-transform: uppercase;
        }

        .live-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 0 5px rgba(15, 159, 110, 0.11);
        }

        .topbar h1 {
            margin: 0;
            font-size: clamp(1.75rem, 3vw, 2.45rem);
            line-height: 1.08;
            letter-spacing: -0.045em;
        }

        .topbar p { margin: 8px 0 0; color: var(--muted); font-size: 0.95rem; }
        .top-actions { display: flex; align-items: center; gap: 10px; }

        .source-panel {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 13px 14px;
            margin-bottom: 12px;
            border-radius: 16px;
        }

        .source-title strong { display: block; font-size: 0.82rem; }
        .source-title span { display: block; margin-top: 2px; color: var(--muted); font-size: 0.7rem; }

        .source-switcher {
            display: flex;
            gap: 5px;
            padding: 4px;
            border: 1px solid var(--line);
            border-radius: 12px;
            background: var(--surface-soft);
        }

        .source-button {
            min-height: 34px;
            padding: 7px 13px;
            border: 0;
            border-radius: 8px;
            background: transparent;
            color: var(--muted);
            font-size: 0.75rem;
            font-weight: 790;
            transition: background 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
        }

        .source-button:hover { color: var(--ink); }
        .source-button.is-active {
            background: #fff;
            color: var(--blue);
            box-shadow: 0 3px 10px rgba(30, 55, 90, 0.11);
        }

        .filter-panel {
            display: grid;
            grid-template-columns: minmax(150px, 210px) minmax(150px, 210px) auto 1fr;
            gap: 12px;
            align-items: end;
            padding: 14px;
            margin-bottom: 18px;
            border-radius: 16px;
        }

        .field label {
            display: block;
            margin: 0 0 6px 2px;
            color: var(--muted);
            font-size: 0.69rem;
            font-weight: 820;
            letter-spacing: 0.07em;
            text-transform: uppercase;
        }

        .refresh-meta {
            align-self: center;
            justify-self: end;
            color: var(--muted);
            font-size: 0.81rem;
            text-align: right;
        }

        .decision-card {
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
            gap: 16px;
            min-height: 92px;
            padding: 18px 20px;
            margin-bottom: 18px;
            border-radius: 18px;
            overflow: hidden;
            position: relative;
        }

        .decision-card::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 5px;
            background: var(--amber);
        }

        .decision-card.is-solid::before { background: var(--green); }
        .decision-card.is-testing::before { background: var(--blue); }

        .decision-icon {
            display: grid;
            width: 46px;
            height: 46px;
            place-items: center;
            border-radius: 14px;
            background: var(--amber-soft);
            color: var(--amber);
            font-size: 1.25rem;
            font-weight: 900;
        }

        .decision-card.is-solid .decision-icon { background: var(--green-soft); color: var(--green); }
        .decision-card.is-testing .decision-icon { background: var(--blue-soft); color: var(--blue); }

        .decision-copy h2 { margin: 0 0 4px; font-size: 1rem; letter-spacing: -0.015em; }
        .decision-copy p { margin: 0; color: var(--muted); font-size: 0.87rem; line-height: 1.45; }

        .sample-chip {
            min-width: 150px;
            padding: 10px 12px;
            border-radius: 12px;
            background: var(--surface-soft);
            border: 1px solid var(--line);
        }

        .sample-chip strong { display: block; font-size: 0.9rem; }
        .sample-chip span { color: var(--muted); font-size: 0.75rem; }

        .sample-track,
        .progress-track,
        .mini-track {
            overflow: hidden;
            background: #e9eef6;
            border-radius: 999px;
        }

        .sample-track { height: 5px; margin-top: 8px; }
        .sample-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--blue), #60a5fa); }

        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
            margin-bottom: 18px;
        }

        .kpi-card {
            min-height: 152px;
            padding: 18px;
            border-radius: 17px;
            box-shadow: 0 8px 28px rgba(30, 55, 90, 0.055);
        }

        .kpi-card.is-priority {
            border-color: rgba(37, 99, 235, 0.28);
            background: linear-gradient(150deg, #ffffff 35%, #f0f6ff 100%);
        }

        .kpi-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
        .kpi-label { color: var(--muted); font-size: 0.75rem; font-weight: 780; text-transform: uppercase; letter-spacing: 0.055em; }
        .kpi-badge { padding: 4px 7px; border-radius: 999px; background: var(--blue-soft); color: var(--blue); font-size: 0.64rem; font-weight: 820; text-transform: uppercase; }
        .kpi-value { margin-top: 17px; font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 870; letter-spacing: -0.055em; line-height: 1; }
        .kpi-sub { margin-top: 9px; color: var(--muted); font-size: 0.79rem; }
        .kpi-sub strong { color: var(--ink-2); }

        .content-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.55fr) minmax(310px, 0.85fr);
            gap: 18px;
            align-items: start;
        }

        .panel { padding: 20px; border-radius: 18px; }
        .panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
        .panel-head h2 { margin: 0; font-size: 1.02rem; letter-spacing: -0.02em; }
        .panel-head p { margin: 4px 0 0; color: var(--muted); font-size: 0.78rem; }
        .variant-pill { padding: 5px 9px; border-radius: 999px; background: var(--blue-soft); color: var(--blue); font-size: 0.7rem; font-weight: 820; text-transform: uppercase; }

        .funnel-list { display: grid; gap: 14px; }
        .funnel-stage { display: grid; gap: 7px; }
        .stage-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .stage-title { display: flex; align-items: center; gap: 9px; font-size: 0.84rem; font-weight: 730; }
        .stage-index { display: grid; width: 24px; height: 24px; place-items: center; border-radius: 8px; background: var(--surface-soft); color: var(--muted); font-size: 0.68rem; font-weight: 850; }
        .stage-values { display: flex; align-items: baseline; gap: 8px; }
        .stage-count { font-size: 0.92rem; font-weight: 850; }
        .stage-rate { color: var(--muted); font-size: 0.72rem; }
        .progress-track { height: 9px; }
        .progress-fill { height: 100%; min-width: 3px; border-radius: inherit; background: linear-gradient(90deg, var(--blue), #60a5fa); transition: width 0.45s ease; }
        .funnel-stage:last-child .progress-fill { background: linear-gradient(90deg, var(--green), #34d399); }
        .stage-foot { display: flex; justify-content: flex-end; min-height: 1em; color: var(--muted); font-size: 0.69rem; }

        .side-stack { display: grid; gap: 18px; }
        .segment-list { display: grid; gap: 12px; }
        .segment-card { padding: 14px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface-soft); }
        .segment-card.is-priority { border-color: rgba(37, 99, 235, 0.24); background: var(--blue-soft); }
        .segment-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
        .segment-name { font-size: 0.8rem; font-weight: 790; }
        .segment-volume { margin-top: 3px; color: var(--muted); font-size: 0.7rem; }
        .segment-rate { font-size: 1.23rem; font-weight: 870; letter-spacing: -0.035em; }
        .mini-track { height: 6px; margin-top: 12px; }
        .mini-fill { height: 100%; border-radius: inherit; background: var(--cyan); }
        .segment-card.is-priority .mini-fill { background: var(--blue); }

        .data-note {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 11px;
            padding: 13px;
            border-radius: 13px;
            background: var(--green-soft);
            color: #09684b;
            font-size: 0.76rem;
            line-height: 1.5;
        }

        .data-note-mark { width: 22px; height: 22px; display: grid; place-items: center; border-radius: 50%; background: #c9f4e2; font-weight: 900; }

        .variant-section + .variant-section { margin-top: 20px; }
        .empty { padding: 46px 28px; text-align: center; color: var(--muted); }
        .empty strong { display: block; margin-bottom: 5px; color: var(--ink-2); }
        .screen-error { padding: 16px; border-radius: 13px; background: #fff1f2; color: #b42336; font-weight: 650; }

        @media (max-width: 980px) {
            .kpi-grid { grid-template-columns: repeat(2, 1fr); }
            .content-grid { grid-template-columns: 1fr; }
            .side-stack { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .filter-panel { grid-template-columns: 1fr 1fr auto; }
            .refresh-meta { grid-column: 1 / -1; justify-self: start; text-align: left; }
        }

        @media (max-width: 680px) {
            .shell { width: min(100% - 24px, 1240px); padding-top: 20px; }
            .topbar { display: grid; }
            .top-actions { position: absolute; top: 16px; right: 12px; }
            .top-actions .btn { min-height: 38px; padding: 8px 11px; font-size: 0.76rem; }
            .topbar p { max-width: 78%; }
            .source-panel { display: grid; }
            .source-switcher { overflow-x: auto; }
            .source-button { flex: 0 0 auto; }
            .filter-panel { grid-template-columns: 1fr 1fr; }
            .filter-panel .btn { grid-column: 1 / -1; }
            .decision-card { grid-template-columns: auto 1fr; }
            .sample-chip { grid-column: 1 / -1; }
            .kpi-grid, .side-stack { grid-template-columns: 1fr; }
            .kpi-card { min-height: 136px; }
            .panel { padding: 16px; }
        }
    </style>
</head>
<body>
    <main class="shell">
        <section id="boot" class="boot">Chargement du cockpit…</section>

        <section id="login-view" class="login" hidden>
            <form id="login-form" class="login-card">
                <div class="login-mark" aria-hidden="true"></div>
                <h1>Cockpit Masterclass</h1>
                <p>Connecte-toi avec le mot de passe de l’admin ES2.</p>
                <input id="password" type="password" autocomplete="current-password" placeholder="Mot de passe" required />
                <button class="btn" type="submit">Ouvrir le cockpit</button>
                <div id="login-error" class="error" role="alert"></div>
            </form>
        </section>

        <section id="dashboard-view" hidden>
            <header class="topbar">
                <div>
                    <div class="eyebrow"><span class="live-dot"></span> Tracking interne actif</div>
                    <h1>Opt-in Masterclass</h1>
                    <p>La performance business, les pays forts et les pertes du funnel en un coup d’œil.</p>
                </div>
                <div class="top-actions">
                    <button id="logout" class="btn btn-ghost" type="button">Déconnexion</button>
                </div>
            </header>

            <section class="panel source-panel" aria-label="Source d’acquisition">
                <div class="source-title">
                    <strong>Source d’acquisition</strong>
                    <span>Données comparables depuis le tracking complet : 28/07/2026 à 22:28.</span>
                </div>
                <div class="source-switcher" role="group" aria-label="Filtrer par source">
                    <button class="source-button is-active" type="button" data-source="all" aria-pressed="true">Tout</button>
                    <button class="source-button" type="button" data-source="organic" aria-pressed="false">Organique</button>
                    <button class="source-button" type="button" data-source="meta_ad" aria-pressed="false">Meta Ads</button>
                    <button class="source-button" type="button" data-source="tiktok_ad" aria-pressed="false">TikTok Ads</button>
                </div>
            </section>

            <section class="panel filter-panel" aria-label="Période d’analyse">
                <div class="field">
                    <label for="from">Depuis</label>
                    <input id="from" type="date" />
                </div>
                <div class="field">
                    <label for="to">Jusqu’au</label>
                    <input id="to" type="date" />
                </div>
                <button id="refresh" class="btn" type="button">Actualiser</button>
                <div id="status" class="refresh-meta" aria-live="polite"></div>
            </section>

            <div id="results"></div>
        </section>
    </main>

    <script>
        // @ts-nocheck
        const SESSION_API = '/.netlify/functions/admin-es2-session';
        const LOGIN_API = '/.netlify/functions/admin-es2-login';
        const LOGOUT_API = '/.netlify/functions/admin-es2-logout';
        const DATA_API = '/.netlify/functions/admin-masterclass-optin';
        const RICH_SAMPLE_TARGET = 500;
        const COMPLETE_TRACKING_START = new Date('2026-07-28T20:28:05.586Z');
        const COMPLETE_TRACKING_START_DATE = '2026-07-28';
        const SOURCE_LABELS = {
            all: 'Tout le trafic',
            organic: 'Organique',
            meta_ad: 'Meta Ads',
            tiktok_ad: 'TikTok Ads',
            other: 'Autre source',
        };
        let selectedSource = 'all';
        let latestData = null;

        const STEP_LABELS = {
            page_view: 'Visiteurs de la page',
            cta_clicked: 'Bouton d’inscription cliqué',
            popup_opened: 'Formulaire affiché après l’animation',
            step_1_completed: 'Prénom + email validés',
            step_2_completed: 'Téléphone validé',
            commitment_checked: 'Engagement de présence coché',
            registration_submitted: 'Inscription envoyée',
            registration_completed: 'Inscription confirmée',
        };

        function setView(name) {
            document.getElementById('boot').hidden = name !== 'boot';
            document.getElementById('login-view').hidden = name !== 'login';
            document.getElementById('dashboard-view').hidden = name !== 'dashboard';
        }

        function localDateValue(date) {
            const offset = date.getTimezoneOffset() * 60000;
            return new Date(date.getTime() - offset).toISOString().slice(0, 10);
        }

        function formatRate(value, digits = 1) {
            return Number.isFinite(value)
                ? value.toLocaleString('fr-FR', { minimumFractionDigits: digits, maximumFractionDigits: digits }) + ' %'
                : '—';
        }

        function formatNumber(value) {
            return Number(value || 0).toLocaleString('fr-FR');
        }

        function make(tag, className, text) {
            const element = document.createElement(tag);
            if (className) element.className = className;
            if (text !== undefined) element.textContent = text;
            return element;
        }

        function findGroup(groups, variant, source, segment) {
            return groups.find(
                (group) =>
                    group.variant === variant &&
                    group.source === source &&
                    group.segment === segment,
            ) || null;
        }

        function emptyGroup(segment) {
            return {
                segment,
                conversion_rate: null,
                counts: {
                    page_view: 0,
                    cta_clicked: 0,
                    popup_opened: 0,
                    step_1_completed: 0,
                    step_2_completed: 0,
                    commitment_checked: 0,
                    registration_submitted: 0,
                    registration_completed: 0,
                },
                steps: [],
            };
        }

        function renderDecision(rich, global) {
            const views = rich.counts.page_view || 0;
            const progress = Math.min(100, (views / RICH_SAMPLE_TARGET) * 100);
            const card = make('section', 'decision-card');
            const icon = make('div', 'decision-icon', '!');
            const copy = make('div', 'decision-copy');
            const title = make('h2');
            const description = make('p');

            if (views >= RICH_SAMPLE_TARGET) {
                card.classList.add('is-solid');
                icon.textContent = '✓';
                title.textContent = 'Échantillon pays forts exploitable';
                description.textContent = `La conversion pays forts est à ${formatRate(rich.conversion_rate)}. Tu peux commencer à arbitrer avec davantage de confiance.`;
            } else if (views >= 100) {
                card.classList.add('is-testing');
                icon.textContent = '↗';
                title.textContent = 'Signal en formation — continue la collecte';
                description.textContent = `La tendance pays forts est à ${formatRate(rich.conversion_rate)}, mais le volume reste insuffisant pour déclarer un gagnant.`;
            } else {
                title.textContent = 'Trop tôt pour prendre une décision';
                description.textContent = `Seulement ${formatNumber(views)} visiteurs pays forts. Observe le funnel, mais ne modifie pas encore la page sur cette base.`;
            }

            copy.append(title, description);

            const sample = make('div', 'sample-chip');
            sample.appendChild(make('strong', '', `${formatNumber(views)} / ${formatNumber(RICH_SAMPLE_TARGET)} visiteurs`));
            sample.appendChild(make('span', '', 'Objectif pays forts'));
            const track = make('div', 'sample-track');
            const fill = make('div', 'sample-fill');
            fill.style.width = `${progress}%`;
            track.appendChild(fill);
            sample.appendChild(track);

            card.append(icon, copy, sample);
            return card;
        }

        function renderKpi(label, value, sub, options = {}) {
            const card = make('article', 'kpi-card' + (options.priority ? ' is-priority' : ''));
            const top = make('div', 'kpi-top');
            top.appendChild(make('div', 'kpi-label', label));
            if (options.badge) top.appendChild(make('span', 'kpi-badge', options.badge));
            card.appendChild(top);
            card.appendChild(make('div', 'kpi-value', value));
            card.appendChild(make('div', 'kpi-sub', sub));
            return card;
        }

        function renderKpis(global, rich, other, trackedFunnels) {
            const grid = make('section', 'kpi-grid');
            grid.append(
                renderKpi(
                    'Conversion globale',
                    formatRate(global.conversion_rate),
                    `${formatNumber(global.counts.page_view)} visiteurs → ${formatNumber(global.counts.registration_completed)} inscrits`,
                ),
                renderKpi(
                    'Conversion pays forts',
                    formatRate(rich.conversion_rate),
                    `${formatNumber(rich.counts.page_view)} visiteurs → ${formatNumber(rich.counts.registration_completed)} inscrits`,
                    { priority: true, badge: 'Priorité business' },
                ),
                renderKpi(
                    'Conversion autres pays',
                    formatRate(other.conversion_rate),
                    `${formatNumber(other.counts.page_view)} visiteurs → ${formatNumber(other.counts.registration_completed)} inscrits`,
                ),
                renderKpi(
                    'Parcours suivis',
                    formatNumber(trackedFunnels),
                    `${formatNumber(global.counts.registration_completed)} inscriptions finales réellement confirmées`,
                    { badge: 'Donnée interne' },
                ),
            );
            return grid;
        }

        function renderFunnel(global, variant, source) {
            const panel = make('section', 'panel');
            const head = make('div', 'panel-head');
            const headCopy = make('div');
            headCopy.append(
                make('h2', '', 'Funnel de conversion'),
                make('p', '', 'Chaque pourcentage est calculé depuis les visiteurs de la page.'),
            );
            head.append(headCopy, make('span', 'variant-pill', `${variant} · ${SOURCE_LABELS[source] || source}`));
            panel.appendChild(head);

            const list = make('div', 'funnel-list');
            const steps = Array.isArray(global.steps) ? global.steps : [];
            steps.forEach((step, index) => {
                const row = make('div', 'funnel-stage');
                const rowHead = make('div', 'stage-head');
                const title = make('div', 'stage-title');
                title.append(
                    make('span', 'stage-index', String(index + 1).padStart(2, '0')),
                    make('span', '', STEP_LABELS[step.name] || step.name),
                );
                const values = make('div', 'stage-values');
                values.append(
                    make('span', 'stage-count', formatNumber(step.count)),
                    make('span', 'stage-rate', formatRate(step.from_view_rate, 0)),
                );
                rowHead.append(title, values);

                const track = make('div', 'progress-track');
                const fill = make('div', 'progress-fill');
                fill.style.width = `${Math.max(0, Math.min(100, step.from_view_rate || 0))}%`;
                track.appendChild(fill);

                const foot = make(
                    'div',
                    'stage-foot',
                    index === 0
                        ? 'Point de départ'
                        : `${formatRate(step.previous_rate, 0)} passent l’étape précédente`,
                );
                row.append(rowHead, track, foot);
                list.appendChild(row);
            });
            panel.appendChild(list);
            return panel;
        }

        function renderSegmentCard(name, group, priority) {
            const card = make('article', 'segment-card' + (priority ? ' is-priority' : ''));
            const top = make('div', 'segment-top');
            const copy = make('div');
            copy.append(
                make('div', 'segment-name', name),
                make(
                    'div',
                    'segment-volume',
                    `${formatNumber(group.counts.page_view)} visiteurs · ${formatNumber(group.counts.registration_completed)} inscrits`,
                ),
            );
            top.append(copy, make('div', 'segment-rate', formatRate(group.conversion_rate)));
            const track = make('div', 'mini-track');
            const fill = make('div', 'mini-fill');
            fill.style.width = `${Math.max(0, Math.min(100, group.conversion_rate || 0))}%`;
            track.appendChild(fill);
            card.append(top, track);
            return card;
        }

        function renderSide(rich, other) {
            const stack = make('aside', 'side-stack');

            const segments = make('section', 'panel');
            const head = make('div', 'panel-head');
            const copy = make('div');
            copy.append(
                make('h2', '', 'Segments pays'),
                make('p', '', 'Lecture prioritaire : les pays qui achètent.'),
            );
            head.appendChild(copy);
            segments.appendChild(head);
            const list = make('div', 'segment-list');
            list.append(
                renderSegmentCard('Pays forts', rich, true),
                renderSegmentCard('Autres pays', other, false),
            );
            segments.appendChild(list);

            const quality = make('section', 'panel');
            const qualityHead = make('div', 'panel-head');
            const qualityCopy = make('div');
            qualityCopy.append(
                make('h2', '', 'Qualité de la mesure'),
                make('p', '', 'Pourquoi cette donnée est plus fiable.'),
            );
            qualityHead.appendChild(qualityCopy);
            quality.appendChild(qualityHead);
            const note = make('div', 'data-note');
            note.append(
                make('div', 'data-note-mark', '✓'),
                make(
                    'div',
                    '',
                    'Une inscription est comptée uniquement après la confirmation finale. Le prénom, l’email et le téléphone ne sont jamais stockés dans ce tracker.',
                ),
            );
            quality.appendChild(note);

            stack.append(segments, quality);
            return stack;
        }

        function renderVariant(groups, variant, source, trackedFunnels) {
            const global = findGroup(groups, variant, source, 'global') || emptyGroup('global');
            const rich = findGroup(groups, variant, source, 'pays_forts') || emptyGroup('pays_forts');
            const other = findGroup(groups, variant, source, 'autres') || emptyGroup('autres');
            const section = make('section', 'variant-section');
            section.append(
                renderDecision(rich, global),
                renderKpis(global, rich, other, trackedFunnels),
            );
            const content = make('div', 'content-grid');
            content.append(renderFunnel(global, variant, source), renderSide(rich, other));
            section.appendChild(content);
            return section;
        }

        function selectedTrackedFunnels(data) {
            if (selectedSource === 'all') return data.tracked_funnels || 0;
            return data.tracked_funnels_by_source?.[selectedSource] || 0;
        }

        function updateSourceButtons() {
            document.querySelectorAll('.source-button').forEach((button) => {
                const isActive = button.dataset.source === selectedSource;
                button.classList.toggle('is-active', isActive);
                button.setAttribute('aria-pressed', String(isActive));
            });
        }

        function render(data) {
            const root = document.getElementById('results');
            root.replaceChildren();
            const groups = Array.isArray(data.groups) ? data.groups : [];
            const sourceGroups = groups.filter((group) => group.source === selectedSource);
            if (!sourceGroups.length) {
                const empty = make('div', 'panel empty');
                empty.append(
                    make('strong', '', `Aucun parcours ${SOURCE_LABELS[selectedSource].toLowerCase()} sur cette période`),
                    make('span', '', 'Le cockpit se remplira automatiquement dès la prochaine visite de cette source.'),
                );
                root.appendChild(empty);
                return;
            }

            const trackedFunnels = selectedTrackedFunnels(data);
            const variants = [...new Set(sourceGroups.map((group) => group.variant || 'v2'))];
            for (const variant of variants) {
                root.appendChild(renderVariant(sourceGroups, variant, selectedSource, trackedFunnels));
            }
        }

        async function loadData() {
            const status = document.getElementById('status');
            const refresh = document.getElementById('refresh');
            const fromValue = document.getElementById('from').value;
            const toValue = document.getElementById('to').value;
            const requestedFrom = new Date(`${fromValue}T00:00:00`);
            const from = new Date(
                Math.max(requestedFrom.getTime(), COMPLETE_TRACKING_START.getTime()),
            ).toISOString();
            const to = new Date(`${toValue}T23:59:59.999`).toISOString();

            refresh.disabled = true;
            refresh.textContent = 'Actualisation…';
            status.textContent = 'Lecture des événements…';

            try {
                const response = await fetch(
                    `${DATA_API}?from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`,
                    { credentials: 'same-origin' },
                );
                if (response.status === 401) {
                    setView('login');
                    return;
                }
                const body = await response.json();
                if (!response.ok) throw new Error(body.error || 'Lecture impossible');
                latestData = body;
                render(body);
                status.textContent = `${SOURCE_LABELS[selectedSource]} · ${formatNumber(selectedTrackedFunnels(body))} parcours · mis à jour ${new Date(body.generated_at).toLocaleString('fr-FR', { hour: '2-digit', minute: '2-digit' })}`;
            } finally {
                refresh.disabled = false;
                refresh.textContent = 'Actualiser';
            }
        }

        async function showDashboard() {
            setView('dashboard');
            try {
                await loadData();
            } catch (error) {
                const root = document.getElementById('results');
                root.replaceChildren(make('div', 'screen-error', error.message || 'Lecture impossible'));
                document.getElementById('status').textContent = 'Erreur de chargement';
            }
        }

        document.getElementById('login-form').addEventListener('submit', async function (event) {
            event.preventDefault();
            const error = document.getElementById('login-error');
            error.textContent = '';
            const password = document.getElementById('password').value;
            const response = await fetch(LOGIN_API, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ password }),
            });
            const body = await response.json().catch(() => ({}));
            if (!response.ok) {
                error.textContent = body.error || 'Connexion impossible';
                return;
            }
            document.getElementById('password').value = '';
            await showDashboard();
        });

        document.getElementById('refresh').addEventListener('click', function () {
            loadData().catch(function (error) {
                const root = document.getElementById('results');
                root.replaceChildren(make('div', 'screen-error', error.message || 'Lecture impossible'));
            });
        });

        document.querySelectorAll('.source-button').forEach((button) => {
            button.addEventListener('click', function () {
                selectedSource = this.dataset.source || 'all';
                updateSourceButtons();
                if (latestData) {
                    render(latestData);
                    document.getElementById('status').textContent =
                        `${SOURCE_LABELS[selectedSource]} · ${formatNumber(selectedTrackedFunnels(latestData))} parcours`;
                }
            });
        });

        document.getElementById('logout').addEventListener('click', async function () {
            await fetch(LOGOUT_API, { method: 'POST', credentials: 'same-origin' }).catch(() => {});
            setView('login');
        });

        async function boot() {
            const today = new Date();
            const fromInput = document.getElementById('from');
            fromInput.min = COMPLETE_TRACKING_START_DATE;
            fromInput.value = COMPLETE_TRACKING_START_DATE;
            document.getElementById('to').value = localDateValue(today);
            const response = await fetch(SESSION_API, { credentials: 'same-origin' }).catch(() => null);
            if (response && response.ok) {
                await showDashboard();
            } else {
                setView('login');
            }
        }

        boot();
    </script>
</body>
</html>
