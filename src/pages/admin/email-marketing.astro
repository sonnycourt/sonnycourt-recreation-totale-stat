          emailStudioState.mailerlite = { campaign: data.campaign, syncedSnapshot: draftSnapshot(emailStudioState.draft), at: new Date().toISOString() };
          finalApprovalToken = '';
          persistEmailStudioState();
          persistWorkspaceDurably();
          renderEmailStudio();
          showToast('Brouillon MailerLite synchronisé. Aucun envoi n’a été effectué.');
