      function computeMaturity(metrics) {
        let score = 42;
        if (metrics.campaignsLast30Days >= 4) score += 16;
        else score += Math.min(12, metrics.campaignsLast30Days * 3);
        if (metrics.openRate90Days >= 20) score += 12;
        if (metrics.clickRate90Days >= 1) score += 12;
        else if (metrics.clickRate90Days >= .4) score += 5;
        if (metrics.unsubscribeRate90Days <= .3) score += 8;
        if (metrics.activeAutomations >= 10) score += 6;
        if (metrics.trackedRecentCampaigns > 0) score += 4;
        return Math.min(100, score);
      }

      function showAgentFocus(agent) {
        if (!agent) return;
        selectedAgentId = agent.id;
        document.querySelectorAll('.agent-card').forEach((card) => {
          card.setAttribute('aria-pressed', card.dataset.agent === selectedAgentId ? 'true' : 'false');
        });
        byId('agentFocus').dataset.color = agent.color;
        byId('focusDivision').textContent = agent.division;
        byId('focusName').textContent = agent.name;
        byId('focusRole').textContent = agent.role;
        byId('focusState').textContent = agent.stateLabel;
        byId('focusTask').textContent = agent.task;
        const progress = Math.max(0, Math.min(100, Number(agent.progress) || 0));
        byId('focusProgressValue').textContent = `${progress} %`;
        byId('focusProgressBar').style.width = `${progress}%`;
      }

      function openAgentProfile(agent) {
        if (!agent) return;
        agentProfileDialog.dataset.agent = agent.id;
        agentProfileDialog.dataset.color = agent.color;
        agentProfileDialog.dataset.spriteGroup = agent.spriteGroup;
        agentProfileDialog.dataset.spriteIndex = String(agent.spriteIndex);
        byId('agentProfileDivision').textContent = agent.division;
        byId('agentProfileName').textContent = agent.name;
        byId('agentProfileRole').textContent = agent.role;
        byId('agentProfileSummary').textContent = agent.profile?.summary || agent.task;
        byId('agentProfileState').textContent = agent.stateLabel;
        byId('agentProfileTask').textContent = agent.task;

        const responsibilities = byId('agentProfileResponsibilities');
        responsibilities.replaceChildren();
        const items = Array.isArray(agent.profile?.responsibilities) && agent.profile.responsibilities.length
          ? agent.profile.responsibilities
          : [agent.task];
        items.forEach((responsibility, index) => {
