        byId('agentProfileProgressBar').style.width = `${progress}%`;
        renderAgentMissionHistory(agent.id);
        if (!agentProfileDialog.open) agentProfileDialog.showModal();
      }

      function directMissionStatusLabel(status) {
        const labels = {
          queued: 'En attente', running: 'En mission', review: 'À valider', done: 'Validée',
          archived: 'Abandonnée', failed: 'Arrêtée en sécurité',
        };
        return labels[status] || status || 'En attente';
      }

      function agentById(agentId) {
        return currentAgents.find((agent) => agent.id === agentId) || null;
      }

      function applyAgentSprite(target, agent) {
        if (!target || !agent) return;
        target.dataset.agent = agent.id;
        target.dataset.color = agent.color;
        target.dataset.spriteGroup = agent.spriteGroup;
        target.dataset.spriteIndex = String(agent.spriteIndex);
      }

      function renderAgentMissionHistory(agentId) {
        const section = byId('agentProfileMissionHistory');
        const list = byId('agentProfileMissionList');
        if (!section || !list) return;
        const missions = directMissions.filter((mission) => mission.agentId === agentId).slice(0, 3);
        section.hidden = !missions.length;
        list.replaceChildren();
        missions.forEach((mission) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'agent-profile-mission-row';
          const copy = document.createElement('span');
          const title = document.createElement('strong');
          title.textContent = mission.result?.title || mission.objective;
          const meta = document.createElement('small');
          meta.textContent = `${directMissionStatusLabel(mission.status)} · ${mission.deliverableLabel || 'Rapport interne'}`;
          copy.append(title, meta);
