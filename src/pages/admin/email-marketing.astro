    <script is:inline>
      const OVERVIEW_API = '/.netlify/functions/admin-email-marketing-overview';
      const ACTIONS_API = '/.netlify/functions/admin-email-marketing-actions';
      const AGENT_RUNS_API = '/.netlify/functions/admin-email-marketing-agent-runs';
      const AUTONOMY_API = '/.netlify/functions/admin-email-marketing-autonomy';
      const DIRECT_MISSIONS_API = '/.netlify/functions/admin-email-marketing-agent-missions';
      const workspace = document.getElementById('workspace');
      const loadingScreen = document.getElementById('loadingScreen');
      const lockedScreen = document.getElementById('lockedScreen');
      const refreshButton = document.getElementById('refreshButton');
      const toast = document.getElementById('toast');
      const reviewDialog = document.getElementById('reviewDialog');
      const agentProfileDialog = document.getElementById('agentProfileDialog');
      const agentCommandDialog = document.getElementById('agentCommandDialog');
      const directMissionDialog = document.getElementById('directMissionDialog');
      const missionDialog = document.getElementById('missionDialog');
      const emailStudioDialog = document.getElementById('emailStudioDialog');
      const testConfirmationDialog = document.getElementById('testConfirmationDialog');
      const sendConfirmationDialog = document.getElementById('sendConfirmationDialog');
      let currentPriorities = [];
      let currentAgents = [];
      let currentMissions = [];
      let currentOverview = null;
      let selectedAgentId = 'nova';
      let featuredMissionId = 'broadcast-value';
      let activeMissionId = null;
      let finalApprovalToken = '';
      let emailPersistTimer = null;
      let currentAgentRun = null;
      let workspaceIsDurable = false;
      let currentAutonomy = null;
      let autonomyBusy = false;
      let firstFlightBusy = false;
      let directMissions = [];
      let activeDirectMissionId = null;
      let directMissionPollTimer = null;

      const MISSION_DECISION_KEY = 'sonnycourt.emailDivision.missionDecisions.v1';
      const EMAIL_STUDIO_KEY = 'sonnycourt.emailDivision.broadcastStudio.v1';
      const EMAIL_STUDIO_STALE_ARCHIVE_KEY = 'sonnycourt.emailDivision.broadcastStudio.stale.v1';
      let actionCapabilities = {
        mode: 'construction',
        draftWritesEnabled: false,
        sendsEnabled: false,
        finalApprovalRequired: true,
        confirmationPhrase: 'ENVOYER',
        testFlightsEnabled: false,
        testRecipients: ['sonnycourt@gmail.com'],
        testConfirmationPhrase: 'ENVOYER TEST',
      };
      const missionStatusLabels = {
        working: 'En cours', review: 'À valider', queued: 'En attente', done: 'Terminée',
        validated: 'Validée localement', revision: 'Correction demandée',
      };

      function readMissionDecisions() {
        try {
          const parsed = JSON.parse(window.localStorage.getItem(MISSION_DECISION_KEY) || '{}');
          return parsed && typeof parsed === 'object' ? parsed : {};
        } catch {
          return {};
        }
      }

      let missionDecisions = readMissionDecisions();

      const byId = (id) => document.getElementById(id);
      const formatNumber = (value) => value == null ? '—' : Number(value).toLocaleString('fr-FR');
      const formatRate = (value) => Number.isFinite(Number(value)) ? `${Number(value).toFixed(2).replace('.', ',')} %` : '—';
      const dateTime = (value) => new Intl.DateTimeFormat('fr-FR', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value));

      function showToast(message) {
        toast.textContent = message;
        toast.hidden = false;
        window.clearTimeout(showToast.timer);
        showToast.timer = window.setTimeout(() => { toast.hidden = true; }, 5000);
      }

      function showValidatorMode() {
        byId('validatorHome').hidden = false;
        byId('departmentView').hidden = true;
        byId('validatorTitle').focus?.({ preventScroll: true });
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function showDepartmentMode() {
        byId('validatorHome').hidden = true;
        byId('departmentView').hidden = false;
        byId('departmentView').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function openStudioFromValidator() {
        if (!emailStudioState.draft && currentAgentRun?.artifact) adoptAgentDraft();
        openEmailStudio();
      }

      function renderValidatorAgents() {
        const strip = byId('validatorAgentStrip');
        if (!strip) return;
        strip.replaceChildren();
        const preferred = ['nova', 'leo', 'alma', 'sacha', 'june'];
        const agents = preferred
          .map((id) => currentAgents.find((agent) => agent.id === id))
          .filter(Boolean)
          .slice(0, 5);
        agents.forEach((agent) => {
          const chip = document.createElement('div');
          chip.className = 'validator-agent-chip';
          chip.dataset.spriteGroup = agent.spriteGroup;
          chip.dataset.spriteIndex = String(agent.spriteIndex);
          chip.title = `${agent.name} · ${agent.stateLabel}`;
          const avatar = document.createElement('span');
          avatar.setAttribute('aria-hidden', 'true');
          chip.append(avatar);
          strip.append(chip);
        });
      }

      function renderValidatorHome() {
        const primaryCard = byId('validatorPrimaryCard');
        if (!primaryCard) return;
        const action = byId('validatorPrimaryAction');
        const agentsReady = currentAgentRun?.status === 'completed' && Boolean(currentAgentRun?.artifact);
        const agentsRunning = firstFlightBusy || currentAgentRun?.status === 'running';
        const directAgentsRunning = directMissions.some((mission) => ['queued', 'running'].includes(mission.status));
        const stage = emailStudioState?.draft ? emailStageState() : {
          dossierApproved: dossierIsApproved(), contentApproved: false, testProofSent: false, draftSynced: false,
        };

        let primary = {
          state: 'loading', kicker: 'Prochaine action', title: 'Le briefing arrive…',
          summary: 'Nova rassemble les informations utiles sans toucher à MailerLite.',
          reason: 'Aucune action externe ne sera exécutée silencieusement.',
          time: '2 min', label: 'Patienter', disabled: true, onClick: null,
        };

        if (currentOverview && agentsRunning) {
          primary = {
            state: 'working', kicker: 'Équipe au travail', title: 'Les agents construisent ton dossier.',
            summary: 'Angle, audience, rédaction et contrôle qualité sont analysés ensemble. Tu seras sollicité uniquement quand une décision sera prête.',
            reason: 'MailerLite reste en lecture seule pendant tout ce cycle.',
            time: '≈ 2 min', label: 'Production en cours…', disabled: true, onClick: null,
          };
        } else if (currentOverview && !agentsReady) {
          primary = {
            state: currentAgentRun?.status === 'failed' ? 'review' : 'ready',
            kicker: 'Premier email de valeur', title: currentAgentRun?.status === 'failed' ? 'Le cycle peut être relancé sans risque.' : 'Lance ton premier cycle réel.',
            summary: 'L’équipe choisira un angle utile, recommandera une audience et rédigera une V2 prête à relire.',
            reason: 'Le lancement produit seulement un dossier interne : aucun brouillon, aucun contact et aucun envoi MailerLite.',
            time: '2 min', label: currentAgentRun?.status === 'failed' ? 'Relancer les agents' : 'Faire travailler les agents', disabled: false,
            onClick: () => startAgentRun({ firstFlight: true }),
          };
        } else if (agentsReady && !stage.dossierApproved) {
          primary = {
            state: 'review', kicker: 'Décision n° 1', title: 'Le dossier éditorial est prêt à relire.',
            summary: currentAgentRun?.artifact?.executiveSummary || 'L’équipe a préparé l’angle, l’audience et le raisonnement du prochain email de valeur.',
            reason: 'Tu valides la direction ou demandes une correction. Rien n’est encore écrit dans MailerLite.',
            time: '3 min', label: 'Relire le dossier', disabled: false,
            onClick: () => openMissionDialog('broadcast-value'),
          };
        } else if (stage.dossierApproved && !stage.contentApproved) {
          primary = {
            state: 'review', kicker: 'Décision n° 2', title: 'Ton email est prêt à être corrigé.',
            summary: 'Relis l’objet et le contenu directement dans le studio, modifie librement, puis valide exactement ta version.',
            reason: 'La validation du contenu ne déclenche encore ni brouillon MailerLite ni envoi.',
            time: '5–8 min', label: 'Corriger l’email', disabled: false, onClick: openStudioFromValidator,
          };
        } else if (stage.contentApproved && !stage.testProofSent) {
          primary = {
            state: 'review', kicker: 'Décision n° 3', title: 'La version approuvée peut partir en épreuve.',
            summary: 'Un dernier contrôle dans le studio permet de recevoir cette version uniquement sur ton adresse test autorisée.',
            reason: 'Le broadcast public reste verrouillé. L’épreuve ne peut cibler que sonnycourt@gmail.com.',
            time: '2 min', label: 'Contrôler l’épreuve', disabled: false, onClick: openStudioFromValidator,
          };
        } else if (stage.testProofSent && !emailStudioState.sent) {
          primary = {
            state: 'done', kicker: 'Épreuve envoyée', title: 'Ton premier cycle est arrivé au contrôle final.',
            summary: 'L’épreuve isolée a été transmise. Tu peux relire son état et préparer la suite sans ouvrir la diffusion publique.',
            reason: 'Aucun broadcast réel ne part tant que la capacité d’envoi et ta validation finale ne sont pas réunies.',
            time: '2 min', label: 'Ouvrir le studio', disabled: false, onClick: openStudioFromValidator,
          };
        } else if (emailStudioState.sent) {
          primary = {
            state: 'done', kicker: 'Cycle terminé', title: 'Le broadcast validé a été transmis.',
            summary: 'La division peut maintenant observer les résultats et préparer le prochain apprentissage.',
            reason: 'Le prochain dossier repartira des performances réellement observées.',
            time: '1 min', label: 'Voir le département', disabled: false, onClick: showDepartmentMode,
          };
        }

        primaryCard.dataset.state = primary.state;
        byId('validatorPrimaryKicker').textContent = primary.kicker;
        byId('validatorPrimaryTitle').textContent = primary.title;
        byId('validatorPrimarySummary').textContent = primary.summary;
        byId('validatorPrimaryReason').textContent = primary.reason;
        byId('validatorPrimaryTime').textContent = primary.time;
        action.textContent = primary.label;
        action.disabled = primary.disabled;
        action.onclick = primary.onClick;

        const decisions = [];
        if (!agentsRunning) {
          if (!agentsReady) decisions.push({ title: 'Démarrer le cycle éditorial', meta: 'Aucune action MailerLite', label: 'Lancer', action: () => startAgentRun({ firstFlight: true }) });
          else if (!stage.dossierApproved) decisions.push({ title: 'Direction éditoriale', meta: 'Valider ou demander une correction', label: 'Relire', action: () => openMissionDialog('broadcast-value') });
          else if (!stage.contentApproved) decisions.push({ title: 'Version de l’email', meta: 'Corriger puis approuver', label: 'Ouvrir', action: openStudioFromValidator });
          else if (!stage.testProofSent) decisions.push({ title: 'Épreuve personnelle', meta: '1 seule adresse autorisée', label: 'Contrôler', action: openStudioFromValidator });
        }
        directMissions
          .filter((mission) => mission.status === 'review')
          .slice(0, Math.max(0, 3 - decisions.length))
          .forEach((mission) => decisions.push({
            title: mission.result?.title || mission.objective,
            meta: `${mission.agent?.name || 'Agent'} · mission ponctuelle`,
            label: 'Examiner',
            action: () => openDirectMission(mission.id),
          }));
        currentMissions
          .map(effectiveMission)
          .filter((mission) => mission.id !== 'broadcast-value' && mission.effectiveStatus === 'review')
          .slice(0, Math.max(0, 3 - decisions.length))
          .forEach((mission) => decisions.push({
            title: mission.title, meta: `${mission.owner} · ${mission.priority}`, label: 'Examiner', action: () => openMissionDialog(mission.id),
          }));

        const list = byId('validatorDecisionList');
        list.replaceChildren();
        decisions.slice(0, 3).forEach((decision) => {
          const item = document.createElement('div'); item.className = 'validator-decision-item';
          const dot = document.createElement('i'); dot.setAttribute('aria-hidden', 'true');
          const copy = document.createElement('span');
          const title = document.createElement('strong'); title.textContent = decision.title;
          const meta = document.createElement('small'); meta.textContent = decision.meta;
          copy.append(title, meta);
          const button = document.createElement('button'); button.type = 'button'; button.textContent = decision.label; button.addEventListener('click', decision.action);
          item.append(dot, copy, button); list.append(item);
        });
        if (!decisions.length) {
          const empty = document.createElement('div'); empty.className = 'validator-empty'; empty.textContent = agentsRunning ? 'L’équipe travaille. Rien à décider pour le moment.' : 'Aucune décision urgente pour le moment.'; list.append(empty);
        }

        const count = Math.min(3, decisions.length);
        const minutes = count === 0 ? 0 : stage.dossierApproved && !stage.contentApproved ? 8 : Math.max(3, count * 3);
        byId('validatorDecisionBadge').textContent = String(count);
        byId('validatorDecisionCount').textContent = count === 0 ? 'Aucune décision ne t’attend.' : `${count} décision${count > 1 ? 's' : ''} t’attend${count > 1 ? 'ent' : ''}.`;
        byId('validatorTimeEstimate').textContent = count === 0 ? 'Tu peux laisser la division travailler.' : `Environ ${minutes} minutes pour tout traiter.`;

        const status = directAgentsRunning
          ? `${directMissions.filter((mission) => ['queued', 'running'].includes(mission.status)).length} mission(s) ponctuelle(s) en cours.`
          : agentsRunning ? 'Nova coordonne la production en ce moment.'
            : agentsReady ? 'Le dossier collectif est prêt et mémorisé.' : 'Les agents sont prêts pour leur prochain cycle.';
        byId('validatorTeamStatus').textContent = status;
        renderValidatorAgents();

        const metrics = currentOverview?.metrics;
        if (metrics) {
          const cadence = Number(metrics.campaignsLast30Days || 0);
          byId('validatorSignalTitle').textContent = cadence === 0 ? 'Rythme éditorial à relancer' : `${cadence} grand${cadence > 1 ? 's' : ''} broadcast${cadence > 1 ? 's' : ''} sur 30 jours`;
          byId('validatorSignalDetail').textContent = cadence === 0
            ? 'Aucun grand broadcast détecté sur les 30 derniers jours : le prochain email de valeur est la priorité logique.'
            : `Ouvertures pondérées ${formatRate(metrics.openRate90Days)} · clics ${formatRate(metrics.clickRate90Days)} sur les grands envois récents.`;
        }
      }

      function autonomyDecisionLabel(decision) {
        const labels = {
          generated: 'Nouveau dossier préparé · validation requise',
          awaiting_human_review: 'En attente de ta relecture du dossier précédent',
          not_scheduled: 'Scan terminé · journée d’analyse seulement',
          paused: 'Moteur autonome en pause',
          providers_missing: 'Connexions IA à compléter',
          budget_exhausted: 'Plafond mensuel atteint',
          daily_limit: 'Limite quotidienne atteinte',
          cooldown: 'Intervalle de sécurité actif',
          eligible: 'Production du dossier en cours',
          failed: 'Production IA arrêtée sans action externe',
          pending: 'Analyse des signaux en cours',
        };
        return labels[decision?.status] || 'Briefing interne terminé';
      }

      function renderAutonomy(data) {
        if (!data?.state) return;
        currentAutonomy = data;
        const state = data.state;
        const pulse = data.latestPulse;
        const badge = byId('autonomyStateBadge');
        const panel = byId('autonomyPanel');
        const running = ['scanning', 'planning', 'producing'].includes(pulse?.status);
        const active = Boolean(state.enabled);
        panel.dataset.state = running ? 'running' : active ? 'active' : 'paused';
        badge.textContent = running ? 'Agents au travail' : active ? 'Actif · zone verte' : 'En pause';
        byId('autonomyLastPulse').textContent = pulse?.startedAt ? dateTime(pulse.startedAt) : 'Aucun';
        byId('autonomyLastDecision').textContent = pulse
          ? running ? 'Le briefing quotidien est en cours…' : autonomyDecisionLabel(pulse.decision?.aiRun)
          : 'Le premier briefing sera archivé ici';
        byId('autonomyNextPulse').textContent = data.nextRunAt ? dateTime(data.nextRunAt) : '—';
        const signalCount = Number(pulse?.summary?.signalsFound ?? pulse?.signals?.length ?? 0);
        const reviewCount = Number(pulse?.summary?.reviewItems ?? pulse?.signals?.filter?.((item) => item.status === 'review')?.length ?? 0);
        byId('autonomyMissionCount').textContent = pulse ? `${signalCount}` : '0';
        byId('autonomyMissionDetail').textContent = pulse ? `${reviewCount} point(s) demandent une revue` : 'Le premier scan n’a pas encore tourné';
        const spent = Number(data.budget?.spentMonthUsd || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const limit = Number(data.budget?.monthlyLimitUsd || 0).toLocaleString('fr-FR', { maximumFractionDigits: 0 });
        byId('autonomyBudget').textContent = `${spent} $ / ${limit} $`;
        byId('autonomyBudgetDetail').textContent = `${Number(data.budget?.remainingMonthUsd || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} $ disponibles`;
        byId('toggleAutonomy').textContent = active ? 'Mettre en pause' : 'Réactiver';
        byId('runAutonomyNow').disabled = autonomyBusy || !active || running;
        renderValidatorHome();
      }

      async function loadAutonomy() {
        try {
          const response = await fetch(AUTONOMY_API, { method: 'GET', credentials: 'same-origin', headers: { Accept: 'application/json' } });
          if (!response.ok) return null;
          const data = await response.json();
          renderAutonomy(data);
          return data;
        } catch {
          return null;
        }
      }

      async function runAutonomyNow() {
        if (autonomyBusy || !currentAutonomy?.state?.enabled) return;
        autonomyBusy = true;
        const button = byId('runAutonomyNow');
        const previousId = currentAutonomy?.latestPulse?.id || '';
        button.disabled = true;
        button.textContent = 'Briefing en cours…';
        try {
          const response = await fetch(AUTONOMY_API, {
            method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ operation: 'run_now' }),
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.error || `autonomy_${response.status}`);
          const deadline = Date.now() + 10 * 60 * 1000;
          while (Date.now() < deadline) {
            await new Promise((resolve) => window.setTimeout(resolve, 2_500));
            const data = await loadAutonomy();
            const pulse = data?.latestPulse;
            if (!pulse || pulse.id === previousId) continue;
            if (pulse.status === 'completed') {
              showToast(pulse.decision?.aiRun?.status === 'generated'
                ? 'Le briefing autonome a créé un dossier. Il attend ta validation et MailerLite n’a pas été modifié.'
                : 'Briefing autonome terminé et archivé. MailerLite n’a pas été modifié.');
              await loadAgentWorkspace();
              return;
            }
            if (pulse.status === 'failed') throw new Error('autonomy_pulse_failed');
          }
          showToast('Le briefing continue en arrière-plan. Son état restera visible ici.');
        } catch {
          showToast('Le moteur autonome s’est arrêté en sécurité, sans toucher à MailerLite.');
          await loadAutonomy();
        } finally {
          autonomyBusy = false;
          button.textContent = 'Lancer le briefing maintenant';
          if (currentAutonomy) renderAutonomy(currentAutonomy);
        }
      }

      async function toggleAutonomy() {
        const button = byId('toggleAutonomy');
        const enabled = !currentAutonomy?.state?.enabled;
        button.disabled = true;
        try {
          const response = await fetch(AUTONOMY_API, {
            method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ operation: 'set_enabled', enabled }),
          });
          if (!response.ok) throw new Error(`autonomy_toggle_${response.status}`);
          await loadAutonomy();
          showToast(enabled ? 'Moteur autonome réactivé en zone verte.' : 'Moteur autonome mis en pause. Aucun travail ne sera généré.');
        } catch {
          showToast('Impossible de modifier le moteur autonome pour le moment.');
        } finally {
          button.disabled = false;
        }
      }

      function readEmailStudioState() {
        try {
          const parsed = JSON.parse(window.localStorage.getItem(EMAIL_STUDIO_KEY) || '{}');
          return parsed && typeof parsed === 'object'
            ? { draft: null, versions: [], contentApproval: null, mailerlite: null, sent: null, testProof: null, ...parsed }
            : { draft: null, versions: [], contentApproval: null, mailerlite: null, sent: null, testProof: null };
        } catch {
          return { draft: null, versions: [], contentApproval: null, mailerlite: null, sent: null, testProof: null };
        }
      }

      let emailStudioState = readEmailStudioState();

      function persistEmailStudioState() {
        emailStudioState.updatedAt = new Date().toISOString();
        try {
          window.localStorage.setItem(EMAIL_STUDIO_KEY, JSON.stringify(emailStudioState));
          byId('emailSaveState').textContent = `Sauvegardé à ${new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit' }).format(new Date())}`;
        } catch {
          byId('emailSaveState').textContent = 'Sauvegarde locale indisponible';
        }
      }

      function scheduleEmailPersist() {
        window.clearTimeout(emailPersistTimer);
        byId('emailSaveState').textContent = 'Modifications locales…';
        emailPersistTimer = window.setTimeout(persistEmailStudioState, 250);
      }

      async function persistWorkspaceDurably() {
        try {
          const response = await fetch(AGENT_RUNS_API, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              operation: 'save_workspace',
              workspace: {
                state: emailStudioState,
                missionDecision: missionDecisions['broadcast-value'] || null,
              },
            }),
          });
          if (!response.ok) return false;
          const data = await response.json();
          emailStudioState.durableUpdatedAt = data.workspace?.updatedAt || new Date().toISOString();
          workspaceIsDurable = true;
          try { window.localStorage.setItem(EMAIL_STUDIO_KEY, JSON.stringify(emailStudioState)); } catch {}
          if (byId('emailSaveState')) byId('emailSaveState').textContent = 'Sauvegardé dans la mémoire de la division';
          if (byId('missionPortfolioLabel')) byId('missionPortfolioLabel').textContent = `${currentMissions.length} missions actives · décisions sauvegardées durablement`;
          return true;
        } catch {
          return false;
        }
      }

      function broadcastMission() {
        return currentMissions.find((mission) => mission.id === 'broadcast-value') || null;
      }

      function dossierIsApproved() {
        return missionDecisions['broadcast-value']?.type === 'approved';
      }

      function renderFirstFlight() {
        const panel = byId('firstFlightPanel');
        if (!panel) return;
        const stage = emailStudioState.draft ? emailStageState() : {
          dossierApproved: dossierIsApproved(), contentApproved: false, testProofSent: false,
        };
        const agentsReady = currentAgentRun?.status === 'completed' && Boolean(currentAgentRun?.artifact);
        const running = firstFlightBusy || currentAgentRun?.status === 'running';
        const setStep = (id, state) => { byId(id).dataset.state = state; };
        setStep('firstFlightStepAgents', agentsReady ? 'done' : running ? 'current' : 'current');
        setStep('firstFlightStepDossier', stage.dossierApproved ? 'done' : agentsReady ? 'current' : 'locked');
        setStep('firstFlightStepContent', stage.contentApproved ? 'done' : stage.dossierApproved ? 'current' : 'locked');
        setStep('firstFlightStepProof', stage.testProofSent ? 'done' : stage.contentApproved ? 'current' : 'locked');
        setStep('firstFlightStepBroadcast', emailStudioState.sent ? 'done' : 'locked');

        const audience = currentOverview?.recommendedValueAudience;
        byId('firstFlightAudience').textContent = audience
          ? `${audience.name} · ${formatNumber(audience.count)}`
          : 'Aucune audience fiable détectée';
        byId('firstFlightAudienceReason').textContent = audience?.reason
          || 'La recommandation restera sans effet tant que tu ne valides pas un futur broadcast.';
        byId('firstFlightRecipient').textContent = actionCapabilities.testRecipients?.[0] || 'sonnycourt@gmail.com';

        const launch = byId('startFirstFlight');
        launch.disabled = running;
        launch.textContent = running ? 'Les agents travaillent…' : agentsReady ? 'Produire une nouvelle V2' : 'Faire produire la V2';
        byId('openFirstFlightDossier').disabled = !agentsReady;
        byId('openFirstFlightStudio').disabled = !agentsReady;

        const state = byId('firstFlightState');
        if (stage.testProofSent) {
          panel.dataset.state = 'done'; state.textContent = 'Épreuve envoyée';
        } else if (stage.contentApproved) {
          panel.dataset.state = 'ready'; state.textContent = 'Prêt pour l’épreuve';
        } else if (stage.dossierApproved) {
          panel.dataset.state = 'working'; state.textContent = 'Correction en cours';
        } else if (agentsReady) {
          panel.dataset.state = 'review'; state.textContent = 'Dossier à valider';
        } else if (running) {
          panel.dataset.state = 'working'; state.textContent = 'Agents au travail';
        } else {
          panel.dataset.state = 'idle'; state.textContent = 'Prêt à démarrer';
        }
        renderValidatorHome();
      }

      function draftSnapshot(draft) {
        if (!draft) return '';
        return JSON.stringify({
          campaignName: draft.campaignName || '', subject: draft.subject || '', subjectVariant: draft.subjectVariant || '',
          preheader: draft.preheader || '', fromName: draft.fromName || '', fromAddress: draft.fromAddress || '',
          audienceType: draft.audienceType || '', audienceId: draft.audienceId || '', body: draft.body || '',
          ctaLabel: draft.ctaLabel || '', ctaUrl: draft.ctaUrl || '', hypothesis: draft.hypothesis || '',
        });
      }

      function initializeEmailDraft() {
        if (emailStudioState.draft) return;
        const seed = broadcastMission()?.emailDraft || {};
        const sender = currentOverview?.senderRecommendation || {};
        const audience = currentOverview?.recommendedValueAudience || {};
        emailStudioState.draft = {
          campaignName: seed.campaignName || 'Broadcast valeur',
          subject: seed.subject || '',
          subjectVariant: seed.subjectVariant || '',
          preheader: seed.preheader || '',
          fromName: sender.fromName || seed.fromName || 'Sonny Court',
          fromAddress: sender.fromAddress || seed.fromAddress || '',
          audienceType: audience.type || seed.audienceType || '',
          audienceId: audience.id || seed.audienceId || '',
          audienceName: audience.name || seed.audienceName || '',
          audienceCount: Number(audience.count ?? seed.audienceCount) || 0,
          body: seed.body || '',
          ctaLabel: seed.ctaLabel || '',
          ctaUrl: seed.ctaUrl || '',
          hypothesis: seed.hypothesis || '',
        };
        persistEmailStudioState();
      }

      function populateAudienceOptions() {
        const select = byId('emailAudience');
        select.replaceChildren();
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = 'Sélectionner une audience réelle…';
        select.append(placeholder);

        const appendGroup = (label, type, items, countKey) => {
          if (!items?.length) return;
          const group = document.createElement('optgroup');
          group.label = label;
          items.forEach((item) => {
            const option = document.createElement('option');
            option.value = `${type}:${item.id}`;
            option.dataset.name = item.name;
            option.dataset.count = String(Number(item[countKey]) || 0);
            option.textContent = `${item.name} · ${formatNumber(item[countKey])}`;
            group.append(option);
          });
          select.append(group);
        };
        appendGroup('Groupes MailerLite', 'group', currentOverview?.audiences?.groups, 'activeCount');
        appendGroup('Segments MailerLite', 'segment', currentOverview?.audiences?.segments, 'total');
      }

      function writeDraftToFields() {
        const draft = emailStudioState.draft || {};
        byId('emailSubject').value = draft.subject || '';
        byId('emailSubjectVariant').value = draft.subjectVariant || '';
        byId('emailPreheader').value = draft.preheader || '';
        byId('emailFromName').value = draft.fromName || '';
        byId('emailFromAddress').value = draft.fromAddress || '';
        byId('emailBody').value = draft.body || '';
        byId('emailCtaLabel').value = draft.ctaLabel || '';
        byId('emailCtaUrl').value = draft.ctaUrl || '';
        byId('emailHypothesis').value = draft.hypothesis || '';
        const audienceValue = draft.audienceType && draft.audienceId ? `${draft.audienceType}:${draft.audienceId}` : '';
        byId('emailAudience').value = audienceValue;
      }

      function draftFromFields() {
        const selection = byId('emailAudience');
        const selectedOption = selection.selectedOptions[0];
        const [audienceType = '', audienceId = ''] = selection.value.split(':');
        return {
          ...(emailStudioState.draft || {}),
          subject: byId('emailSubject').value.trim(),
          subjectVariant: byId('emailSubjectVariant').value.trim(),
          preheader: byId('emailPreheader').value.trim(),
          fromName: byId('emailFromName').value.trim(),
          fromAddress: byId('emailFromAddress').value.trim().toLowerCase(),
          audienceType,
          audienceId,
          audienceName: selectedOption?.dataset.name || '',
          audienceCount: Number(selectedOption?.dataset.count) || 0,
          body: byId('emailBody').value.trim(),
          ctaLabel: byId('emailCtaLabel').value.trim(),
          ctaUrl: byId('emailCtaUrl').value.trim(),
          hypothesis: byId('emailHypothesis').value.trim(),
        };
      }

      function emailChecks(draft) {
        let secureCta = false;
        try { secureCta = new URL(draft.ctaUrl).protocol === 'https:'; } catch {}
        const ctaAbsent = !draft.ctaLabel && !draft.ctaUrl;
        const ctaCoherent = ctaAbsent || (Boolean(draft.ctaLabel) && secureCta);
        const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(draft.fromAddress || '');
        const words = (draft.body || '').split(/\s+/).filter(Boolean).length;
        return [
          { label: 'Objet clair et exploitable', detail: `${(draft.subject || '').length} caractères`, ok: (draft.subject || '').length >= 12 && (draft.subject || '').length <= 80 },
          { label: 'Préheader complémentaire', detail: `${(draft.preheader || '').length} caractères`, ok: (draft.preheader || '').length >= 20 && (draft.preheader || '').length <= 120 },
          { label: 'Expéditeur vérifiable', detail: draft.fromAddress || 'Adresse manquante', ok: Boolean(draft.fromName) && emailValid },
          { label: 'Audience explicitement choisie', detail: draft.audienceName || 'Audience manquante', ok: Boolean(draft.audienceId) },
          { label: 'Corps suffisamment développé', detail: `${words} mots`, ok: words >= 60 },
          { label: 'CTA cohérent ou volontairement absent', detail: ctaAbsent ? 'Email de valeur sans CTA' : draft.ctaLabel || 'CTA incomplet', ok: ctaCoherent },
        ];
      }

      function renderEmailPreview() {
        const draft = emailStudioState.draft || {};
        byId('previewFrom').textContent = draft.fromName || 'Expéditeur';
        byId('previewSubject').textContent = draft.subject || 'Objet de l’email';
        byId('previewPreheader').textContent = draft.preheader || 'Préheader de l’email';
        byId('emailSubjectCount').textContent = `${(draft.subject || '').length}/55 recommandé`;
        byId('emailPreheaderCount').textContent = `${(draft.preheader || '').length}/90 recommandé`;
        const words = (draft.body || '').split(/\s+/).filter(Boolean).length;
        byId('emailWordCount').textContent = `${words} mot${words > 1 ? 's' : ''}`;
        byId('emailAudienceMeta').textContent = draft.audienceId
          ? `${draft.audienceName} · ${formatNumber(draft.audienceCount)} contacts observés`
          : 'Sélection obligatoire avant synchronisation';

        const preview = byId('previewBody');
        preview.replaceChildren();
        (draft.body || '').split(/\n{2,}/).filter(Boolean).forEach((paragraph) => {
          const p = document.createElement('p');
          p.textContent = paragraph.replaceAll('{$name}', 'Prénom');
          preview.append(p);
        });
        if (draft.ctaLabel) {
          const link = document.createElement('a');
          link.href = draft.ctaUrl || '#';
          link.textContent = draft.ctaLabel;
          link.addEventListener('click', (event) => event.preventDefault());
          preview.append(link);
        }

        const checks = emailChecks(draft);
        const list = byId('emailChecklist');
        list.replaceChildren();
        checks.forEach((check) => {
          const item = document.createElement('li');
          item.dataset.ok = check.ok ? 'true' : 'false';
          const icon = document.createElement('span'); icon.textContent = check.ok ? '✓' : '!';
          const copy = document.createElement('div');
          const label = document.createElement('strong'); label.textContent = check.label;
          const detail = document.createElement('small'); detail.textContent = check.detail;
          copy.append(label, detail); item.append(icon, copy); list.append(item);
        });
        byId('emailChecklistScore').textContent = `${checks.filter((item) => item.ok).length}/${checks.length}`;
      }

      function setEmailStage(id, state) {
        const stage = byId(id);
        stage.dataset.state = state;
      }

      function emailStageState() {
        const currentSnapshot = draftSnapshot(emailStudioState.draft);
        const contentApproved = emailStudioState.contentApproval?.snapshot === currentSnapshot;
        const testProofSent = Boolean(emailStudioState.testProof?.sentAt && emailStudioState.testProof?.sentSnapshot === currentSnapshot);
        const draftSynced = Boolean(emailStudioState.mailerlite?.campaign?.id && emailStudioState.mailerlite?.syncedSnapshot === currentSnapshot);
        return { currentSnapshot, dossierApproved: dossierIsApproved(), contentApproved, testProofSent, draftSynced };
      }

      function renderEmailWorkflow() {
        const stage = emailStageState();
        setEmailStage('emailStageDossier', stage.dossierApproved ? 'done' : 'current');
        setEmailStage('emailStageContent', stage.contentApproved ? 'done' : stage.dossierApproved ? 'current' : 'locked');
        setEmailStage('emailStageTest', stage.testProofSent ? 'done' : stage.contentApproved ? 'current' : 'locked');
        setEmailStage('emailStageDraft', stage.draftSynced ? 'done' : stage.testProofSent ? 'current' : 'locked');
        setEmailStage('emailStageSend', emailStudioState.sent ? 'done' : stage.draftSynced ? 'current' : 'locked');

        const checksPass = emailChecks(emailStudioState.draft || {}).every((item) => item.ok);
        byId('approveEmailContent').disabled = !checksPass || stage.contentApproved;
        byId('approveEmailContent').textContent = stage.contentApproved ? 'Version validée' : 'Valider cette version';
        const contentState = byId('emailContentState');
        if (!stage.dossierApproved) {
          contentState.dataset.state = 'waiting';
          contentState.textContent = 'Étape 1 requise : valide d’abord le dossier de mission.';
        } else if (!stage.contentApproved) {
          contentState.dataset.state = 'working';
          contentState.textContent = 'Tes corrections sont libres. La validation figera exactement cette version.';
        } else {
          contentState.dataset.state = 'approved';
          contentState.textContent = `Version approuvée le ${dateTime(emailStudioState.contentApproval.at)}. Toute modification annulera cette approbation.`;
        }

        const syncButton = byId('syncMailerLiteDraft');
        const bridgeTitle = byId('mailerLiteBridgeTitle');
        const bridgeDetail = byId('mailerLiteBridgeDetail');
        syncButton.textContent = emailStudioState.mailerlite?.campaign?.id ? 'Mettre à jour le brouillon MailerLite' : 'Créer le brouillon MailerLite';
        syncButton.disabled = !actionCapabilities.draftWritesEnabled || !stage.dossierApproved || !stage.contentApproved;
        byId('prepareFinalApproval').disabled = !stage.draftSynced;

        if (!actionCapabilities.draftWritesEnabled) {
          bridgeTitle.textContent = 'Écriture désarmée';
          bridgeDetail.textContent = 'Le studio est fonctionnel. La passerelle reste verrouillée pendant la construction.';
        } else if (!stage.dossierApproved) {
          bridgeTitle.textContent = 'Dossier en attente';
          bridgeDetail.textContent = 'Valide le dossier avant toute écriture dans MailerLite.';
        } else if (!stage.contentApproved) {
          bridgeTitle.textContent = 'Contenu en attente';
          bridgeDetail.textContent = 'Valide cette version exacte avant de créer ou modifier le brouillon.';
        } else if (stage.draftSynced) {
          bridgeTitle.textContent = 'Brouillon synchronisé';
          bridgeDetail.textContent = 'La version MailerLite correspond exactement au contenu approuvé.';
        } else if (emailStudioState.mailerlite?.campaign?.id) {
          bridgeTitle.textContent = 'Brouillon à resynchroniser';
          bridgeDetail.textContent = 'Le contenu local a changé depuis la dernière écriture MailerLite.';
        } else {
          bridgeTitle.textContent = 'Prêt à créer le brouillon';
          bridgeDetail.textContent = 'Cette action écrira dans MailerLite, mais elle ne pourra jamais envoyer la campagne.';
        }

        byId('mailerLiteDraftMeta').textContent = emailStudioState.mailerlite?.campaign?.id
          ? `Campagne #${emailStudioState.mailerlite.campaign.id} · ${emailStudioState.mailerlite.campaign.status || 'draft'}`
          : 'Aucun brouillon MailerLite lié.';
        const proofButton = byId('prepareTestProof');
        const proofPanel = byId('emailTestBridge');
        const proofTitle = byId('testFlightTitle');
        const proofDetail = byId('testFlightDetail');
        proofButton.disabled = !actionCapabilities.testFlightsEnabled || !stage.dossierApproved || !stage.contentApproved || stage.testProofSent;
        proofPanel.dataset.state = stage.testProofSent ? 'done' : stage.contentApproved ? 'ready' : 'locked';
        if (stage.testProofSent) {
          proofTitle.textContent = 'Épreuve envoyée';
          proofDetail.textContent = `Cette version exacte a été transmise le ${dateTime(emailStudioState.testProof.sentAt)}. Le broadcast public reste verrouillé.`;
          proofButton.textContent = 'Épreuve reçue';
          byId('testProofMeta').textContent = `Campagne test #${emailStudioState.testProof.campaign?.id || '—'} · 1 destinataire`;
        } else if (!actionCapabilities.testFlightsEnabled) {
          proofTitle.textContent = 'Épreuve désarmée';
          proofDetail.textContent = 'La capacité test n’est pas activée côté serveur.';
          proofButton.textContent = 'Recevoir l’épreuve';
        } else if (!stage.contentApproved) {
          proofTitle.textContent = 'En attente de la version approuvée';
          proofDetail.textContent = 'Valide d’abord le dossier puis la version exacte que tu veux recevoir.';
          proofButton.textContent = 'Recevoir l’épreuve';
        } else {
          proofTitle.textContent = 'Prête pour ton dernier contrôle';
          proofDetail.textContent = 'L’épreuve ciblera uniquement sonnycourt@gmail.com, jamais l’audience recommandée.';
          proofButton.textContent = 'Recevoir l’épreuve';
        }

        byId('emailStudioMode').textContent = actionCapabilities.sendsEnabled
          ? 'Division armée · double validation obligatoire'
          : actionCapabilities.draftWritesEnabled
            ? 'Brouillons autorisés · envois désarmés'
            : actionCapabilities.testFlightsEnabled
              ? 'Premier vol · épreuve isolée autorisée, broadcasts désarmés'
              : 'Mode construction · aucune écriture MailerLite';
        renderFirstFlight();
      }

      function renderEmailVersions() {
        const versions = Array.isArray(emailStudioState.versions) ? emailStudioState.versions : [];
        byId('emailVersionCount').textContent = String(versions.length);
        const list = byId('emailVersionList');
        list.replaceChildren();
        if (!versions.length) {
          const empty = document.createElement('p'); empty.textContent = 'Aucune version enregistrée pour le moment.'; list.append(empty); return;
        }
        versions.forEach((version, index) => {
          const row = document.createElement('div'); row.className = 'email-version-row';
          const copy = document.createElement('div');
          const title = document.createElement('strong'); title.textContent = `V${versions.length - index} · ${version.draft?.subject || 'Sans objet'}`;
          const meta = document.createElement('small'); meta.textContent = `${dateTime(version.at)} · ${version.author || 'Sonny'}`;
          copy.append(title, meta);
          const restore = document.createElement('button'); restore.type = 'button'; restore.textContent = 'Restaurer';
          restore.addEventListener('click', () => {
            emailStudioState.draft = { ...version.draft };
            emailStudioState.contentApproval = null;
            finalApprovalToken = '';
            persistEmailStudioState();
            persistWorkspaceDurably();
            writeDraftToFields();
            renderEmailStudio();
            showToast('Version restaurée. Une nouvelle validation sera nécessaire.');
          });
          row.append(copy, restore); list.append(row);
        });
      }

      function renderEmailStudio() {
        renderEmailPreview();
        renderEmailWorkflow();
        renderEmailVersions();
      }

      function saveDraftFromEditor() {
        const previousSnapshot = draftSnapshot(emailStudioState.draft);
        emailStudioState.draft = draftFromFields();
        const nextSnapshot = draftSnapshot(emailStudioState.draft);
        if (previousSnapshot !== nextSnapshot && emailStudioState.contentApproval?.snapshot !== nextSnapshot) {
          emailStudioState.contentApproval = null;
          finalApprovalToken = '';
        }
        scheduleEmailPersist();
        renderEmailPreview();
        renderEmailWorkflow();
      }

      function saveEmailVersion() {
        emailStudioState.draft = draftFromFields();
        const version = { at: new Date().toISOString(), author: 'Sonny', draft: { ...emailStudioState.draft } };
        emailStudioState.versions = [version, ...(emailStudioState.versions || [])].slice(0, 20);
        persistEmailStudioState();
        persistWorkspaceDurably();
        renderEmailVersions();
        showToast('Nouvelle version enregistrée localement.');
      }

      async function approveEmailContent() {
        emailStudioState.draft = draftFromFields();
        if (!dossierIsApproved()) {
          showToast('Valide d’abord le dossier de mission avant d’approuver le contenu.');
          return;
        }
        if (!emailChecks(emailStudioState.draft).every((item) => item.ok)) {
          showToast('Complète les contrôles signalés avant de valider cette version.');
          return;
        }
        const snapshot = draftSnapshot(emailStudioState.draft);
        emailStudioState.contentApproval = { snapshot, at: new Date().toISOString() };
        if (!(emailStudioState.versions || []).some((version) => draftSnapshot(version.draft) === snapshot)) saveEmailVersion();
        persistEmailStudioState();
        await persistWorkspaceDurably();
        renderEmailStudio();
        showToast('Contenu validé. Cette version exacte peut maintenant devenir un brouillon MailerLite.');
      }

      function openEmailStudio() {
        initializeEmailDraft();
        populateAudienceOptions();
        writeDraftToFields();
        renderEmailStudio();
        missionDialog.close();
        if (!emailStudioDialog.open) emailStudioDialog.showModal();
      }

      function syncAgentRunToMission(run) {
        if (!run?.artifact || run.status !== 'completed' || !currentMissions.length) return;
        const contributionByName = new Map((run.artifact.agentContributions || []).map((item) => [String(item.agent || '').toLocaleLowerCase('fr-FR'), item]));
        currentMissions = currentMissions.map((mission) => {
          if (mission.id !== 'broadcast-value') return mission;
          return {
            ...mission,
            status: 'review',
            statusLabel: 'À valider',
            progress: 92,
            summary: run.artifact.executiveSummary || mission.summary,
            deliverable: `Dossier IA · qualité ${run.artifact.qa?.score || 0}/100 · en attente de Sonny`,
            steps: (mission.steps || []).map((step) => {
              const contribution = contributionByName.get(String(step.agent || '').toLocaleLowerCase('fr-FR'));
              if (!contribution) return step;
              return { ...step, status: contribution.status === 'done' ? 'done' : 'review', detail: contribution.recommendation || step.detail };
            }),
          };
        });
        renderMissions(currentMissions);
      }

      function renderAgentRun(run) {
        currentAgentRun = run || null;
        const panel = byId('agenticProductionPanel');
        const title = byId('agentRunTitle');
        const detail = byId('agentRunDetail');
        const meta = byId('agentRunMeta');
        const contributions = byId('agentRunContributions');
        const adopt = byId('adoptAgentDraft');
        const launch = byId('runAgentTeam');
        contributions.replaceChildren();
        panel.dataset.state = run?.status || 'idle';
        adopt.hidden = true;
        launch.disabled = run?.status === 'running';
        launch.textContent = run?.status === 'running' ? 'Équipe au travail…' : 'Relancer un cycle IA';

        if (!run) {
          title.textContent = 'L’équipe n’a pas encore produit de dossier.';
          detail.textContent = 'Les agents analyseront uniquement les données agrégées autorisées. Aucun abonné, aucune écriture et aucun envoi MailerLite.';
          meta.textContent = 'Stockage durable prêt · validation humaine obligatoire';
          launch.textContent = 'Faire travailler l’équipe';
          renderFirstFlight();
          return;
        }
        if (run.status === 'running') {
          title.textContent = 'Nova coordonne les spécialistes…';
          detail.textContent = 'Scan des performances, choix de l’angle, rédaction, expérimentation et contrôle qualité sont en cours.';
          meta.textContent = `Cycle lancé ${dateTime(run.startedAt)} · MailerLite reste en lecture seule`;
          renderFirstFlight();
          return;
        }
        if (run.status === 'failed') {
          title.textContent = 'Le cycle n’a pas produit de dossier.';
          detail.textContent = 'Le moteur s’est arrêté avant toute action MailerLite. Tu peux relancer sans risque.';
          meta.textContent = `${dateTime(run.finishedAt || run.startedAt)} · ${run.error || 'erreur technique'}`;
          renderFirstFlight();
          return;
        }
        const artifact = run.artifact;
        const engineLabel = run.orchestration
          ? `Nova ${run.orchestration.director?.model || 'OpenAI'} · Léo ${run.orchestration.writer?.model || 'Claude'} · contrôle Nova`
          : run.model || 'modèle IA';
        title.textContent = artifact?.recommendedAngle || 'Dossier prêt pour ta relecture';
        detail.textContent = artifact?.executiveSummary || 'Les neuf spécialistes ont terminé leur travail.';
        meta.textContent = `${dateTime(run.finishedAt || run.startedAt)} · ${engineLabel} · qualité ${artifact?.qa?.score || 0}/100 · aucune action MailerLite`;
        adopt.hidden = !artifact;
        (artifact?.agentContributions || []).forEach((item) => {
          const card = document.createElement('article'); card.className = 'agentic-contribution'; card.dataset.status = item.status;
          const head = document.createElement('div');
          const initials = document.createElement('span'); initials.textContent = String(item.agent || item.agentId).slice(0, 2).toUpperCase();
          const copy = document.createElement('div');
          const name = document.createElement('strong'); name.textContent = item.agent;
          const role = document.createElement('small'); role.textContent = item.role;
          copy.append(name, role); head.append(initials, copy);
          const finding = document.createElement('p'); finding.textContent = item.finding;
          card.append(head, finding); contributions.append(card);
        });
        syncAgentRunToMission(run);
        renderFirstFlight();
      }

      async function loadAgentWorkspace() {
        try {
          const response = await fetch(AGENT_RUNS_API, { method: 'GET', credentials: 'same-origin', headers: { Accept: 'application/json' } });
          if (!response.ok) return;
          const data = await response.json();
          workspaceIsDurable = Boolean(data.durable);
          if (data.intelligenceResetRequired && emailStudioState.intelligenceVersion !== data.intelligenceVersion) {
            try { window.localStorage.setItem(EMAIL_STUDIO_STALE_ARCHIVE_KEY, JSON.stringify(emailStudioState)); } catch {}
            emailStudioState = {
              draft: null, versions: [], contentApproval: null, mailerlite: null, sent: null, testProof: null,
              intelligenceVersion: data.intelligenceVersion,
              updatedAt: new Date().toISOString(),
            };
            delete missionDecisions['broadcast-value'];
            try {
              window.localStorage.setItem(EMAIL_STUDIO_KEY, JSON.stringify(emailStudioState));
              window.localStorage.setItem(MISSION_DECISION_KEY, JSON.stringify(missionDecisions));
            } catch {}
            renderMissions(currentMissions);
            showToast('L’ancien dossier a été archivé car il utilisait une cadence erronée. Relance les agents sur les données corrigées.');
          }
          const serverWorkspace = data.workspace;
          const serverTime = new Date(serverWorkspace?.updatedAt || 0).getTime();
          const localTime = new Date(emailStudioState?.updatedAt || 0).getTime();
          if (serverWorkspace?.state && serverTime > localTime) {
            emailStudioState = {
              draft: null, versions: [], contentApproval: null, mailerlite: null, sent: null, testProof: null,
              ...serverWorkspace.state,
              updatedAt: serverWorkspace.updatedAt,
              durableUpdatedAt: serverWorkspace.updatedAt,
            };
            if (serverWorkspace.missionDecision) missionDecisions['broadcast-value'] = serverWorkspace.missionDecision;
            try {
              window.localStorage.setItem(EMAIL_STUDIO_KEY, JSON.stringify(emailStudioState));
              window.localStorage.setItem(MISSION_DECISION_KEY, JSON.stringify(missionDecisions));
            } catch {}
            renderMissions(currentMissions);
          }
          renderAgentRun(data.latestRun);
          if (workspaceIsDurable) byId('missionPortfolioLabel').textContent = `${currentMissions.length} missions actives · mémoire durable connectée`;
        } catch {}
      }

      async function startAgentRun(options = {}) {
        const firstFlight = options?.firstFlight === true;
        const button = firstFlight ? byId('startFirstFlight') : byId('runAgentTeam');
        const requestedAt = Date.now();
        if (firstFlight) firstFlightBusy = true;
        button.disabled = true;
        renderAgentRun({ status: 'running', startedAt: new Date().toISOString() });
        try {
          const response = await fetch(AGENT_RUNS_API, {
            method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ operation: 'start_broadcast', force: true }),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || `agent_run_${response.status}`);
          let run = data.run || null;
          if (data.accepted) {
            const deadline = Date.now() + 150_000;
            while (Date.now() < deadline) {
              await new Promise((resolve) => window.setTimeout(resolve, 2_500));
              const statusResponse = await fetch(AGENT_RUNS_API, { method: 'GET', credentials: 'same-origin', headers: { Accept: 'application/json' } });
              if (!statusResponse.ok) continue;
              const statusData = await statusResponse.json();
              const candidate = statusData.latestRun;
              if (!candidate || new Date(candidate.startedAt || 0).getTime() < requestedAt - 2_000) continue;
              renderAgentRun(candidate);
              if (candidate.status === 'completed') { run = candidate; break; }
              if (candidate.status === 'failed') throw new Error(candidate.error || 'agent_run_failed');
            }
          }
          if (!run || run.status !== 'completed') throw new Error('agent_run_timeout');
          renderAgentRun(run);
          showToast('Les neuf agents ont terminé. Le dossier attend ta relecture, sans aucune action MailerLite.');
          if (firstFlight) {
            adoptAgentDraft();
            openMissionDialog('broadcast-value');
          }
          return run;
        } catch (error) {
          await loadAgentWorkspace();
          const messages = {
            agent_run_already_in_progress: 'Un cycle est déjà en cours. Son état va se mettre à jour.',
            ai_provider_not_configured: 'Aucun moteur IA n’est configuré pour la division.',
            email_division_storage_not_configured: 'La mémoire durable de la division n’est pas configurée.',
          };
          showToast(messages[error.message] || 'Le cycle IA s’est arrêté avant toute action MailerLite.');
        } finally {
          if (firstFlight) firstFlightBusy = false;
          button.disabled = false;
          if (!firstFlight && currentAgentRun?.status !== 'running') button.textContent = 'Relancer un cycle IA';
          renderFirstFlight();
        }
        return null;
      }

      function adoptAgentDraft() {
        const artifact = currentAgentRun?.artifact;
        if (!artifact) return;
        initializeEmailDraft();
        const preserved = emailStudioState.draft || {};
        const sender = currentOverview?.senderRecommendation || {};
        const audience = currentOverview?.recommendedValueAudience || {};
        emailStudioState.draft = {
          ...preserved,
          campaignName: preserved.campaignName || 'Broadcast valeur',
          fromName: preserved.fromName || sender.fromName || 'Sonny Court',
          fromAddress: preserved.fromAddress || sender.fromAddress || '',
          audienceType: preserved.audienceType || audience.type || '',
          audienceId: preserved.audienceId || audience.id || '',
          audienceName: preserved.audienceName || audience.name || '',
          audienceCount: Number(preserved.audienceCount || audience.count) || 0,
          subject: artifact.subjectA,
          subjectVariant: artifact.subjectB,
          preheader: artifact.preheader,
          body: artifact.emailBody,
          ctaLabel: artifact.ctaLabel,
          ctaUrl: artifact.ctaUrlRecommendation,
          hypothesis: artifact.hypothesis,
        };
        const version = { at: new Date().toISOString(), author: 'Équipe IA · Nova', draft: { ...emailStudioState.draft } };
        emailStudioState.versions = [version, ...(emailStudioState.versions || [])].slice(0, 20);
        emailStudioState.contentApproval = null;
        finalApprovalToken = '';
        persistEmailStudioState();
        populateAudienceOptions();
        writeDraftToFields();
        renderEmailStudio();
        persistWorkspaceDurably();
        showToast('Proposition chargée. Le cockpit a prérempli l’expéditeur et l’audience recommandés sans rien modifier dans MailerLite.');
      }

      async function actionRequest(payload) {
        const response = await fetch(ACTIONS_API, {
          method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          const error = new Error(data.error || `action_${response.status}`);
          error.payload = data;
          throw error;
        }
        return data;
      }

      function actionErrorMessage(error) {
        const messages = {
          authentication_required: 'Reconnecte-toi à l’espace administrateur avant une écriture.',
          authenticated_session_required_for_writes: 'Une session administrateur authentifiée est obligatoire pour écrire.',
          test_flights_locked: 'L’épreuve isolée n’est pas encore activée côté serveur.',
          explicit_test_approval_required: 'Relis puis confirme exactement « ENVOYER TEST ».',
          dossier_approval_required: 'Valide d’abord le dossier de mission.',
          content_approval_required: 'Valide d’abord cette version exacte dans l’éditeur.',
          draft_changed_after_content_approval: 'La version a changé depuis ta validation. Valide-la de nouveau.',
          test_proof_already_requested_for_this_version: 'Cette version exacte a déjà demandé une épreuve récemment.',
          test_group_is_not_isolated: 'Le groupe test contient une autre adresse active : l’envoi a été bloqué.',
          test_recipient_is_not_active: 'L’adresse test n’est pas active dans MailerLite : l’envoi a été bloqué.',
          draft_writes_locked: 'La création de brouillons est encore verrouillée.',
          broadcast_sends_locked: 'Les envois broadcast sont encore verrouillés.',
          invalid_draft: 'MailerLite refuse encore certains paramètres du brouillon.',
          campaign_not_managed_by_email_division: 'Cette campagne n’a pas été créée par la division et reste donc intouchable.',
          campaign_changed_after_approval: 'Le brouillon a changé : la validation finale est annulée.',
          campaign_preflight_failed: 'Le contrôle MailerLite signale des données manquantes ou des alertes.',
          invalid_or_expired_approval: 'La validation finale a expiré. Relance le contrôle.',
        };
        return messages[error?.message] || 'L’action MailerLite n’a pas abouti. Aucun envoi n’a été déclenché.';
      }

      function openTestConfirmation() {
        const stage = emailStageState();
        if (!actionCapabilities.testFlightsEnabled || !stage.dossierApproved || !stage.contentApproved || stage.testProofSent) return;
        byId('testConfirmationRecipient').textContent = actionCapabilities.testRecipients?.[0] || 'sonnycourt@gmail.com';
        byId('testConfirmationSubject').textContent = emailStudioState.draft?.subject || '—';
        byId('testConfirmationAudience').textContent = emailStudioState.draft?.audienceName || '—';
        byId('confirmTestReview').checked = false;
        byId('testConfirmationPhrase').value = '';
        byId('sendTestProofButton').textContent = 'Envoyer uniquement l’épreuve';
        byId('testAuthMessage').textContent = 'Une session administrateur reste obligatoire pour l’écriture réelle.';
        updateTestProofButton();
        if (!testConfirmationDialog.open) testConfirmationDialog.showModal();
      }

      function updateTestProofButton() {
        const phraseOk = byId('testConfirmationPhrase').value.trim() === actionCapabilities.testConfirmationPhrase;
        const reviewed = byId('confirmTestReview').checked;
        byId('sendTestProofButton').disabled = !actionCapabilities.testFlightsEnabled || !phraseOk || !reviewed;
      }

      async function sendTestProof() {
        const button = byId('sendTestProofButton');
        if (button.disabled) return;
        button.disabled = true;
        button.textContent = 'Transmission de l’épreuve…';
        try {
          const sentSnapshot = draftSnapshot(emailStudioState.draft);
          const data = await actionRequest({
            operation: 'send_test_proof',
            finalApproval: true,
            confirmation: byId('testConfirmationPhrase').value.trim(),
            draft: emailStudioState.draft,
          });
          emailStudioState.testProof = { ...data.testProof, sentSnapshot };
          persistEmailStudioState();
          await persistWorkspaceDurably();
          testConfirmationDialog.close();
