          : `Décris précisément ce que tu veux que ${agent.name} analyse ou prépare.`;
        byId('agentCommandCharacters').textContent = '0';
        byId('agentCommandDeliverable').value = 'recommendations';
        byId('agentCommandWebSearch').checked = ['iris', 'alma', 'sacha', 'ada', 'eli', 'milo'].includes(agent.id);
        byId('agentCommandSubmit').disabled = false;
        byId('agentCommandSubmit').innerHTML = '<span aria-hidden="true">▶</span> Lancer la mission';
