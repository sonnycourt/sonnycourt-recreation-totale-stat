        byId('sendCampaignAudience').textContent = campaign.audience?.join(' · ') || emailStudioState.draft?.audienceName || '—';
        byId('sendCampaignFrom').textContent = [campaign.fromName, campaign.fromAddress].filter(Boolean).join(' · ') || '—';
