      async function loadDirectMissions() {
        try {
          const response = await fetch(`${DIRECT_MISSIONS_API}?limit=40`, {
            method: 'GET', credentials: 'same-origin', headers: { Accept: 'application/json' },
          });
          if (!response.ok) return null;
          const data = await response.json();
          directMissions = Array.isArray(data.missions) ? data.missions : [];
          if (agentProfileDialog.open) renderAgentMissionHistory(agentProfileDialog.dataset.agent);
          renderValidatorHome();
          return directMissions;
        } catch {
          return null;
        }
      }

      function replaceDirectMission(mission) {
        directMissions = [mission, ...directMissions.filter((item) => item.id !== mission.id)]
          .sort((a, b) => new Date(b.updatedAt || b.createdAt) - new Date(a.updatedAt || a.createdAt));
      }

      async function submitDirectMission(event) {
        event.preventDefault();
        const agentId = agentCommandDialog.dataset.agent;
        const objective = byId('agentCommandObjective').value.trim();
        if (objective.length < 12) {
          showToast('Décris la mission en une phrase un peu plus précise.');
          byId('agentCommandObjective').focus();
          return;
        }
        const button = byId('agentCommandSubmit');
        button.disabled = true;
        button.textContent = 'Mission transmise…';
        try {
          const response = await fetch(DIRECT_MISSIONS_API, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              operation: 'start', agentId, objective,
              deliverable: byId('agentCommandDeliverable').value,
              webSearchAllowed: byId('agentCommandWebSearch').checked,
            }),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || `direct_mission_${response.status}`);
          replaceDirectMission(data.mission);
          agentCommandDialog.close();
          showToast(`${data.mission.agent.name} est parti en mission. Aucune action externe ne sera exécutée.`);
          openDirectMission(data.mission.id);
          renderValidatorHome();
        } catch (error) {
          const message = String(error?.message || '');
          showToast(message === 'too_many_active_missions'
            ? 'Trois missions travaillent déjà. Attends qu’une d’elles revienne avant d’en lancer une autre.'
            : 'La mission n’a pas pu démarrer. Aucun outil externe n’a été modifié.');
          button.disabled = false;
          button.innerHTML = '<span aria-hidden="true">▶</span> Lancer la mission';
        }
      }

      function renderDirectMission(mission) {
        if (!mission) return;
        const agent = agentById(mission.agentId);
        activeDirectMissionId = mission.id;
        applyAgentSprite(directMissionDialog, agent);
        byId('directMissionOwner').textContent = `Dossier ${mission.id.slice(0, 8)} · ${mission.agent?.name || agent?.name || 'Agent'}`;
        byId('directMissionAgentName').textContent = mission.agent?.name || agent?.name || 'Agent';
        byId('directMissionAgentRole').textContent = mission.agent?.role || agent?.role || 'Email Marketing Division';
        byId('directMissionStatus').textContent = directMissionStatusLabel(mission.status);
        byId('directMissionStatus').dataset.status = mission.status;
        byId('directMissionTitle').textContent = mission.result?.title || `${mission.agent?.name || 'L’agent'} travaille sur ta demande`;
        byId('directMissionObjective').textContent = mission.objective;

        const loading = byId('directMissionLoading');
        const report = byId('directMissionReport');
        const decision = byId('directMissionDecision');
        const isWorking = ['queued', 'running'].includes(mission.status);
        loading.hidden = !isWorking && mission.status !== 'failed';
        report.hidden = !mission.result;
        decision.hidden = mission.status !== 'review';
        byId('directMissionDecisionNote').value = '';

        if (mission.status === 'failed') {
          loading.hidden = false;
          byId('directMissionLoadingTitle').textContent = 'La mission s’est arrêtée en sécurité.';
          byId('directMissionLoadingDetail').textContent = 'Aucune action externe n’a été exécutée. Tu peux fermer puis relancer une nouvelle mission.';
        } else {
          byId('directMissionLoadingTitle').textContent = mission.status === 'queued' ? 'La mission rejoint la file de travail…' : `${mission.agent?.name || 'L’agent'} travaille sur ton dossier…`;
          byId('directMissionLoadingDetail').textContent = mission.webSearchAllowed
            ? 'Recherche web en lecture seule, analyse et synthèse en cours. Tu peux fermer : le travail continue.'
            : 'Analyse et synthèse internes en cours. Tu peux fermer : le travail continue.';
        }

        if (mission.result) {
          byId('directMissionSummary').textContent = mission.result.executiveSummary || 'Rapport prêt pour ta validation.';
          const findings = byId('directMissionFindings');
          findings.replaceChildren();
          (mission.result.findings || []).forEach((finding, index) => {
            const card = document.createElement('article');
            const number = document.createElement('span'); number.textContent = String(index + 1).padStart(2, '0');
            const content = document.createElement('div');
            const title = document.createElement('h3'); title.textContent = finding.title;
            const detail = document.createElement('p'); detail.textContent = finding.detail;
            content.append(title, detail);
            if (finding.evidence?.length) {
              const evidence = document.createElement('ul');
              finding.evidence.forEach((proof) => { const item = document.createElement('li'); item.textContent = proof; evidence.append(item); });
              content.append(evidence);
            }
            const recommendation = document.createElement('strong'); recommendation.textContent = finding.recommendation;
            content.append(recommendation);
            card.append(number, content);
            findings.append(card);
          });

          const sources = byId('directMissionSources');
          sources.replaceChildren();
          const sourceItems = mission.result.sources || [];
          byId('directMissionSourcesSection').hidden = !sourceItems.length;
          sourceItems.forEach((source) => {
            const link = document.createElement('a');
            link.href = source.url; link.target = '_blank'; link.rel = 'noopener noreferrer';
            const copy = document.createElement('span');
            const title = document.createElement('strong'); title.textContent = source.title;
            const reason = document.createElement('small'); reason.textContent = source.whyRelevant;
            copy.append(title, reason);
            const arrow = document.createElement('i'); arrow.textContent = '↗';
            link.append(copy, arrow); sources.append(link);
          });

          const next = byId('directMissionNextActions');
          next.replaceChildren();
          (mission.result.nextActions || []).forEach((action) => { const item = document.createElement('li'); item.textContent = action; next.append(item); });
          const external = byId('directMissionExternal');
          external.hidden = !mission.result.requiresExternalAction;
          byId('directMissionExternalCopy').textContent = mission.result.externalActionProposal || '';
        }
      }

      async function pollDirectMission(id) {
        window.clearTimeout(directMissionPollTimer);
        if (!id || !directMissionDialog.open || activeDirectMissionId !== id) return;
        try {
          const response = await fetch(`${DIRECT_MISSIONS_API}?id=${encodeURIComponent(id)}`, {
            method: 'GET', credentials: 'same-origin', headers: { Accept: 'application/json' },
          });
          if (!response.ok) throw new Error(`direct_mission_${response.status}`);
          const data = await response.json();
          replaceDirectMission(data.mission);
          renderDirectMission(data.mission);
          renderValidatorHome();
          if (['queued', 'running'].includes(data.mission.status)) {
            directMissionPollTimer = window.setTimeout(() => pollDirectMission(id), 2_500);
          } else if (data.mission.status === 'review') {
            showToast(`${data.mission.agent.name} a terminé sa mission. Ton rapport est prêt à valider.`);
          }
        } catch {
          directMissionPollTimer = window.setTimeout(() => pollDirectMission(id), 5_000);
        }
      }

      function openDirectMission(id) {
        const mission = directMissions.find((item) => item.id === id);
        if (!mission) return;
        renderDirectMission(mission);
        if (!directMissionDialog.open) directMissionDialog.showModal();
        if (['queued', 'running'].includes(mission.status)) pollDirectMission(id);
      }

      async function decideDirectMission(decision) {
        const mission = directMissions.find((item) => item.id === activeDirectMissionId);
        if (!mission) return;
        const note = byId('directMissionDecisionNote').value.trim();
        if (decision === 'revision' && note.length < 3) {
          showToast('Indique la correction attendue pour que l’agent puisse reprendre son travail.');
          byId('directMissionDecisionNote').focus();
          return;
        }
        const buttons = [byId('approveDirectMission'), byId('reviseDirectMission'), byId('abandonDirectMission')];
        buttons.forEach((button) => { button.disabled = true; });
        try {
          const response = await fetch(DIRECT_MISSIONS_API, {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ operation: 'decide', id: mission.id, decision, note }),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || `direct_mission_decision_${response.status}`);
          replaceDirectMission(data.mission);
          renderDirectMission(data.mission);
          renderValidatorHome();
          if (decision === 'revision') {
            showToast(`${mission.agent.name} reprend le rapport avec ta correction.`);
            pollDirectMission(mission.id);
          } else {
            showToast(decision === 'approved' ? 'Rapport validé et conservé dans la mémoire de la division.' : 'Mission abandonnée sans aucune action externe.');
          }
        } catch {
          showToast('Ta décision n’a pas pu être enregistrée. Aucune action externe n’a été exécutée.');
        } finally {
          buttons.forEach((button) => { button.disabled = false; });
        }
      }

      function renderAgents(agents) {
        currentAgents = Array.isArray(agents) ? agents : [];
        const floor = byId('agentFloor');
        floor.replaceChildren();

        currentAgents.forEach((agent, index) => {
          const card = document.createElement('button');
          card.type = 'button';
          card.className = 'agent-card';
          card.dataset.agent = agent.id;
          card.dataset.color = agent.color;
          card.dataset.state = agent.state;
          card.dataset.spriteGroup = agent.spriteGroup;
          card.dataset.spriteIndex = String(agent.spriteIndex);
          card.style.setProperty('--agent-delay', `${-(index * .17)}s`);
          card.setAttribute('aria-label', `${agent.name}, ${agent.role}. ${agent.stateLabel}.`);
          card.setAttribute('aria-haspopup', 'dialog');
          card.setAttribute('aria-controls', 'agentProfileDialog');
          card.setAttribute('aria-pressed', 'false');

          const avatar = document.createElement('span');
          avatar.className = 'agent-avatar';
          avatar.setAttribute('aria-hidden', 'true');
          const pulse = document.createElement('i');
          pulse.className = 'agent-pulse';
          avatar.append(pulse);

          const label = document.createElement('span');
          label.className = 'agent-info';
          const name = document.createElement('strong');
          name.className = 'agent-name';
          name.textContent = agent.name;
          const role = document.createElement('small');
          role.className = 'agent-role';
          role.textContent = agent.role;
          label.append(name, role);
          card.append(avatar, label);
          card.addEventListener('click', () => {
            showAgentFocus(agent);
            openAgentProfile(agent);
          });
          floor.append(card);
        });

        showAgentFocus(currentAgents.find((agent) => agent.id === selectedAgentId) || currentAgents[0]);
      }

      function effectiveMission(mission) {
        const decision = missionDecisions[mission.id];
        if (!decision) return { ...mission, effectiveStatus: mission.status, effectiveStatusLabel: mission.statusLabel };
        const effectiveStatus = decision.type === 'approved' ? 'validated' : 'revision';
        return {
          ...mission,
          localDecision: decision,
          effectiveStatus,
          effectiveStatusLabel: missionStatusLabels[effectiveStatus],
          progress: decision.type === 'approved' ? 100 : mission.progress,
        };
      }

      function makeMissionStatus(status, label) {
        const node = document.createElement('span');
        node.className = 'mission-status';
        node.dataset.status = status;
        node.textContent = label || missionStatusLabels[status] || status;
        return node;
      }

      function renderMissionFeature(rawMission) {
        if (!rawMission) return;
        const mission = effectiveMission(rawMission);
        const feature = byId('missionFeature');
        feature.dataset.tone = mission.tone;
        feature.dataset.status = mission.effectiveStatus;
        byId('featuredMissionPriority').textContent = mission.priority;
        byId('featuredMissionStatus').replaceWith(makeMissionStatus(mission.effectiveStatus, mission.effectiveStatusLabel));
        const replacedStatus = document.querySelector('.mission-feature-topline .mission-status');
        replacedStatus.id = 'featuredMissionStatus';
        byId('featuredMissionOwner').textContent = `Mission pilotée par ${mission.owner}`;
        byId('featuredMissionTitle').textContent = mission.title;
        byId('featuredMissionSummary').textContent = mission.summary;
        byId('featuredMissionProgress').textContent = `${mission.progress} %`;
        byId('featuredMissionDeliverable').textContent = mission.deliverable;

        const evidence = byId('featuredMissionEvidence');
        evidence.replaceChildren();
        (mission.evidence || []).slice(0, 4).forEach((item, index) => {
          const proof = document.createElement('div');
          proof.className = 'mission-proof';
          const number = document.createElement('span'); number.textContent = String(index + 1).padStart(2, '0');
          const text = document.createElement('p'); text.textContent = item;
          proof.append(number, text); evidence.append(proof);
        });

        const pipeline = byId('missionPipeline');
        pipeline.replaceChildren();
        (mission.steps || []).forEach((step) => {
          const item = document.createElement('div');
          item.className = 'mission-pipeline-step';
          item.dataset.status = step.status;
          const avatar = document.createElement('span'); avatar.className = 'mission-step-avatar'; avatar.textContent = step.initials;
          const copy = document.createElement('span');
          const owner = document.createElement('strong'); owner.textContent = step.agent;
          const label = document.createElement('small'); label.textContent = step.label;
          copy.append(owner, label);
          const state = document.createElement('i'); state.setAttribute('aria-label', missionStatusLabels[step.status] || step.status);
          item.append(avatar, copy, state); pipeline.append(item);
        });

        const openButton = byId('openFeaturedMission');
        openButton.textContent = mission.effectiveStatus === 'validated' ? 'Relire le dossier' : 'Ouvrir le dossier';
        openButton.onclick = () => openMissionDialog(mission.id);
      }

      function makeMissionListCard(rawMission) {
        const mission = effectiveMission(rawMission);
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'mission-list-card';
        button.dataset.status = mission.effectiveStatus;
        button.dataset.tone = mission.tone;
        button.setAttribute('aria-pressed', mission.id === featuredMissionId ? 'true' : 'false');

        const top = document.createElement('span'); top.className = 'mission-list-card-top';
        const owner = document.createElement('span'); owner.className = 'mission-list-owner'; owner.textContent = mission.owner;
        top.append(owner, makeMissionStatus(mission.effectiveStatus, mission.effectiveStatusLabel));
        const title = document.createElement('strong'); title.textContent = mission.title;
        const meta = document.createElement('span'); meta.className = 'mission-list-meta';
        const priority = document.createElement('small'); priority.textContent = mission.priority;
        const due = document.createElement('small'); due.textContent = mission.dueLabel;
        meta.append(priority, due);
        const progress = document.createElement('span'); progress.className = 'mission-list-progress';
        const bar = document.createElement('i'); bar.style.width = `${Math.max(0, Math.min(100, mission.progress))}%`;
        progress.append(bar);
        button.append(top, title, meta, progress);
        button.addEventListener('click', () => {
          featuredMissionId = mission.id;
          renderMissionFeature(rawMission);
          renderMissionPortfolio();
        });
        return button;
      }

      function renderMissionPortfolio() {
        const list = byId('missionList');
        list.replaceChildren();
        currentMissions.forEach((mission) => list.append(makeMissionListCard(mission)));
      }

      function renderMissions(missions) {
        currentMissions = Array.isArray(missions) ? missions : [];
        const effective = currentMissions.map(effectiveMission);
        const count = (statuses) => effective.filter((mission) => statuses.includes(mission.effectiveStatus)).length;
        byId('missionWorkingCount').textContent = String(count(['working', 'revision']));
        byId('missionReviewCount').textContent = String(count(['review']));
        byId('missionQueuedCount').textContent = String(count(['queued']));
        byId('missionDoneCount').textContent = String(count(['done', 'validated']));
        byId('missionPortfolioLabel').textContent = `${currentMissions.length} missions actives · décisions conservées sur cet appareil`;
        const featured = currentMissions.find((mission) => mission.id === featuredMissionId) || currentMissions[0];
        if (featured) featuredMissionId = featured.id;
        renderMissionFeature(featured);
        renderMissionPortfolio();
      }

      function openMissionDialog(id) {
        const rawMission = currentMissions.find((mission) => mission.id === id);
        if (!rawMission) return;
        activeMissionId = id;
        const mission = effectiveMission(rawMission);
        byId('missionDialogOwner').textContent = `Dossier piloté par ${mission.owner}`;
        byId('missionDialogPriority').textContent = mission.priority;
        byId('missionDialogStatus').replaceWith(makeMissionStatus(mission.effectiveStatus, mission.effectiveStatusLabel));
        const status = document.querySelector('.mission-dialog-heading .mission-status');
        status.id = 'missionDialogStatus';
        byId('missionDialogTitle').textContent = mission.title;
        byId('missionDialogSummary').textContent = mission.summary;
        byId('missionDecisionPrompt').textContent = mission.decisionPrompt;

        const evidence = byId('missionDialogEvidence'); evidence.replaceChildren();
        (mission.evidence || []).forEach((item) => { const li = document.createElement('li'); li.textContent = item; evidence.append(li); });
        const deliverables = byId('missionDialogDeliverables'); deliverables.replaceChildren();
        (mission.deliverables || []).forEach((item) => { const li = document.createElement('li'); li.textContent = item; deliverables.append(li); });
        const steps = byId('missionDialogSteps'); steps.replaceChildren();
        (mission.steps || []).forEach((step) => {
          const row = document.createElement('div'); row.className = 'mission-dialog-step'; row.dataset.status = step.status;
          const initials = document.createElement('span'); initials.textContent = step.initials;
          const copy = document.createElement('div');
          const title = document.createElement('strong'); title.textContent = `${step.agent} · ${step.label}`;
          const detail = document.createElement('p'); detail.textContent = step.detail;
          copy.append(title, detail);
          const state = makeMissionStatus(step.status, missionStatusLabels[step.status]);
          row.append(initials, copy, state); steps.append(row);
        });

        const emailEntry = byId('missionEmailEntry');
        emailEntry.hidden = mission.type !== 'broadcast';
        if (mission.type === 'broadcast') {
          const hasLocalDraft = Boolean(emailStudioState.draft);
          byId('openEmailStudio').textContent = hasLocalDraft ? 'Reprendre la rédaction' : 'Ouvrir l’éditeur';
        }

        const decisionState = byId('missionDecisionState');
        const note = byId('missionDecisionNote');
        note.value = mission.localDecision?.note || '';
        if (mission.localDecision) {
          const decisionDate = new Date(mission.localDecision.at);
          decisionState.hidden = false;
          decisionState.dataset.type = mission.localDecision.type;
          decisionState.textContent = `${mission.effectiveStatusLabel} · ${dateTime(decisionDate)}`;
        } else {
          decisionState.hidden = true;
          decisionState.textContent = '';
          delete decisionState.dataset.type;
        }
        byId('approveMission').disabled = mission.localDecision?.type === 'approved';
        if (!missionDialog.open) missionDialog.showModal();
      }

      async function saveMissionDecision(type) {
        if (!activeMissionId) return;
        const note = byId('missionDecisionNote').value.trim();
        if (type === 'revision' && !note) {
          showToast('Ajoute une consigne avant de demander une correction.');
          byId('missionDecisionNote').focus();
          return;
        }
        missionDecisions[activeMissionId] = { type, note, at: new Date().toISOString() };
        try { window.localStorage.setItem(MISSION_DECISION_KEY, JSON.stringify(missionDecisions)); } catch {}
        await persistWorkspaceDurably();
        renderMissions(currentMissions);
        openMissionDialog(activeMissionId);
        renderFirstFlight();
        showToast(type === 'approved'
          ? 'Dossier validé. Le contenu peut maintenant être relu, sans aucune écriture MailerLite.'
          : 'Correction demandée et mémorisée localement.');
      }

      function makePriority(item, index) {
        const card = document.createElement('article');
        card.className = 'priority-card';
        card.dataset.tone = item.tone;

        const accent = document.createElement('span');
        accent.className = 'priority-accent';
        const copy = document.createElement('div');
        copy.className = 'priority-copy';
        const title = document.createElement('h3');
        title.textContent = item.title;
        const detail = document.createElement('p');
        detail.textContent = item.detail;
        const meta = document.createElement('div');
        meta.className = 'priority-meta';
        const owner = document.createElement('span');
        owner.className = 'priority-owner';
        owner.textContent = item.owner;
        const evidence = document.createElement('span');
        evidence.textContent = item.evidence;
        meta.append(owner, evidence);
        copy.append(title, detail, meta);

        const button = document.createElement('button');
        button.className = 'review-button';
        button.type = 'button';
        button.textContent = item.actionLabel || 'Examiner';
        button.addEventListener('click', () => openRecommendation(index));
        card.append(accent, copy, button);
        return card;
      }

      function renderPriorities(priorities) {
        currentPriorities = priorities || [];
        byId('priorityCount').textContent = String(currentPriorities.length);
        const list = byId('priorityList');
        list.replaceChildren();
        if (!currentPriorities.length) {
          const empty = document.createElement('div');
          empty.className = 'empty-state';
          empty.textContent = 'Aucun arbitrage prioritaire détecté pour ce briefing.';
          list.append(empty);
          return;
        }
        currentPriorities.forEach((item, index) => list.append(makePriority(item, index)));
      }

      function openRecommendation(index) {
        const item = currentPriorities[index];
        if (!item) return;
        byId('dialogOwner').textContent = `Dossier préparé par ${item.owner}`;
        byId('dialogTitle').textContent = item.title;
        byId('dialogDetail').textContent = item.detail;
        byId('dialogEvidence').textContent = item.evidence;
        reviewDialog.showModal();
      }

      function renderActivity(data) {
        const feed = byId('activityFeed');
        feed.replaceChildren();
        const timestamp = new Date(data.generatedAt);
        const items = [
          ['SA', 'Sacha a terminé le scan', `${data.metrics.inspectedRecentCampaigns} campagnes et ${data.metrics.activeAutomations + data.metrics.inactiveAutomations} automations lues.`, 'maintenant'],
          ['NO', 'Nova a ordonné le briefing', `${data.priorities.length} recommandation${data.priorities.length > 1 ? 's' : ''} classée${data.priorities.length > 1 ? 's' : ''} par priorité.`, '-1 min'],
          ['MI', 'Milo a consolidé la mémoire', 'Le nouveau scan est prêt à rejoindre l’historique d’apprentissage.', '-1 min'],
          ['AL', 'Alma a évalué la cadence', `${data.metrics.campaignsLast30Days} grand${data.metrics.campaignsLast30Days > 1 ? 's' : ''} broadcast${data.metrics.campaignsLast30Days > 1 ? 's' : ''} sur 30 jours.`, '-2 min'],
          ['IN', 'Inès a cartographié la base', `${data.metrics.segmentCount} segments observés, sans ouvrir de fiche contact.`, '-2 min'],
        ];
        for (const [initials, title, description, time] of items) {
          const row = document.createElement('div');
          row.className = 'activity-item';
          const avatar = document.createElement('span'); avatar.className = 'activity-avatar'; avatar.textContent = initials;
          const copy = document.createElement('div');
          const strong = document.createElement('strong'); strong.textContent = title;
          const p = document.createElement('p'); p.textContent = description;
          copy.append(strong, p);
          const timeNode = document.createElement('span'); timeNode.className = 'activity-time'; timeNode.textContent = time;
          row.append(avatar, copy, timeNode);
          feed.append(row);
        }
        byId('syncLabel').textContent = `Synchronisé ${dateTime(timestamp)}`;
      }

      function renderCampaigns(campaigns) {
        const tbody = byId('campaignRows');
        tbody.replaceChildren();
        if (!campaigns?.length) {
          const row = document.createElement('tr');
          const cell = document.createElement('td'); cell.colSpan = 5; cell.textContent = 'Aucune campagne récente disponible.';
          row.append(cell); tbody.append(row); return;
        }
        for (const campaign of campaigns) {
          const row = document.createElement('tr');
          const nameCell = document.createElement('td');
          const wrapper = document.createElement('div'); wrapper.className = 'campaign-cell';
          const icon = document.createElement('span'); icon.className = 'campaign-icon'; icon.textContent = '✉';
          const name = document.createElement('span'); name.className = 'campaign-name';
          const strong = document.createElement('strong'); strong.textContent = campaign.name;
          const small = document.createElement('small');
          small.textContent = campaign.sentAt ? new Intl.DateTimeFormat('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }).format(new Date(campaign.sentAt)) : 'Date inconnue';
          name.append(strong, small); wrapper.append(icon, name); nameCell.append(wrapper);
          const values = [formatNumber(campaign.sent), formatRate(campaign.openRate), formatRate(campaign.clickRate), formatRate(campaign.unsubscribeRate)];
          row.append(nameCell, ...values.map((value) => { const cell = document.createElement('td'); cell.textContent = value; return cell; }));
          tbody.append(row);
        }
      }

      function renderOverview(data) {
        currentOverview = data;
        const metrics = data.metrics;
        renderAgents(data.agents);
        renderMissions(data.missions);
        renderPriorities(data.priorities);
        renderActivity(data);
        renderCampaigns(data.recentCampaigns);
        renderFirstFlight();

        const maturity = computeMaturity(metrics);
        byId('maturityScore').textContent = String(maturity);
        byId('maturityLabel').textContent = maturity >= 80 ? 'Fondations solides, pilotage à structurer' : maturity >= 65 ? 'Potentiel fort, rythme à stabiliser' : 'Actifs forts, système encore sous-exploité';
        byId('briefingDate').textContent = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(data.generatedAt));
        byId('lastBroadcastValue').textContent = metrics.lastBroadcastDays == null ? 'Non détecté' : metrics.lastBroadcastDays === 0 ? 'Aujourd’hui' : `${metrics.lastBroadcastDays} j`;
        byId('pipelineValue').textContent = formatNumber(metrics.readyCount + metrics.draftCount);
        byId('trackingValue').textContent = `${metrics.trackedRecentCampaigns}/${metrics.inspectedRecentCampaigns}`;
        byId('webhookValue').textContent = formatNumber(metrics.activeWebhooks);

        byId('metricCadence').textContent = formatNumber(metrics.campaignsLast30Days);
        const cadenceDelta = metrics.campaignsLast30Days - metrics.campaignsPrevious30Days;
        const cadenceTrend = byId('metricCadenceTrend');
        cadenceTrend.textContent = cadenceDelta === 0 ? 'Stable vs 30 j précédents' : `${cadenceDelta > 0 ? '+' : ''}${cadenceDelta} vs 30 j précédents`;
        cadenceTrend.className = `metric-trend ${metrics.campaignsLast30Days >= 4 ? 'good' : 'warn'}`;
        byId('metricOpen').textContent = formatRate(metrics.openRate90Days);
        byId('metricClick').textContent = formatRate(metrics.clickRate90Days);
        byId('metricUnsub').textContent = formatRate(metrics.unsubscribeRate90Days);
        const unsubTrend = byId('metricUnsubTrend');
        unsubTrend.textContent = metrics.unsubscribeRate90Days <= .3 ? 'Sous le seuil de vigilance' : 'À surveiller';
        unsubTrend.className = `metric-trend ${metrics.unsubscribeRate90Days <= .3 ? 'good' : 'warn'}`;
        byId('metricAutomations').textContent = formatNumber(metrics.activeAutomations);
        byId('metricAutomationDetail').textContent = `${metrics.automationSteps} étapes · ${metrics.automationEmailSteps} emails`;
        byId('metricInactive').textContent = formatNumber(metrics.inactiveContacts);

        const strongest = data.automationSignals?.strongest;
        const weakest = data.automationSignals?.weakest;
        byId('strongAutomation').textContent = strongest?.name || 'Volume insuffisant';
        byId('strongAutomationRate').textContent = strongest ? `${formatRate(strongest.clickRate)} de clics` : '—';
        byId('weakAutomation').textContent = weakest?.name || 'Volume insuffisant';
        byId('weakAutomationRate').textContent = weakest ? `${formatRate(weakest.clickRate)} de clics` : '—';
        byId('automationWarnings').textContent = formatNumber(data.automationSignals?.warningCount);
        byId('segmentCount').textContent = formatNumber(metrics.segmentCount);
        byId('groupCount').textContent = formatNumber(metrics.groupCount);
        byId('fieldCount').textContent = formatNumber(metrics.fieldsCount);
        byId('activeSixMonths').textContent = formatNumber(metrics.activeSixMonths);

        if (data.unavailable?.length) showToast(`Données partielles : ${data.unavailable.length} source(s) MailerLite momentanément indisponible(s).`);
        renderValidatorHome();
      }

      async function loadOverview({ initial = false } = {}) {
        refreshButton.disabled = true;
        try {
          const response = await fetch(OVERVIEW_API, { method: 'GET', credentials: 'same-origin', headers: { Accept: 'application/json' } });
          if (response.status === 401) {
            loadingScreen.hidden = true;
            lockedScreen.hidden = false;
            return;
          }
          if (!response.ok) throw new Error(`overview_${response.status}`);
          const data = await response.json();
          renderOverview(data);
          await Promise.all([loadActionCapabilities(), loadAgentWorkspace(), loadAutonomy(), loadDirectMissions()]);
          workspace.setAttribute('aria-busy', 'false');
          loadingScreen.hidden = true;
          lockedScreen.hidden = true;
          if (!initial) showToast('Briefing MailerLite actualisé. Aucune action n’a été exécutée.');
        } catch (error) {
          loadingScreen.hidden = true;
          workspace.setAttribute('aria-busy', 'false');
          showToast('Lecture MailerLite indisponible pour le moment. Aucun changement n’a été effectué.');
        } finally {
          refreshButton.disabled = false;
        }
      }

      refreshButton.addEventListener('click', () => loadOverview());
      byId('openDepartmentView').addEventListener('click', showDepartmentMode);
      byId('backToValidatorMode').addEventListener('click', showValidatorMode);
      byId('dialogClose').addEventListener('click', () => reviewDialog.close());
      reviewDialog.addEventListener('click', (event) => {
        if (event.target === reviewDialog) reviewDialog.close();
      });
      byId('agentProfileClose').addEventListener('click', () => agentProfileDialog.close());
      agentProfileDialog.addEventListener('click', (event) => {
        if (event.target === agentProfileDialog) agentProfileDialog.close();
      });
      byId('openAgentMissionComposer').addEventListener('click', () => openAgentMissionComposer(agentById(agentProfileDialog.dataset.agent)));
      byId('agentCommandClose').addEventListener('click', () => agentCommandDialog.close());
      agentCommandDialog.addEventListener('click', (event) => {
        if (event.target === agentCommandDialog) agentCommandDialog.close();
      });
      byId('agentCommandObjective').addEventListener('input', (event) => {
        byId('agentCommandCharacters').textContent = String(event.currentTarget.value.length);
      });
      byId('agentCommandForm').addEventListener('submit', submitDirectMission);
      byId('directMissionClose').addEventListener('click', () => directMissionDialog.close());
      directMissionDialog.addEventListener('close', () => {
        window.clearTimeout(directMissionPollTimer);
        activeDirectMissionId = null;
      });
      directMissionDialog.addEventListener('click', (event) => {
        if (event.target === directMissionDialog) directMissionDialog.close();
      });
      byId('approveDirectMission').addEventListener('click', () => decideDirectMission('approved'));
      byId('reviseDirectMission').addEventListener('click', () => decideDirectMission('revision'));
      byId('abandonDirectMission').addEventListener('click', () => decideDirectMission('abandoned'));
      byId('missionDialogClose').addEventListener('click', () => missionDialog.close());
      byId('approveMission').addEventListener('click', () => saveMissionDecision('approved'));
      byId('requestMissionRevision').addEventListener('click', () => saveMissionDecision('revision'));
      byId('openEmailStudio').addEventListener('click', openEmailStudio);
      missionDialog.addEventListener('click', (event) => {
        if (event.target === missionDialog) missionDialog.close();
      });
      byId('emailStudioClose').addEventListener('click', () => emailStudioDialog.close());
      emailStudioDialog.addEventListener('click', (event) => {
        if (event.target === emailStudioDialog) emailStudioDialog.close();
      });
      [
        'emailSubject', 'emailSubjectVariant', 'emailPreheader', 'emailFromName', 'emailFromAddress',
        'emailAudience', 'emailBody', 'emailCtaLabel', 'emailCtaUrl', 'emailHypothesis',
      ].forEach((id) => byId(id).addEventListener(id === 'emailAudience' ? 'change' : 'input', saveDraftFromEditor));
      document.querySelectorAll('[data-email-device]').forEach((button) => {
        button.addEventListener('click', () => {
          document.querySelectorAll('[data-email-device]').forEach((item) => item.classList.toggle('is-active', item === button));
          byId('emailPreviewViewport').dataset.device = button.dataset.emailDevice;
        });
      });
      byId('saveEmailVersion').addEventListener('click', saveEmailVersion);
      byId('approveEmailContent').addEventListener('click', approveEmailContent);
      byId('runAgentTeam').addEventListener('click', () => startAgentRun());
      byId('adoptAgentDraft').addEventListener('click', adoptAgentDraft);
      byId('startFirstFlight').addEventListener('click', () => startAgentRun({ firstFlight: true }));
      byId('openFirstFlightDossier').addEventListener('click', () => openMissionDialog('broadcast-value'));
      byId('openFirstFlightStudio').addEventListener('click', () => {
        if (!emailStudioState.draft && currentAgentRun?.artifact) adoptAgentDraft();
        openEmailStudio();
      });
      byId('runAutonomyNow').addEventListener('click', runAutonomyNow);
      byId('toggleAutonomy').addEventListener('click', toggleAutonomy);
      byId('syncMailerLiteDraft').addEventListener('click', syncMailerLiteDraft);
      byId('prepareTestProof').addEventListener('click', openTestConfirmation);
      byId('testConfirmationClose').addEventListener('click', () => testConfirmationDialog.close());
      testConfirmationDialog.addEventListener('click', (event) => {
        if (event.target === testConfirmationDialog) testConfirmationDialog.close();
      });
      byId('confirmTestReview').addEventListener('change', updateTestProofButton);
      byId('testConfirmationPhrase').addEventListener('input', updateTestProofButton);
      byId('sendTestProofButton').addEventListener('click', sendTestProof);
      byId('prepareFinalApproval').addEventListener('click', prepareFinalApproval);
      byId('sendConfirmationClose').addEventListener('click', () => sendConfirmationDialog.close());
      sendConfirmationDialog.addEventListener('click', (event) => {
        if (event.target === sendConfirmationDialog) sendConfirmationDialog.close();
      });
      byId('confirmFinalReview').addEventListener('change', updateFinalSendButton);
      byId('sendConfirmationPhrase').addEventListener('input', updateFinalSendButton);
      byId('finalSendButton').addEventListener('click', sendApprovedCampaign);
      loadOverview({ initial: true });
    </script>
  </body>
</html>
