---
import { inspira, inspiraEmbedUrl } from '../data/inspira.mjs';
import JungleStage from '../components/delta/JungleStage.astro';
import WalletMarks from '../components/delta/WalletMarks.astro';
import UrgencyPreview from '../components/delta/UrgencyPreview.astro';
import AnalyticsConsent from '../components/delta/AnalyticsConsent.astro';
import SocialProof from '../components/delta/SocialProof.astro';
import { responsiveDeltaImage, posterSizes, programSizes } from '../lib/delta-vision-images.mjs';
const videoUrl = inspiraEmbedUrl(inspira.presentationVideoUrl);
const checkoutUrl = inspira.checkoutUrl;
const socialImageUrl = 'https://sonnycourt.com/media/pages/delta-vision-social-v1.jpg';
const socialTitle = '12 minutes pour transformer ton état intérieur et attirer ce que tu veux vraiment.';
const socialDescription = "La nouvelle méthode qui combine respiration et visualisation pour changer d'état intérieur et transformer sa vie.";
const socialImageAlt = 'Delta Vision par Sonny Court — Respire. Visualise. Manifeste. Sonny en méditation dans une jungle lumineuse.';
const sectionLinks = [
  { href: '#presentation', label: 'Présentation' },
  { href: '#histoire', label: 'Pourquoi Delta Vision' },
  { href: '#ressentir', label: 'Ce que tu reçois' },
  { href: '#methode', label: 'La méthode' },
  { href: '#science', label: 'La science' },
];
const intentions = [
  { number: 'Jour 1', title: 'Tes premiers ressentis.', text: 'Après la séance, prends un instant pour observer : ton corps, ton souffle, ton état intérieur. Qu’est-ce qui est différent, ici et maintenant ?', icon: 'waves' },
  { number: 'Jour 2', title: 'Retrouver cet espace.', text: 'Reviens à la pratique et retrouve tes repères. Explore ce moment où les pensées peuvent laisser davantage de place aux sensations.', icon: 'waves' },
  { number: 'Jour 3', title: 'Rendre ta vision vivante.', text: 'Porte ton attention sur ce que ton souhait te fait ressentir. Moins chercher l’image parfaite. Plus laisser venir l’émotion.', icon: 'sun' },
  { number: 'Jour 4', title: 'Écouter ce qui compte.', text: 'Après la séance, demande-toi ce que tu souhaites vraiment cultiver. Fais une place à une intention plus claire pour ta journée.', icon: 'sun' },
  { number: 'Jour 5', title: 'Du ressenti à l’action.', text: 'Choisis un petit geste cohérent avec ta vision. Une décision, une conversation, un premier pas : donne une suite concrète à ton expérience.', icon: 'arrow' },
  { number: 'Jour 6', title: 'Ton rendez-vous avec toi.', text: 'Observe la place que prend ce rituel dans tes journées. Qu’as-tu envie de garder dans ton énergie, ton attention et ta façon d’agir ?', icon: 'waves' },
  { number: 'Jour 7', title: 'Mesurer ton chemin.', text: 'Repense à ton premier jour. Énergie, clarté, optimisme : qu’as-tu remarqué ? Identifie ce qui t’aide et ce que tu veux continuer à explorer.', icon: 'sun' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={inspira.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#faf8f4" />
    <script is:inline>
      // Keep invitations sent before the dedicated gift page usable.
      if (new URLSearchParams(location.hash.slice(1)).has('gift')) {
        location.replace('/delta-vision-cadeau-recu/' + location.hash);
      }
    </script>
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sonnycourt.com/delta-vision/" />
    <meta property="og:site_name" content="Sonny Court" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href="https://sonnycourt.com/delta-vision/" />
    <title>{inspira.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <svg class="svg-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <symbol id="delta-vision-mark" viewBox="0 0 48 48">
        <path d="M32 19 24 5 4 40h40l-6-10" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" />
        <path d="m25 18 2.4 6.6L34 27l-6.6 2.4L25 36l-2.4-6.6L16 27l6.6-2.4Z" fill="currentColor" />
      </symbol>
      <symbol id="inspira-sun" viewBox="0 0 40 40">
        <circle cx="20" cy="20" r="5" fill="currentColor" />
        {Array.from({ length: 12 }, (_, i) => <path d="M20 3v7" transform={`rotate(${i * 30} 20 20)`} stroke="currentColor" stroke-width="2" stroke-linecap="round" />)}
      </symbol>
      <symbol id="inspira-arrow" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></symbol>
      <symbol id="inspira-waves" viewBox="0 0 40 40"><path d="M3 14c6-12 12 12 18 0S32 2 37 14M3 22c6-12 12 12 18 0s11-12 16 0M3 30c6-12 12 12 18 0s11-12 16 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></symbol>
      <symbol id="inspira-play" viewBox="0 0 24 24"><path d="m9 5 11 7-11 7V5Z" fill="currentColor" /></symbol>
    </svg>

    <header class="site-header wrap">
      <a class="wordmark" href="#" aria-label="Delta Vision, accueil"><svg aria-hidden="true"><use href="#delta-vision-mark" /></svg><span class="wordmark-name">Delta <span>Vision</span></span></a>
      <nav aria-label="Navigation principale">
        <div class="section-nav">
          {sectionLinks.map(({ href, label }) => <a class="nav-link" href={href}>{label}</a>)}
        </div>
        <details class="mobile-nav">
          <summary>Explorer <span class="mobile-nav-icon" aria-hidden="true"><i></i><i></i></span></summary>
          <div class="mobile-nav-links">
            <p class="mobile-nav-heading">Découvrir Delta Vision</p>
            {sectionLinks.map(({ href, label }, index) => <a href={href}><span class="mobile-nav-number" aria-hidden="true">0{index + 1}</span><span>{label}</span><svg aria-hidden="true"><use href="#inspira-arrow" /></svg></a>)}
          </div>
        </details>
      </nav>
    </header>

    <main id="contenu">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-ambient" aria-hidden="true"></div>
        <p class="eyebrow hero-eyebrow"><span></span> Effets ressentis dès la première session guidée.</p>
        <h1 id="hero-title">12 minutes pour transformer ton état intérieur <em>et attirer ce que tu veux vraiment.</em></h1>
        <p class="hero-subtitle">La nouvelle méthode qui combine respiration et visualisation pour changer d'état intérieur et transformer sa vie.</p>
      </section>

      <section class="presentation wrap" id="presentation" aria-label="Présentation vidéo de Delta Vision">
        <JungleStage videoAvailable={Boolean(videoUrl)} instantPlayback responsiveImages>
        <div class="video-poster" data-inspira-video data-video-url={videoUrl || undefined}>
          <img class="video-thumbnail" src={inspira.presentationPosterUrl} {...responsiveDeltaImage(inspira.presentationPosterUrl, posterSizes)} width="1672" height="941" alt="Sonny Court en méditation au cœur d’une jungle baignée de brume et de lumière dorée" fetchpriority="high" />
            <button class="video-play" type="button" data-video-play aria-label="Lire la présentation de Delta Vision">
              <span class="video-play-disc"><svg aria-hidden="true"><use href="#inspira-play" /></svg></span>
            </button>
        </div>
        </JungleStage>
        <div class="price-card price-card--intro" aria-label="Rejoindre Delta Vision">
          <p class="price-launch">Offre de lancement</p>
          <UrgencyPreview />
          <a class="button button-coral" data-dv-buy href={checkoutUrl}>J’entre dans l’expérience <svg aria-hidden="true"><use href="#inspira-arrow" /></svg></a>
          <p class="purchase-guarantee"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 3 8 3v5c0 5-5 8-8 10-3-2-8-5-8-10V6l8-3Z" /><path d="m8 12 2.5 2.5L16 9" /></svg><span>Satisfait ou remboursé pendant 14 jours</span></p>
          <WalletMarks />
        </div>
        <SocialProof />
      </section>

      <section class="origin-story wrap section-space" id="histoire" aria-labelledby="story-title">
        <div class="story-copy">
          <p class="eyebrow">POURQUOI J’AI CRÉÉ DELTA VISION</p>
          <h2 id="story-title">La méthode Wim Hof <br /><em>ne suffit pas.</em></h2>
          <p>Ça fait plus de dix ans que je pratique la méthode Wim Hof. Elle m’a aidé à apaiser certains états anxieux, à relâcher la pression, à retrouver du calme. Et pour ça, elle a eu une vraie place dans ma vie.</p>
          <p>Mais il me manquait quelque chose. Je me sentais mieux... sur le moment. Sauf que je ne voulais plus seulement soulager mon anxiété. <strong>Je voulais que ma vie change !</strong></p>
          <p>Alors j’ai commencé à intégrer la visualisation à des moments précis d’une respiration inspirée de la méthode Wim Hof.</p>
          <p><strong>Delta Vision est né le jour où j’ai trouvé quand et comment le faire.</strong></p>
          <p>À ces instants, j’ai senti mes visualisations s’imprimer directement dans mon subconscient. Je ne ressentais pas juste moins d’anxiété pendant cinq minutes : je me sentais profondément aligné. Et surtout, <strong>j’avais le sentiment d’être guidé par le futur que je venais de vivre dans ces états de conscience altérés.</strong></p>
          <p>En rouvrant les yeux, j’avais la solution d’un problème qui me pesait depuis des mois.</p>
          <p>Cette pratique a entièrement remplacé mon rituel Wim Hof. <strong>Je ne reviendrai pas en arrière. Et je pense que toi non plus, une fois que tu l’auras essayée.</strong></p>
        </div>
        <aside class="morning-routine" aria-labelledby="routine-title">
          <svg class="routine-sun" aria-hidden="true"><use href="#inspira-sun" /></svg>
          <p class="eyebrow">AVANT QUE LA JOURNÉE T’EMPORTE</p>
          <h3 id="routine-title">Ta nouvelle <br /><em>routine du matin.</em></h3>
          <div class="routine-duration"><strong>12</strong><span>minutes<br />avant tout le reste</span></div>
          <ol class="routine-steps">
            <li><span class="routine-step-number" aria-hidden="true">1</span><span>Tu lances la séance.</span></li>
            <li><span class="routine-step-number" aria-hidden="true">2</span><span>Tu te laisses guider.</span></li>
            <li><span class="routine-step-number" aria-hidden="true">3</span><span>Tu vis ton souhait réalisé.</span></li>
          </ol>
          <p class="routine-closing">Plus besoin d’y croire : tu l’as vécu. Et depuis là, chaque action devient évidente.</p>
        </aside>
        <div class="section-purchase">
          <a class="button button-coral" data-dv-buy href={checkoutUrl}>J’entre dans l’expérience <svg aria-hidden="true"><use href="#inspira-arrow" /></svg></a>
          <p>Satisfait ou remboursé pendant 14 jours</p>
        </div>
      </section>

      <section class="benefits wrap section-space" id="ressentir" aria-labelledby="benefits-title">
        <div class="section-heading">
          <div><p class="eyebrow">CE QUE TU REÇOIS AVEC DELTA VISION</p><h2 id="benefits-title">Comprendre la méthode.<br /><em>Puis la vivre.</em></h2></div>
        </div>
        <div class="program-grid">
          <article class="program-card">
            <img class="program-image" src="/media/pages/souffle-createur-theorie.webp" {...responsiveDeltaImage('/media/pages/souffle-createur-theorie.webp', programSizes)} width="1672" height="941" loading="lazy" decoding="async" fetchpriority="low" alt="Sonny Court explique la méthode devant un tableau de schémas, dans une jungle baignée de lumière dorée" />
            <div class="program-copy">
              <p class="eyebrow">01 · LA LEÇON THÉORIQUE</p>
              <h3>Et si tu visualisais<br /><em>au mauvais moment ?</em></h3>
              <p>Tu sais ce que tu veux. Mais quand tu fermes les yeux, une partie de toi murmure encore : « Ce n’est pas possible. »</p>
              <p>Dans cette leçon, tu vas découvrir :</p>
              <ul>
                <li><strong>Le « gardien » du subconscient</strong> : une autre façon de comprendre cette voix qui remet tes souhaits en question.</li>
                <li><strong>Pourquoi le moment compte autant que l’image</strong> : la logique derrière l’association de la respiration et de la visualisation.</li>
                <li><strong>Ce que tu prépares avant de fermer les yeux</strong> : un exercice simple pour donner une direction précise à ta séance.</li>
              </ul>
              <p class="program-takeaway">Tu comprends ce que tu fais, pourquoi tu le fais et comment entrer dans l’expérience.</p>
            </div>
          </article>
          <article class="program-card">
            <img class="program-image" src="/media/pages/delta-vision-seance-television.webp" {...responsiveDeltaImage('/media/pages/delta-vision-seance-television.webp', programSizes)} width="1672" height="941" loading="lazy" decoding="async" fetchpriority="low" alt="Une femme installée sur son canapé découvre la séance Delta Vision sur sa télévision, avec un triangle doré au cœur de la jungle" />
            <div class="program-copy">
              <p class="eyebrow">02 · TA SÉANCE GUIDÉE DE 12 MINUTES</p>
              <h3>Et si tu ne faisais plus<br /><em>qu’imaginer ton souhait ?</em></h3>
              <p>Tu fermes les yeux sur ton quotidien. Pendant douze minutes, tu fais une place à la vie que tu veux créer.</p>
              <ul>
                <li><strong>On respire ensemble.</strong> Dans cette vidéo guidée, tu suis mon rythme, étape après étape. Rien à mémoriser, tu te laisses accompagner.</li>
                <li><strong>Tu ne regardes plus ton souhait de loin.</strong> Tu entres dans la scène. Les images prennent vie, les émotions aussi.</li>
                <li><strong>Tu emportes cette énergie dans ta journée.</strong> Une intention claire, une direction pour tes décisions et tes prochains pas.</li>
              </ul>
              <p class="program-takeaway">12 minutes chaque matin. Pour commencer ta journée avec l’énergie de ton souhait réalisé.</p>
            </div>
          </article>
        </div>
      </section>

      <div class="section-purchase program-purchase wrap">
        <a class="button button-coral" data-dv-buy href={checkoutUrl}>J’entre dans l’expérience <svg aria-hidden="true"><use href="#inspira-arrow" /></svg></a>
        <p>Satisfait ou remboursé pendant 14 jours</p>
      </div>

      <section class="method-section" id="methode" aria-labelledby="method-title">
        <div class="method-triangle-inner wrap">
          <div class="triangle-heading">
            <p class="eyebrow">LE CŒUR DE DELTA VISION</p>
            <h2 id="method-title">La respiration ouvre une faille. <br /><em>Ta vision atteint ton subconscient.</em></h2>
          </div>
          <div class="triangle-experience">
            <div class="triangle-art" aria-hidden="true">
              <svg viewBox="0 0 600 540" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="triangle-gold" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#936338" /><stop offset=".22" stop-color="#ecd3a5" /><stop offset=".4" stop-color="#fff9e8" /><stop offset=".54" stop-color="#b98c54" /><stop offset=".72" stop-color="#e6c692" /><stop offset=".9" stop-color="#936638" /><stop offset="1" stop-color="#f2dfbb" />
                  </linearGradient>
                  <linearGradient id="triangle-light" x1="1" y1="0" x2="0" y2="1">
                    <stop stop-color="#fffdf4" /><stop offset=".48" stop-color="#e2c391" /><stop offset="1" stop-color="#a77847" />
                  </linearGradient>
                  <radialGradient id="triangle-aura"><stop stop-color="#fffdf4" stop-opacity=".95" /><stop offset=".55" stop-color="#f0d5a0" stop-opacity=".22" /><stop offset="1" stop-color="#e6c185" stop-opacity="0" /></radialGradient>
                  <filter id="triangle-depth" x="-30%" y="-30%" width="160%" height="180%"><feDropShadow dx="0" dy="18" stdDeviation="15" flood-color="#705037" flood-opacity=".17" /></filter>
                  <filter id="triangle-glow" x="-200%" y="-200%" width="500%" height="500%"><feGaussianBlur stdDeviation="6" /></filter>
                  <path id="triangle-contour" d="M286 67 Q300 43 314 67 L549 458 Q563 482 535 482 H65 Q37 482 51 458 Z" />
                </defs>
                <ellipse cx="300" cy="299" rx="294" ry="245" fill="url(#triangle-aura)" />
                <path d="M300 20 580 504H20Z" fill="none" stroke="#b9946433" stroke-width="1" />
                <g class="triangle-ribbon" filter="url(#triangle-depth)">
                  {Array.from({ length: 13 }, (_, i) => <use href="#triangle-contour" transform={`translate(300 302) scale(${1 - i * .024}) translate(-300 -302)`} fill="none" stroke={i % 2 === 0 ? 'url(#triangle-gold)' : 'url(#triangle-light)'} stroke-width={i % 2 === 0 ? 7 : 3} stroke-linejoin="round" />)}
                </g>
                <g fill="#fff8e4" filter="url(#triangle-glow)"><circle cx="300" cy="58" r="10" /><circle cx="53" cy="474" r="10" /><circle cx="547" cy="474" r="10" /></g>
                <g fill="#fffdf3" stroke="#c6a36b" stroke-width="1.4"><circle cx="300" cy="58" r="5" /><circle cx="53" cy="474" r="5" /><circle cx="547" cy="474" r="5" /></g>
              </svg>
              <div class="triangle-center"><span>Delta<br /><em>Vision</em></span></div>
            </div>
            <article class="triangle-node node-breath">
              <h3>Respiration <em>intense</em></h3>
              <p>La respiration t’invite à quitter le flux habituel des pensées et à explorer un état de conscience alterné.</p>
            </article>
            <article class="triangle-node node-vision">
              <h3>Visualisation <em>vivide</em></h3>
              <p>Quand le mental s’apaise, explore ta scène avec moins de jugement. Ses détails, ses sensations, son émotion. Comme si tu y étais déjà.</p>
            </article>
            <article class="triangle-node node-integration">
              <h3>Intégration <em>naturelle</em></h3>
              <p>Tu lâches le « comment » et le « quand ». Avec la confiance du « c’est déjà fait », tu avances naturellement vers ton souhait.</p>
            </article>
          </div>
          <p class="triangle-mantra">Moins de contrôle. Plus de ressenti. <em>Une expérience transcendante.</em></p>
        </div>
      </section>

      <section class="science wrap section-space" id="science" aria-labelledby="science-title">
        <header class="science-heading">
          <h2 id="science-title">La science derrière<br /><em>Delta-Vision</em></h2>
        </header>
        <div class="science-flow">
          <article class="science-step">
            <span class="science-number" aria-hidden="true">01</span>
            <div class="science-copy">
              <h3>Ta respiration change tes ondes cérébrales.</h3>
              <p>Depuis près d'un siècle, les neurologues utilisent la respiration rapide pendant les examens EEG.</p>
              <p>Elle fait chuter le CO2 dans le sang et ralentit l'activité du cerveau vers les <strong>ondes thêta et delta</strong>, les plus lentes.</p>
              <p>Dans une étude, une hyperventilation soutenue a multiplié la puissance des ondes thêta par <strong>plus de 7</strong>, et celle des ondes delta par <strong>près de 13</strong>.</p>
              <figure class="eeg-evidence" aria-labelledby="eeg-title">
                <div class="eeg-heading"><span>MESURÉ PAR EEG</span><span>ÉTUDE PUBLIÉE · 1998</span></div>
                <h4 id="eeg-title">Puissance des ondes cérébrales</h4>
                <div class="eeg-context">20 volontaires sains · Hyperventilation contrôlée</div>
                <div class="eeg-charts">
                  <div class="eeg-chart" aria-label="Thêta : référence 1, hyperventilation contrôlée 7,6. Échelle commune de 0 à 13.">
                    <div class="eeg-result"><span>Thêta</span><strong>× 7,6</strong></div>
                    <div class="eeg-bar-label"><span>Référence</span><span>1</span></div>
                    <div class="eeg-track" aria-hidden="true"><span class="eeg-bar eeg-bar--reference" style="width:7.6923077%"></span></div>
                    <div class="eeg-bar-label"><span>Hyperventilation contrôlée</span><span>7,6</span></div>
                    <div class="eeg-track" aria-hidden="true"><span class="eeg-bar" style="width:58.4615385%"></span></div>
                  </div>
                  <div class="eeg-chart" aria-label="Delta : référence 1, hyperventilation contrôlée 12,9. Échelle commune de 0 à 13.">
                    <div class="eeg-result"><span>Delta</span><strong>× 12,9</strong></div>
                    <div class="eeg-bar-label"><span>Référence</span><span>1</span></div>
                    <div class="eeg-track" aria-hidden="true"><span class="eeg-bar eeg-bar--reference" style="width:7.6923077%"></span></div>
                    <div class="eeg-bar-label"><span>Hyperventilation contrôlée</span><span>12,9</span></div>
                    <div class="eeg-track" aria-hidden="true"><span class="eeg-bar" style="width:99.2307692%"></span></div>
                  </div>
                </div>
                <div class="eeg-scale">Puissance spectrale moyenne relative · Référence = 1 · Même échelle de 0 à 13</div>
                <figcaption>
                  <a href="https://pubmed.ncbi.nlm.nih.gov/9881925/" target="_blank" rel="noopener noreferrer">Consulter l’étude <span aria-hidden="true">↗</span></a>
                  <span>Zwiener et al. · Journal of Clinical Neurophysiology</span>
                  <span>Graphique recréé à partir des résultats publiés. Résultats de ce protocole expérimental, pas une mesure de l’efficacité de Delta Vision.</span>
                </figcaption>
              </figure>
            </div>
          </article>
          <article class="science-step">
            <span class="science-number" aria-hidden="true">02</span>
            <div class="science-copy">
              <h3>Ces états ralentis sont une porte ouverte vers ton subconscient.</h3>
              <p>En 2021, des chercheurs de l'Institut du Cerveau à Paris ont étudié la phase qui précède l'endormissement, dominée par les ondes thêta.</p>
              <p>Les participants qui y passaient <strong>au moins 15 secondes</strong> avaient trois fois plus de chances de trouver la solution cachée d'un problème : <strong>83 % contre 30 %.</strong></p>
              <figure class="eeg-evidence insight-evidence" aria-labelledby="insight-title">
                <div class="eeg-heading"><span>SOMMEIL &amp; CRÉATIVITÉ</span><span>ÉTUDE PUBLIÉE · 2021</span></div>
                <h4 id="insight-title">Trouver la règle cachée</h4>
                <div class="eeg-context">Part des participants ayant découvert le raccourci d’un exercice mathématique après une pause.</div>
                <div class="insight-comparison">
                  <div class="insight-row" aria-label="Début d’endormissement, stade N1 : 83 pour cent ont découvert la règle cachée.">
                    <div class="insight-label"><span>Début d’endormissement<small>Au moins 15 secondes en stade N1</small></span><strong>83<span>%</span></strong></div>
                    <div class="eeg-track" aria-hidden="true"><span class="eeg-bar" style="width:83%"></span></div>
                  </div>
