---
import '../../styles/coach-continuation.css';
const checkoutUrls = {
  'session-1': import.meta.env.PUBLIC_SPIFFY_COACHING_SESSION_1_URL || '',
  'pack-3': import.meta.env.PUBLIC_SPIFFY_COACHING_PACK_3_URL || '',
  'pack-6': import.meta.env.PUBLIC_SPIFFY_COACHING_PACK_6_URL || '',
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#071733" />
    <title>Continuer avec Romain — accompagnement individuel</title>
    <meta
      name="description"
      content="Choisis le niveau d’accompagnement qui te permettra de transformer ta prise de conscience en mouvement durable."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <svg class="symbol-sprite" aria-hidden="true">
      <symbol id="continue-check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></symbol>
      <symbol id="continue-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></symbol>
      <symbol id="continue-lock" viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="3" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></symbol>
      <symbol id="continue-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M8 3v4M16 3v4M3 10h18" /></symbol>
      <symbol id="continue-video" viewBox="0 0 24 24"><rect x="3" y="5" width="13" height="14" rx="3" /><path d="m16 10 5-3v10l-5-3z" /></symbol>
      <symbol id="continue-sparkle" viewBox="0 0 24 24"><path d="m12 3 1.3 4.2L17.5 8.5l-4.2 1.3L12 14l-1.3-4.2-4.2-1.3 4.2-1.3zM19 15l.7 2.3L22 18l-2.3.7L19 21l-.7-2.3L16 18l2.3-.7z" /></symbol>
      <symbol id="continue-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></symbol>
    </svg>

    <div class="continuation-bg" aria-hidden="true"><span></span><span></span><span></span></div>

    <header class="minimal-header">
      <a href="/" class="brand" aria-label="Sonny Court"><span>S</span><strong>SONNY COURT</strong></a>
      <div class="secure-pill"><i></i><span>Proposition personnelle · paiement unique</span></div>
    </header>

    <main>
      <section class="continuation-hero">
        <div class="hero-copy">
          <p class="eyebrow">La suite de ton accompagnement</p>
          <h1><span id="client-greeting">Tu sais maintenant</span> ce qui mérite de bouger.<br /><em>Ne laisse pas retomber le mouvement.</em></h1>
          <p class="hero-lead">
            Choisis simplement le niveau de soutien qui correspond à ce que tu veux traverser.
            Tu règles une seule fois, puis tu réserves chaque séance au rythme qui te convient.
          </p>
          <div class="hero-reassurance">
            <span><svg><use href="#continue-check"></use></svg>Aucun abonnement</span>
            <span><svg><use href="#continue-check"></use></svg>Agenda flexible</span>
            <span><svg><use href="#continue-check"></use></svg>Séances avec Romain</span>
          </div>
        </div>

        <aside class="romain-note liquid-panel">
          <div class="romain-head">
            <img src="/media/coachs/romain.webp?v=ai-hd" width="84" height="84" alt="Romain" />
            <div><small>Ton coach</small><strong>Romain</strong><span><i></i> Disponible pour la suite</span></div>
          </div>
          <blockquote>
            « Une séance peut débloquer un point. Plusieurs séances permettent surtout de protéger ce
            qui vient de bouger, jusqu’à ce que cela devienne réellement tien. »
          </blockquote>
          <p>Tu n’as pas besoin de décider pour toujours. Seulement du niveau de soutien juste pour la prochaine étape.</p>
        </aside>
      </section>

      <section class="offers" aria-labelledby="offers-title">
        <div class="section-heading">
          <p class="eyebrow">Trois manières de continuer</p>
          <h2 id="offers-title">Choisis ton niveau de soutien.</h2>
          <p>Les séances durent 60 minutes, en visioconférence avec Romain.</p>
        </div>

        <div class="offer-grid">
          <article class="offer-card liquid-panel single">
            <header>
              <span class="offer-number">01</span>
              <p>Pour un point précis</p>
              <h3>Le prochain pas</h3>
            </header>
            <div class="price"><strong>247&nbsp;€</strong><span>paiement unique</span></div>
            <p class="offer-promise">Une nouvelle séance pour clarifier, décider ou débloquer le prochain mouvement.</p>
            <ul>
              <li><svg><use href="#continue-check"></use></svg>1 séance individuelle de 60 minutes</li>
              <li><svg><use href="#continue-check"></use></svg>À réserver lorsque tu en ressens le besoin</li>
              <li><svg><use href="#continue-check"></use></svg>Idéal pour un sujet bien identifié</li>
            </ul>
            <button class="offer-button secondary" type="button" data-plan="1 séance" data-total="247 €" data-checkout={checkoutUrls['session-1']}>
              <span>Réserver ma prochaine séance</span><svg><use href="#continue-arrow"></use></svg>
            </button>
            <small class="validity">Crédit valable 3 mois</small>
          </article>

          <article class="offer-card liquid-panel momentum">
            <header>
              <span class="offer-number">03</span>
              <p>Pour créer une dynamique</p>
              <h3>Le mouvement</h3>
            </header>
            <div class="price"><strong>591&nbsp;€</strong><span><b>197 €</b> par séance</span></div>
            <div class="saving">Tu économises 150 €</div>
            <p class="offer-promise">Trois points d’appui pour transformer une décision en changement observable.</p>
            <ul>
              <li><svg><use href="#continue-check"></use></svg>3 séances individuelles de 60 minutes</li>
              <li><svg><use href="#continue-check"></use></svg>Un rythme conseillé sur 6 à 10 semaines</li>
              <li><svg><use href="#continue-check"></use></svg>Assez long pour créer une vraie continuité</li>
            </ul>
            <button class="offer-button secondary" type="button" data-plan="3 séances" data-total="591 €" data-checkout={checkoutUrls['pack-3']}>
              <span>Choisir les 3 séances</span><svg><use href="#continue-arrow"></use></svg>
            </button>
            <small class="validity">Crédits valables 4 mois</small>
          </article>

          <article class="offer-card liquid-panel transformation">
            <div class="recommended"><svg><use href="#continue-sparkle"></use></svg>Recommandé pour une transformation durable</div>
            <header>
              <span class="offer-number">06</span>
              <p>Pour installer le changement</p>
              <h3>La transformation</h3>
            </header>
            <div class="price"><strong>882&nbsp;€</strong><span><b>147 €</b> par séance</span></div>
            <div class="saving best">Tu économises 600 €</div>
            <p class="offer-promise">Un véritable parcours pour comprendre, expérimenter, ajuster et ancrer.</p>
            <ul>
              <li><svg><use href="#continue-check"></use></svg>6 séances individuelles de 60 minutes</li>
              <li><svg><use href="#continue-check"></use></svg>Un parcours structuré autour de ton objectif</li>
              <li><svg><use href="#continue-check"></use></svg>Une séance finale dédiée au bilan et à la suite</li>
              <li><svg><use href="#continue-check"></use></svg>Le tarif le plus avantageux</li>
            </ul>
            <button class="offer-button primary" type="button" data-plan="6 séances" data-total="882 €" data-checkout={checkoutUrls['pack-6']}>
              <span>Choisir les 6 séances</span><svg><use href="#continue-arrow"></use></svg>
            </button>
            <small class="validity">Crédits valables 8 mois</small>
          </article>
        </div>
      </section>

      <section class="how-it-works liquid-panel">
        <div><p class="eyebrow">Après ton choix</p><h2>Une seule décision maintenant.<br />Le reste se fait séance par séance.</h2></div>
        <ol>
          <li><span>1</span><div><strong>Tu choisis ton accompagnement</strong><p>Le règlement est effectué une seule fois, sans prélèvement récurrent.</p></div></li>
          <li><span>2</span><div><strong>Tes crédits apparaissent dans ton espace</strong><p>Chaque séance réservée utilise simplement un crédit.</p></div></li>
          <li><span>3</span><div><strong>Tu avances au rythme juste</strong><p>Romain te recommande un rythme, mais vous gardez de la souplesse.</p></div></li>
        </ol>
      </section>

      <section class="continuity-values">
        <article><span><svg><use href="#continue-video"></use></svg></span><div><strong>Toujours avec Romain</strong><p>Tu gardes le même interlocuteur et le fil de ce qui a déjà été compris.</p></div></article>
        <article><span><svg><use href="#continue-calendar"></use></svg></span><div><strong>Tu ne réserves pas tout maintenant</strong><p>Après le paiement, les prochains créneaux sont choisis progressivement.</p></div></article>
        <article><span><svg><use href="#continue-clock"></use></svg></span><div><strong>De la place pour intégrer</strong><p>Le rythme s’adapte au travail engagé, sans créer une course aux séances.</p></div></article>
      </section>

      <section class="faq" aria-labelledby="faq-title">
        <div class="section-heading"><p class="eyebrow">Questions simples</p><h2 id="faq-title">Avant de choisir.</h2></div>
        <div class="faq-list">
          <details><summary>Dois-je réserver toutes les dates immédiatement&nbsp;?</summary><p>Non. Tu règles ton accompagnement aujourd’hui, puis tu réserves chaque séance au fur et à mesure dans les créneaux proposés par Romain.</p></details>
          <details><summary>Est-ce un abonnement&nbsp;?</summary><p>Non. Il s’agit d’un paiement unique pour un nombre défini de séances. Aucun prélèvement mensuel n’est créé.</p></details>
          <details><summary>Quelle formule choisir si j’hésite&nbsp;?</summary><p>Choisis une séance si ton sujet est ponctuel, trois si tu veux créer une dynamique, et six si tu veux réellement travailler le changement dans la durée.</p></details>
          <details><summary>Puis-je commencer par une séance et acheter un pack ensuite&nbsp;?</summary><p>Oui. Tu restes libre de continuer ponctuellement ou de choisir un parcours plus structuré après ta prochaine séance.</p></details>
        </div>
      </section>

      <section class="closing-card liquid-panel">
        <div class="closing-photo"><img src="/media/coachs/romain.webp?v=ai-hd" alt="Romain" width="92" height="92" /><i></i></div>
        <div><p class="eyebrow">La bonne formule</p><h2>Ce n’est pas celle qui promet le plus.<br /><em>C’est celle qui t’aide à continuer.</em></h2><p>Choisis avec calme. L’objectif n’est pas de multiplier les séances, mais de protéger ce que tu veux vraiment changer.</p></div>
        <a href="#offers-title" class="closing-button">Revoir les options<svg><use href="#continue-arrow"></use></svg></a>
      </section>
    </main>

    <footer><span>SONNY COURT · COACHING</span><p>Paiements et réservations sécurisés · Conditions à finaliser avant mise en production</p></footer>

    <div class="plan-modal" id="plan-modal" aria-hidden="true">
      <button class="modal-backdrop" type="button" data-modal-close aria-label="Fermer"></button>
      <section class="modal-card liquid-panel" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <button class="modal-close" type="button" data-modal-close aria-label="Fermer">×</button>
        <span class="modal-icon"><svg><use href="#continue-lock"></use></svg></span>
        <p class="eyebrow">Étape suivante</p>
        <h2 id="modal-title">Ton choix est prêt.</h2>
        <div class="selected-plan"><span id="selected-plan-name">6 séances</span><strong id="selected-plan-total">882 €</strong></div>
        <p>La checkout Spiffy dédiée sera connectée ici. Aucun paiement n’est déclenché dans cette maquette.</p>
        <button class="modal-action" type="button" data-modal-close>Revenir à la présentation</button>
      </section>
    </div>

    <script>
      const query = new URLSearchParams(window.location.search);
      const firstName = (query.get('prenom') || '').trim().slice(0, 40);
      const email = (query.get('email') || '').trim().slice(0, 254);
      if (firstName) document.getElementById('client-greeting').textContent = firstName + ', tu sais maintenant';

      const modal = document.getElementById('plan-modal');
      const closeModal = () => {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      };

      document.querySelectorAll('[data-plan]').forEach((button) => {
        button.addEventListener('click', () => {
          if (button.dataset.checkout) {
            const checkout = new URL(button.dataset.checkout, window.location.origin);
            if (firstName) checkout.searchParams.set('name_first', firstName);
            if (email) checkout.searchParams.set('email', email);
            checkout.searchParams.set('coaching_offer_slug', button.dataset.plan === '1 séance' ? 'session-1' : button.dataset.plan === '3 séances' ? 'pack-3' : 'pack-6');
            window.location.href = checkout.toString();
            return;
          }
          document.getElementById('selected-plan-name').textContent = button.dataset.plan || '';
          document.getElementById('selected-plan-total').textContent = button.dataset.total || '';
          modal.classList.add('is-open');
          modal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });

      document.querySelectorAll('[data-modal-close]').forEach((button) => button.addEventListener('click', closeModal));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeModal(); });
    </script>
  </body>
</html>
