                linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(59, 130, 246, 0.05) 100%),
                rgba(20, 20, 20, 0.8);
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 24px;
            padding: 40px;
            margin-bottom: 60px;
            display: flex;
            align-items: center;
            gap: 30px;
            position: relative;
            overflow: hidden;
        }

        .guarantee-highlight::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(59, 130, 246, 0.1),
                transparent
            );
            transition: left 1s ease;
        }

        .guarantee-highlight:hover::before {
            left: 100%;
        }

        .highlight-icon {
            width: 60px;
            height: 60px;
            color: var(--primary-purple);
            flex-shrink: 0;
            filter: drop-shadow(0 0 10px rgba(59, 130, 246, 0.5));
        }

        .guarantee-highlight-text {
            font-size: 1.3rem;
            color: var(--text-primary);
            line-height: 1.6;
            margin: 0;
            font-weight: 500;
        }

        .guarantee-steps {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            margin-bottom: 60px;
        }

        .step-item {
            background: var(--card-bg);
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 16px;
            padding: 30px;
            text-align: center;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .step-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.05) 0%, transparent 100%);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .step-item:hover::before {
            opacity: 1;
        }

        .step-item:hover {
            transform: translateY(-5px);
            border-color: rgba(59, 130, 246, 0.4);
            box-shadow: 0 10px 30px rgba(59, 130, 246, 0.2);
        }

        .step-number {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--primary-purple) 0%, #60A5FA 100%);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0 auto 20px;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        }

        .step-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 10px;
        }

        .step-description {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.5;
            margin: 0;
        }

        .guarantee-conditions {
            background: var(--card-bg);
            border: 2px solid rgba(59, 130, 246, 0.3);
            border-radius: 24px;
            padding: 50px;
            margin-bottom: 60px;
            text-align: center;
            position: relative;
        }

        .conditions-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 25px;
        }

        .guarantee-text {
            color: var(--text-secondary);
            font-size: 1.1rem;
            line-height: 1.7;
            margin: 0 0 30px 0;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }

        .guarantee-reassurance {
            list-style: none;
            margin: 0 auto;
            padding: 0;
            display: flex;
            flex-wrap: wrap;
            align-items: stretch;
            justify-content: center;
            gap: clamp(10px, 2vw, 16px);
            max-width: 900px;
        }

        .guarantee-pill {
            margin: 0;
            padding: 0.65em 1.15em;
            font-size: clamp(0.85rem, 1.8vw, 0.98rem);
            font-weight: 600;
            letter-spacing: 0.02em;
            color: rgba(226, 232, 240, 0.95);
            background: linear-gradient(165deg, rgba(255, 255, 255, 0.06), rgba(15, 23, 42, 0.45));
            border: 1px solid rgba(96, 165, 250, 0.28);
            border-radius: 999px;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.18);
            text-align: center;
            line-height: 1.35;
        }

        @media (max-width: 520px) {
            .guarantee-pill {
                flex: 1 1 100%;
            }
        }

        .guarantee-trust {
            background:
                linear-gradient(135deg, rgba(59, 130, 246, 0.08) 0%, rgba(59, 130, 246, 0.04) 100%),
                rgba(20, 20, 20, 0.9);
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 24px;
            padding: 50px;
            text-align: center;
            position: relative;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

        .trust-icon {
            position: relative;
            margin-bottom: 30px;
            display: inline-block;
            isolation: isolate;
        }

        .trust-glow {
            position: absolute;
            z-index: 0;
            inset: -42px -58px -38px -58px;
            background:
                radial-gradient(
                    ellipse 72% 68% at 50% 48%,
                    rgba(96, 165, 250, 0.1) 0%,
                    rgba(59, 130, 246, 0.04) 45%,
                    rgba(59, 130, 246, 0) 72%
                ),
                radial-gradient(
                    ellipse 100% 92% at 50% 52%,
                    rgba(59, 130, 246, 0.07) 0%,
                    rgba(37, 99, 235, 0.028) 48%,
                    rgba(59, 130, 246, 0.008) 72%,
                    rgba(59, 130, 246, 0) 100%
                );
            pointer-events: none;
        }

        .trust-icon svg {
            position: relative;
            z-index: 1;
            width: 80px;
            height: 80px;
            color: var(--primary-purple);
            filter:
                drop-shadow(0 0 22px rgba(96, 165, 250, 0.18))
                drop-shadow(0 0 44px rgba(59, 130, 246, 0.1))
                drop-shadow(0 0 72px rgba(37, 99, 235, 0.05));
        }

        .trust-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 25px;
        }

        .trust-text {
            color: var(--text-secondary);
            font-size: 1.1rem;
            line-height: 1.7;
            margin-bottom: 20px;
            max-width: 900px;
            margin-left: auto;
            margin-right: auto;
        }

        .trust-text:last-child {
            margin-bottom: 0;
        }

        @keyframes shieldPulse {
            0%, 100% {
                transform: scale(1);
                filter:
                    drop-shadow(0 0 20px rgba(59, 130, 246, 0.6))
                    drop-shadow(0 0 40px rgba(59, 130, 246, 0.4));
            }
            50% {
                transform: scale(1.05);
                filter:
                    drop-shadow(0 0 25px rgba(59, 130, 246, 0.8))
                    drop-shadow(0 0 50px rgba(59, 130, 246, 0.6));
            }
        }

        @keyframes shieldGlowPulse {
            0%, 100% {
                opacity: 0.3;
                transform: scale(1);
            }
            50% {
                opacity: 0.6;
                transform: scale(1.1);
            }
        }

        @keyframes trustPulse {
            0%, 100% {
                transform: scale(1);
                filter:
                    drop-shadow(0 0 15px rgba(59, 130, 246, 0.5))
                    drop-shadow(0 0 30px rgba(59, 130, 246, 0.3));
            }
            50% {
                transform: scale(1.02);
                filter:
                    drop-shadow(0 0 20px rgba(59, 130, 246, 0.7))
                    drop-shadow(0 0 40px rgba(59, 130, 246, 0.5));
            }
        }

        @keyframes trustGlowPulse {
            0%, 100% {
                opacity: 0.3;
                transform: scale(1);
            }
            50% {
                opacity: 0.5;
                transform: scale(1.05);
            }
        }

        @keyframes pulse {
            0%, 100% {
                transform: scale(1);
                opacity: 1;
            }
            50% {
                transform: scale(1.05);
                opacity: 0.9;
            }
        }

        @media (max-width: 768px) {
            .guarantee-highlight {
                flex-direction: column;
                text-align: center;
                gap: 20px;
                padding: 30px;
            }

            .guarantee-steps {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .guarantee-conditions {
                padding: 30px;
            }

            .guarantee-trust {
                padding: 30px;
            }

            .shield-icon {
                width: 200px;
                height: 200px;
            }

            .guarantee-title {
                font-size: 2rem;
            }

            .trust-icon svg {
                width: 60px;
                height: 60px;
            }

            .trust-glow {
                inset: -30px -42px -26px -42px;
            }
        }

        /* Modules Section */
