        /* URGENT Scarcity Section - DARK BACKGROUND */
        .scarcity-section {
            padding: clamp(18px, 3.8vw, 42px) 0 clamp(42px, 6vw, 60px);
            background: transparent;
            position: relative;
        }

        .invitation-offer-zone {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding-top: 6px;
        }

        .offer-countdown-title {
            margin: 0 0 13px;
            color: #ffffff;
            font-size: clamp(0.86rem, 1.7vw, 1rem);
            font-weight: 900;
            letter-spacing: 0.105em;
            text-transform: uppercase;
            text-align: center;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-shadow: 0 0 22px rgba(239, 68, 68, 0.22);
        }

        .offer-countdown-title::before {
            content: '';
            width: 8px;
            height: 8px;
            flex: 0 0 auto;
            border-radius: 50%;
            background: #ef4444;
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.58);
            animation: urgencyHeartbeatDot 1.7s ease-out infinite;
        }

        .offer-countdown-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 0;
            width: 100%;
            max-width: 560px;
            padding: 6px;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(248, 113, 113, 0.42);
            border-radius: 16px;
            background: rgba(8, 15, 35, 0.58);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 18px 40px rgba(2, 6, 23, 0.18);
            animation: urgencyGlow 2.8s ease-in-out infinite;
        }

        .offer-countdown-box {
            position: relative;
            min-width: 0;
            min-height: 66px;
            padding: 9px 5px 7px;
            border-radius: 11px;
            background: linear-gradient(145deg, rgba(185, 28, 28, 0.13), rgba(69, 10, 10, 0.07));
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .offer-countdown-box + .offer-countdown-box::before {
            content: '';
            position: absolute;
            top: 12px;
            bottom: 12px;
            left: 0;
            width: 1px;
            background: linear-gradient(to bottom, transparent, rgba(248, 113, 113, 0.28), transparent);
        }

        .offer-countdown-value {
            display: block;
            font-size: 1.82rem;
            line-height: 1;
            font-weight: 800;
            color: #fff7f7;
            margin-bottom: 5px;
            font-variant-numeric: tabular-nums;
            text-shadow: 0 0 20px rgba(248, 113, 113, 0.24);
        }

        .offer-countdown-box:last-child .offer-countdown-value {
            animation: urgencyHeartbeatValue 1.7s ease-in-out infinite;
        }

        .offer-countdown-label {
            display: block;
            font-size: 0.61rem;
            letter-spacing: 0.10em;
            text-transform: uppercase;
            color: rgba(254, 202, 202, 0.72);
            font-weight: 700;
        }

        .invitation-offer-zone--hero-urgency .offer-countdown-title {
            margin-bottom: 18px;
            font-size: clamp(1.05rem, 2.2vw, 1.3rem);
            letter-spacing: 0.09em;
        }

        .invitation-offer-zone--hero-urgency .offer-countdown-grid {
            max-width: 680px;
            padding: 8px;
            border-radius: 19px;
        }

        .invitation-offer-zone--hero-urgency .offer-countdown-box {
            min-height: 86px;
            padding: 12px 8px 10px;
            border-radius: 13px;
        }

        .invitation-offer-zone--hero-urgency .offer-countdown-value {
            margin-bottom: 7px;
            font-size: clamp(2rem, 4vw, 2.45rem);
        }

        .invitation-offer-zone--hero-urgency .offer-countdown-label {
            font-size: clamp(0.62rem, 1.1vw, 0.7rem);
        }

        .invitation-offer-zone--hero-urgency .offer-deadline-reminder {
            margin-top: 18px;
        }

        @keyframes urgencyHeartbeatDot {
            0%, 42%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.58); }
            12% { transform: scale(1.18); box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
            24% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
            32% { transform: scale(1.1); }
        }

        @keyframes urgencyHeartbeatValue {
            0%, 42%, 100% { transform: scale(1); }
            12% { transform: scale(1.07); }
            24% { transform: scale(1); }
            32% { transform: scale(1.035); }
        }

        @keyframes urgencyGlow {
            0%, 100% { border-color: rgba(248, 113, 113, 0.36); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 18px 40px rgba(2, 6, 23, 0.18), 0 0 0 rgba(220, 38, 38, 0); }
            50% { border-color: rgba(248, 113, 113, 0.54); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 18px 40px rgba(2, 6, 23, 0.20), 0 0 28px rgba(220, 38, 38, 0.08); }
        }

        @media (prefers-reduced-motion: reduce) {
            .offer-countdown-title::before,
            .offer-countdown-grid,
            .offer-countdown-box:last-child .offer-countdown-value {
                animation: none;
            }
        }

