            function lockInvitationGateUntil(gateOpensAtMs) {
                if (!Number.isFinite(gateOpensAtMs)) return;
                const existing = document.getElementById('inv-gate-not-open-overlay');
                if (existing) existing.remove();

                const overlay = document.createElement('div');
                overlay.id = 'inv-gate-not-open-overlay';
                overlay.style.cssText = 'position:fixed;inset:0;z-index:10010;background:rgba(2,6,23,.9);display:flex;align-items:center;justify-content:center;padding:16px;';
                overlay.innerHTML = `
                    <div style="width:100%;max-width:460px;border:1px solid rgba(148,163,184,.25);background:#0f172a;border-radius:16px;padding:20px;color:#e2e8f0;text-align:center;">
                        <p style="margin:0 0 8px;font-size:24px;font-weight:800;">Les portes ne sont pas encore ouvertes</p>
                        <p style="margin:0 0 14px;font-size:14px;color:#94a3b8;">Ouverture dans :</p>
                        <p id="inv-gate-not-open-countdown" style="margin:0;font-size:30px;font-weight:900;letter-spacing:.03em;color:#7dd3fc;">00:00:00</p>
                    </div>
                `;
                document.body.appendChild(overlay);
                setBodyScrollLocked(true);

                const countdownEl = overlay.querySelector('#inv-gate-not-open-countdown');
                const formatRemaining = function (remainingMs) {
                    const totalSeconds = Math.max(0, Math.floor(remainingMs / 1000));
                    const h = Math.floor(totalSeconds / 3600);
                    const m = Math.floor((totalSeconds % 3600) / 60);
                    const s = totalSeconds % 60;
                    return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
                };
                const refreshFromServer = function () {
                    window.location.reload();
                };
                const tick = function () {
                    const remaining = gateOpensAtMs - Date.now();
                    if (countdownEl) countdownEl.textContent = formatRemaining(remaining);
                    if (remaining <= 0) refreshFromServer();
                };
                tick();
                const timer = setInterval(tick, 1000);
                const autoRefreshDelay = Math.max(300, gateOpensAtMs - Date.now() + 300);
                const autoRefreshTimer = setTimeout(refreshFromServer, autoRefreshDelay);
                const onVisibility = function () {
                    if (document.visibilityState === 'visible' && Date.now() >= gateOpensAtMs) {
                        refreshFromServer();
                    }
                };
                document.addEventListener('visibilitychange', onVisibility);
                window.addEventListener('beforeunload', function () {
                    clearInterval(timer);
                    clearTimeout(autoRefreshTimer);
                    document.removeEventListener('visibilitychange', onVisibility);
                }, { once: true });
            }

            async function requestTokenFromEmail() {
                const overlay = document.createElement('div');
                overlay.style.cssText = 'position:fixed;inset:0;z-index:9999;background:rgba(2,6,23,.88);display:flex;align-items:center;justify-content:center;padding:16px;';
                overlay.innerHTML = `
                    <div style="width:100%;max-width:420px;border:1px solid rgba(148,163,184,.25);background:#0f172a;border-radius:16px;padding:18px;color:#e2e8f0;">
                        <p style="margin:0 0 8px;font-size:20px;font-weight:700;">Accès invitation</p>
                        <p style="margin:0 0 12px;font-size:14px;color:#94a3b8;">Entre l'email utilisé à l'inscription pour retrouver ton accès.</p>
                        <input id="inv-recovery-email" type="email" placeholder="Ton email" autocomplete="email" style="width:100%;height:44px;border-radius:10px;border:1px solid #334155;background:#020617;color:#e2e8f0;padding:0 12px;outline:none;" />
                        <button id="inv-recovery-submit" type="button" style="margin-top:10px;width:100%;height:44px;border:none;border-radius:10px;background:#38bdf8;color:#082f49;font-weight:800;cursor:pointer;">Vérifier mon accès</button>
                        <p id="inv-recovery-error" style="min-height:1.2em;margin:10px 0 0;color:#fca5a5;font-size:13px;"></p>
                    </div>
                `;
                document.body.appendChild(overlay);
                setBodyScrollLocked(true);

                const input = overlay.querySelector('#inv-recovery-email');
                const submit = overlay.querySelector('#inv-recovery-submit');
                const err = overlay.querySelector('#inv-recovery-error');

                async function submitEmail() {
                    err.textContent = '';
                    const email = String(input.value || '').trim().toLowerCase();
                    if (!email || !email.includes('@')) {
                        err.textContent = 'Merci de saisir un email valide.';
                        return;
                    }
                    submit.disabled = true;
                    try {
                        const res = await fetch('/.netlify/functions/check-webinaire-eligibility', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ email }),
                        });
                        const body = await res.json().catch(function () { return {}; });
                        if (!res.ok) {
                            err.textContent = 'Vérification impossible. Réessaie dans un instant.';
                            return;
                        }
                        if (body.eligible === false && body.reason === 'excluded') {
                            err.textContent = "Tu n'es pas éligible pour cette invitation.";
                            return;
                        }
                        if (body.eligible === false && body.reason === 'already_registered' && body.token) {
                            overlay.remove();
                            setBodyScrollLocked(false);
                            window.__invitationRecoveredToken = String(body.token);
                            return;
                        }
                        err.textContent = "Aucune inscription trouvée avec cet email.";
                    } catch {
                        err.textContent = 'Vérification impossible. Réessaie dans un instant.';
                    } finally {
                        submit.disabled = false;
                    }
                }

                submit.addEventListener('click', submitEmail);
                input.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') submitEmail();
                });

                // Wait until token is resolved by submitEmail
                return new Promise(function (resolve) {
                    const t = setInterval(function () {
                        if (window.__invitationRecoveredToken) {
                            const recovered = window.__invitationRecoveredToken;
                            window.__invitationRecoveredToken = '';
                            clearInterval(t);
                            resolve(recovered);
                        }
                    }, 120);
                });
            }

            let token = (params.get('t') || params.get('token') || '').trim();
            if (!token) token = (localStorage.getItem(TOKEN_KEY) || '').trim();

            let offerExpiryMs = null;
            let scarcityWindowStartMs = null;
            let sessionStartsAtMsForAudit = null;
            let sessionStartsAtMsForGate = null;
            try {
                if (!token && !isPreview) {
                    token = await requestTokenFromEmail();
                }

                if (!isPreview) {
                    const res = await fetch('/.netlify/functions/get-webinaire-registration?t=' + encodeURIComponent(token));
                    if (!res.ok) throw new Error('registration lookup failed');
                    const data = await res.json();
                    if (!data || !data.valid) {
                        token = await requestTokenFromEmail();
                        const retryRes = await fetch('/.netlify/functions/get-webinaire-registration?t=' + encodeURIComponent(token));
                        const retryData = await retryRes.json().catch(function () { return null; });
                        if (!retryRes.ok || !retryData || !retryData.valid) throw new Error('registration lookup failed');
                        if (isBuyer(retryData)) {
                            setTokenEverywhere(token);
                            lockInvitationBuyer();
                            return;
                        }
                        offerExpiryMs = new Date(retryData.offreExpiresAt || retryData.offre_expires_at).getTime();
                        const retrySessionMs = new Date(retryData.sessionStartsAt || retryData.session_date || '').getTime();
                        if (Number.isFinite(retrySessionMs)) {
                            sessionStartsAtMsForAudit = retrySessionMs;
                            sessionStartsAtMsForGate = retrySessionMs;
                            scarcityWindowStartMs = retrySessionMs + SCARCITY_WINDOW_START_AFTER_SESSION_MS;
                        }
                    } else {
                        if (isBuyer(data)) {
                            setTokenEverywhere(token);
                            lockInvitationBuyer();
                            return;
                        }
                        offerExpiryMs = new Date(data.offreExpiresAt || data.offre_expires_at).getTime();
                        const sessionMs = new Date(data.sessionStartsAt || data.session_date || '').getTime();
                        if (Number.isFinite(sessionMs)) {
                            sessionStartsAtMsForAudit = sessionMs;
                            sessionStartsAtMsForGate = sessionMs;
                            scarcityWindowStartMs = sessionMs + SCARCITY_WINDOW_START_AFTER_SESSION_MS;
                        }
                    }
                } else {
                    try {
                        const res = await fetch('/.netlify/functions/get-webinaire-registration?t=' + encodeURIComponent(token));
                        if (res.ok) {
                            const data = await res.json().catch(function () { return null; });
                            if (data && data.valid) {
                                if (isBuyer(data)) {
                                    setTokenEverywhere(token);
                                    lockInvitationBuyer();
                                    return;
                                }
                                offerExpiryMs = new Date(data.offreExpiresAt || data.offre_expires_at).getTime();
                                const sessionMs = new Date(data.sessionStartsAt || data.session_date || '').getTime();
                                if (Number.isFinite(sessionMs)) {
                                    sessionStartsAtMsForAudit = sessionMs;
                                    sessionStartsAtMsForGate = sessionMs;
                                    scarcityWindowStartMs = sessionMs + SCARCITY_WINDOW_START_AFTER_SESSION_MS;
                                }
                            }
                        }
                    } catch {
                        /* ignore */
                    }
                    if (!Number.isFinite(offerExpiryMs)) {
                        offerExpiryMs = getCurrentWindow(Date.now()).endMs;
                    }
                    if (Number.isFinite(offerExpiryMs) && offerExpiryMs <= invitationNowMs()) {
                        offerExpiryMs = getCurrentWindow(invitationNowMs()).endMs;
                    }
                }

                // Aperçu closer : page toujours consultable, quelle que soit la date.
                // On force une fenêtre future (jamais de lock "offre expirée") et on
                // neutralise le gate "offre pas encore ouverte".
                if (isPreviewCloser) {
                    offerExpiryMs = invitationNowMs() + 48 * 60 * 60 * 1000;
                    sessionStartsAtMsForGate = null;
                }

                if (Number.isFinite(sessionStartsAtMsForGate)) {
                    const gateOpensAtMs = sessionStartsAtMsForGate + INVITATION_GATE_DELAY_MS;
                    const isGateClosed = Date.now() < gateOpensAtMs;
                    if (isGateClosed) {
                        if (!token && isPreview && !isTokenlessPresentation) token = 'preview-invitation';
                        setTokenEverywhere(token);
                        propagateTokenToCheckoutLinks(token);
                        lockInvitationGateUntil(gateOpensAtMs);
                        return;
                    }
                }

                if (!Number.isFinite(scarcityWindowStartMs)) {
                    scarcityWindowStartMs = getCurrentWindow(invitationNowMs()).startMs;
                }
                if (!Number.isFinite(sessionStartsAtMsForAudit) && Number.isFinite(scarcityWindowStartMs)) {
                    sessionStartsAtMsForAudit = scarcityWindowStartMs - SCARCITY_WINDOW_START_AFTER_SESSION_MS;
                }

                // Persist token and propagate it to CTA links.
                if (!token && isPreview && !isTokenlessPresentation) token = 'preview-invitation';
                setTokenEverywhere(token);
                propagateTokenToCheckoutLinks(token);
                bindCheckoutClickTracking(token);
                initSalesIntentTracking(token);
                mountScarcityAudit();
                updateScarcityAudit(sessionStartsAtMsForAudit, scarcityWindowStartMs, offerExpiryMs);
                if (!isPreviewDev && Number.isFinite(offerExpiryMs) && invitationNowMs() >= offerExpiryMs) {
                    invitationOfferExpiryMs = offerExpiryMs;
                    lockInvitationOfferExpired();
                    return;
                }
                invPreviewJump = function () {
