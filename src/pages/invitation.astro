        /* Live Viewers Sticker - Premium Purple Style */
        .live-viewers-sticker {
            position: fixed;
            bottom: 24px;
            left: 24px;
            z-index: 9998;
            display: flex;
            align-items: center;
            gap: 14px;
            background: linear-gradient(135deg, rgba(20, 20, 20, 0.95), rgba(30, 30, 35, 0.92));
            border: 1px solid rgba(59, 130, 246, 0.35);
            border-radius: 16px;
            padding: 14px 20px;
            box-shadow:
                0 10px 40px rgba(0, 0, 0, 0.5),
                0 0 30px rgba(59, 130, 246, 0.12),
                inset 0 1px 0 rgba(255, 255, 255, 0.05);
            opacity: 0;
            transform: translateY(20px) scale(0.95);
            will-change: transform;
            animation: stickerSlideIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            animation-delay: 2.5s;
