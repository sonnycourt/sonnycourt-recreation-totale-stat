    <script>
        // Heure locale du visiteur dans le titre de l'histoire, mise à jour en continu
        (function () {
            const el = document.getElementById('visitor-clock');
            if (!el) return;
            let last = '';
            function tick() {
                const now = new Date();
                const label = String(now.getHours()).padStart(2, '0') + 'h' + String(now.getMinutes()).padStart(2, '0');
                if (label !== last) {
                    last = label;
                    el.textContent = label;
                }
            }
            tick();
            setInterval(tick, 1000);
        })();
    </script>

    <script>
        // Temps actif passé sur la PDV, par prospect (token ?t=).
        // Battements envoyés toutes les ~15 s actives + à la fermeture (sendBeacon).
        (function () {
            var token = new URLSearchParams(location.search).get('t');
            if (!token) {
                try { token = localStorage.getItem('masterclass_es2_token'); } catch (e) {}
            }
            var timeLabel = document.getElementById('pdv-rounded-minutes');
            var acc = 0;
            var activeThisVisit = 0;
            var previousActiveSeconds = 0;
            var last = Date.now();
            var visible = !document.hidden;
            var canPersist = Boolean(token && ('sendBeacon' in navigator));

            function updateTimeLabel() {
                if (!timeLabel) return;
                var totalSeconds = Math.max(0, previousActiveSeconds + activeThisVisit);
                var roundedMinutes = Math.max(15, Math.ceil(totalSeconds / (15 * 60)) * 15);
                var displayedMinutes = Math.min(60, roundedMinutes);
                timeLabel.textContent = displayedMinutes === 60 ? 'une heure' : displayedMinutes + ' minutes';
            }

            function collect() {
                if (visible) {
                    var delta = Math.max(0, (Date.now() - last) / 1000);
                    acc += delta;
                    activeThisVisit += delta;
                }
                last = Date.now();
                updateTimeLabel();
            }

            function flush() {
                if (!canPersist) return;
                var s = Math.round(acc);
                if (s < 1) return;
                acc = 0;
                try {
                    navigator.sendBeacon(
                        '/.netlify/functions/track-pdv-time',
                        new Blob([JSON.stringify({ t: token, s: s })], { type: 'application/json' })
                    );
                } catch (e) { /* silencieux : le tracking ne doit jamais gêner la page */ }
            }

            updateTimeLabel();
            if (token) {
                fetch('/.netlify/functions/track-pdv-time?t=' + encodeURIComponent(token))
                    .then(function (res) { return res.ok ? res.json() : null; })
                    .then(function (data) {
                        if (!data) return;
                        previousActiveSeconds = Math.max(0, Number(data.pdv_seconds) || 0);
                        updateTimeLabel();
                    })
                    .catch(function () {});
            }

            setInterval(function () {
                collect();
                if (acc >= 15) flush();
            }, 5000);

            document.addEventListener('visibilitychange', function () {
                collect();
                visible = !document.hidden;
                last = Date.now();
                if (document.hidden) flush();
            });

            addEventListener('pagehide', function () {
                collect();
                flush();
            });
        })();
    </script>

