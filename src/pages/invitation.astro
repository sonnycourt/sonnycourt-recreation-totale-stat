        /* Descriptive Section */
        .descriptive-section {
            padding: 120px 0;
            background: linear-gradient(180deg, var(--dark-bg) 0%, var(--darker-bg) 100%);
            position: relative;
            z-index: 2;
        }

        .descriptive-content {
            display: flex;
            flex-direction: column;
            gap: 60px;
            align-items: center;
            max-width: 1000px;
            margin: 0 auto;
        }

        .descriptive-image-wrapper {
            position: relative;
            display: flex;
            justify-content: center;
        }

        .descriptive-image-frame {
            position: relative;
            border-radius: 24px;
            overflow: hidden;
            box-shadow:
                0 25px 50px rgba(0, 0, 0, 0.4),
                0 0 80px rgba(59, 130, 246, 0.2);
            transition: all 0.4s ease;
        }

        .descriptive-image-frame:hover {
            transform: translateY(-10px);
            box-shadow:
                0 35px 70px rgba(0, 0, 0, 0.5),
                0 0 100px rgba(59, 130, 246, 0.3);
        }

        .descriptive-image {
            width: 100%;
            max-width: 600px;
            height: auto;
            border-radius: 24px;
            transition: all 0.4s ease;
        }

        .descriptive-image-frame:hover .descriptive-image {
            transform: scale(1.02);
        }

        .descriptive-image-glow {
            position: absolute;
            top: -10px;
            left: -10px;
            right: -10px;
            bottom: -10px;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.3), rgba(59, 130, 246, 0.1));
            border-radius: 28px;
            z-index: -1;
            opacity: 0.7;
        }

        .module-discovery {
            position: relative;
            width: min(100%, 900px);
            padding: clamp(30px, 5vw, 48px);
            overflow: hidden;
            border: 1px solid rgba(96, 165, 250, 0.22);
            border-radius: 24px;
            background: linear-gradient(150deg, rgba(30, 58, 138, 0.1), rgba(15, 23, 42, 0.7));
            box-shadow:
                0 28px 70px rgba(2, 6, 23, 0.32),
                inset 0 1px 0 rgba(255, 255, 255, 0.04);
            text-align: left;
        }

        .module-discovery::before {
            content: "";
            position: absolute;
            top: 0;
            left: 15%;
            right: 15%;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(96, 165, 250, 0.88), transparent);
        }

        .module-discovery__kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: clamp(20px, 3vw, 28px);
            color: #93c5fd;
            font-size: 0.7rem;
            font-weight: 900;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        .module-discovery__kicker::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #60a5fa;
            box-shadow: 0 0 12px rgba(96, 165, 250, 0.78);
        }

        .module-discovery__intro {
            max-width: 720px;
            margin: 0;
        }

        .module-discovery__intro p {
            margin: 0;
            color: rgba(226, 232, 240, 0.76);
            font-size: clamp(0.98rem, 1.35vw, 1.08rem);
            line-height: 1.72;
        }

        .module-discovery__intro p + p {
            margin-top: 14px;
        }

        .module-discovery__intro .module-discovery__lead {
            color: #f8fafc;
            font-size: clamp(1.25rem, 2.4vw, 1.65rem);
            line-height: 1.45;
            letter-spacing: -0.02em;
        }

        .module-discovery__lead strong {
            color: #fff;
        }

        .module-discovery__instruction {
            margin: clamp(28px, 4vw, 38px) 0 16px;
            color: rgba(248, 250, 252, 0.92);
            font-size: clamp(0.94rem, 1.25vw, 1rem);
            font-weight: 750;
            line-height: 1.5;
        }

        .module-discovery__grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
        }

        .module-discovery__step {
            position: relative;
            display: flex;
            flex-direction: column;
            min-width: 0;
            padding: 20px 18px 22px;
            border: 1px solid rgba(96, 165, 250, 0.2);
            border-radius: 14px;
            background:
                radial-gradient(circle at 20% 0%, rgba(59, 130, 246, 0.12), transparent 42%),
                rgba(15, 23, 42, 0.66);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.025);
            text-align: left;
        }

        .module-discovery__step small {
            display: block;
            margin-bottom: 8px;
            color: #60a5fa;
            font-size: 0.65rem;
            font-weight: 900;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .module-discovery__step strong {
            display: block;
            color: #fff;
            font-size: clamp(0.96rem, 1.4vw, 1.08rem);
            line-height: 1.35;
        }

        .module-discovery__step p {
            margin: 10px 0 0;
            color: rgba(203, 213, 225, 0.72);
            font-size: 0.86rem;
            line-height: 1.58;
        }

        .module-discovery__payoff {
            display: block;
            margin-top: auto;
            padding-top: 18px;
            border-top: 1px solid rgba(96, 165, 250, 0.14);
            color: #dbeafe;
            font-size: 0.84rem;
            font-weight: 780;
            line-height: 1.5;
        }

        .module-discovery__step p + .module-discovery__payoff {
            margin-top: 18px;
        }

        .module-discovery__audience {
            max-width: 720px;
            margin: clamp(26px, 4vw, 34px) 0 0;
            padding: 17px 19px;
            border-left: 2px solid #60a5fa;
            border-radius: 0 12px 12px 0;
            background: rgba(30, 64, 175, 0.08);
            color: rgba(226, 232, 240, 0.78);
            font-size: clamp(0.94rem, 1.25vw, 1.02rem);
            line-height: 1.65;
        }

        .module-discovery__audience strong {
            color: #fff;
        }

        .module-discovery__audience p {
            margin: 0;
        }

        .module-discovery__audience p + p {
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid rgba(96, 165, 250, 0.12);
        }

        .module-discovery__proof {
            max-width: 720px;
            margin: 18px 0 0;
            color: rgba(203, 213, 225, 0.7);
            font-size: clamp(0.9rem, 1.15vw, 0.98rem);
            line-height: 1.65;
        }

        .module-discovery__bridge {
            max-width: 740px;
            margin: clamp(24px, 4vw, 32px) 0 0;
            padding-top: clamp(22px, 3vw, 28px);
            border-top: 1px solid rgba(96, 165, 250, 0.16);
            color: #fff;
            font-size: clamp(1.08rem, 1.8vw, 1.3rem);
            line-height: 1.5;
        }

        @media (max-width: 768px) {
            .module-discovery {
                padding: 26px 18px 30px;
                border-radius: 19px;
            }

            .module-discovery__grid {
                grid-template-columns: 1fr;
            }

            .module-discovery__step {
                padding: 16px;
            }
        }

        /* Morpho case study before pricing */
        .morpho-case-study {
            position: relative;
            max-width: 980px;
            margin: clamp(54px, 8vw, 92px) auto clamp(60px, 9vw, 104px);
            padding: clamp(30px, 5vw, 58px);
            overflow: hidden;
            border: 1px solid rgba(125, 180, 226, 0.34);
            border-radius: 14px;
            background:
                linear-gradient(rgba(96, 165, 250, 0.045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(96, 165, 250, 0.045) 1px, transparent 1px),
                linear-gradient(145deg, rgba(13, 31, 55, 0.98), rgba(7, 18, 34, 0.99));
            background-size: 32px 32px, 32px 32px, auto;
            box-shadow: 0 26px 70px rgba(0, 0, 0, 0.28), inset 0 1px 0 rgba(255, 255, 255, 0.04);
            text-align: left;
        }

        .morpho-case-study::before {
            content: "";
            position: absolute;
            inset: 0 0 auto;
            height: 3px;
            background: linear-gradient(90deg, #38bdf8, #60a5fa 52%, rgba(96, 165, 250, 0.12));
        }

        .morpho-case-study__header {
            max-width: 790px;
            margin: 0 auto;
            text-align: center;
        }

        .morpho-case-study__kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 16px;
            color: rgba(186, 230, 253, 0.66);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: clamp(0.66rem, 1.2vw, 0.76rem);
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .morpho-case-study__kicker::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #60a5fa;
            box-shadow: 0 0 16px rgba(96, 165, 250, 0.8);
        }

        .morpho-case-study__header h2 {
            margin: 0;
            color: #f8fafc;
            font-size: clamp(2.5rem, 6vw, 4.75rem);
            line-height: 0.98;
            letter-spacing: -0.055em;
        }

        .morpho-case-study__header > p {
            max-width: 720px;
            margin: 18px auto 0;
            color: rgba(226, 232, 240, 0.82);
            font-size: clamp(1rem, 1.7vw, 1.14rem);
            line-height: 1.72;
        }

        .morpho-case-study__header > .morpho-case-study__dataset {
            display: inline-block;
            max-width: none;
            margin: 22px auto 0;
            padding: 9px 14px;
            border: 1px solid rgba(56, 189, 248, 0.3);
            border-radius: 4px;
            background: rgba(14, 116, 144, 0.1);
            color: #bae6fd;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: clamp(0.78rem, 1.4vw, 0.92rem);
            font-weight: 750;
            letter-spacing: 0.08em;
            line-height: 1.2;
            text-transform: uppercase;
        }

        .morpho-case-study__header > .morpho-case-study__subtitle {
            max-width: 790px;
            margin-top: 20px;
            color: #dbeafe;
            font-size: clamp(1.25rem, 2.5vw, 1.72rem);
            font-weight: 650;
            line-height: 1.42;
        }

        .morpho-case-study__subtitle strong {
            color: #60a5fa;
        }

        .morpho-case-study__timeline {
            --case-timeline-gutter: clamp(20px, 4vw, 38px);
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 0;
            max-width: 800px;
            margin: clamp(34px, 6vw, 58px) auto 0;
            padding-left: var(--case-timeline-gutter);
        }

        .morpho-case-study__timeline::before {
            content: "";
            position: absolute;
            top: 18px;
            bottom: 18px;
            left: 5px;
            width: 2px;
            background: linear-gradient(180deg, rgba(96, 165, 250, 0.3), #60a5fa 58%, rgba(96, 165, 250, 0.3));
        }

        .morpho-case-study__moment {
            position: relative;
            padding: clamp(22px, 3.5vw, 30px) clamp(20px, 3.5vw, 30px);
            border: 0;
            border-top: 1px solid rgba(125, 180, 226, 0.18);
            border-radius: 0;
            background: rgba(8, 24, 44, 0.58);
        }

        .morpho-case-study__moment:last-child {
            border-bottom: 1px solid rgba(125, 180, 226, 0.18);
        }

        .morpho-case-study__moment::before {
            content: "";
            position: absolute;
            top: 27px;
            left: calc(5px - var(--case-timeline-gutter) - 6px);
            width: 12px;
            height: 12px;
            border: 3px solid #0d1c36;
            border-radius: 50%;
            background: #60a5fa;
            box-shadow: 0 0 0 4px rgba(96, 165, 250, 0.16), 0 0 18px rgba(96, 165, 250, 0.45);
        }

        .morpho-case-study__moment--turn,
        .morpho-case-study__moment--result {
            background: linear-gradient(90deg, rgba(14, 116, 144, 0.14), rgba(8, 24, 44, 0.58));
        }

        .morpho-case-study__moment > span {
            display: block;
            margin-bottom: 12px;
            color: #7dd3fc;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.72rem;
            font-weight: 750;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .morpho-case-study__moment p {
            margin: 0;
            color: #f8fafc;
            font-size: clamp(1.08rem, 2vw, 1.3rem);
            font-weight: 750;
            line-height: 1.5;
        }

        .morpho-case-study__moment small {
            display: block;
            margin-top: 14px;
            color: rgba(203, 213, 225, 0.72);
            font-size: 0.9rem;
            line-height: 1.6;
        }

        .morpho-case-study__moment small strong {
            color: #bfdbfe;
        }

        .morpho-case-study__scores {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: clamp(16px, 4vw, 40px);
            margin: clamp(32px, 6vw, 54px) auto;
            padding: clamp(22px, 4vw, 30px);
            border-block: 1px solid rgba(96, 165, 250, 0.18);
            text-align: center;
        }

        .morpho-case-study__scores > p {
            margin: 0;
            padding: 10px 14px;
            border-left: 1px solid rgba(56, 189, 248, 0.32);
            text-align: left;
        }

        .morpho-case-study__scores > p strong,
        .morpho-case-study__scores > p span {
            display: block;
        }

        .morpho-case-study__scores > p strong {
            color: #7dd3fc;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 1.2rem;
        }

        .morpho-case-study__scores > p span {
            margin-top: 4px;
            color: rgba(186, 230, 253, 0.58);
            font-size: 0.68rem;
            font-weight: 750;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .morpho-case-study__scores > div > span {
            display: block;
            margin-bottom: 6px;
            color: rgba(191, 219, 254, 0.7);
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .morpho-case-study__scores strong {
            color: #fff;
            font-size: clamp(2rem, 5vw, 3.15rem);
            line-height: 1;
        }

        .morpho-case-study__scores strong small {
            color: #60a5fa;
            font-size: 0.42em;
        }

        .morpho-case-study__arrow {
            color: #38bdf8;
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            font-weight: 300;
        }

        .morpho-case-study__method {
            max-width: 720px;
            margin: -34px auto clamp(38px, 6vw, 54px);
            color: rgba(148, 163, 184, 0.58);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.68rem;
            line-height: 1.55;
            text-align: center;
        }

        .morpho-case-study__conclusion {
            max-width: 760px;
            margin: 0 auto;
            text-align: center;
        }

        .morpho-case-study__conclusion h3 {
            margin: 0;
            color: #f8fafc;
            font-size: clamp(1.45rem, 3vw, 2.1rem);
            line-height: 1.3;
        }

        .morpho-case-study__conclusion h3 strong {
            color: #60a5fa;
        }

        .morpho-case-study__conclusion > p {
            margin: 20px 0 0;
            color: rgba(226, 232, 240, 0.82);
            font-size: clamp(1rem, 1.7vw, 1.12rem);
            line-height: 1.7;
        }

        .morpho-case-study__question {
            padding: 22px;
            border-radius: 16px;
            background: rgba(37, 99, 235, 0.14);
        }

        .morpho-case-study__question strong {
            color: #fff;
        }

        .morpho-case-study__privacy {
            margin: 28px 0 0;
            color: rgba(148, 163, 184, 0.58);
            font-size: 0.73rem;
            line-height: 1.5;
            text-align: center;
        }

        @media (max-width: 700px) {
            .morpho-case-study {
                padding: 28px 18px 30px;
            }

            .morpho-case-study__scores {
                gap: 12px;
                padding-inline: 8px;
            }

            .morpho-case-study__scores > div > span {
                font-size: 0.64rem;
            }
        }

        /* Price Reveal Section */
        .price-reveal-section {
            text-align: center;
            margin: clamp(32px, 5vw, 56px) 0 clamp(24px, 4vw, 40px);
        }

        .price-headline {
            margin-bottom: clamp(28px, 4vw, 44px);
        }

        .price-stack {
            position: relative;
            max-width: 420px;
            margin: 0 auto;
            padding: clamp(22px, 3vw, 32px) clamp(20px, 3vw, 28px);
            border-radius: 18px;
            background: linear-gradient(165deg, rgba(255, 255, 255, 0.06), rgba(15, 23, 42, 0.5));
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 20px 48px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.06);
        }

        .price-total-label {
            margin: 0 0 6px;
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        .price-old-line {
            margin: 0 0 14px;
            line-height: 1.05;
        }

        .price-old-value {
            display: inline-block;
            text-decoration: line-through;
            text-decoration-thickness: 2px;
            text-underline-offset: 4px;
            color: rgba(255, 255, 255, 0.42);
            font-size: clamp(2rem, 3.8vw, 2.85rem);
            font-weight: 800;
            letter-spacing: -0.03em;
        }

        .price-discount {
            position: absolute;
            top: -12px;
            right: -10px;
            padding: 5px 14px;
            border-radius: 999px;
            background: linear-gradient(135deg, #dc2626, #b91c1c);
            border: 1px solid rgba(252, 165, 165, 0.4);
            color: #fff;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.06em;
            box-shadow: 0 4px 14px rgba(220, 38, 38, 0.35);
            z-index: 2;
        }

        .price-today-caption {
            margin: 14px 0 0;
            padding-top: 12px;
            border-top: 1px solid rgba(255, 255, 255, 0.07);
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.4);
        }

        .price-arrow-down {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            margin-top: clamp(18px, 2.5vw, 28px);
            margin-bottom: clamp(28px, 4vw, 48px);
        }

        .scarcity-section .scarcity-payment-cta-override.cta-button-final {
            background: linear-gradient(135deg, #3B82F6 0%, #60A5FA 50%, #3B82F6 100%) !important;
            box-shadow:
              0 10px 30px rgba(59, 130, 246, 0.4) !important,
              inset 0 0 0 2px rgba(255, 255, 255, 0.1) !important;
            width: auto !important;
            display: inline-block !important;
            padding: 20px 50px !important;
            white-space: nowrap !important;
            animation: none !important;
        }
        .scarcity-section .scarcity-payment-cta-override.cta-button-final::before,
        .scarcity-section .scarcity-payment-cta-override.cta-button-final::after {
            content: none !important;
            display: none !important;
            animation: none !important;
        }
        .scarcity-section .scarcity-payment-cta-override.cta-button-final:hover {
            background-position: 100% 100% !important;
            box-shadow:
              0 20px 50px rgba(59, 130, 246, 0.7) !important,
              inset 0 0 0 2px rgba(255, 255, 255, 0.3) !important,
              0 0 80px rgba(59, 130, 246, 0.5) !important;
        }
        .scarcity-payment-block {
            margin-top: 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 28px;
            width: 100%;
        }
        .scarcity-payment-card {
            width: 100%;
            max-width: 380px;
            animation: none !important;
        }
        .scarcity-payment-card::before,
        .scarcity-payment-card::after {
            content: none !important;
            animation: none !important;
            display: none !important;
        }
        .scarcity-payment-card .payment-badge {
            animation: none !important;
            box-shadow: none !important;
        }
        .scarcity-payment-card .payment-badge::before,
        .scarcity-payment-card .payment-badge::after {
            content: none !important;
            display: none !important;
            animation: none !important;
        }
        .scarcity-payment-guarantee {
            font-size: 0.82rem;
            font-weight: 600;
            color: rgba(255,255,255,0.4);
            text-align: center;
        }

        .price-arrow-emoji {
            -webkit-text-fill-color: initial;
            background: none;
            background-clip: initial;
            -webkit-background-clip: initial;
        }
        .price-arrow-sub {
            font-size: 0.82rem;
            font-weight: 500;
            color: rgba(255, 255, 255, 0.35);
            text-align: center;
            letter-spacing: 0.01em;
            margin-bottom: 4px;
        }

        .price-arrow-down svg {
            color: rgba(96, 165, 250, 0.6);
            animation: arrowBounce 2s ease-in-out infinite;
        }

        @keyframes arrowBounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(6px); }
        }

        .payment-options {
            display: grid;
            grid-template-columns: 1fr;
            gap: clamp(12px, 1.8vw, 20px);
            max-width: 380px;
            margin-inline: auto;
        }

        .payment-option {
            position: relative;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: clamp(22px, 2.8vw, 32px) clamp(16px, 2vw, 24px);
            text-align: center;
            transition: border-color 0.3s ease, background 0.3s ease, transform 0.3s ease;
        }
        .payment-option-link {
            display: block;
            text-decoration: none;
            color: inherit;
        }

        .payment-option:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.14);
            transform: translateY(-2px);
        }

        .payment-option--featured {
            background: linear-gradient(165deg, rgba(59, 130, 246, 0.12), rgba(37, 99, 235, 0.06));
            border-color: rgba(96, 165, 250, 0.35);
