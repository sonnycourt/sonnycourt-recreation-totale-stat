        /* Sold Out State */
        .sold-out-state {
            text-align: center;
            padding: 50px 30px;
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
            border-radius: 25px;
            box-shadow: 0 15px 50px rgba(220, 38, 38, 0.4);
            animation: soldOutPulse 1s ease-in-out infinite;
            margin-top: 30px;
        }

        .sold-out-content {
            color: white;
        }

        .sold-out-icon {
            display: none;
        }

        .sold-out-title {
            font-size: 2.5rem;
            font-weight: 900;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .sold-out-description {
            font-size: 1.1rem;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        .reminder-btn {
            background: rgba(255, 255, 255, 0.25);
            color: white;
            border: 2px solid white;
            padding: 15px 30px;
            border-radius: 30px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .reminder-btn:hover {
            background: white;
            color: #dc2626;
            transform: scale(1.05);
        }

        /* ANIMATIONS - PANIC EFFECTS */
        @keyframes counterPulse {
            0%, 100% {
                box-shadow: 0 15px 50px rgba(220, 38, 38, 0.25);
                transform: scale(1);
            }
            50% {
                box-shadow: 0 18px 55px rgba(220, 38, 38, 0.35);
                transform: scale(1.005); /* Plus subtil */
            }
        }


        @keyframes numberThrob {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); } /* Plus subtil */
        }

        /* Animation pulse légère pour le nombre de places */
        @keyframes gentlePulse {
            0%, 100% {
                transform: scale(1);
                opacity: 1;
            }
            50% {
                transform: scale(1.08); /* Pulse très léger */
                opacity: 0.95;
            }
        }

        @keyframes soldOutPulse {
            0%, 100% {
                transform: scale(1);
                box-shadow: 0 15px 50px rgba(220, 38, 38, 0.4);
            }
            50% {
                transform: scale(1.02);
                box-shadow: 0 20px 60px rgba(220, 38, 38, 0.6);
            }
        }


