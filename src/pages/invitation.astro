        }


        /* CTA Section - URGENT CALL */
        .cta-section {
            text-align: center;
            margin-top: 30px;
        }

        .scarcity-cta-button {
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
            color: white !important;
            font-size: 1.4rem;
            font-weight: 800;
            padding: 22px 60px;
            border-radius: 50px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 15px;
            transition: all 0.3s ease;
            box-shadow:
                0 10px 40px rgba(220, 38, 38, 0.5),
                0 0 0 1px rgba(220, 38, 38, 0.3);
            border: none;
            cursor: pointer;
            margin-bottom: 20px;
            position: relative;
            overflow: hidden;
            /* Supprimer tout effet violet/bleu potentiel */
            filter: none;
            -webkit-filter: none;
        }

        /* Brillance premium sur le bouton */
        .scarcity-cta-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg,
                transparent,
                rgba(255, 255, 255, 0.2),
                transparent);
            transition: left 0.6s ease;
        }

        .scarcity-cta-button:hover::before {
            left: 100%;
        }

        .scarcity-cta-button:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 15px 50px rgba(220, 38, 38, 0.7);
        }

        .scarcity-cta-button.sold-out {
            /* Même design que l'état normal mais désactivé */
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
            color: white !important;
            cursor: not-allowed;
            pointer-events: none;
            opacity: 0.8; /* Légèrement transparent mais pas gris */
            transform: none;
            box-shadow: 0 10px 40px rgba(220, 38, 38, 0.5);
            /* Forcer l'absence totale de glow violet en sold-out */
            filter: none !important;
            -webkit-filter: none !important;
            text-shadow: none !important;
            -webkit-text-stroke: none !important;
        }

        .scarcity-cta-button.sold-out:hover {
            /* Même hover que normal mais désactivé */
            transform: none;
            box-shadow: 0 10px 40px rgba(220, 38, 38, 0.5);
        }

        .scarcity-cta-button.sold-out .cta-arrow {
            /* Garder la flèche visible mais en blanc */
            color: white;
            opacity: 0.8;
        }

        .cta-arrow {
            font-size: 1.4rem;
            transition: transform 0.3s ease;
            /* Animation supprimée pour plus de calme */
        }

        .scarcity-cta-button:hover .cta-arrow {
            transform: translateX(8px);
        }

        /* CTA Benefits */
        .cta-benefits {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
            margin-bottom: 30px;
        }

        .benefit {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 18px;
            background: rgba(255, 255, 255, 0.08);
