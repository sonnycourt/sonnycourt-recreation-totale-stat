            margin-bottom: clamp(32px, 5vw, 60px);
            font-style: italic;
        }

        .video-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: clamp(16px, 2.5vw, 32px);
            margin-top: clamp(32px, 5vw, 60px);
            max-width: 960px;
            margin-left: auto;
            margin-right: auto;
        }

        .video-card {
            background: linear-gradient(165deg, rgba(255, 255, 255, 0.04), rgba(15, 23, 42, 0.5));
            border: 1px solid rgba(96, 165, 250, 0.2);
            border-radius: 20px;
            padding: clamp(10px, 1.5vw, 16px);
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.2);
            aspect-ratio: 9 / 16;
        }

        .video-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 40px rgba(59, 130, 246, 0.22);
            border-color: rgba(96, 165, 250, 0.45);
        }

        .review-video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 14px;
            background: var(--dark-bg);
            outline: none;
        }

        .review-video:focus {
            outline: 2px solid rgba(96, 165, 250, 0.6);
            outline-offset: 4px;
        }

        /* Custom Play Button */
        .custom-play-button {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: clamp(44px, 8vw, 72px);
            height: clamp(44px, 8vw, 72px);
            background: none;
            border: none;
            cursor: pointer;
            z-index: 15;
            transition: transform 0.3s ease, opacity 0.3s ease;
            opacity: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .custom-play-button:hover {
            transform: translate(-50%, -50%) scale(1.1);
        }

        .custom-play-button:active {
            transform: translate(-50%, -50%) scale(0.95);
        }

        .custom-play-button svg {
            width: 100%;
            height: 100%;
            filter: drop-shadow(0 4px 8px rgba(59, 130, 246, 0.3));
        }

        /* Hide/show play and pause icons */
        .custom-play-button .play-icon,
        .custom-play-button .pause-icon {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            transition: opacity 0.3s ease;
        }

        /* Hide pause icon by default */
        .custom-play-button .pause-icon {
            display: none;
        }

        .custom-play-button svg circle {
            transition: all 0.3s ease;
        }

        .custom-play-button:hover svg circle {
            r: 13;
            stroke-width: 3;
        }

        /* Hide custom play button when video is playing */
        .video-card.playing .custom-play-button {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        /* Show custom play button when paused (but hide at start/end) */
        .video-card.paused .custom-play-button {
            opacity: 1;
            pointer-events: auto;
        }

        /* Blue-tinted overlay before first play */
        .video-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(180deg,
                rgba(15, 23, 42, 0.25) 0%,
                rgba(30, 58, 138, 0.18) 40%,
                rgba(15, 23, 42, 0.45) 100%);
            border-radius: 14px;
            z-index: 4;
            pointer-events: none;
            transition: opacity 0.4s ease;
        }

        .video-card.has-played::after {
            opacity: 0;
        }

