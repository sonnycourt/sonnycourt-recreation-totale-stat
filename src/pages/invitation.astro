                        btnEl.setAttribute('href', 'https://sonnycourt.com/invitation?t=7a1392fd-f575-45f3-b7ac-6f78ad49e10d');
                        btnEl.setAttribute('target', '_blank');
                        btnEl.setAttribute('rel', 'noopener');
                    }
                    overlay.classList.add('is-visible');
                    overlay.setAttribute('aria-hidden', 'false');
                }
                document.documentElement.classList.add('inv-offer-lock');
            }

            function startInvitationOfferWatch(expiryMs, scarcityCtl, sessionStartsAtMs, windowStartMs) {
                invitationOfferExpiryMs = expiryMs;
                invitationScarcityCtl = scarcityCtl;
                if (!Number.isFinite(expiryMs)) return;
                updateInvitationOfferDeadline(expiryMs);
                if (invitationOfferInterval) clearInterval(invitationOfferInterval);
                const tick = function () {
                    if (invitationOfferLocked) return;
                    if (invitationNowMs() >= expiryMs) {
                        lockInvitationOfferExpired();
                        updateScarcityAudit(sessionStartsAtMs, windowStartMs, expiryMs);
                        return;
                    }
                    updateInvitationOfferCountdown(expiryMs);
                    updateScarcityAudit(sessionStartsAtMs, windowStartMs, expiryMs);
                };
                tick();
                invitationOfferInterval = setInterval(tick, 1000);
            }

            function setTokenEverywhere(nextToken) {
                if (!nextToken) return;
                // Le token synthétique de l'aperçu ne doit jamais remplacer un
                // vrai token webinaire conservé dans le navigateur.
                if ((isPreviewDev || isTokenlessPresentation) && nextToken === 'preview-invitation') return;
                localStorage.setItem(TOKEN_KEY, nextToken);
            }
            function trackWebinaireEvent(token, eventName, value, meta) {
                if (!token || !eventName) return;
                const payload = { token, event: eventName };
                if (value !== undefined && value !== null) payload.value = String(value);
                if (meta && typeof meta === 'object') payload.meta = meta;
                console.log('[ES2 TRACKING]', eventName, payload);
                fetch('/.netlify/functions/track-webinaire-event', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                    keepalive: true,
                }).catch(function () {});
            }

            function propagateTokenToCheckoutLinks(activeToken) {
                if (isTokenlessPresentation) return;
                document.querySelectorAll('a[href*="spiffy.co/checkout"], a[href*="/invitation-es2"]').forEach(function (a) {
                    const href = a.getAttribute('href') || '';
                    const separator = href.includes('?') ? '&' : '?';
                    const accessParam = isPreviewDev
                        ? 'preview=dev'
                        : 't=' + encodeURIComponent(activeToken);
                    a.setAttribute('href', href + separator + accessParam);
                });
            }
            function bindCheckoutClickTracking(activeToken) {
                if (!activeToken) return;
                document.querySelectorAll('a[href*="spiffy.co/checkout"], a[href*="/invitation-es2"]').forEach(function (a) {
                    if (a.dataset.ctaTrackedBound === '1') return;
                    a.dataset.ctaTrackedBound = '1';
                    a.addEventListener('click', function () {
                        const route = (() => {
                            try { return new URL(a.href, window.location.href).pathname; }
                            catch (e) { return a.getAttribute('href') || ''; }
                        })();
                        const meta = {
                            page_path: window.location.pathname,
                            route,
                            plan: a.dataset.trackPlan || '',
                            payment_mode: a.dataset.trackPayment || '',
                            button_id: a.dataset.trackButton || 'checkout-link',
                        };
                        trackWebinaireEvent(activeToken, 'cta_clicked', null, meta);
                        // Signal distinct : clic sur le bouton checkout (page de vente), pour le triage closers.
                        trackWebinaireEvent(activeToken, 'checkout_clicked', null, meta);
                    });
                });
            }

            function initSalesIntentTracking(activeToken) {
                if (!activeToken || isPreview) return;
                const milestones = [25, 50, 75, 90];
                const sent = new Set();
                let scheduled = false;

                function sampleScroll() {
                    scheduled = false;
                    const doc = document.documentElement;
                    const max = Math.max(1, doc.scrollHeight - window.innerHeight);
                    const percent = Math.min(100, Math.max(0, Math.round((window.scrollY / max) * 100)));
                    milestones.forEach(function (milestone) {
                        if (percent < milestone || sent.has(milestone)) return;
                        sent.add(milestone);
                        trackWebinaireEvent(activeToken, 'sales_scroll', milestone, {
                            page_path: window.location.pathname,
                            percent: milestone,
                        });
                    });
                }
                function scheduleScrollSample() {
                    if (scheduled) return;
                    scheduled = true;
                    requestAnimationFrame(sampleScroll);
                }
                window.addEventListener('scroll', scheduleScrollSample, { passive: true });
                window.addEventListener('resize', scheduleScrollSample, { passive: true });
                sampleScroll();

                if (!('IntersectionObserver' in window)) return;
                const targets = [
                    { el: document.getElementById('formules'), section: 'pricing' },
                    { el: document.querySelector('.launch-guarantee-card'), section: 'guarantee' },
                ].filter(function (item) { return item.el; });
                const timers = new Map();
                const completed = new Set();
                const observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        const item = targets.find(function (candidate) { return candidate.el === entry.target; });
                        if (!item || completed.has(item.section)) return;
                        if (entry.isIntersecting && entry.intersectionRatio >= 0.35) {
                            if (timers.has(item.section)) return;
                            timers.set(item.section, setTimeout(function () {
                                completed.add(item.section);
                                timers.delete(item.section);
                                observer.unobserve(item.el);
                                trackWebinaireEvent(activeToken, 'sales_section_viewed', null, {
                                    page_path: window.location.pathname,
                                    section: item.section,
                                });
                            }, 1500));
                        } else if (timers.has(item.section)) {
                            clearTimeout(timers.get(item.section));
                            timers.delete(item.section);
                        }
                    });
                }, { threshold: [0.35] });
                targets.forEach(function (item) { observer.observe(item.el); });
            }

            function initInvitationScarcity() {
                const placesEl = document.getElementById('current-places');
                const toast = document.getElementById('purchase-toast');
                const toastText = document.getElementById('purchase-toast-text');
                const toastFlag = document.getElementById('purchase-toast-flag');
                if (!placesEl || !toast || !toastText || !toastFlag) return null;

                let hideTimer = null;
                let queueGapTimer = null;
                const toastQueue = [];
                let toastBusy = false;
                let lastPhase = 'phase1';
                let lastSeats = 30;
                function updatePhaseUi(phase, seats) {
                    document.querySelectorAll('.scarcity-number').forEach(function (el) {
                        el.textContent = String(seats);
                    });
                    const isPhase2 = phase === 'phase2';
                    document.querySelectorAll('.scarcity-phase1-total').forEach(function (el) {
                        el.classList.toggle('is-visible', isPhase2);
                    });
                    document.querySelectorAll('.scarcity-phase2-note').forEach(function (el) {
                        el.classList.toggle('is-visible', isPhase2);
                    });
                    document.querySelectorAll('.scarcity-denominator').forEach(function (el) {
                        el.classList.add('is-visible');
                        el.textContent = `/ ${isPhase2 ? 10 : 30}`;
                    });
                    document.querySelectorAll('.scarcity-card, .xmen-scarcity-strip').forEach(function (el) {
                        el.classList.toggle('is-phase-2', isPhase2);
                    });
                    const denominator = isPhase2 ? 10 : 30;
                    const pct = (Math.max(0, Math.min(denominator, seats)) / denominator) * 100;
                    document.querySelectorAll('.scarcity-meter__fill').forEach(function (el) {
                        el.style.width = `${pct}%`;
                    });
                    lastPhase = phase || 'phase1';
                    lastSeats = Number.isFinite(seats) ? seats : lastSeats;
                    if (previewStatusEl) {
                        previewStatusEl.textContent = `Phase: ${lastPhase} • Places: ${lastSeats}`;
                    }
                }
                function enqueueToast(purchase, mode, detail) {
                    toastQueue.push({ purchase, mode, detail });
                    if (!toastBusy) flushToastQueue();
                }
                function flushToastQueue() {
                    if (toastBusy) return;
                    const next = toastQueue.shift();
                    if (!next) return;
                    toastBusy = true;
                    const actionText = next.mode === 'replay'
                      ? `a rejoint il y a ${next.detail || 'quelques instants'}`
                      : 'vient de rejoindre';
                    toastFlag.textContent = next.purchase.flag;
                    toastText.innerHTML = `<span class="purchase-toast__name">${next.purchase.name}</span> <span class="purchase-toast__action">${actionText}</span><br /><span class="purchase-toast__course">Esprit Subconscient 2.0</span>`;
                    toast.classList.add('show');
                    if (hideTimer) clearTimeout(hideTimer);
                    if (queueGapTimer) clearTimeout(queueGapTimer);
                    hideTimer = setTimeout(function () {
                        toast.classList.remove('show');
                        queueGapTimer = setTimeout(function () {
                            toastBusy = false;
                            flushToastQueue();
                        }, 1000);
                    }, 4000);
                }
                const engine = startScarcityEngine({
                    now: () => invitationNowMs() - INVITATION_SCARCITY_DELAY_MS,
                    isActive: () => true,
                    windowStartMs: scarcityWindowStartMs,
                    windowEndMs: offerExpiryMs,
                    enableReplay: true,
                    debug: debugScarcity,
                    onSeatsLeft: function (seatsLeft, _soldCount, phase) {
                        const seats = Math.max(0, Math.min(30, Number(seatsLeft) || 0));
                        placesEl.textContent = String(seats);
                        updatePhaseUi(phase, seats);
                    },
                    // Les notifications sont désormais pilotées séparément de la scarcity.
                    onNotification: function () {},
                });
                return {
                    stop() {
                        if (hideTimer) clearTimeout(hideTimer);
                        if (queueGapTimer) clearTimeout(queueGapTimer);
                        hideTimer = null;
                        queueGapTimer = null;
                        toastQueue.length = 0;
                        toastBusy = false;
                        engine.stop();
                    },
                    recalc() {
                        if (engine && typeof engine.debugSnapshot === 'function') {
                            const snap = engine.debugSnapshot();
                            updatePhaseUi(snap.phase, snap.seatsLeft);
                        }
                    },
                };
            }

