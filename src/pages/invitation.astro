---
import BlackFridayBanner from '../components/BlackFridayBanner.astro';
import GAConsentMode from '../components/GAConsentMode.astro';
import PromoBanner from '../components/PromoBanner.astro';
import { getPromoBannerMessage, getPromoCheckoutCode, getPromoLabel, isPromoActiveFor, promo } from '../config/promo';
const currentYear = new Date().getFullYear();
const isEs2Presentation = Astro.url.pathname.replace(/\/+$/, '') === '/es2-presentation';
---

<html lang="fr">
<head>
    <meta charset="UTF-8">
    <!-- Meta Pixel (base PageView) -->
    <script type="text/javascript">
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '3367958190030822');
    fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=3367958190030822&ev=PageView&noscript=1"/></noscript>
    <!-- Meta Pixel End -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {isEs2Presentation && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <title>{isEs2Presentation ? 'Découvrir Esprit Subconscient 2.0' : 'Esprit Subconscient 2.0 - La formation pour reprogrammer ton subconscient'}</title>
    <meta name="description" content="Accès à la formation Esprit Subconscient 2.0 : reprogramme ton subconscient et manifeste la vie de tes rêves avec la méthode de Sonny Court.">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Esprit Subconscient 2.0 - La formation pour reprogrammer ton subconscient" />
    <meta property="og:description" content="Accès à la formation Esprit Subconscient 2.0 : reprogramme ton subconscient et manifeste la vie de tes rêves avec la méthode de Sonny Court." />
    <meta property="og:image" content={new URL("/media/pages/ES20-banner.webp", Astro.url)} />
    <meta property="og:url" content={Astro.url.href} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Esprit Subconscient 2.0 - La formation pour reprogrammer ton subconscient" />
    <meta name="twitter:description" content="Accès à la formation Esprit Subconscient 2.0 : reprogramme ton subconscient et manifeste la vie de tes rêves avec la méthode de Sonny Court." />
    <meta name="twitter:image" content={new URL("/media/pages/ES20-banner.webp", Astro.url)} />

    <!-- GA4 Consent Mode v2 -->
    <GAConsentMode />

    <!-- Microsoft Clarity (invitation page only) -->
    <script type="text/javascript">
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "wkawxw5jtq");
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@400;700;900&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@400;700;900&display=swap"></noscript>


    <!-- Spiffy Checkout Integration -->
    <script>
    if (window.location.pathname.replace(/\/+$/, '') !== '/es2-presentation') {
    "use strict";!function(i,t){var f=t.spiffy=t.spiffy||[];if(!f.init){
    if(f.invoked)return void(t.console&&console.error&&console.warn("Spiffy Elements included twice."))
    ;f.invoked=!0,f.methods=["identify","config","debug","off","on"],f.factory=function(i){
    return function(){var t=Array.prototype.slice.call(arguments);return t.unshift(i),f.push(t),f}},
    f.methods.forEach(function(i){spiffy[i]=f.factory(i)}),f.load=function(t,f){if(!spiffy.ACCOUNT){
    spiffy.ACCOUNT=t,spiffy.DOMAIN=f;var e=i.createElement("script");e.type="text/javascript",
    e.async=!0,e.crossorigin="anonymous",e.src="https://js.static.spiffy.co/spiffy.js?a="+t
    ;var n=i.getElementsByTagName("script")[0];n.parentNode.insertBefore(e,n)}}}}(document,window),
    spiffy.SNIPPET_VERSION="1.1.0";
    spiffy.config({
        hideSidebar: false,
    })
    spiffy.load("sonnycourt");
    }
    </script>
    <!-- End Spiffy Integration -->
    <style>html{opacity:0}html.ready{opacity:1;transition:opacity .15s ease}</style>
</head>
<body class:list={{ 'es2-presentation-mode': isEs2Presentation }}>
    {!isEs2Presentation && <PromoBanner formation="manifest" />}
    {!isEs2Presentation && <div id="promo-config"
      data-start={promo.start}
      data-deadline={promo.deadline}
      data-badge={promo.badgeText}
      data-active={isPromoActiveFor('manifest').toString()}
      data-promo-label={getPromoLabel()}
      data-banner-message={getPromoBannerMessage()}
      data-checkout-code={getPromoCheckoutCode('manifest')}
      data-price-original={promo.formations.manifest.priceOriginal}
      data-price-promo={promo.formations.manifest.pricePromo}
      data-installment-count={promo.formations.manifest.installmentCount}
      data-installment-price={promo.formations.manifest.installmentPrice}
      style="display:none;"></div>}
    {/* BlackFriday Banner désactivé - Réactiver l'année prochaine en changeant show={false} en show={true} */}
    {!isEs2Presentation && <BlackFridayBanner show={false} discount={70} />}
    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <div style="text-align:center;"><span class="modules-intro-kicker">{isEs2Presentation ? 'Bienvenue dans Esprit Subconscient 2.0' : 'Réservé aux participants de la masterclass'}</span></div>
                <h1 class="guarantee-title guarantee-title--split hero-page-title">
                    <span class="hero-page-title__stack">
                        {isEs2Presentation ? (
                            <>
                                <span class="guarantee-title-main">Bienvenue dans ES2.</span>
                                <span class="guarantee-title-accent">Voici ton parcours, tes outils et tes ressources pour les six prochains mois.</span>
                            </>
                        ) : (
                            <>
                                <span class="guarantee-title-main">Tu sais maintenant exactement ce que tu veux</span>
                                <span class="guarantee-title-main">et ce qui te bloque.</span>
                                <span class="guarantee-title-accent">Il ne te manque plus que le protocole ES2 pour transformer ta vie.</span>
                            </>
                        )}
                    </span>
                </h1>

                <div class="hero-pills">
                    <div class="hero-pill">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span>{isEs2Presentation ? 'Tu rejoins +10k participants' : '+10k vies transformées'}</span>
                    </div>
                    <div class="hero-pill">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <span>15 min par jour</span>
                    </div>
                    <div class="hero-pill">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                        <span>{isEs2Presentation ? '14 jours pour poser les bases' : '1ers résultats en 2 semaines'}</span>
                    </div>
                </div>

                <div class="hero-cover-container">
                    <div class="premium-frame">
                        <div class="frame-border"></div>
                        <div class="glare-effect"></div>
                        <img src="/media/pages/ES20-banner.webp"
                             alt="Cover ES 2.0 - papillon bleu"
                             class="hero-cover-image">
                        <div class="subtle-overlay"></div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Scarcity Section -->
    <section class="scarcity-section">
        <div class="container">
            <div class="invitation-offer-zone invitation-offer-zone--hero-urgency">
                <p class="offer-countdown-title">L'offre de lancement expire dans :</p>
                <div class="offer-countdown-grid">
                    <div class="offer-countdown-box"><span id="offer-days" class="offer-countdown-value">03</span><span class="offer-countdown-label">Jours</span></div>
                    <div class="offer-countdown-box"><span id="offer-hours" class="offer-countdown-value">01</span><span class="offer-countdown-label">Heures</span></div>
                    <div class="offer-countdown-box"><span id="offer-minutes" class="offer-countdown-value">29</span><span class="offer-countdown-label">Minutes</span></div>
                    <div class="offer-countdown-box"><span id="offer-seconds" class="offer-countdown-value">44</span><span class="offer-countdown-label">Secondes</span></div>
                </div>

                <!-- Source de données conservée hors affichage pour déplacer le scarcity sans casser ses deux phases. -->
                <div class="scarcity-card" id="scarcity-card" aria-live="polite" aria-hidden="true" hidden>
                    <p class="scarcity-kicker">Nombre de places limitées</p>
                    <div class="scarcity-main">
                        <p class="scarcity-label">Places restantes</p>
                        <div class="scarcity-value">
                            <span class="scarcity-number" id="current-places">30</span>
                            <span class="scarcity-denominator">/ 10</span>
                            <span class="scarcity-unit">places</span>
                        </div>
                    </div>
                    <div class="scarcity-meter" aria-hidden="true">
                        <div class="scarcity-meter__fill"></div>
                    </div>
                    <div class="scarcity-phase2-note">
                        <span class="scarcity-reopen-stamp">Réouverture</span>
                        <div class="scarcity-reopen-line">
                            <span class="scarcity-reopen-count"><span class="scarcity-phase2-pulse"></span>10 places rouvertes</span>
                            <span class="scarcity-reopen-sub">exceptionnellement</span>
                        </div>
                    </div>
                    <div class="scarcity-phase1-total">
                        <span class="scarcity-soldout-stamp">Complet</span>
                        <div class="scarcity-soldout-line">
                            <span class="scarcity-soldout-count">30<span class="scarcity-soldout-slash">/30</span> places vendues</span>
                            <span class="scarcity-soldout-text">en quelques heures</span>
                        </div>
                    </div>
                </div>
                <p class="offer-deadline-reminder" data-offer-deadline-reminder>
                    Fin de l'offre : dimanche soir.
                </p>

            </div>
        </div>
    </section>

    <!-- Histoire d'identification -->
    <section class="sales-stories-section sales-identification-section">
        <div class="container">
            <div class="sales-stories-inner">
                <div style="text-align:center;"><span class="modules-intro-kicker">Une histoire vraie</span></div>
                <h2 class="guarantee-title guarantee-title--split sales-stories-title-stack">
                    <span class="guarantee-title-main">Il est <span id="visitor-clock">23h07</span>,</span>
                    <span class="guarantee-title-accent">et tu recommences à y croire <span class="guarantee-title-main">(mais tu doutes encore)</span></span>
                </h2>
                <div class="ss-intro ss-identification-intro">
                    <p>Tu connais ce moment. <strong>La maison est silencieuse, l'écran éclaire ton visage</strong>, et tu regardes une vidéo de plus sur le développement personnel. Tu as pris des notes que tu ne reliras jamais. Tu te dis que cette fois, c'est la bonne. Que lundi, tout change.</p>
                    <p>Et lundi arrive. <strong>Et mercredi, l'ancien toi a déjà repris le dessus</strong>, comme si rien ne s'était passé.</p>
                    <p>Mais je ne peux pas t'abandonner à ce triste sort quand je sais ce qui est possible pour toi.</p>
                </div>

                <div class="ss-story-hinge">
                    <span>Puis il y a eu Louis.</span>
                </div>

                <div class="ss-story-chapter">
                    <p class="ss-story-chapter__label">Le message</p>
                    <div class="ss-intro">
                    <p>Si je le sais, c'est parce que tu n'es pas la première personne à qui je tends la main.</p>
                    <p><strong>Louis dormait dans le salon depuis trois semaines</strong> quand il m'a écrit.</p>
                    <p>Sa femme lui avait dit la phrase que des millions d'hommes redoutent : « Je t'aime, mais je ne suis plus heureuse. » Quatorze ans de mariage. Deux enfants. Un carton à moitié rempli dans l'entrée.</p>
                    <p>Je reçois des centaines de messages par jour, et je n'arrive généralement pas à y répondre. Le sien se terminait par : <strong>« Elle part le premier du mois. Je sais que tu ne liras jamais ça. Je l'envoie quand même. »</strong></p>
                    <p>C'est peut-être parce qu'il était certain que je ne lirais pas que j'ai eu envie de lire. Puis de répondre.</p>
                    <p>Pas avec des conseils de couple, je n'en donne pas. Je lui ai dit une seule vérité :</p>
                    </div>
                </div>
                <div class="ss-callout ss-callout--accent">
                    <p><strong>« Tu ne peux pas la rendre heureuse. Tu peux seulement redevenir l'homme avec qui elle était heureuse. »</strong></p>
                </div>

                <div class="ss-story-chapter">
                    <p class="ss-story-chapter__label">Le déclic</p>
                    <div class="ss-intro">
                    <p>Puis je lui ai appris trois techniques. <strong>Le Soleil Intérieur. Les Souvenirs Futurs. La 3ème Porte.</strong> Trois techniques que tu retrouveras dans ES2.</p>
                    <p>Sa réponse tenait en une ligne : « Je ne me sens pas capable d'y arriver. Mais je te promets d'essayer. »</p>
                    <p>Un mois et demi s'est écoulé sans nouvelles. Et je vais être honnête avec toi : entre les centaines de messages et les journées trop courtes, <strong>j'avais complètement oublié Louis.</strong></p>
                    <p>Puis un matin, dans mes DM : <strong>« Merci Sonny. On est toujours ensemble. C'est grâce à toi. »</strong></p>
                    <p>Il m'a tout raconté. Il avait suivi les trois techniques à la lettre. Quelque chose s'était relâché en lui, cette chose qui le faisait se comporter en désespéré. Dès le premier soir, avec le Soleil Intérieur, il avait compris une vérité terrible : <strong>même lui ne pourrait plus aimer l'homme qu'il était devenu.</strong></p>
                    <p>Avec cette prise de conscience, tout s'est mis en place dans les jours qui ont suivi. Et sa femme a changé de comportement envers lui, naturellement, en miroir de l'homme qui changeait devant elle.</p>
                    <p><strong>Le carton dans l'entrée n'a jamais été terminé.</strong></p>
                    </div>
                </div>

                <div class="ss-story-chapter ss-story-chapter--last">
                    <p class="ss-story-chapter__label">Huit mois plus tard</p>
                    <div class="ss-intro">
                        <p>J'ai reçu un message d'un compte inconnu. <strong>C'était elle.</strong> Une phrase :</p>
                    </div>
                </div>
                <div class="ss-callout ss-callout--accent">
                    <p><strong>« C'est la femme de Louis... Je ne sais pas ce que vous avez fait à mon mari, mais merci. »</strong></p>
                </div>
                <div class="ss-intro">
                    <p>Ce n'est pas seulement une histoire d'amour. C'est ce qui arrive quand quelqu'un arrête de se battre contre les circonstances, et va régler ce qui tourne à l'intérieur.</p>
                    <p>Louis a eu seulement trois techniques et un message de ma part. Toi, tu peux avoir le protocole entier, et l'appliquer dès ce soir avec ES2.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Le subconscient — ce n'était pas ta faute -->
    <section class="sales-stories-section sales-secrets-section">
        <div class="container">
            <div class="sales-stories-inner sales-blame-intro">
                <h2 class="guarantee-title guarantee-title--split sales-stories-title-stack">
                    <span class="guarantee-title-main">Rien n'a vraiment fonctionné jusqu'ici.</span>
                    <span class="guarantee-title-accent">Et ce n'est pas de ta faute !</span>
                </h2>
                <div class="ss-intro ss-blame-story">
                    <p>Tu avances d'un espoir à une déception.</p>
                    <p>Chaque fois, tu as accepté d'y croire encore. Tu as donné ton temps, ton énergie, parfois ton argent à quelqu'un qui disait pouvoir t'aider.</p>
                    <p>Et quand rien n'a vraiment tenu, ce n'est pas sa méthode que tu as remise en question.</p>
                    <p class="ss-blame-pivot"><strong>C'est toi.</strong></p>
                    <p>Tu t'es dit que tu manquais de volonté. Que tu n'étais peut-être pas assez discipliné. Que les autres pouvaient changer, mais que quelque chose devait clocher chez toi.</p>
                    <p>À force, le blâme a changé de camp. Il a quitté toutes ces méthodes qui ne t'ont pas aidé pour venir se poser sur tes épaules.</p>
                </div>

                <p class="ss-blame-reset">Mais regarde les faits.</p>
                <div class="ss-persistence-proof" aria-label="La preuve de ta volonté de changer">
                    <span>Tu es encore là.</span>
                    <span>Tu cherches encore.</span>
                    <span>Tu essaies encore.</span>
                </div>

                <div class="ss-intro ss-blame-resolution">
                    <p>Quelqu'un qui ne veut pas changer ne fait pas tout ce chemin.</p>
                    <p><strong>Ton désir de transformer ta vie n'a jamais été le problème. Ta volonté de reprendre les choses en main non plus.</strong></p>
                    <p>Il te manquait simplement trois vérités que personne ne t'avait encore montrées.</p>
                </div>

                <div class="ss-callout ss-callout--accent ss-secrets-invitation">
                    <p><strong>Trois secrets qui expliquent pourquoi tes anciens élans se sont toujours éteints au même endroit, et comment faire pour que cette fois, le changement tienne.</strong></p>
                    <p>Lis-les attentivement. Ils peuvent faire toute la différence pour la suite de ton histoire.</p>
                </div>
            </div>

            <!-- Secret n°1 — l'avant, le pendant, l'après -->
            <div class="sales-stories-inner">
                <h2 class="secret-heading">
                    <span class="secret-heading__number">Secret n°1</span>
                    <span class="secret-heading__statement">La transformation n'a pas deux phases. Elle en a trois. <span class="secret-heading__statement-accent">Et la plus dangereuse est celle que personne ne te montre.</span></span>
                </h2>
                <div class="ss-intro secret1-opening">
                    <p><strong>Le moment où tu risques le plus d'abandonner n'est pas avant de commencer.</strong></p>
                    <p>C'est quand tu as déjà commencé à changer, mais que ta vie ressemble encore exactement à hier.</p>
                </div>

                <div class="secret1-reveal" aria-label="La phase du pendant">
                    <span>Le pendant.</span>
                </div>

                <div class="ss-intro">
                    <p>On t'a montré mille avant / après. La photo de gauche où rien ne va. La photo de droite où tout semble enfin réglé.</p>
                    <p>Mais entre ces deux images, il y a des jours, parfois des semaines, que personne ne photographie.</p>
                </div>

                <div class="secret1-inner-voice">
                    <p>Tu pratiques. Tu réagis autrement. Tu sens que quelque chose bouge à l'intérieur. Mais autour de toi, le décor n'a pas changé : le même compte en banque, les mêmes remarques, les mêmes problèmes sur la table.</p>
                    <strong>Alors une phrase finit par monter : « Ça ne marche pas. »</strong>
                </div>

                <div class="ss-intro">
                    <p>C'est ici que beaucoup abandonnent. Pas au début. Au milieu.</p>
                    <p>L'absence de preuve devient, dans leur tête, la preuve que rien ne change. Pourtant, le silence du dehors n'est pas un verdict. <strong>Le dehors ne change simplement pas toujours au même rythme que le dedans.</strong></p>
                </div>

                <figure class="secret-triptych-figure">
                    <!-- Images temporaires (finales à venir) : sources dans ~/Downloads/image secret 1/ -->
                    <div class="secret-triptych">
                        <svg class="secret-triptych__flow secret-triptych__flow--top" viewBox="0 0 360 100" aria-hidden="true">
                            <g transform="translate(0 100) scale(1 -1)">
                                <path class="secret-triptych__flow-line" d="M14 14 C92 91 245 94 323 31"></path>
                                <path class="secret-triptych__flow-head" d="M292 40 L324 30 L318 61"></path>
                            </g>
                        </svg>

                        <div class="secret-triptych__cards">
                            <div class="secret-triptych__item">
                                <img src="/media/pages/secret1-avant-sonny-v2.webp" alt="L'avant : un décor éteint, un état éteint" class="secret-proof__img" loading="lazy" width="1672" height="941">
                                <p class="secret-triptych__label"><strong>L'avant.</strong> Le décor décide de ton état.</p>
                            </div>
                            <div class="secret-triptych__item">
                                <img src="/media/pages/secret1-pendant-sonny-v4.webp" alt="Le pendant : même décor, mais un état transformé" class="secret-proof__img" loading="lazy" width="1672" height="941">
                                <p class="secret-triptych__label"><strong>Le pendant.</strong> Le décor n'a pas bougé. Toi, oui.</p>
                            </div>
                            <div class="secret-triptych__item">
                                <img src="/media/pages/secret1-apres-sonny-v3.webp" alt="L'après : le décor s'est aligné sur le nouvel état" class="secret-proof__img" loading="lazy" width="1672" height="941">
                                <p class="secret-triptych__label"><strong>L'après.</strong> Le changement devient visible.</p>
                            </div>
                        </div>

                        <svg class="secret-triptych__flow secret-triptych__flow--bottom" viewBox="0 0 360 100" aria-hidden="true">
                            <path class="secret-triptych__flow-line" d="M14 14 C92 91 245 94 323 31"></path>
                            <path class="secret-triptych__flow-head" d="M292 40 L324 30 L318 61"></path>
                        </svg>
                    </div>
                    <figcaption class="secret-triptych__caption">Tout le monde rêve de l'APRÈS. Mais presque tout le monde oublie que la magie opère réellement durant le PENDANT.</figcaption>
                </figure>

                <div class="ss-intro secret1-es2-bridge">
                    <p>{isEs2Presentation ? "C'est précisément cette phase qu'ES2 va maintenant t'aider à traverser. Ton accompagnement te donne les repères et les outils nécessaires pour rester fidèle à ta vision pendant que les premiers changements s'installent." : "C'est pour t'aider à traverser le PENDANT qu'ES2 est né. Notre accompagnement complet te donne tout ce dont tu as besoin chaque jour, pour rester fidèle à ta vision pendant que le monde autour de toi se réorganise et s'aligne à l'état de ton souhait réalisé."}</p>
                </div>

                <div class="ss-callout ss-callout--accent">
                    <p><strong>Tu n'abandonnes pas parce que rien ne change. Tu abandonnes parce que le changement intérieur arrive avant les preuves extérieures.</strong></p>
                </div>

