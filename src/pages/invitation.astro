        .es2-presentation-mode .es2-resource-card--legacy,
        .es2-presentation-mode #formules,
        .es2-presentation-mode .launch-protection-content,
        .es2-presentation-mode .decision-six-weeks,
        .es2-presentation-mode .decision-answer--guarantee,
        .es2-presentation-mode .final-enrollment-section,
        .es2-presentation-mode .inv-offer-expired {
            display: none !important;
        }

        .es2-presentation-mode .launch-protection-section {
            padding-top: clamp(56px, 8vw, 96px);
        }

        .es2-presentation-mode .decision-title--presentation {
            margin-bottom: clamp(30px, 5vw, 54px);
        }

        .es2-presentation-mode .decision-answers {
            grid-template-columns: minmax(0, 1fr);
            max-width: 760px;
            margin-inline: auto;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            background-color: #0a0f1f;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #0a0f1f;
            background:
                radial-gradient(ellipse at 20% 0%, rgba(59, 130, 246, 0.24) 0%, transparent 52%),
                radial-gradient(ellipse at 80% 100%, rgba(37, 99, 235, 0.16) 0%, transparent 52%),
                linear-gradient(180deg, #0a0f1f 0%, #0a1628 48%, #0a0f1f 100%);
            color: var(--text-primary);
            line-height: 1.6;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .hero {
            min-height: auto;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            background: radial-gradient(ellipse at center top, rgba(59, 130, 246, 0.05) 0%, transparent 50%);
            z-index: 2;
            padding: clamp(76px, 9vw, 120px) 0 clamp(18px, 3.6vw, 44px) 0;
        }

        .hero-content {
            text-align: center;
            z-index: 3;
        }

        #counter-number {
            font-weight: 900;
            color: #3B82F6;
            text-shadow:
                0 2px 4px rgba(0, 0, 0, 0.3);
            transition: all 0.3s ease;
        }

        #countdown-timer {
            font-family: 'Courier New', monospace;
            font-weight: 900;
            color: #ff4757;
            background: linear-gradient(135deg, #ff4757 0%, #ff3838 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow:
                0 0 10px rgba(255, 71, 87, 0.8),
                0 0 20px rgba(255, 71, 87, 0.6);
            /* Animation supprimée pour moins d'agitation */
            /* Assurer que le timer reste parfaitement stable */
            position: relative !important;
            transform: none !important;
            animation: none !important;
            transition: none !important;
        }

        @keyframes timerPulse {
            0%, 100% {
                opacity: 1;
                transform: scale(1);
            }
            50% {
                opacity: 0.8;
                transform: scale(1.05);
            }
        }

        .hero-tagline {
            font-size: 1rem;
            color: rgba(255, 255, 255, 0.8);
            max-width: 760px;
            margin: 0 auto 34px;
            font-weight: 500;
            font-style: normal;
            opacity: 1;
            line-height: 1.5;
            text-shadow:
                0 2px 4px rgba(0, 0, 0, 0.45);
            letter-spacing: 0.01em;
            text-align: center;
        }

        .hero-pills {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            max-width: 760px;
            margin: 0 auto 34px;
        }

        .hero-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 999px;
            border: 1px solid rgba(96, 165, 250, 0.35);
            background: rgba(59, 130, 246, 0.12);
            color: rgba(255, 255, 255, 0.92);
            font-size: 0.85rem;
            font-weight: 600;
            white-space: nowrap;
        }

        .hero-pill svg {
            width: 15px;
            height: 15px;
            color: #60A5FA;
            flex: none;
        }

        .hero-guarantee {
            margin: 15px 0 0 0;
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.9rem;
            font-weight: 500;
            text-align: center;
            letter-spacing: 0.5px;
        }

        .hero-guarantee::first-letter {
            color: var(--primary-purple);
            font-weight: 700;
        }

        .hero-cover-container {
            position: relative;
            max-width: 800px;
            margin: 0 auto clamp(10px, 2.2vw, 22px);
        }

        .premium-frame {
            position: relative;
            background:
                linear-gradient(135deg, rgba(20, 20, 20, 0.9) 0%, rgba(30, 30, 30, 0.8) 100%),
                rgba(59, 130, 246, 0.05);
            border-radius: 24px;
            padding: 12px;
            box-shadow:
                0 20px 60px rgba(0, 0, 0, 0.4),
                0 0 80px rgba(59, 130, 246, 0.2),
                inset 0 0 0 1px rgba(255, 255, 255, 0.08);
            transition: all 0.35s ease;
        }

        .premium-frame:hover {
            transform: translateY(-3px);
            box-shadow:
                0 25px 70px rgba(0, 0, 0, 0.5),
                0 0 100px rgba(59, 130, 246, 0.3),
                inset 0 0 0 1px rgba(255, 255, 255, 0.12);
        }

        .frame-border {
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.42), rgba(37, 99, 235, 0.22));
            border-radius: 26px;
            opacity: 0;
            transition: opacity 0.4s ease;
            z-index: -1;
        }

        .premium-frame:hover .frame-border {
            opacity: 1;
        }

        .glare-effect {
            position: absolute;
            top: 12px;
            left: 12px;
            right: 12px;
            bottom: 12px;
            background: linear-gradient(
                135deg,
                transparent 30%,
                rgba(255, 255, 255, 0.06) 50%,
                transparent 70%
            );
            border-radius: 20px;
            opacity: 0.3;
            transition: opacity 0.4s ease;
            pointer-events: none;
            z-index: 1;
        }

        .premium-frame:hover .glare-effect {
            opacity: 0.5;
        }

        .hero-cover-image {
            width: 100%;
            height: auto;
            max-height: none;
            object-fit: contain;
            display: block;
            border-radius: 20px;
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            filter: brightness(0.95) contrast(1.05) saturate(1.1);
        }

        .premium-frame:hover .hero-cover-image {
            transform: scale(1.01);
            filter: brightness(1.05) contrast(1.1) saturate(1.15);
        }

        .subtle-overlay {
            position: absolute;
            top: 12px;
            left: 12px;
            right: 12px;
            bottom: 12px;
            background: linear-gradient(
                135deg,
                rgba(59, 130, 246, 0.08) 0%,
                rgba(37, 99, 235, 0.05) 50%,
                rgba(59, 130, 246, 0.06) 100%
            );
            border-radius: 20px;
            opacity: 0.6;
            transition: opacity 0.4s ease;
            pointer-events: none;
            z-index: 2;
        }

        .premium-frame:hover .subtle-overlay {
            opacity: 0.8;
        }


        .cta-button-final {
            display: inline-block;
            padding: 20px 50px;
            font-size: 1.2rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #FFFFFF;
            background: linear-gradient(135deg, #3B82F6 0%, #60A5FA 50%, #3B82F6 100%);
            background-size: 200% 200%;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow:
              0 10px 30px rgba(59, 130, 246, 0.4),
              inset 0 0 0 2px rgba(255, 255, 255, 0.1);
            position: relative;
            overflow: hidden;
            text-decoration: none;
            animation: buttonPulse 2s ease-in-out infinite;
        }

        .cta-button-final::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
              45deg,
              transparent 30%,
              rgba(255, 255, 255, 0.3) 50%,
              transparent 70%
            );
            transform: rotate(45deg);
            transition: all 0.6s;
            animation: buttonShine 3s ease-in-out infinite;
            pointer-events: none;
        }

        .cta-button-final:hover {
            background-position: 100% 100%;
            transform: scale(1.05);
            box-shadow:
              0 20px 50px rgba(59, 130, 246, 0.7),
              inset 0 0 0 2px rgba(255, 255, 255, 0.3),
              0 0 80px rgba(59, 130, 246, 0.5);
            animation: none;
        }

        /* CORRECTION CRITIQUE : Boutons CTA dans section scarcity - UNIQUEMENT ROUGE */
        .scarcity-section .cta-button-final {
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%) !important;
            box-shadow:
              0 10px 40px rgba(220, 38, 38, 0.5) !important,
              inset 0 0 0 2px rgba(255, 255, 255, 0.1) !important;
            /* Animation supprimée pour plus de sobriété */
            /* Forcer l'absence totale de glow violet */
            filter: none !important;
            -webkit-filter: none !important;
            text-shadow: none !important;
            -webkit-text-stroke: none !important;
        }

        .scarcity-section .cta-button-final:hover {
            box-shadow:
              0 15px 50px rgba(220, 38, 38, 0.7) !important,
              inset 0 0 0 2px rgba(255, 255, 255, 0.3) !important;
            animation: none !important; /* Supprimer l'animation hover violette */
            /* Forcer l'absence totale de glow violet au hover */
            filter: none !important;
            -webkit-filter: none !important;
            text-shadow: none !important;
            -webkit-text-stroke: none !important;
        }

        .cta-button-final:active {
            transform: scale(1.02);
        }

        /* Animations EXACTES de access-optin.html */
        @keyframes buttonPulse {
            0%, 100% {
              transform: scale(1);
              box-shadow:
                0 10px 30px rgba(59, 130, 246, 0.4),
                inset 0 0 0 2px rgba(255, 255, 255, 0.1);
            }
            50% {
              transform: scale(1.02);
              box-shadow:
                0 15px 40px rgba(59, 130, 246, 0.6),
                inset 0 0 0 2px rgba(255, 255, 255, 0.2);
            }
        }


        @keyframes buttonShine {
            0% {
              transform: rotate(45deg) translateX(-200%);
            }
              100% {
              transform: rotate(45deg) translateX(200%);
            }
        }

        @keyframes titleGradient {
            0% {
                background-position: 0% 50%;
            }
            25% {
                background-position: 30% 70%;
            }
            50% {
                background-position: 70% 30%;
            }
            75% {
                background-position: 40% 80%;
            }
            100% {
                background-position: 0% 50%;
            }
        }

        .features {
            padding: clamp(64px, 10vw, 120px) 0;
            position: relative;
            z-index: 2;
        }

        .feature-card {
            position: relative;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: clamp(28px, 4.2vw, 52px);
            margin-bottom: clamp(24px, 3.5vw, 40px);
            display: grid;
            grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.68fr);
            gap: clamp(24px, 4vw, 48px);
            align-items: start;
            transition: all 0.3s ease;
        }

        .feature-card:hover {
            background: var(--card-hover);
            transform: translateY(-5px);
        }

        .feature-content {
            position: relative;
            z-index: 1;
            min-width: 0;
        }

        .feature-number {
            display: block;
            font-size: clamp(2.4rem, 5.2vw, 3.85rem);
            font-weight: 900;
            color: var(--primary-purple);
            opacity: 0.22;
            font-family: 'Playfair Display', serif;
            line-height: 1;
            letter-spacing: -0.03em;
            margin: 0 0 clamp(12px, 2.4vw, 20px) 0;
            user-select: none;
        }

        .feature-content h3 {
            font-size: clamp(1.45rem, 2.6vw, 2rem);
            margin: 0 0 20px 0;
            font-weight: 700;
        }

        .feature-content h3 span {
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .feature-content p {
            color: var(--text-secondary);
            font-size: 1.1rem;
            line-height: 1.8;
        }

        .feature-image {
            width: 100%;
            max-width: min(100%, clamp(220px, 26vw, 360px));
            justify-self: end;
            align-self: center;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .feature-image img {
            width: 100%;
            height: auto;
            max-height: clamp(200px, 28vh, 320px);
            object-fit: contain;
            border-radius: 16px;
        }

        .glow {
            position: relative;
        }

        .glow::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.3) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.3s ease;
            pointer-events: none;
        }

        .glow:hover::after {
            opacity: 1;
        }

        /* Quotes Section */
        .quotes-section {
            padding: 120px 0;
            background: var(--darker-bg);
            position: relative;
            z-index: 2;
        }

        .quotes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
        }

        .quote-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 40px;
            position: relative;
            transition: all 0.3s ease;
        }

        .quote-card:hover {
            background: var(--card-hover);
            transform: translateY(-5px);
            box-shadow: var(--shadow-card);
        }

        .quote-icon {
            color: var(--primary-purple);
            font-size: 3rem;
            opacity: 0.3;
            position: absolute;
            top: 20px;
            right: 30px;
        }

        .quote-text {
            font-size: 1.1rem;
            line-height: 1.8;
            color: var(--text-secondary);
            margin-bottom: 30px;
            font-style: italic;
        }

        .quote-author {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .quote-author img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: 2px solid var(--primary-purple);
        }

        .quote-author-name {
            font-weight: 600;
            color: var(--primary-purple);
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 3.5rem;
            text-align: center;
            margin-bottom: 80px;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Method Section */
        .method-section {
            padding: 120px 0;
            background: linear-gradient(180deg, var(--card-bg) 0%, var(--dark-bg) 100%);
            position: relative;
            z-index: 2;
        }

        .method-header {
            text-align: center;
            margin-bottom: 60px;
            position: relative;
        }

        .method-main-title {
            margin: 0;
            background: linear-gradient(135deg, var(--primary-purple), #60A5FA);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-size: clamp(2.5rem, 4vw, 3.5rem);
            font-weight: 800;
        }

        .method-subtitle {
            font-size: 1.3rem;
            color: var(--text-secondary);
            max-width: 700px;
            margin: 0 auto 30px;
            line-height: 1.6;
            font-weight: 400;
        }

        .method-content {
            display: flex;
            flex-direction: column;
            gap: 60px;
        }

        .method-video-container {
            position: relative;
        }

        .method-video-frame {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            box-shadow:
                0 25px 50px rgba(0, 0, 0, 0.4),
                0 0 80px rgba(59, 130, 246, 0.2);
            transition: all 0.4s ease;
        }

        .method-video-frame:hover {
            transform: translateY(-10px);
            box-shadow:
                0 35px 70px rgba(0, 0, 0, 0.5),
                0 0 100px rgba(59, 130, 246, 0.3);
        }

        .method-video-glow {
            position: absolute;
            top: -15px;
            left: -15px;
            right: -15px;
            bottom: -15px;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.3), rgba(59, 130, 246, 0.1));
            border-radius: 35px;
            z-index: -1;
            opacity: 0.8;
        }

        .method-keypoints {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .method-keypoint {
            display: flex;
            align-items: flex-start;
            gap: 20px;
            padding: 25px;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.08), rgba(20, 20, 20, 0.8));
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 16px;
            transition: all 0.3s ease;
        }

        .method-keypoint:hover {
            transform: translateX(10px);
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.12), rgba(20, 20, 20, 0.9));
            border-color: rgba(59, 130, 246, 0.4);
            box-shadow: 0 10px 30px rgba(59, 130, 246, 0.15);
        }

        .keypoint-icon {
                font-size: 2rem;
            color: var(--primary-purple);
            flex-shrink: 0;
            margin-top: 2px;
        }

        .keypoint-content h4 {
            margin: 0 0 10px 0;
            color: var(--text-primary);
            font-size: 1.2rem;
            font-weight: 600;
        }

        .keypoint-content p {
            margin: 0;
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .method-cta {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(20, 20, 20, 0.9));
            border: 2px solid rgba(59, 130, 246, 0.3);
            border-radius: 24px;
            padding: 50px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .method-cta::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.1), transparent);
            transition: left 0.5s;
        }

        .method-cta:hover::before {
            left: 100%;
        }

        .method-cta-title {
                font-size: 2rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 15px;
            background: linear-gradient(135deg, var(--primary-purple), #60A5FA);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .method-cta-text {
            font-size: 1.1rem;
            color: var(--text-secondary);
            margin-bottom: 30px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .method-benefits-preview {
            display: flex;
            justify-content: center;
                gap: 30px;
            flex-wrap: wrap;
        }

        .benefit-preview-item {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-secondary);
            font-size: 0.95rem;
        }

        .benefit-check {
            color: var(--primary-purple);
            font-weight: 700;
            font-size: 1.1rem;
        }

        .method-cta-button {
            margin-top: 40px;
                text-align: center;
        }

        .method-guarantee {
            margin: 15px 0 0 0;
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.9rem;
            font-weight: 500;
            text-align: center;
            letter-spacing: 0.5px;
        }

        .method-guarantee::first-letter {
            color: var(--primary-purple);
            font-weight: 700;
        }

        /* Video Section */
        .video-section {
            padding: 120px 0;
            background: var(--card-bg);
            position: relative;
            z-index: 2;
        }

        .video-container {
            max-width: 900px;
            margin: 0 auto;
            background: var(--darker-bg);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: var(--shadow-card);
            border: 1px solid var(--border-color);
        }

        .video-wrapper {
            position: relative;
            padding-bottom: 56.25%;
            height: 0;
            background: #000;
        }

        .custom-video-player {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
            cursor: pointer;
            -webkit-user-select: none;
            -moz-user-select: none;
            user-select: none;
        }

        /* Masquer les contrôles natifs */
        .custom-video-player::-webkit-media-controls {
            display: none !important;
        }
        .custom-video-player::-webkit-media-controls-panel {
            display: none !important;
        }
        .custom-video-player::-webkit-media-controls-play-button {
            display: none !important;
        }
        .custom-video-player::-webkit-media-controls-timeline {
            display: none !important;
        }
        .custom-video-player::-webkit-media-controls-current-time-display {
            display: none !important;
        }
        .custom-video-player::-webkit-media-controls-time-remaining-display {
            display: none !important;
        }
        .custom-video-player::-webkit-media-controls-mute-button {
            display: none !important;
        }
        .custom-video-player::-webkit-media-controls-volume-slider {
            display: none !important;
        }
        .custom-video-player::-webkit-media-controls-fullscreen-button {
            display: none !important;
        }

        /* Contrôles personnalisés */
        .custom-video-controls {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.4) 50%, transparent 100%);
            padding: 20px;
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: 10;
        }

        .video-wrapper:hover .custom-video-controls,
        .custom-video-controls.show {
            opacity: 1;
        }

        /* Barre de progression */
        .video-progress-container {
            margin-bottom: 12px;
        }

        .video-progress-bar {
            width: 100%;
            height: 6px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 3px;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .video-progress-filled {
            height: 100%;
            background: linear-gradient(90deg, #3B82F6 0%, #60A5FA 100%);
            border-radius: 3px;
            width: 0%;
            transition: width 0.1s linear;
        }

        .video-progress-bar:hover .video-progress-filled {
            background: linear-gradient(90deg, #60A5FA 0%, #93C5FD 100%);
        }

        /* Contrôles du bas */
        .video-controls-bottom {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .video-control-btn {
            background: rgba(59, 130, 246, 0.3);
            border: 1px solid rgba(59, 130, 246, 0.5);
            border-radius: 8px;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: white;
            transition: all 0.3s ease;
        }

        .video-control-btn:hover {
            background: rgba(59, 130, 246, 0.5);
            border-color: rgba(59, 130, 246, 0.7);
            transform: scale(1.1);
        }

        .video-time {
            color: white;
            font-size: 14px;
            font-weight: 500;
            flex: 1;
        }

        .time-separator {
            margin: 0 4px;
            opacity: 0.6;
        }

        .video-controls-right {
            display: flex;
            gap: 8px;
        }

        /* Overlay play button */
        .video-play-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 5;
            transition: opacity 0.3s ease;
            cursor: pointer;
        }

        .video-play-overlay.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .video-play-button {
            background: none;
            border: none;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        .video-play-button:hover {
            transform: scale(1.1);
        }

        /* Learning Section */
        .learning-section {
            padding: 120px 0;
            background:
                radial-gradient(circle at 20% 30%, rgba(59, 130, 246, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(59, 130, 246, 0.06) 0%, transparent 50%),
                var(--darker-bg);
            position: relative;
            z-index: 2;
            overflow: hidden;
        }

        .learning-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image:
                radial-gradient(circle at 25% 25%, rgba(59, 130, 246, 0.03) 0%, transparent 25%),
                radial-gradient(circle at 75% 75%, rgba(59, 130, 246, 0.03) 0%, transparent 25%);
            pointer-events: none;
        }

        .learning-header {
            text-align: center;
            margin-bottom: 80px;
            position: relative;
        }

        .learning-subtitle {
            font-size: 1.3rem;
            color: var(--text-secondary);
            margin-top: 20px;
            font-style: italic;
            opacity: 0.8;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
        }

        .learning-mystic-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 40px;
            position: relative;
        }

        .learning-mystic-item {
            background:
                linear-gradient(135deg, rgba(20, 20, 20, 0.9) 0%, rgba(30, 30, 30, 0.8) 100%),
                rgba(59, 130, 246, 0.05);
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 20px;
            padding: 50px 30px;
            display: block;
            text-align: center;
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
        }

        .learning-mystic-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, transparent 30%, rgba(59, 130, 246, 0.1) 50%, transparent 70%);
            opacity: 0;
            transition: opacity 0.6s ease;
            pointer-events: none;
        }

        .learning-mystic-item:hover::before {
            opacity: 1;
        }

        .learning-mystic-item:hover {
            transform: translateY(-10px) scale(1.02);
            border-color: rgba(59, 130, 246, 0.5);
            box-shadow:
                0 20px 60px rgba(59, 130, 246, 0.3),
                0 0 80px rgba(59, 130, 246, 0.1),
                inset 0 0 20px rgba(59, 130, 246, 0.05);
        }


        .mystic-content {
            text-align: center;
        }

        .mystic-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: #60A5FA;
            margin-bottom: 15px;
        }

        .mystic-description {
            color: var(--text-secondary);
            font-size: 1rem;
            line-height: 1.6;
            margin: 0;
        }

        @keyframes mysticGlow {
            0% {
                filter: drop-shadow(0 0 10px rgba(59, 130, 246, 0.5));
                transform: scale(1);
            }
            100% {
                filter: drop-shadow(0 0 20px rgba(59, 130, 246, 0.8));
                transform: scale(1.1);
            }
        }

        @keyframes crystalPulse {
            0%, 100% {
                opacity: 0.3;
                transform: translate(-50%, -50%) scale(1);
            }
            50% {
                opacity: 0.6;
                transform: translate(-50%, -50%) scale(1.2);
            }
        }

        @media (max-width: 768px) {
            .learning-mystic-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .learning-mystic-item {
                padding: 30px 20px;
            }

        }

