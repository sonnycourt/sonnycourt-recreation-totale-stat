            function setBodyScrollLocked(locked) {
                if (locked) {
                    document.body.style.overflow = 'hidden';
                    document.body.style.touchAction = 'none';
                    return;
                }
                document.body.style.overflow = '';
                document.body.style.touchAction = '';
