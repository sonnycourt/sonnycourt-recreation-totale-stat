        .descriptive-text {
            color: var(--text-primary);
            text-align: center;
            width: 100%;
            max-width: 800px;
            min-width: 0;
        }

        .descriptive-intro {
            margin-bottom: 40px;
        }

        .descriptive-intro-text {
            font-size: 1.3rem;
            color: var(--text-secondary);
            line-height: 1.7;
            margin-bottom: 25px;
        }

        .descriptive-highlight {
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--primary-purple);
            margin-bottom: 30px;
            background: linear-gradient(135deg, var(--primary-purple), #60A5FA);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .descriptive-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
            align-items: center;
        }

        .descriptive-item {
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 25px;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.08), rgba(20, 20, 20, 0.5));
            border: 1px solid rgba(59, 130, 246, 0.2);
            border-radius: 16px;
            transition: all 0.3s ease;
            max-width: 700px;
            width: 100%;
        }

        .descriptive-item:hover {
            transform: translateY(-5px);
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.12), rgba(20, 20, 20, 0.7));
            border-color: rgba(59, 130, 246, 0.4);
            box-shadow: 0 15px 40px rgba(59, 130, 246, 0.15);
        }

        .descriptive-bullet {
            font-size: 1.8rem;
            color: var(--primary-purple);
            flex-shrink: 0;
            margin-top: 2px;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(59, 130, 246, 0.1));
            border-radius: 50%;
        }

        .descriptive-item p {
            margin: 0;
            color: var(--text-secondary);
            font-size: 1.05rem;
            line-height: 1.6;
            font-weight: 400;
        }

        .descriptive-cta {
            margin-top: 50px;
            text-align: center;
        }

        .descriptive-guarantee {
            margin: 15px 0 0 0;
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.9rem;
            font-weight: 500;
            text-align: center;
            letter-spacing: 0.5px;
        }

        .descriptive-guarantee::first-letter {
            color: var(--primary-purple);
            font-weight: 700;
        }

        /* Dernière décision */
        .decision-section {
            position: relative;
            z-index: 2;
            padding: clamp(88px, 11vw, 140px) 0;
            background:
                radial-gradient(circle at 50% 10%, rgba(59, 130, 246, 0.12), transparent 34%),
                linear-gradient(180deg, rgba(7, 12, 24, 0.42), rgba(10, 15, 31, 0.96));
        }

        .decision-shell {
            max-width: 980px;
            margin: 0 auto;
        }

        .decision-kicker,
        .decision-block-label {
            display: block;
            margin: 0 0 10px;
            color: #60a5fa;
            font-size: 0.74rem;
            font-weight: 800;
            letter-spacing: 0.11em;
            text-transform: uppercase;
        }

        .decision-kicker {
            text-align: center;
        }

        .decision-title {
            margin-bottom: clamp(24px, 4vw, 38px);
        }

        .decision-title #pdv-rounded-minutes {
            color: #f8fafc;
            text-shadow: 0 0 24px rgba(96, 165, 250, 0.3);
        }

        .decision-intro {
            max-width: 760px;
            margin: 0 auto clamp(42px, 6vw, 64px);
            text-align: center;
        }

        .decision-intro p {
            margin: 0;
            color: rgba(203, 213, 225, 0.76);
            font-size: clamp(1rem, 1.6vw, 1.16rem);
            line-height: 1.72;
        }

        .decision-intro p + p {
            margin-top: 12px;
        }

        .decision-intro strong {
            color: #f8fafc;
        }

        .decision-disqualify,
        .decision-six-weeks,
        .decision-answer {
            border: 1px solid rgba(96, 165, 250, 0.18);
            border-radius: 22px;
            background: linear-gradient(145deg, rgba(15, 23, 42, 0.94), rgba(8, 15, 30, 0.92));
            box-shadow: 0 24px 70px rgba(2, 6, 23, 0.24);
        }

        .decision-disqualify {
            padding: clamp(26px, 4.5vw, 46px);
        }

        .decision-disqualify h3,
        .decision-six-weeks h3,
        .decision-answer h3 {
            margin: 0;
            color: #f8fafc;
            font-size: clamp(1.28rem, 2.4vw, 1.8rem);
            line-height: 1.25;
        }

        .decision-disqualify-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin-top: clamp(22px, 3.5vw, 32px);
        }

        .decision-disqualify-grid article {
            min-height: 100%;
            padding: 18px;
            border: 1px solid rgba(248, 113, 113, 0.14);
            border-radius: 15px;
            background: rgba(127, 29, 29, 0.08);
        }

        .decision-disqualify-grid article > span {
            display: block;
            margin-bottom: 12px;
            color: #f87171;
            font-size: 0.72rem;
            font-weight: 900;
            letter-spacing: 0.08em;
        }

        .decision-disqualify-grid p,
        .decision-path p,
        .decision-answer p {
            margin: 0;
            color: rgba(203, 213, 225, 0.75);
            font-size: 0.95rem;
            line-height: 1.62;
        }

        .decision-verdict {
            margin: clamp(24px, 3.5vw, 32px) 0 0;
            padding-top: 22px;
            border-top: 1px solid rgba(148, 163, 184, 0.14);
            color: rgba(226, 232, 240, 0.8);
            font-size: clamp(1rem, 1.5vw, 1.1rem);
            line-height: 1.65;
        }

        .decision-verdict strong {
            color: #f8fafc;
        }

        .decision-six-weeks {
            margin-top: 18px;
            padding: clamp(26px, 4.5vw, 46px);
        }

        .decision-paths {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
            margin-top: 24px;
        }

        .decision-path {
            padding: clamp(18px, 2.8vw, 24px);
            border-radius: 16px;
        }

        .decision-path > span {
            display: block;
            margin-bottom: 8px;
            color: #f8fafc;
            font-size: 1rem;
            font-weight: 800;
        }

        .decision-path--muted {
            border: 1px solid rgba(148, 163, 184, 0.13);
            background: rgba(15, 23, 42, 0.54);
        }

        .decision-path--active {
            border: 1px solid rgba(96, 165, 250, 0.34);
            background: linear-gradient(135deg, rgba(37, 99, 235, 0.16), rgba(59, 130, 246, 0.07));
        }

        .decision-answers {
            display: grid;
            gap: 18px;
            margin-top: clamp(30px, 5vw, 48px);
        }

        .decision-answer {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            gap: clamp(18px, 3vw, 30px);
            padding: clamp(26px, 4.5vw, 44px);
        }

        .decision-answer-number {
            display: grid;
            place-items: center;
            width: 42px;
            height: 42px;
            border: 1px solid rgba(96, 165, 250, 0.34);
            border-radius: 50%;
            color: #93c5fd;
            font-size: 0.78rem;
            font-weight: 900;
        }

        .decision-answer h3 {
            margin-bottom: 16px;
        }

        .decision-answer p + p {
            margin-top: 12px;
        }

        .decision-answer strong {
            color: #f8fafc;
        }

        .decision-answer a {
            color: #60a5fa;
        }

        .decision-legal-link {
            display: inline-block;
            margin-top: 18px;
            font-size: 0.84rem;
            font-weight: 700;
        }

        .decision-start-steps {
            display: grid;
            gap: 10px;
        }

        .decision-start-steps > div {
            display: grid;
            grid-template-columns: 30px minmax(0, 1fr);
            gap: 12px;
            align-items: start;
            padding: 14px 15px;
            border: 1px solid rgba(96, 165, 250, 0.12);
            border-radius: 13px;
            background: rgba(59, 130, 246, 0.045);
        }

        .decision-start-steps > div > span {
            display: grid;
            place-items: center;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(59, 130, 246, 0.15);
            color: #93c5fd;
            font-size: 0.72rem;
            font-weight: 900;
        }

        .decision-start-close {
            margin-top: 18px !important;
            color: #bfdbfe !important;
            font-weight: 750;
        }

        .final-enrollment-section {
            padding-bottom: clamp(72px, 9vw, 110px);
        }

        .final-enrollment-title {
            max-width: 940px;
            margin-right: auto;
            margin-left: auto;
        }

        .final-countdown-block {
            max-width: 720px;
            margin: clamp(30px, 5vw, 52px) auto clamp(50px, 7vw, 76px);
        }

        .final-formules-heading {
            max-width: 720px;
            margin: 0 auto 30px;
        }

        .final-formules-heading > span {
            display: block;
            margin-bottom: 8px;
            color: #f8fafc;
            font-size: clamp(1.5rem, 3vw, 2.15rem);
            font-weight: 850;
        }

        .final-formules-heading p {
            margin: 0;
            color: rgba(203, 213, 225, 0.7);
            line-height: 1.6;
        }

        #final-formules-mount {
            max-width: 1080px;
            margin: 0 auto;
            text-align: left;
        }

        #final-formules-mount .xmen-promo-banner {
            margin-top: 0;
        }

        .final-support-card {
            max-width: 780px;
            margin: clamp(42px, 7vw, 70px) auto 0;
            padding: 20px 24px;
            border: 1px solid rgba(96, 165, 250, 0.2);
            border-radius: 16px;
            background: rgba(15, 23, 42, 0.72);
            text-align: center;
        }

        .final-support-card p {
            margin: 0;
            color: rgba(226, 232, 240, 0.76);
            line-height: 1.6;
        }

        .final-support-card a,
        .final-support-card strong {
            color: #f8fafc;
            font-weight: 800;
        }

        .final-support-card a {
            text-decoration-color: rgba(96, 165, 250, 0.6);
            text-underline-offset: 3px;
        }

        @media (max-width: 760px) {
            .decision-disqualify-grid,
            .decision-paths {
                grid-template-columns: 1fr;
            }

            .decision-answer {
                grid-template-columns: 1fr;
            }

            .decision-answer-number {
                width: 36px;
                height: 36px;
            }
        }

        /* FAQ Section */
        .faq-section {
            padding: 120px 0;
            background: var(--card-bg);
            position: relative;
            z-index: 2;
        }

        .faq-container {
            max-width: 800px;
            margin: 0 auto;
        }


        .faq-item {
            background: linear-gradient(135deg, var(--darker-bg) 0%, rgba(20, 20, 20, 0.95) 100%);
            border: 1px solid rgba(59, 130, 246, 0.15);
            border-radius: 16px;
            margin-bottom: 20px;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .faq-item:hover {
            border-color: rgba(59, 130, 246, 0.3);
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.08);
            transform: translateY(-1px);
        }

        .faq-item.active {
            border-color: rgba(59, 130, 246, 0.4);
            box-shadow: 0 6px 20px rgba(59, 130, 246, 0.1);
        }

        .faq-question {
            padding: 30px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
            position: relative;
        }

        .faq-question:hover {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.08), rgba(59, 130, 246, 0.02));
        }

        .faq-question span {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        .faq-toggle {
            color: var(--primary-purple);
            font-size: 1.5rem;
            font-weight: 700;
            transition: all 0.3s ease;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(59, 130, 246, 0.1);
            border-radius: 8px;
            border: 1px solid rgba(59, 130, 246, 0.2);
        }

        .faq-question:hover .faq-toggle {
            background: rgba(59, 130, 246, 0.2);
            border-color: rgba(59, 130, 246, 0.4);
            transform: scale(1.05);
        }

        .faq-item.active .faq-toggle {
            transform: rotate(45deg);
        }

        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: all 0.4s ease;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.03), rgba(59, 130, 246, 0.01));
            border-top: 1px solid rgba(59, 130, 246, 0.1);
        }

        .faq-answer.active {
            max-height: 600px;
            padding-top: 20px;
        }

        .faq-answer p {
            padding: 0 30px 30px;
            color: var(--text-secondary);
            line-height: 1.7;
            margin: 0;
            font-size: 1rem;
        }

        /* Final CTA Section */
        .final-cta-section {
            padding: 120px 0;
            background: radial-gradient(ellipse at center, rgba(59, 130, 246, 0.1) 0%, transparent 50%);
            text-align: center;
            position: relative;
            z-index: 2;
