        /* counter-label garde le même style blanc en sold-out */

        /* URGENCY METER - VISUAL PROGRESS */
        .urgency-meter {
            margin-bottom: 30px;
        }

        .meter-container {
            width: 100%;
            height: 12px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 25px;
