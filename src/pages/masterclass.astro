---
import GAConsentMode from '../components/GAConsentMode.astro';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#07162f" />
    <title>Liste d’attente — Masterclass Esprit Subconscient 2.0</title>
    <meta
      name="description"
      content="Rejoins la liste d’attente de la nouvelle masterclass Esprit Subconscient 2.0."
    />
    <link rel="canonical" href="https://sonnycourt.com/masterclass/" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <GAConsentMode performanceMode />
    <script is:inline>
      (function(c,l,a,r,i){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        function loadClarity(){
          if(l.querySelector('script[data-sonny-clarity]')) return;
          var t=l.createElement(r);
          t.async=1;
          t.dataset.sonnyClarity='true';
          t.src='https://www.clarity.ms/tag/'+i;
          l.head.appendChild(t);
        }
        if(l.readyState==='complete') c.setTimeout(loadClarity,800);
        else c.addEventListener('load',function(){c.setTimeout(loadClarity,800)},{once:true});
      })(window,document,'clarity','script','wkawxw5jtq');
    </script>
    <style>
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400 800;
        font-display: swap;
        src: url('/fonts/inter-latin.woff2') format('woff2');
      }

      :root {
        color-scheme: dark;
        --blue: #2582f5;
        --blue-light: #69a9ff;
        --ink: #07162f;
        --panel: rgba(10, 30, 63, 0.9);
        --line: rgba(124, 176, 255, 0.26);
        --muted: rgba(235, 243, 255, 0.72);
      }

      * { box-sizing: border-box; }

      html { min-height: 100%; }

      body {
        min-height: 100vh;
        margin: 0;
        font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: #fff;
        background:
          radial-gradient(circle at 18% 8%, rgba(37, 130, 245, 0.26), transparent 34rem),
          radial-gradient(circle at 84% 88%, rgba(65, 99, 220, 0.18), transparent 28rem),
          linear-gradient(145deg, #040b18 0%, #07162f 55%, #061126 100%);
      }

      body::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.3;
        background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
        background-size: 48px 48px;
        mask-image: linear-gradient(to bottom, black, transparent 82%);
      }

      .page {
        position: relative;
        min-height: 100vh;
        display: grid;
        grid-template-rows: auto 1fr auto;
        width: min(100% - 32px, 1120px);
        margin: 0 auto;
      }

      header {
        display: flex;
        align-items: center;
        min-height: 86px;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: .16em;
      }

      main {
        display: grid;
        place-items: center;
        padding: 32px 0 56px;
      }

      .card {
        position: relative;
        width: min(100%, 640px);
        padding: clamp(28px, 6vw, 56px);
        border: 1px solid var(--line);
        border-radius: 28px;
        background: linear-gradient(150deg, rgba(16, 44, 88, .94), rgba(7, 23, 51, .96));
        box-shadow: 0 36px 90px rgba(0, 0, 0, .38), inset 0 1px rgba(255,255,255,.06);
        overflow: hidden;
      }

      .card::after {
        content: '';
        position: absolute;
        width: 280px;
        height: 280px;
        right: -150px;
        top: -160px;
        border-radius: 50%;
        background: rgba(37, 130, 245, .25);
        filter: blur(16px);
        pointer-events: none;
      }

      .eyebrow {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin: 0 0 20px;
        color: #9ec9ff;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
      }

      .eyebrow::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--blue-light);
        box-shadow: 0 0 18px rgba(105,169,255,.8);
      }

      h1 {
        position: relative;
        z-index: 1;
        max-width: 540px;
        margin: 0;
        font-size: clamp(34px, 7vw, 58px);
        line-height: .98;
        letter-spacing: -.045em;
      }

      .intro {
        position: relative;
        z-index: 1;
        max-width: 520px;
        margin: 24px 0 32px;
        color: var(--muted);
        font-size: clamp(16px, 2.4vw, 19px);
        line-height: 1.6;
      }

      form {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 16px;
      }

      .fields {
        display: grid;
        grid-template-columns: .8fr 1.2fr;
        gap: 12px;
      }

      label {
        display: grid;
        gap: 8px;
        color: rgba(255,255,255,.82);
        font-size: 13px;
        font-weight: 700;
      }

      input {
        width: 100%;
        min-height: 54px;
        padding: 0 16px;
        border: 1px solid rgba(146, 187, 245, .28);
        border-radius: 12px;
        outline: none;
        background: rgba(2, 13, 33, .7);
        color: #fff;
        font: inherit;
        transition: border-color .16s ease, box-shadow .16s ease;
      }

      input::placeholder { color: rgba(231,240,255,.38); }

      input:focus {
        border-color: var(--blue-light);
        box-shadow: 0 0 0 4px rgba(55, 137, 245, .16);
      }

      .trap {
        position: absolute !important;
        left: -10000px !important;
        width: 1px !important;
        height: 1px !important;
        overflow: hidden !important;
      }

      button {
        min-height: 58px;
        border: 0;
        border-radius: 13px;
        color: #fff;
        background: linear-gradient(110deg, #2582f5, #4c73e5);
        box-shadow: 0 14px 34px rgba(37,130,245,.25);
        font: inherit;
        font-size: 14px;
        font-weight: 800;
        letter-spacing: .02em;
        cursor: pointer;
        transition: transform .16s ease, filter .16s ease;
      }

      button:hover { transform: translateY(-1px); filter: brightness(1.07); }
      button:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
      button:disabled { cursor: wait; opacity: .68; transform: none; }

      .privacy {
        margin: 0;
        color: rgba(235,243,255,.52);
        font-size: 12px;
        line-height: 1.5;
        text-align: center;
      }

      .privacy a { color: inherit; }

      .message {
        display: none;
        margin: 0;
        padding: 14px 16px;
        border-radius: 12px;
        font-size: 14px;
        line-height: 1.45;
      }

      .message.is-visible { display: block; }
      .message.success { color: #d6ffec; background: rgba(24, 152, 98, .18); border: 1px solid rgba(67, 217, 155, .32); }
      .message.error { color: #ffe2e5; background: rgba(219, 57, 79, .16); border: 1px solid rgba(255, 110, 129, .34); }

      footer {
        display: flex;
        justify-content: center;
        gap: 18px;
        flex-wrap: wrap;
        padding: 0 0 28px;
        color: rgba(235,243,255,.46);
        font-size: 12px;
      }

      footer a { color: inherit; text-decoration: none; }
      footer a:hover { color: #fff; }

      @media (max-width: 620px) {
        .page { width: min(100% - 22px, 1120px); }
        header { min-height: 68px; }
        main { padding: 14px 0 34px; }
        .card { border-radius: 21px; padding: 28px 20px 24px; }
        .fields { grid-template-columns: 1fr; }
        h1 { font-size: clamp(36px, 12vw, 48px); }
        .intro { margin: 20px 0 28px; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header>SONNY COURT</header>
      <main>
        <section class="card" aria-labelledby="waitlist-title">
          <p class="eyebrow">Masterclass Esprit Subconscient 2.0</p>
          <h1 id="waitlist-title">La nouvelle masterclass arrive.</h1>
          <p class="intro">
            Les inscriptions sont temporairement fermées pendant que nous finalisons une nouvelle version.
            Rejoins la liste d’attente pour être prévenu(e) dès la réouverture.
          </p>

          <form id="waitlist-form" novalidate>
            <div class="fields">
              <label>
                Prénom
                <input name="prenom" type="text" autocomplete="given-name" maxlength="120" placeholder="Ton prénom" required />
              </label>
              <label>
                Email
                <input name="email" type="email" autocomplete="email" inputmode="email" maxlength="320" placeholder="ton@email.com" required />
              </label>
            </div>
            <label class="trap" aria-hidden="true">
              Entreprise
              <input name="company" type="text" tabindex="-1" autocomplete="off" />
            </label>
            <button type="submit">JE REJOINS LA LISTE D’ATTENTE</button>
            <p id="waitlist-message" class="message" role="status" aria-live="polite"></p>
            <p class="privacy">
              Tu recevras les informations de réouverture par email. En t’inscrivant, tu acceptes notre
              <a href="/confidentialite/">politique de confidentialité</a>.
            </p>
          </form>
        </section>
      </main>
      <footer>
        <span>© {new Date().getFullYear()} Sonny Court</span>
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/confidentialite/">Confidentialité</a>
      </footer>
    </div>

    <script>
      const form = document.querySelector('#waitlist-form');
      const message = document.querySelector('#waitlist-message');
      const submit = form?.querySelector('button[type="submit"]');

      function showMessage(text, type) {
        if (!(message instanceof HTMLElement)) return;
        message.textContent = text;
        message.className = `message is-visible ${type}`;
      }

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!(form instanceof HTMLFormElement) || !(submit instanceof HTMLButtonElement)) return;

        const data = new FormData(form);
        const prenom = String(data.get('prenom') || '').trim();
        const email = String(data.get('email') || '').trim().toLowerCase();
        const company = String(data.get('company') || '').trim();

        if (!prenom || !email || !email.includes('@')) {
          showMessage('Entre ton prénom et une adresse email valide.', 'error');
          return;
        }

        submit.disabled = true;
        const previousLabel = submit.textContent;
        submit.textContent = 'INSCRIPTION EN COURS…';

        try {
          const response = await fetch('/.netlify/functions/masterclass-waitlist', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prenom, email, company }),
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok || payload?.success !== true) throw new Error('waitlist_failed');

          form.reset();
          showMessage('C’est bon, tu es sur la liste. On te préviendra dès la réouverture.', 'success');
          submit.textContent = 'INSCRIPTION CONFIRMÉE';
        } catch {
          showMessage('L’inscription n’a pas abouti. Réessaie dans quelques instants.', 'error');
          submit.disabled = false;
          submit.textContent = previousLabel;
        }
      });
    </script>
  </body>
</html>
