---
// New-offer terms only. Historical /cgv/ and already accepted contracts are unchanged.
const { Content, getHeadings, frontmatter } = await import('../../../drafts/mc2-cgv-2026-09-v7.md');
const sections = getHeadings().filter((heading) => heading.depth === 2);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>CGV — Esprit Subconscient 2.0 · Nouvelle offre</title>
    <style is:global>
      :root { color-scheme: light; --ink: #16283e; --muted: #536478; --blue: #185de0; }
      * { box-sizing: border-box; }
      html { scroll-padding-top: 28px; }
      body { margin: 0; background: #eef2f7; color: var(--ink); font: 16px/1.75 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
      a { color: var(--blue); text-underline-offset: 3px; }
      a:focus-visible, summary:focus-visible { outline: 3px solid #2563eb; outline-offset: 4px; border-radius: 3px; }
      .review-notice { margin: 0; padding: 12px 24px; background: #fff3d4; color: #624718; border-bottom: 1px solid #e4d1a0; text-align: center; font-size: 13px; line-height: 1.55; }
      .hero { padding: 50px 24px 44px; color: #fff; background: #0c1b30; }
      .hero-inner { max-width: 1160px; margin: auto; }
      .eyebrow { color: #91bbff; margin: 0 0 14px; font-size: 12px; font-weight: 750; letter-spacing: .09em; text-transform: uppercase; }
      h1 { max-width: 780px; margin: 0 0 16px; font-size: clamp(29px, 4vw, 44px); line-height: 1.17; letter-spacing: -.035em; }
      .hero-copy { max-width: 770px; color: #c0d0e4; margin: 0; }
      .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 23px; }
      .tags span { padding: 6px 11px; border: 1px solid #345077; border-radius: 6px; color: #dbeafe; font-size: 12px; }
      .layout { display: grid; grid-template-columns: 244px minmax(0, 1fr); gap: 34px; max-width: 1208px; padding: 34px 24px 70px; margin: auto; align-items: start; }
      aside { position: sticky; top: 24px; max-height: calc(100dvh - 48px); overflow-y: auto; padding-right: 10px; }
      aside h2, .mobile-contents summary { margin: 0 0 14px; font-size: 13px; font-weight: 750; text-transform: uppercase; letter-spacing: .055em; }
      .contents { list-style: none; padding: 0; margin: 0; }
      .contents li + li { margin-top: 9px; }
      .contents a { display: block; color: #41546c; text-decoration: none; font-size: 13px; line-height: 1.5; padding: 4px 0; }
      .contents a:hover { color: var(--blue); }
      .mobile-contents { display: none; }
      article { min-width: 0; padding: 38px 44px 46px; background: #fff; border: 1px solid #dbe3ed; border-radius: 14px; box-shadow: 0 7px 25px #10234205; }
      .document-meta { margin: 0 0 25px; padding-bottom: 20px; border-bottom: 1px solid #e4eaf2; color: var(--muted); font-size: 12px; overflow-wrap: anywhere; }
      .terms { overflow-wrap: anywhere; }
      .terms h2 { color: #12325b; font-size: 25px; line-height: 1.3; letter-spacing: -.02em; margin: 48px 0 19px; padding-top: 25px; border-top: 1px solid #e2e8f0; }
      .terms h2:first-child { margin-top: 0; border: 0; padding: 0; }
      .terms h3 { font-size: 18px; line-height: 1.4; margin: 26px 0 13px; color: #1e4575; }
      .terms p { margin: 0 0 17px; }
      .terms ul { padding-left: 23px; margin: 16px 0 23px; }
      .terms li { padding-left: 3px; margin: 8px 0; }
      .terms strong { color: #122b4a; font-weight: 700; }
      .terms table { width: 100%; table-layout: fixed; margin: 22px 0; border-collapse: collapse; font-size: 13px; line-height: 1.55; }
      .terms th, .terms td { border: 1px solid #dbe4ef; padding: 12px 10px; vertical-align: top; text-align: left; }
      .terms th { background: #eaf2ff; color: #153d71; font-weight: 700; }
      .terms tr:nth-child(even) td { background: #f8fafd; }
      .review-footer { padding-top: 32px; margin-top: 40px; border-top: 1px solid #e4eaf2; color: var(--muted); font-size: 12px; }
      @media (max-width: 900px) {
        .layout { grid-template-columns: minmax(0, 1fr); max-width: 820px; gap: 0; }
        aside { display: none; }
        .mobile-contents { display: block; border: 1px solid #dbe3ed; background: #f8fafd; border-radius: 8px; padding: 17px 18px; margin-bottom: 26px; }
        .mobile-contents summary { margin: 0; cursor: pointer; }
        .mobile-contents[open] .contents { margin-top: 16px; }
      }
      @media (max-width: 560px) {
        body { font-size: 15px; line-height: 1.7; }
        .review-notice { text-align: left; padding: 11px 18px; }
        .hero { padding: 32px 20px; }
        .hero-copy { font-size: 14px; }
        .layout { padding: 18px 10px 40px; }
        article { padding: 24px 18px 30px; border-radius: 10px; }
        .terms h2 { font-size: 22px; margin-top: 36px; }
        .terms table { display: block; overflow-x: auto; table-layout: auto; }
        .terms th, .terms td { min-width: 120px; padding: 10px 9px; }
        .terms th:first-child, .terms td:first-child { min-width: 158px; }
      }
      @media print {
        body { background: white; font-size: 10pt; }
        .review-notice { background: none; color: #333; }
        .hero { background: none; color: #111; padding: 20px 0; }
        .eyebrow, .hero-copy { color: #444; }
        h1 { font-size: 26pt; }
        .tags, aside, .mobile-contents { display: none; }
        .layout { display: block; padding: 0; max-width: none; }
        article { border: 0; padding: 0; box-shadow: none; }
        .terms h2 { font-size: 16pt; break-after: avoid; }
        .terms h3, .terms th { break-after: avoid; }
        .terms table { display: table; font-size: 9pt; }
        .terms th, .terms td { min-width: 0; }
        a { color: inherit; }
      }
    </style>
  </head>
  <body>
    <p class="review-notice">Ces conditions concernent exclusivement les commandes qui désignent cette version avant leur validation. Les contrats déjà conclus restent inchangés.</p>
    <header class="hero">
      <div class="hero-inner">
        <p class="eyebrow">Esprit Subconscient 2.0 · Nouvelle offre</p>
        <h1>Conditions générales<br />de vente</h1>
        <p class="hero-copy">Parcours annuel, paiement différé de sept jours, services inclus et Garantie Manifestation.</p>
        <div class="tags" aria-label="Principaux repères">
          <span>12 mois d’engagement</span><span>Sans reconduction</span><span>Morpho : 2 ans</span><span>Garantie : 6 mois</span>
        </div>
      </div>
    </header>
    <div class="layout">
      <aside aria-label="Sommaire">
        <h2>Dans ce document</h2>
        <ol class="contents">{sections.map((section) => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol>
      </aside>
      <main>
        <article aria-label="Conditions générales de vente">
          <p class="document-meta">Version : {frontmatter.version} · Mise à jour le {frontmatter.reviewDate}.</p>
          <details class="mobile-contents">
            <summary>Sommaire des 18 articles</summary>
            <ol class="contents">{sections.map((section) => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol>
          </details>
          <div class="terms"><Content /></div>
          <footer class="review-footer">Pour les autres offres et les commandes qui les désignent, consulte les <a href="/cgv/">conditions générales correspondantes</a>. La version acceptée à la commande reste applicable.</footer>
        </article>
      </main>
    </div>
  </body>
</html>
