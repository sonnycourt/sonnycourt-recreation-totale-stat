---
import GAConsentMode from '../../components/GAConsentMode.astro';
import Mc2SafetyGuard from '../../components/Mc2SafetyGuard.astro';
import Mc2AccessGate from '../../components/Mc2AccessGate.astro';
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Inscription confirmée — Masterclass Esprit Subconscient 2.0</title>
    <meta name="description" content="Ta place est réservée. Prépare-toi et rejoins ta session au moment choisi." />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <GAConsentMode performanceMode />
    <Mc2SafetyGuard />
    <style>
        @font-face {
            font-family: Inter;
            font-style: normal;
            font-weight: 400 800;
            font-display: swap;
            src: url('/fonts/inter-latin.woff2') format('woff2');
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --blue: #3b82f6;
            --blue-light: #93c5fd;
            --orange: #fb923c;
            --green: #4ade80;
            --ink: #070b18;
            --muted: rgba(255, 255, 255, 0.68);
        }

        body {
            min-height: 100vh;
            overflow-x: hidden;
            font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            color: #fff;
            background: var(--ink);
        }

        body::before {
            position: fixed;
            inset: 0;
            z-index: -2;
            content: '';
            background:
                radial-gradient(circle at 12% 0%, rgba(37, 99, 235, 0.34), transparent 38%),
                radial-gradient(circle at 92% 34%, rgba(251, 146, 60, 0.1), transparent 30%),
                linear-gradient(180deg, #0b1634 0%, #080b18 55%, #050710 100%);
        }

        body::after {
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            content: '';
            opacity: 0.16;
            background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
            background-size: 42px 42px;
            mask-image: linear-gradient(to bottom, black, transparent 70%);
        }

        .shell {
            width: min(100% - 30px, 760px);
            margin: 0 auto;
            padding: 30px 0 64px;
        }

        .preview-banner {
            display: none;
            margin-bottom: 14px;
            padding: 8px 12px;
            border: 1px solid rgba(251, 146, 60, 0.4);
            border-radius: 10px;
            color: #fed7aa;
            background: rgba(124, 45, 18, 0.22);
            text-align: center;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .preview-banner.is-visible { display: block; }

        .confetti-canvas {
            position: fixed;
            inset: 0;
            z-index: 9998;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        .confirmation-head {
            text-align: center;
            margin-bottom: 22px;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 15px;
            padding: 8px 14px;
            border: 1px solid rgba(74, 222, 128, 0.35);
            border-radius: 999px;
            color: #bbf7d0;
            background: rgba(34, 197, 94, 0.1);
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .badge-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 14px rgba(74, 222, 128, 0.8);
        }

        h1 {
            max-width: 680px;
            margin: 0 auto 12px;
            font-size: clamp(2rem, 6vw, 3.35rem);
            font-weight: 800;
            line-height: 1.04;
            letter-spacing: -0.045em;
        }

        .subtitle {
            color: var(--muted);
            font-size: clamp(0.98rem, 2vw, 1.12rem);
            line-height: 1.55;
        }

        .session-card,
        .content-card {
            margin-bottom: 16px;
            border: 1px solid rgba(96, 165, 250, 0.24);
            border-radius: 20px;
            background: linear-gradient(145deg, rgba(17, 30, 62, 0.86), rgba(8, 12, 28, 0.92));
            box-shadow: inset 0 1px 0 rgba(255,255,255,.045), 0 24px 70px rgba(0,0,0,.28);
        }

        .session-card {
            position: relative;
            overflow: hidden;
            padding: 24px;
            text-align: center;
        }

        .session-kicker {
            position: relative;
            margin-bottom: 8px;
            color: #fdba74;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.11em;
            text-transform: uppercase;
        }

        .session-time {
            position: relative;
            margin-bottom: 5px;
            font-size: clamp(1.38rem, 4vw, 2rem);
            font-weight: 800;
        }

        .timezone {
            position: relative;
            color: rgba(255,255,255,.52);
            font-size: 0.76rem;
        }

        .countdown {
            position: relative;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 9px;
            width: min(100%, 390px);
            margin: 20px auto 16px;
        }

        .count-box {
            padding: 13px 8px;
            border: 1px solid rgba(96, 165, 250, 0.34);
            border-radius: 13px;
            background: linear-gradient(180deg, rgba(37, 99, 235, .22), rgba(15, 23, 42, .62));
            box-shadow: inset 0 1px 0 rgba(255,255,255,.055);
        }

        .count-number {
            display: block;
            font-variant-numeric: tabular-nums;
            color: #eff6ff;
            font-size: clamp(1.35rem, 5vw, 2rem);
            font-weight: 800;
            line-height: 1;
        }

        .count-label {
            display: block;
            margin-top: 6px;
            color: #93c5fd;
            font-size: 0.58rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .join-button {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: min(100%, 460px);
            min-height: 54px;
            margin: 0 auto;
            padding: 14px 20px;
            border: 0;
            border-radius: 13px;
            color: #fff;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            box-shadow: 0 12px 34px rgba(37, 99, 235, 0.34);
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 800;
            letter-spacing: 0.02em;
            transition: transform .18s ease, opacity .18s ease;
        }

        .join-button:not(.is-locked):hover { transform: translateY(-2px); }

        .join-button.is-locked {
            opacity: 0.46;
            cursor: not-allowed;
            box-shadow: none;
        }

        .access-note {
            position: relative;
            margin-top: 10px;
            color: rgba(255,255,255,.5);
            font-size: 0.72rem;
        }

        .session-summary {
            position: relative;
            margin-top: 11px;
            color: rgba(255,255,255,.62);
            font-size: .75rem;
            font-weight: 600;
            line-height: 1.4;
        }

        .content-card { padding: 22px; }

        .workbook-card {
            display: block;
            margin-bottom: 16px;
            padding: 20px;
            border: 1px solid rgba(96, 165, 250, 0.24);
            border-radius: 20px;
            background: linear-gradient(145deg, rgba(17, 30, 62, 0.86), rgba(8, 12, 28, 0.92));
            box-shadow: inset 0 1px 0 rgba(255,255,255,.05), 0 22px 65px rgba(0,0,0,.3);
        }

        .workbook-cover {
            display: block;
            width: min(100%, 220px);
            max-height: 312px;
            margin: 0 auto 17px;
            object-fit: contain;
            filter: drop-shadow(0 14px 22px rgba(0,0,0,.34));
        }

        .workbook-kicker {
            margin-bottom: 6px;
            color: #fdba74;
            font-size: 0.66rem;
            font-weight: 800;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .workbook-card h2 {
            margin-bottom: 7px;
            font-size: clamp(1.16rem, 3vw, 1.42rem);
        }

        .workbook-copy {
            margin-bottom: 14px;
            color: var(--muted);
            font-size: 0.83rem;
            line-height: 1.5;
        }

        .workbook-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: min(100%, 460px);
            min-height: 54px;
            margin: 0 auto;
            padding: 14px 20px;
            border-radius: 13px;
            color: #fff;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            box-shadow: 0 12px 34px rgba(37, 99, 235, 0.28);
            text-align: center;
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 850;
            letter-spacing: 0.02em;
        }

        .workbook-fallback {
            margin-top: 11px;
            color: rgba(255,255,255,.65);
            text-align: center;
            font-size: .76rem;
            line-height: 1.4;
        }

        .content-card h2 {
            margin-bottom: 7px;
            font-size: clamp(1.18rem, 3vw, 1.45rem);
        }

        .card-intro {
            margin-bottom: 17px;
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.55;
        }

        .video-frame {
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(96, 165, 250, 0.18);
            border-radius: 15px;
            background: #000;
            box-shadow: 0 16px 45px rgba(0,0,0,.34);
        }

        .video-frame video {
            display: block;
            width: 100%;
            aspect-ratio: 16 / 9;
            object-fit: cover;
        }

        .video-frame::after {
            position: absolute;
            right: 0;
            bottom: 0;
            left: 0;
            height: 38%;
            pointer-events: none;
            content: '';
            background: linear-gradient(transparent, rgba(2, 6, 23, .86));
        }

        .video-start {
            position: absolute;
            top: 50%;
            left: 50%;
            z-index: 3;
            display: grid;
            grid-template-columns: 48px auto;
            gap: 11px;
            align-items: center;
            min-height: 64px;
            padding: 8px 20px 8px 9px;
            border: 1px solid rgba(255,255,255,.34);
            border-radius: 999px;
            color: #fff;
            background: linear-gradient(145deg, rgba(30, 64, 175, .88), rgba(15, 23, 42, .9));
            box-shadow: inset 0 1px 0 rgba(255,255,255,.2), 0 18px 50px rgba(2, 6, 23, .5);
            backdrop-filter: blur(15px) saturate(135%);
            transform: translate(-50%, -50%);
            cursor: pointer;
            font: inherit;
            font-size: .78rem;
            font-weight: 800;
            letter-spacing: .035em;
            white-space: nowrap;
            transition: opacity .2s ease, transform .2s ease;
        }

        .video-start.is-hidden {
            opacity: 0;
            pointer-events: none;
            transform: translate(-50%, -50%) scale(.94);
        }

        .video-start-icon {
            display: grid;
            width: 48px;
            height: 48px;
            place-items: center;
            border-radius: 50%;
            color: #1d4ed8;
            background: #fff;
            box-shadow: 0 9px 24px rgba(255,255,255,.18);
        }

        .video-start-icon svg { width: 20px; height: 20px; margin-left: 3px; }

        .video-unmute {
            position: absolute;
            top: 14px;
            right: 14px;
            z-index: 4;
            min-height: 37px;
            padding: 8px 12px;
            border: 1px solid rgba(255,255,255,.3);
            border-radius: 999px;
            color: #fff;
            background: rgba(15, 23, 42, .76);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.12);
            backdrop-filter: blur(12px);
            cursor: pointer;
            font: inherit;
            font-size: .68rem;
            font-weight: 800;
        }

        .video-controls {
            position: absolute;
            right: 13px;
            bottom: 11px;
            left: 13px;
            z-index: 3;
            display: grid;
            grid-template-columns: 36px minmax(0, 1fr) auto 36px 36px;
            gap: 9px;
            align-items: center;
        }

        .video-control-button {
            display: grid;
            width: 36px;
            height: 36px;
            place-items: center;
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 10px;
            color: #fff;
            background: rgba(15, 23, 42, .66);
            backdrop-filter: blur(10px);
            cursor: pointer;
        }

        .video-control-button svg { width: 16px; height: 16px; }

        .video-control-button [hidden],
        .video-control-button .is-hidden,
        .video-unmute[hidden] {
            display: none;
        }

        .video-progress {
            width: 100%;
            height: 4px;
            accent-color: #60a5fa;
            cursor: pointer;
        }

        .video-time {
            min-width: 78px;
            color: rgba(255,255,255,.8);
            font-size: .65rem;
            font-variant-numeric: tabular-nums;
            text-align: center;
        }

        .video-caption {
            margin-top: 10px;
            color: rgba(255,255,255,.48);
            text-align: center;
            font-size: 0.7rem;
        }

        .prep-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
        }

        .prep-item {
            padding: 15px 13px;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 14px;
            background: rgba(255,255,255,.035);
        }

        .prep-number {
            display: grid;
            width: 27px;
            height: 27px;
            margin-bottom: 10px;
            place-items: center;
            border-radius: 8px;
            color: #dbeafe;
            background: rgba(59, 130, 246, 0.22);
            font-size: 0.75rem;
            font-weight: 800;
        }

        .prep-item strong {
            display: block;
            margin-bottom: 5px;
            font-size: 0.82rem;
        }

        .prep-item p {
            color: rgba(255,255,255,.55);
            font-size: 0.72rem;
            line-height: 1.42;
        }

        .action-row {
            display: grid;
            grid-template-columns: 1fr;
            gap: 10px;
            margin-top: 16px;
        }

        .secondary-button {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 48px;
            padding: 12px 14px;
            border: 1px solid rgba(96,165,250,.3);
            border-radius: 12px;
            color: #dbeafe;
            background: rgba(37,99,235,.12);
            text-align: center;
            text-decoration: none;
            font-size: 0.78rem;
            font-weight: 750;
            cursor: pointer;
        }

        button.secondary-button { width: 100%; }

        .confirmation-head { margin-bottom: 26px; }

        .confirmation-head h1 { margin-bottom: 16px; }

        .steps-heading {
            color: #bfdbfe;
            font-size: clamp(1rem, 2.4vw, 1.18rem);
            font-weight: 800;
            letter-spacing: .02em;
        }

        .step-heading {
            position: relative;
            display: grid;
            grid-template-columns: 46px minmax(0, 1fr);
            gap: 13px;
            align-items: center;
            margin-bottom: 18px;
            text-align: left;
        }

        .step-number {
            display: grid;
            width: 46px;
            height: 46px;
            place-items: center;
            border: 1px solid rgba(147, 197, 253, .5);
            border-radius: 14px;
            color: #fff;
            background: linear-gradient(145deg, #2563eb, #1d4ed8);
            box-shadow: 0 10px 24px rgba(37, 99, 235, .26);
            font-size: 1.18rem;
            font-weight: 800;
        }

        .step-title {
            margin: 0;
            font-size: clamp(1.14rem, 3vw, 1.42rem);
            font-weight: 800;
            line-height: 1.15;
        }

        .content-card h2.step-title,
        .workbook-card h2.step-title { margin: 0; }

        .step-copy {
            margin-top: 5px;
            color: var(--muted);
            font-size: .82rem;
            line-height: 1.4;
        }

        .workbook-card .step-heading { margin-bottom: 14px; }

        .session-card .step-heading { margin-bottom: 21px; }

        @media (max-width: 600px) {
            .shell { width: min(100% - 24px, 760px); padding-top: 18px; }
            .confirmation-head { margin-bottom: 17px; }
            h1 { font-size: clamp(1.9rem, 10vw, 2.55rem); }
            .session-card, .content-card { border-radius: 17px; }
            .session-card { padding: 20px 14px; }
            .content-card { padding: 19px 15px; }
            .step-heading { grid-template-columns: 42px minmax(0, 1fr); gap: 11px; margin-bottom: 15px; }
            .step-number { width: 42px; height: 42px; border-radius: 12px; }
            .workbook-card {
                padding: 16px 14px;
                border-radius: 17px;
            }
            .workbook-cover { width: 170px; max-height: 240px; }
            .workbook-copy { font-size: 0.75rem; }
            .workbook-button { min-height: 54px; padding: 14px 20px; font-size: 0.92rem; }
            .prep-grid { grid-template-columns: 1fr; }
            .prep-item { display: grid; grid-template-columns: 34px 1fr; column-gap: 8px; }
            .prep-number { grid-row: 1 / 3; margin-bottom: 0; }
            .action-row { grid-template-columns: 1fr; }
            .video-start { grid-template-columns: 42px auto; min-height: 56px; padding-right: 16px; font-size: .7rem; }
            .video-start-icon { width: 42px; height: 42px; }
            .video-controls { right: 8px; bottom: 7px; left: 8px; grid-template-columns: 32px minmax(0, 1fr) auto 32px 32px; gap: 5px; }
            .video-control-button { width: 32px; height: 32px; border-radius: 9px; }
            .video-time { min-width: 58px; font-size: .58rem; }
        }
    </style>
</head>
<body>
    <Mc2AccessGate pagePath="/mc2/confirmation/" />
    <canvas id="confetti-canvas" class="confetti-canvas" aria-hidden="true"></canvas>
    <main class="shell">
        <div id="preview-banner" class="preview-banner">Préproduction MC2 — aucune inscription réelle</div>

        <header class="confirmation-head">
            <h1>Ta place est réservée.</h1>
            <p class="steps-heading">3 choses à faire maintenant</p>
        </header>

        <section class="content-card" aria-labelledby="video-title">
            <div class="step-heading">
                <span class="step-number">1</span>
                <div>
                    <h2 id="video-title" class="step-title">Regarde la vidéo maintenant</h2>
                    <p class="step-copy">1 minute. Appuie sur lecture.</p>
                </div>
            </div>
            <div id="confirmation-video-frame" class="video-frame">
                <video id="confirmation-video" playsinline preload="metadata" controlslist="nodownload noremoteplayback" poster="https://vz-601d6eb4-a9a.b-cdn.net/2aca51f9-31cc-4fa9-a147-41472b5b9790/thumbnail.jpg">
                    <source src="https://vz-601d6eb4-a9a.b-cdn.net/2aca51f9-31cc-4fa9-a147-41472b5b9790/play_720p.mp4" type="video/mp4" />
                </video>
                <button id="confirmation-video-start" class="video-start" type="button" aria-label="Lire la vidéo">
                    <span class="video-start-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                    </span>
                    <span>LANCER LA VIDÉO</span>
                </button>
                <button id="confirmation-video-unmute" class="video-unmute" type="button" hidden>ACTIVER LE SON</button>
                <div class="video-controls">
                    <button id="confirmation-video-toggle" class="video-control-button" type="button" aria-label="Lire ou mettre en pause">
                        <svg class="video-icon-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                        <svg class="video-icon-pause is-hidden" viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zm8 0h4v14h-4z" /></svg>
                    </button>
                    <input id="confirmation-video-progress" class="video-progress" type="range" min="0" max="1000" value="0" aria-label="Progression de la vidéo" />
                    <span id="confirmation-video-time" class="video-time">0:00 / 1:49</span>
                    <button id="confirmation-video-mute" class="video-control-button" type="button" aria-label="Activer ou couper le son">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/></svg>
                    </button>
                    <button id="confirmation-video-fullscreen" class="video-control-button" type="button" aria-label="Afficher en plein écran">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
                    </button>
                </div>
            </div>
        </section>

        <section class="workbook-card" aria-labelledby="workbook-title">
            <div class="step-heading">
                <span class="step-number">2</span>
                <div>
                    <h2 id="workbook-title" class="step-title">Imprime ton workbook</h2>
                    <p class="step-copy">Tu vas le remplir pendant la session.</p>
                </div>
            </div>
            <img class="workbook-cover" src="/media/pages/mc2-workbook-mockup-portrait.png" alt="Workbook de la masterclass Esprit Subconscient 2.0" width="600" height="900" />
            <a id="workbook-button" class="workbook-button" href="/media/pages/workbook-masterclass-es2-mc2.pdf" target="_blank" rel="noopener">IMPRIMER MON WORKBOOK</a>
            <p class="workbook-fallback">Pas d’imprimante ? Prends simplement de quoi noter.</p>
        </section>

        <section class="session-card" aria-labelledby="session-step-title">
            <div class="step-heading">
                <span class="step-number">3</span>
                <div>
                    <h2 id="session-step-title" class="step-title">Rejoins ta session</h2>
                </div>
            </div>

            <div class="countdown" aria-live="polite">
                <div class="count-box"><span id="hours" class="count-number">00</span><span class="count-label">Heures</span></div>
                <div class="count-box"><span id="minutes" class="count-number">00</span><span class="count-label">Minutes</span></div>
                <div class="count-box"><span id="seconds" class="count-number">00</span><span class="count-label">Secondes</span></div>
            </div>

            <a id="join-button" class="join-button" href="#">ACCÉDER À MA MASTERCLASS</a>
            <p id="session-heading" class="session-summary">Calcul de ton horaire…</p>
            <p id="access-note" hidden></p>
        </section>
    </main>

    <script>
        // @ts-nocheck
        import { MC2_SESSION_DURATION_MS as SESSION_DURATION_MS } from '../../lib/mc2-timing.mjs';
        (function () {
            const STORAGE_KEY = 'mc2_selected_session_v1';
            const TOKEN_KEY = 'mc2_registration_token';

            function nextQuarterWithLead() {
                const now = Date.now();
                const quarter = 15 * 60 * 1000;
                let target = Math.ceil(now / quarter) * quarter;
                if (target - now < 8 * 60 * 1000) target += quarter;
                return new Date(target);
            }

            function readSession() {
                const params = new URLSearchParams(window.location.search);
                const isPreview = params.get('preview') === 'dev';
                const queryStart = params.get('session_starts_at');
                if (queryStart && Number.isFinite(new Date(queryStart).getTime())) {
                    return {
                        id: params.get('creneau') || 'jit',
                        kind: params.get('slot_kind') || 'jit',
                        startsAt: new Date(queryStart).toISOString(),
                        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'
                    };
                }
                if (!isPreview) {
                    try {
                        const stored = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
                        const storedMs = stored && new Date(stored.startsAt).getTime();
                        if (Number.isFinite(storedMs) && storedMs + SESSION_DURATION_MS > Date.now()) return stored;
                    } catch (error) {}
                }
                const fallback = nextQuarterWithLead();
                return {
                    id: 'jit',
                    kind: 'jit',
                    startsAt: fallback.toISOString(),
                    timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'
                };
            }

            function readToken() {
                if (window.__MC2_ACCESS__) return window.__MC2_ACCESS__.peek();
                const params = new URLSearchParams(window.location.search);
                return (params.get('t') || localStorage.getItem(TOKEN_KEY) || '').trim();
            }

            function trackMc2Event(eventName, meta) {
                const token = readToken();
                if (!token || !eventName) return;
                fetch('/.netlify/functions/track-mc2-event', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        token,
                        event: eventName,
                        meta: Object.assign({ page_path: '/mc2/confirmation/' }, meta || {})
                    }),
                    keepalive: true
                }).catch(function () {});
            }

            let confettiPlayed = false;
            function launchConfetti() {
                if (confettiPlayed) return;
                confettiPlayed = true;
                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

                const canvas = document.getElementById('confetti-canvas');
                const ctx = canvas && canvas.getContext('2d');
                if (!canvas || !ctx) return;

                const particles = [];
                const colors = ['#60a5fa', '#93c5fd', '#f8fafc', '#22c55e', '#f59e0b'];
                const durationMs = 4200;
                const gravity = 0.12;
                const drag = 0.992;
                const start = performance.now();

                function resize() {
                    canvas.width = window.innerWidth;
                    canvas.height = window.innerHeight;
                }
                resize();

                const sideCount = Math.min(110, Math.max(66, Math.floor(window.innerWidth / 13)));
                for (let i = 0; i < sideCount; i++) {
                    const fromLeft = i % 2 === 0;
                    particles.push({
                        x: fromLeft ? -20 - Math.random() * 80 : canvas.width + 20 + Math.random() * 80,
                        y: Math.random() * canvas.height * 0.42,
                        vx: fromLeft ? 2 + Math.random() * 4 : -2 - Math.random() * 4,
                        vy: -1.8 + Math.random() * 2.2,
                        size: 3 + Math.random() * 6,
                        rot: Math.random() * Math.PI,
                        vr: (Math.random() - 0.5) * 0.25,
                        color: colors[(Math.random() * colors.length) | 0],
                        life: 0.75 + Math.random() * 0.9
                    });
                }

                const rainCount = Math.min(130, Math.max(75, Math.floor(window.innerWidth / 11)));
                for (let i = 0; i < rainCount; i++) {
                    particles.push({
                        x: Math.random() * canvas.width,
                        y: -20 - Math.random() * 240,
                        vx: (Math.random() - 0.5) * 1.4,
                        vy: 1.6 + Math.random() * 2.3,
                        size: 2.8 + Math.random() * 5.2,
                        rot: Math.random() * Math.PI,
                        vr: (Math.random() - 0.5) * 0.22,
                        color: colors[(Math.random() * colors.length) | 0],
                        life: 0.95 + Math.random() * 1.05
                    });
                }

                function frame(now) {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    particles.forEach(function (particle) {
                        particle.vx *= drag;
                        particle.vy = particle.vy * drag + gravity;
                        particle.x += particle.vx;
                        particle.y += particle.vy;
                        particle.rot += particle.vr;
                        particle.life -= 0.0062;
                        if (particle.life <= 0 || particle.y > canvas.height + 30) return;
                        ctx.save();
                        ctx.translate(particle.x, particle.y);
                        ctx.rotate(particle.rot);
                        ctx.globalAlpha = Math.max(0, particle.life);
                        ctx.fillStyle = particle.color;
                        ctx.fillRect(-particle.size / 2, -particle.size / 2, particle.size, particle.size * 0.64);
                        ctx.restore();
                    });

                    if (now - start < durationMs) requestAnimationFrame(frame);
                    else {
                        ctx.clearRect(0, 0, canvas.width, canvas.height);
                        window.removeEventListener('resize', resize);
                    }
                }

                window.addEventListener('resize', resize);
                requestAnimationFrame(frame);
            }

            function initConfirmationVideo() {
                const frame = document.getElementById('confirmation-video-frame');
                const video = document.getElementById('confirmation-video');
                const startButton = document.getElementById('confirmation-video-start');
                const startLabel = startButton && startButton.querySelector('span:last-child');
                const toggleButton = document.getElementById('confirmation-video-toggle');
                const playIcon = toggleButton && toggleButton.querySelector('.video-icon-play');
                const pauseIcon = toggleButton && toggleButton.querySelector('.video-icon-pause');
                const progress = document.getElementById('confirmation-video-progress');
                const time = document.getElementById('confirmation-video-time');
                const muteButton = document.getElementById('confirmation-video-mute');
                const unmuteButton = document.getElementById('confirmation-video-unmute');
                const fullscreenButton = document.getElementById('confirmation-video-fullscreen');
                if (!frame || !video || !startButton || !toggleButton || !progress || !time || !muteButton || !unmuteButton || !fullscreenButton) return;

                function formatVideoTime(seconds) {
                    if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
                    const minutes = Math.floor(seconds / 60);
                    return minutes + ':' + String(Math.floor(seconds % 60)).padStart(2, '0');
                }

                function refreshTime() {
                    const duration = Number.isFinite(video.duration) ? video.duration : 0;
                    time.textContent = formatVideoTime(video.currentTime) + ' / ' + formatVideoTime(duration);
                    progress.value = duration > 0 ? String(Math.round((video.currentTime / duration) * 1000)) : '0';
                }

                function refreshPlaybackState() {
                    const playing = !video.paused && !video.ended;
                    startButton.classList.toggle('is-hidden', playing);
                    playIcon.classList.toggle('is-hidden', playing);
                    pauseIcon.classList.toggle('is-hidden', !playing);
                    toggleButton.setAttribute('aria-label', playing ? 'Mettre en pause' : 'Lire la vidéo');
                    if (startLabel) startLabel.textContent = video.currentTime > 0 ? 'REPRENDRE LA VIDÉO' : 'LANCER LA VIDÉO';
                    unmuteButton.hidden = !playing || !video.muted;
                }

                async function playWithSound() {
                    video.muted = false;
                    unmuteButton.hidden = true;
                    try {
                        await video.play();
                    } catch (error) {
                        refreshPlaybackState();
                    }
                }

                function togglePlayback() {
                    if (video.paused || video.ended) playWithSound();
                    else video.pause();
                }

                startButton.addEventListener('click', playWithSound);
                toggleButton.addEventListener('click', togglePlayback);
                video.addEventListener('click', togglePlayback);
                video.addEventListener('playing', refreshPlaybackState);
                video.addEventListener('pause', refreshPlaybackState);
                video.addEventListener('ended', refreshPlaybackState);
                video.addEventListener('loadedmetadata', refreshTime);
                video.addEventListener('durationchange', refreshTime);
                video.addEventListener('timeupdate', refreshTime);

                progress.addEventListener('input', function () {
                    if (!Number.isFinite(video.duration) || video.duration <= 0) return;
                    video.currentTime = video.duration * (Number(progress.value) / 1000);
                    refreshTime();
                });

                muteButton.addEventListener('click', function () {
                    video.muted = !video.muted;
                    unmuteButton.hidden = !video.muted || video.paused;
                    muteButton.setAttribute('aria-label', video.muted ? 'Activer le son' : 'Couper le son');
                });

                unmuteButton.addEventListener('click', function () {
                    video.muted = false;
                    unmuteButton.hidden = true;
                    muteButton.setAttribute('aria-label', 'Couper le son');
                });

                fullscreenButton.addEventListener('click', async function () {
                    try {
                        if (document.fullscreenElement) await document.exitFullscreen();
                        else if (frame.requestFullscreen) await frame.requestFullscreen();
                        else if (video.webkitEnterFullscreen) video.webkitEnterFullscreen();
                    } catch (error) {}
                });

                refreshTime();
                refreshPlaybackState();
            }

            async function readServerSession() {
                const params = new URLSearchParams(window.location.search);
                if (params.get('preview') === 'dev') return null;
                const token = readToken();
                if (!token) return null;
                const response = await fetch('/.netlify/functions/get-mc2-registration?t=' + encodeURIComponent(token));
                if (!response.ok) return null;
                const registration = await response.json();
                if (!registration.valid || !registration.sessionStartsAt) return null;
                return {
                    id: registration.creneau || 'jit',
                    kind: registration.slotKind || 'jit',
                    startsAt: registration.sessionStartsAt,
                    timezone: registration.visitorTimezone || Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'
                };
            }

            function formatSession(date) {
                const now = new Date();
                const dayStart = new Date(date.getFullYear(), date.getMonth(), date.getDate()).getTime();
                const nowStart = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
                const offset = Math.round((dayStart - nowStart) / 86400000);
                let day;
                if (offset === 0) day = 'Aujourd’hui';
                else if (offset === 1) day = 'Demain';
                else {
                    day = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' }).format(date);
                    day = day.charAt(0).toUpperCase() + day.slice(1);
                }
                const time = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', hour12: false }).format(date).replace(':', ' h ');
                return day + ' à ' + time.replace(/ h 00$/, ' h');
            }

            function pad(value) { return String(value).padStart(2, '0'); }

            function sessionUrl(session) {
                const current = new URLSearchParams(window.location.search);
                const params = new URLSearchParams({ t: readToken() });
                if (current.get('preview') === 'dev') {
                    params.set('preview', 'mc2');
                    params.set('session_starts_at', session.startsAt);
                    params.set('creneau', session.id || 'jit');
                    params.set('slot_kind', session.kind || 'jit');
                }
                return '/mc2/session/?' + params.toString();
            }

            function update(session) {
                const startMs = new Date(session.startsAt).getTime();
                const remaining = startMs - Date.now();
                const positive = Math.max(0, remaining);
                const totalSeconds = Math.floor(positive / 1000);
                document.getElementById('hours').textContent = pad(Math.floor(totalSeconds / 3600));
                document.getElementById('minutes').textContent = pad(Math.floor((totalSeconds % 3600) / 60));
                document.getElementById('seconds').textContent = pad(totalSeconds % 60);

                const button = document.getElementById('join-button');
                const note = document.getElementById('access-note');
                if (Date.now() <= startMs + SESSION_DURATION_MS) {
                    button.classList.remove('is-locked');
                    button.removeAttribute('aria-disabled');
                    button.href = sessionUrl(session);
                    button.textContent = 'ACCÉDER À MA MASTERCLASS';
                    note.textContent = remaining > 0 ? 'Tu peux déjà entrer dans la salle.' : 'Ta session est en cours.';
                } else if (Date.now() > startMs + SESSION_DURATION_MS) {
                    button.classList.add('is-locked');
                    button.setAttribute('aria-disabled', 'true');
                    button.href = '#';
                    button.textContent = 'CETTE SESSION EST TERMINÉE';
                    note.textContent = 'Reviens à la page d’inscription pour choisir un nouveau créneau.';
                }
            }

            function downloadCalendar(session) {
                const start = new Date(session.startsAt);
                const end = new Date(start.getTime() + SESSION_DURATION_MS);
                const compact = (date) => date.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z');
                const ics = [
                    'BEGIN:VCALENDAR',
                    'VERSION:2.0',
                    'PRODID:-//Sonny Court//MC2//FR',
                    'BEGIN:VEVENT',
                    'UID:mc2-' + start.getTime() + '@sonnycourt.com',
                    'DTSTAMP:' + compact(new Date()),
                    'DTSTART:' + compact(start),
                    'DTEND:' + compact(end),
                    'SUMMARY:Masterclass Esprit Subconscient 2.0',
                    'DESCRIPTION:Reviens sur ta page de confirmation pour rejoindre la masterclass.',
                    'END:VEVENT',
                    'END:VCALENDAR'
                ].join('\r\n');
                const url = URL.createObjectURL(new Blob([ics], { type: 'text/calendar;charset=utf-8' }));
                const link = document.createElement('a');
                link.href = url;
                link.download = 'masterclass-esprit-subconscient.ics';
                document.body.appendChild(link);
                link.click();
                link.remove();
                URL.revokeObjectURL(url);
            }

            async function init() {
                await window.__MC2_ACCESS__.resolve();
                launchConfetti();
                initConfirmationVideo();
                let session = null;
                try { session = await readServerSession(); } catch (error) {}
                session = session || readSession();
                try { localStorage.setItem(STORAGE_KEY, JSON.stringify(session)); } catch (error) {}
                const start = new Date(session.startsAt);
                const formattedSession = formatSession(start);
                document.getElementById('session-heading').textContent = 'La session commence ' + formattedSession.charAt(0).toLowerCase() + formattedSession.slice(1) + '.';
                const calendarButton = document.getElementById('calendar-button');
                if (calendarButton) {
                    calendarButton.addEventListener('click', function () { downloadCalendar(session); });
                    calendarButton.addEventListener('click', function () {
                        trackMc2Event('calendar_downloaded', { slot_kind: session.kind || 'jit' });
                    });
                }
                document.getElementById('workbook-button').addEventListener('click', function () {
                    trackMc2Event('workbook_opened', { slot_kind: session.kind || 'jit' });
                });
                document.getElementById('join-button').addEventListener('click', function (event) {
                    if (event.currentTarget.classList.contains('is-locked')) event.preventDefault();
                    else trackMc2Event('room_join_clicked', { slot_kind: session.kind || 'jit' });
                });
                if (new URLSearchParams(window.location.search).get('preview') === 'dev') {
                    document.getElementById('preview-banner').classList.add('is-visible');
                }
                update(session);
                trackMc2Event('confirmation_viewed', { slot_kind: session.kind || 'jit' });
                window.setInterval(function () { update(session); }, 1000);
            }

            init();
        })();
    </script>
</body>
</html>
