---
import GAConsentMode from '../../components/GAConsentMode.astro';
import Mc2SafetyGuard from '../../components/Mc2SafetyGuard.astro';
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Inscription confirmée — Masterclass Esprit Subconscient 2.0</title>
    <meta name="description" content="Ta place est réservée. Prépare-toi et rejoins ta session au moment choisi." />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <GAConsentMode performanceMode />
    <Mc2SafetyGuard />
    <style>
        @font-face {
            font-family: Inter;
            font-style: normal;
            font-weight: 400 800;
            font-display: swap;
            src: url('/fonts/inter-latin.woff2') format('woff2');
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --blue: #3b82f6;
            --blue-light: #93c5fd;
            --orange: #fb923c;
            --green: #4ade80;
            --ink: #070b18;
            --muted: rgba(255, 255, 255, 0.68);
        }

        body {
            min-height: 100vh;
            overflow-x: hidden;
            font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            color: #fff;
            background: var(--ink);
        }

        body::before {
            position: fixed;
            inset: 0;
            z-index: -2;
            content: '';
            background:
                radial-gradient(circle at 12% 0%, rgba(37, 99, 235, 0.34), transparent 38%),
                radial-gradient(circle at 92% 34%, rgba(251, 146, 60, 0.1), transparent 30%),
                linear-gradient(180deg, #0b1634 0%, #080b18 55%, #050710 100%);
        }

        body::after {
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            content: '';
            opacity: 0.16;
            background-image: linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
            background-size: 42px 42px;
            mask-image: linear-gradient(to bottom, black, transparent 70%);
        }

        .shell {
            width: min(100% - 30px, 760px);
            margin: 0 auto;
            padding: 30px 0 64px;
        }

        .preview-banner {
            display: none;
            margin-bottom: 14px;
            padding: 8px 12px;
            border: 1px solid rgba(251, 146, 60, 0.4);
            border-radius: 10px;
            color: #fed7aa;
            background: rgba(124, 45, 18, 0.22);
            text-align: center;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .preview-banner.is-visible { display: block; }

        .confirmation-head {
            text-align: center;
            margin-bottom: 22px;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 15px;
            padding: 8px 14px;
            border: 1px solid rgba(74, 222, 128, 0.35);
            border-radius: 999px;
            color: #bbf7d0;
            background: rgba(34, 197, 94, 0.1);
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .badge-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 14px rgba(74, 222, 128, 0.8);
        }

        h1 {
            max-width: 680px;
            margin: 0 auto 12px;
            font-size: clamp(2rem, 6vw, 3.35rem);
            font-weight: 800;
            line-height: 1.04;
            letter-spacing: -0.045em;
        }

        .subtitle {
            color: var(--muted);
            font-size: clamp(0.98rem, 2vw, 1.12rem);
            line-height: 1.55;
        }

        .session-card,
        .content-card {
            margin-bottom: 16px;
            border: 1px solid rgba(96, 165, 250, 0.24);
            border-radius: 20px;
            background: linear-gradient(145deg, rgba(17, 30, 62, 0.86), rgba(8, 12, 28, 0.92));
            box-shadow: inset 0 1px 0 rgba(255,255,255,.045), 0 24px 70px rgba(0,0,0,.28);
        }

        .session-card {
            position: relative;
            overflow: hidden;
            padding: 24px;
            text-align: center;
        }

        .session-card::before {
            position: absolute;
            inset: 0;
            pointer-events: none;
            content: '';
            background: radial-gradient(circle at 50% -20%, rgba(251, 146, 60, 0.2), transparent 50%);
        }

        .session-kicker {
            position: relative;
            margin-bottom: 8px;
            color: #fdba74;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.11em;
            text-transform: uppercase;
        }

        .session-time {
            position: relative;
            margin-bottom: 5px;
            font-size: clamp(1.38rem, 4vw, 2rem);
            font-weight: 800;
        }

        .timezone {
            position: relative;
            color: rgba(255,255,255,.52);
            font-size: 0.76rem;
        }

        .countdown {
            position: relative;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 9px;
            width: min(100%, 390px);
            margin: 20px auto 16px;
        }

        .count-box {
            padding: 13px 8px;
            border: 1px solid rgba(251, 146, 60, 0.3);
            border-radius: 13px;
            background: linear-gradient(180deg, rgba(124,45,18,.3), rgba(15,23,42,.58));
            box-shadow: inset 0 1px 0 rgba(255,255,255,.055);
        }

        .count-number {
            display: block;
            font-variant-numeric: tabular-nums;
            color: #fff7ed;
            font-size: clamp(1.35rem, 5vw, 2rem);
            font-weight: 800;
            line-height: 1;
        }

        .count-label {
            display: block;
            margin-top: 6px;
            color: #fdba74;
            font-size: 0.58rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .join-button {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: min(100%, 460px);
            min-height: 54px;
            margin: 0 auto;
            padding: 14px 20px;
            border: 0;
            border-radius: 13px;
            color: #fff;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            box-shadow: 0 12px 34px rgba(37, 99, 235, 0.34);
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 800;
            letter-spacing: 0.02em;
            transition: transform .18s ease, opacity .18s ease;
        }

        .join-button:not(.is-locked):hover { transform: translateY(-2px); }

        .join-button.is-locked {
            opacity: 0.46;
            cursor: not-allowed;
            box-shadow: none;
        }

        .access-note {
            position: relative;
            margin-top: 10px;
            color: rgba(255,255,255,.5);
            font-size: 0.72rem;
        }

        .content-card { padding: 22px; }

        .workbook-card {
            display: grid;
            grid-template-columns: 122px minmax(0, 1fr);
            gap: 20px;
            align-items: center;
            margin-bottom: 16px;
            padding: 20px;
            border: 1px solid rgba(251, 146, 60, 0.32);
            border-radius: 20px;
            background:
                radial-gradient(circle at 0% 50%, rgba(251, 146, 60, 0.14), transparent 42%),
                linear-gradient(145deg, rgba(67, 32, 17, 0.48), rgba(8, 12, 28, 0.94));
            box-shadow: inset 0 1px 0 rgba(255,255,255,.05), 0 22px 65px rgba(0,0,0,.3);
        }

        .workbook-cover {
            display: block;
            width: 100%;
            max-height: 158px;
            object-fit: contain;
            filter: drop-shadow(0 14px 22px rgba(0,0,0,.34));
        }

        .workbook-kicker {
            margin-bottom: 6px;
            color: #fdba74;
            font-size: 0.66rem;
            font-weight: 800;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .workbook-card h2 {
            margin-bottom: 7px;
            font-size: clamp(1.16rem, 3vw, 1.42rem);
        }

        .workbook-copy {
            margin-bottom: 14px;
            color: var(--muted);
            font-size: 0.83rem;
            line-height: 1.5;
        }

        .workbook-button {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 49px;
            padding: 12px 16px;
            border-radius: 12px;
            color: #fff;
            background: linear-gradient(135deg, #f97316, #ea580c);
            box-shadow: 0 12px 34px rgba(234, 88, 12, 0.25);
            text-align: center;
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 850;
            letter-spacing: 0.02em;
        }

        .content-card h2 {
            margin-bottom: 7px;
            font-size: clamp(1.18rem, 3vw, 1.45rem);
        }

        .card-intro {
            margin-bottom: 17px;
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.55;
        }

        .video-frame {
            overflow: hidden;
            border: 1px solid rgba(96, 165, 250, 0.18);
            border-radius: 15px;
            background: #000;
            box-shadow: 0 16px 45px rgba(0,0,0,.34);
        }

        .video-frame video {
            display: block;
            width: 100%;
            aspect-ratio: 16 / 9;
            object-fit: cover;
        }

        .video-caption {
            margin-top: 10px;
            color: rgba(255,255,255,.48);
            text-align: center;
            font-size: 0.7rem;
        }

        .prep-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
        }

        .prep-item {
            padding: 15px 13px;
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 14px;
            background: rgba(255,255,255,.035);
        }

        .prep-number {
            display: grid;
            width: 27px;
            height: 27px;
            margin-bottom: 10px;
            place-items: center;
            border-radius: 8px;
            color: #dbeafe;
            background: rgba(59, 130, 246, 0.22);
            font-size: 0.75rem;
            font-weight: 800;
        }

        .prep-item strong {
            display: block;
            margin-bottom: 5px;
            font-size: 0.82rem;
        }

        .prep-item p {
            color: rgba(255,255,255,.55);
            font-size: 0.72rem;
            line-height: 1.42;
        }

        .action-row {
            display: grid;
            grid-template-columns: 1fr;
            gap: 10px;
            margin-top: 16px;
        }

        .secondary-button {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 48px;
            padding: 12px 14px;
            border: 1px solid rgba(96,165,250,.3);
            border-radius: 12px;
            color: #dbeafe;
            background: rgba(37,99,235,.12);
            text-align: center;
            text-decoration: none;
            font-size: 0.78rem;
            font-weight: 750;
            cursor: pointer;
        }

        button.secondary-button { width: 100%; }

        @media (max-width: 600px) {
            .shell { width: min(100% - 24px, 760px); padding-top: 18px; }
            .confirmation-head { margin-bottom: 17px; }
            h1 { font-size: clamp(1.9rem, 10vw, 2.55rem); }
            .session-card, .content-card { border-radius: 17px; }
            .session-card { padding: 20px 14px; }
            .content-card { padding: 19px 15px; }
            .workbook-card {
                grid-template-columns: 82px minmax(0, 1fr);
                gap: 13px;
                padding: 16px 14px;
                border-radius: 17px;
            }
            .workbook-cover { max-height: 124px; }
            .workbook-copy { font-size: 0.75rem; }
            .workbook-button { min-height: 46px; padding: 10px 11px; font-size: 0.7rem; }
            .prep-grid { grid-template-columns: 1fr; }
            .prep-item { display: grid; grid-template-columns: 34px 1fr; column-gap: 8px; }
            .prep-number { grid-row: 1 / 3; margin-bottom: 0; }
            .action-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <main class="shell">
        <div id="preview-banner" class="preview-banner">Préproduction MC2 — aucune inscription réelle</div>

        <header class="confirmation-head">
            <div class="badge"><span class="badge-dot"></span> Inscription confirmée</div>
            <h1>Ta place est réservée.</h1>
            <p class="subtitle">Prépare maintenant les conditions pour vivre pleinement la masterclass.</p>
        </header>

        <section class="session-card" aria-labelledby="session-heading">
            <p class="session-kicker">Ta session</p>
            <h2 id="session-heading" class="session-time">Calcul de ton horaire…</h2>
            <p id="timezone-label" class="timezone">Heure locale</p>

            <div class="countdown" aria-live="polite">
                <div class="count-box"><span id="hours" class="count-number">00</span><span class="count-label">Heures</span></div>
                <div class="count-box"><span id="minutes" class="count-number">00</span><span class="count-label">Minutes</span></div>
                <div class="count-box"><span id="seconds" class="count-number">00</span><span class="count-label">Secondes</span></div>
            </div>

            <a id="join-button" class="join-button is-locked" href="#" aria-disabled="true">LE LIEN S’OUVRE 3 MINUTES AVANT</a>
            <p id="access-note" class="access-note">Garde cette page ouverte : le bouton s’activera automatiquement.</p>
        </section>

        <section class="workbook-card" aria-labelledby="workbook-title">
            <img class="workbook-cover" src="/media/pages/secrets-book.webp" alt="Workbook de la masterclass Esprit Subconscient 2.0" width="830" height="1114" />
            <div>
                <p class="workbook-kicker">À faire maintenant</p>
                <h2 id="workbook-title">Imprime ton workbook avant le début</h2>
                <p class="workbook-copy">Tu vas le remplir en direct pendant la masterclass. Ouvre le document, puis utilise la fonction « Imprimer » de ton téléphone ou de ton ordinateur.</p>
                <a id="workbook-button" class="workbook-button" href="/media/pages/Masterclass-Esprit-subconscient-2-0.pdf" target="_blank" rel="noopener">OUVRIR ET IMPRIMER LE WORKBOOK</a>
            </div>
        </section>

        <section class="content-card">
            <h2>Regarde ceci avant de commencer</h2>
            <p class="card-intro">Une minute pour savoir comment tirer le maximum de cette expérience.</p>
            <div class="video-frame">
                <video controls playsinline preload="metadata" controlslist="nodownload noremoteplayback" poster="/media/pages/masterclass-gratuite-banner-800.webp">
                    <source src="https://sonnycourt-videos-public.b-cdn.net/FE%CC%81LICITATIONS%20(inscription%20Webinaire%20V2).mp4" type="video/mp4" />
                </video>
            </div>
            <p class="video-caption">Message personnel de Sonny · 1 minute</p>
        </section>

        <section class="content-card">
            <h2>Trois choses avant la diffusion</h2>
            <p class="card-intro">Tu peux suivre sur téléphone. Pour une meilleure expérience, prépare ceci maintenant.</p>
            <div class="prep-grid">
                <div class="prep-item">
                    <span class="prep-number">1</span>
                    <strong>Prends un ordinateur</strong>
                    <p>Écran plus grand, moins de distractions.</p>
                </div>
                <div class="prep-item">
                    <span class="prep-number">2</span>
                    <strong>Imprime le workbook</strong>
                    <p>Tu vas le remplir pendant la masterclass.</p>
                </div>
                <div class="prep-item">
                    <span class="prep-number">3</span>
                    <strong>Bloque 1 h 15</strong>
                    <p>Installe-toi au calme avec de quoi écrire.</p>
                </div>
            </div>
            <div class="action-row">
                <button id="calendar-button" class="secondary-button" type="button">AJOUTER À MON AGENDA</button>
            </div>
        </section>
    </main>

    <script>
        // @ts-nocheck
        (function () {
            const STORAGE_KEY = 'mc2_selected_session_v1';
            const TOKEN_KEY = 'mc2_registration_token';
            const OPEN_EARLY_MS = 3 * 60 * 1000;
            const SESSION_DURATION_MS = 75 * 60 * 1000;

            function nextQuarterWithLead() {
                const now = Date.now();
                const quarter = 15 * 60 * 1000;
                let target = Math.ceil(now / quarter) * quarter;
                if (target - now < 8 * 60 * 1000) target += quarter;
                return new Date(target);
            }

            function readSession() {
                const params = new URLSearchParams(window.location.search);
                const queryStart = params.get('session_starts_at');
                if (queryStart && Number.isFinite(new Date(queryStart).getTime())) {
                    return {
                        id: params.get('creneau') || 'jit',
                        kind: params.get('slot_kind') || 'jit',
                        startsAt: new Date(queryStart).toISOString(),
                        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'
                    };
                }
                try {
                    const stored = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
                    const storedMs = stored && new Date(stored.startsAt).getTime();
                    if (Number.isFinite(storedMs) && storedMs + SESSION_DURATION_MS > Date.now()) return stored;
                } catch (error) {}
                const fallback = nextQuarterWithLead();
                return {
                    id: 'jit',
                    kind: 'jit',
                    startsAt: fallback.toISOString(),
                    timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'
                };
            }

            function readToken() {
                const params = new URLSearchParams(window.location.search);
                return (params.get('t') || localStorage.getItem(TOKEN_KEY) || '').trim();
            }

            function trackMc2Event(eventName, meta) {
                const token = readToken();
                if (!token || !eventName) return;
                fetch('/.netlify/functions/track-mc2-event', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        token,
                        event: eventName,
                        meta: Object.assign({ page_path: '/mc2/confirmation/' }, meta || {})
                    }),
                    keepalive: true
                }).catch(function () {});
            }

            async function readServerSession() {
                const params = new URLSearchParams(window.location.search);
                if (params.get('preview') === 'dev') return null;
                const token = readToken();
                if (!token) return null;
                const response = await fetch('/.netlify/functions/get-mc2-registration?t=' + encodeURIComponent(token));
                if (!response.ok) return null;
                const registration = await response.json();
                if (!registration.valid || !registration.sessionStartsAt) return null;
                return {
                    id: registration.creneau || 'jit',
                    kind: registration.slotKind || 'jit',
                    startsAt: registration.sessionStartsAt,
                    timezone: registration.visitorTimezone || Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'
                };
            }

            function formatSession(date) {
                const now = new Date();
                const dayStart = new Date(date.getFullYear(), date.getMonth(), date.getDate()).getTime();
                const nowStart = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
                const offset = Math.round((dayStart - nowStart) / 86400000);
                let day;
                if (offset === 0) day = 'Aujourd’hui';
                else if (offset === 1) day = 'Demain';
                else {
                    day = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' }).format(date);
                    day = day.charAt(0).toUpperCase() + day.slice(1);
                }
                const time = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', hour12: false }).format(date).replace(':', ' h ');
                return day + ' à ' + time.replace(/ h 00$/, ' h');
            }

            function pad(value) { return String(value).padStart(2, '0'); }

            function sessionUrl(session) {
                const current = new URLSearchParams(window.location.search);
                const params = new URLSearchParams({ t: readToken() });
                if (current.get('preview') === 'dev') {
                    params.set('preview', 'mc2');
                    params.set('session_starts_at', session.startsAt);
                    params.set('creneau', session.id || 'jit');
                    params.set('slot_kind', session.kind || 'jit');
                }
                return '/mc2/session/?' + params.toString();
            }

            function update(session) {
                const startMs = new Date(session.startsAt).getTime();
                const remaining = startMs - Date.now();
                const positive = Math.max(0, remaining);
                const totalSeconds = Math.floor(positive / 1000);
                document.getElementById('hours').textContent = pad(Math.floor(totalSeconds / 3600));
                document.getElementById('minutes').textContent = pad(Math.floor((totalSeconds % 3600) / 60));
                document.getElementById('seconds').textContent = pad(totalSeconds % 60);

                const button = document.getElementById('join-button');
                const note = document.getElementById('access-note');
                const params = new URLSearchParams(window.location.search);
                const isOpen = remaining <= OPEN_EARLY_MS && Date.now() <= startMs + SESSION_DURATION_MS;
                const forceOpen = params.get('unlock') === '1';
                if (isOpen || forceOpen) {
                    button.classList.remove('is-locked');
                    button.removeAttribute('aria-disabled');
                    button.href = sessionUrl(session);
                    button.textContent = remaining > 0 ? 'REJOINDRE LA SALLE MAINTENANT' : 'ENTRER DANS LA MASTERCLASS';
                    note.textContent = remaining > 0 ? 'La salle vient d’ouvrir.' : 'Ta session est en cours.';
                } else if (Date.now() > startMs + SESSION_DURATION_MS) {
                    button.classList.add('is-locked');
                    button.setAttribute('aria-disabled', 'true');
                    button.href = '#';
                    button.textContent = 'CETTE SESSION EST TERMINÉE';
                    note.textContent = 'Reviens à la page d’inscription pour choisir un nouveau créneau.';
                }
            }

            function downloadCalendar(session) {
                const start = new Date(session.startsAt);
                const end = new Date(start.getTime() + SESSION_DURATION_MS);
                const compact = (date) => date.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z');
                const ics = [
                    'BEGIN:VCALENDAR',
                    'VERSION:2.0',
                    'PRODID:-//Sonny Court//MC2//FR',
                    'BEGIN:VEVENT',
                    'UID:mc2-' + start.getTime() + '@sonnycourt.com',
                    'DTSTAMP:' + compact(new Date()),
                    'DTSTART:' + compact(start),
                    'DTEND:' + compact(end),
                    'SUMMARY:Masterclass Esprit Subconscient 2.0',
                    'DESCRIPTION:Reviens sur ta page de confirmation pour rejoindre la masterclass.',
                    'END:VEVENT',
                    'END:VCALENDAR'
                ].join('\r\n');
                const url = URL.createObjectURL(new Blob([ics], { type: 'text/calendar;charset=utf-8' }));
                const link = document.createElement('a');
                link.href = url;
                link.download = 'masterclass-esprit-subconscient.ics';
                document.body.appendChild(link);
                link.click();
                link.remove();
                URL.revokeObjectURL(url);
            }

            async function init() {
                let session = null;
                try { session = await readServerSession(); } catch (error) {}
                session = session || readSession();
                try { localStorage.setItem(STORAGE_KEY, JSON.stringify(session)); } catch (error) {}
                const start = new Date(session.startsAt);
                document.getElementById('session-heading').textContent = formatSession(start);
                document.getElementById('timezone-label').textContent = 'Horaire affiché dans ton heure locale · ' + (session.timezone || 'UTC');
                document.getElementById('calendar-button').addEventListener('click', function () { downloadCalendar(session); });
                document.getElementById('calendar-button').addEventListener('click', function () {
                    trackMc2Event('calendar_downloaded', { slot_kind: session.kind || 'jit' });
                });
                document.getElementById('workbook-button').addEventListener('click', function () {
                    trackMc2Event('workbook_opened', { slot_kind: session.kind || 'jit' });
                });
                document.getElementById('join-button').addEventListener('click', function (event) {
                    if (event.currentTarget.classList.contains('is-locked')) event.preventDefault();
                    else trackMc2Event('room_join_clicked', { slot_kind: session.kind || 'jit' });
                });
                if (new URLSearchParams(window.location.search).get('preview') === 'dev') {
                    document.getElementById('preview-banner').classList.add('is-visible');
                }
                update(session);
                trackMc2Event('confirmation_viewed', { slot_kind: session.kind || 'jit' });
                window.setInterval(function () { update(session); }, 1000);
            }

            init();
        })();
    </script>
</body>
</html>
