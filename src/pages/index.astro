---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Sonny Court - Reprogramme ton subconscient"
  hideFormationsInHeader={true}
  hideBlogInHeader={true}
  hideFormationsInFooter={true}
  headerVariant="glass"
  footerVariant="compact-glass"
>
  <div id="sonny-homepage">
    <section class="hero">
      <div class="hero-background" aria-hidden="true"></div>

      <div class="hero-content">
        <h1>
          <span class="headline-primary">REPROGRAMME TON SUBCONSCIENT</span>
          <span class="headline-accent">TRANSFORME TA VIE</span>
        </h1>

        <p class="hero-subtitle">
          Tu ne peux pas créer une vie plus grande que l’image que tu as de toi.
          <strong>Change cette image et tes limites disparaissent.</strong>
        </p>

        <div class="cta-container">
          <a href="/masterclass" class="cta-primary">Commencer ma transformation</a>
        </div>

        <div class="impact-proof" aria-label="Plus de 15 millions de vies impactées et plus de 10 000 élèves formés">
          <div class="impact-stat">
            <strong>+15 M</strong>
            <span>de vies impactées</span>
          </div>
          <span class="impact-divider" aria-hidden="true"></span>
          <div class="impact-stat">
            <strong>+10 000</strong>
            <span>élèves formés</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  #sonny-homepage {
    width: 100%;
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    background: #02050c;
  }

  #sonny-homepage .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    isolation: isolate;
    padding: 150px 32px 96px;
  }

  #sonny-homepage .hero-background {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(118deg, #02050c 0%, #061226 42%, #092755 76%, #0b356f 100%);
  }

  #sonny-homepage .hero-background::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        112deg,
        transparent 0%,
        transparent 31%,
        rgba(96, 165, 250, 0.025) 42%,
        rgba(147, 197, 253, 0.09) 52%,
        rgba(59, 130, 246, 0.02) 63%,
        transparent 74%
      ),
      linear-gradient(
        90deg,
        rgba(2, 5, 12, 0.34) 0%,
        transparent 22%,
        transparent 78%,
        rgba(1, 4, 10, 0.18) 100%
      );
  }

  #sonny-homepage .hero-background::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.22;
    background-image: repeating-linear-gradient(
      90deg,
      transparent 0,
      transparent calc(12.5% - 1px),
      rgba(191, 219, 254, 0.08) 12.5%
    );
    mask-image: linear-gradient(to bottom, transparent 4%, #000 30%, transparent 86%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 4%, #000 30%, transparent 86%);
  }

  #sonny-homepage .hero-content {
    width: min(1320px, 100%);
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  #sonny-homepage h1 {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', sans-serif;
    text-transform: uppercase;
    text-wrap: balance;
  }

  #sonny-homepage .headline-primary,
  #sonny-homepage .headline-accent {
    display: block;
    white-space: nowrap;
  }

  #sonny-homepage .headline-primary {
    font-size: clamp(38px, 5.2vw, 74px);
    font-weight: 760;
    line-height: 1;
    letter-spacing: -0.055em;
    background: linear-gradient(180deg, #ffffff 0%, #edf3fb 48%, #a9bad3 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 18px 70px rgba(0, 0, 0, 0.24);
  }

  #sonny-homepage .headline-accent {
    margin-top: 12px;
    font-size: clamp(52px, 7.35vw, 106px);
    font-weight: 790;
    line-height: 0.98;
    letter-spacing: -0.065em;
    color: #ffffff;
    -webkit-text-fill-color: #ffffff;
    text-shadow:
      0 18px 46px rgba(2, 12, 31, 0.28),
      0 0 30px rgba(255, 255, 255, 0.045);
  }

  #sonny-homepage .hero-subtitle {
    max-width: 760px;
    margin: 30px auto 0;
    color: rgba(219, 234, 254, 0.72);
    font-size: clamp(17px, 1.45vw, 20px);
    font-weight: 430;
    line-height: 1.55;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  #sonny-homepage .hero-subtitle strong {
    font-weight: 700;
  }

  #sonny-homepage .cta-container {
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: center;
    margin-top: 36px;
  }

  #sonny-homepage .cta-primary {
    display: inline-block;
    padding: 20px 50px;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #FFFFFF;
    background: linear-gradient(135deg, #007AFF 0%, #0051D5 50%, #007AFF 100%);
    background-size: 200% 200%;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow:
      0 10px 30px rgba(0, 122, 255, 0.4),
      inset 0 0 0 2px rgba(255, 255, 255, 0.1);
    position: relative;
    overflow: hidden;
    text-decoration: none;
    animation: buttonPulse 2s ease-in-out infinite;
  }

  #sonny-homepage .cta-primary::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      45deg,
      transparent 30%,
      rgba(255, 255, 255, 0.3) 50%,
      transparent 70%
    );
    transform: rotate(45deg);
    transition: all 0.6s;
    animation: buttonShine 3s ease-in-out infinite;
    pointer-events: none;
  }

  #sonny-homepage .cta-primary:hover {
    background-position: 100% 100%;
    transform: scale(1.05);
    box-shadow:
      0 20px 50px rgba(0, 122, 255, 0.7),
      inset 0 0 0 2px rgba(255, 255, 255, 0.3),
      0 0 80px rgba(0, 122, 255, 0.5);
    animation: none;
  }

  #sonny-homepage .cta-primary:active {
    transform: scale(1.02);
  }

  #sonny-homepage .impact-proof {
    width: fit-content;
    max-width: 100%;
    margin: 34px auto 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
  }

  #sonny-homepage .impact-stat {
    min-width: 150px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }

  #sonny-homepage .impact-stat strong {
    color: rgba(255, 255, 255, 0.92);
    font-size: 27px;
    font-weight: 760;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  #sonny-homepage .impact-stat span {
    color: rgba(191, 219, 254, 0.52);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #sonny-homepage .impact-divider {
    width: 1px;
    height: 38px;
    background: linear-gradient(to bottom, transparent, rgba(191, 219, 254, 0.24), transparent);
  }

  @keyframes buttonPulse {
    0%, 100% {
      transform: scale(1);
      box-shadow:
        0 10px 30px rgba(0, 122, 255, 0.4),
        inset 0 0 0 2px rgba(255, 255, 255, 0.1);
    }
    50% {
      transform: scale(1.02);
      box-shadow:
        0 15px 40px rgba(0, 122, 255, 0.6),
        inset 0 0 0 2px rgba(255, 255, 255, 0.2);
    }
  }

  @keyframes buttonShine {
    0% {
      transform: rotate(45deg) translateX(-200%);
    }
    100% {
      transform: rotate(45deg) translateX(200%);
    }
  }

  @media (max-width: 768px) {
    #sonny-homepage .hero {
      min-height: 100svh;
      padding: 118px 14px 74px;
    }

    #sonny-homepage .hero-content {
      width: 100%;
    }

    #sonny-homepage .headline-primary {
      font-family: 'Bebas Neue', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: clamp(22px, 6.35vw, 34px);
      font-weight: 400;
      line-height: 1;
      letter-spacing: 0.012em;
    }

    #sonny-homepage .headline-accent {
      margin-top: 10px;
      font-size: clamp(31px, 8.8vw, 48px);
      line-height: 1;
      letter-spacing: -0.055em;
    }

    #sonny-homepage .hero-subtitle {
      max-width: 340px;
      margin-top: 24px;
      padding: 0 6px;
      font-size: 15px;
      line-height: 1.5;
    }

    #sonny-homepage .cta-container {
      width: 100%;
      margin-top: 30px;
    }

    #sonny-homepage .cta-primary {
      width: 100%;
      max-width: 372px;
      padding: 18px 14px;
      font-size: clamp(0.82rem, 3.7vw, 1rem);
      text-align: center;
      white-space: nowrap;
    }

    #sonny-homepage .impact-proof {
      width: min(100%, 352px);
      margin-top: 27px;
      gap: 13px;
    }

    #sonny-homepage .impact-stat {
      min-width: 0;
      flex: 1;
      gap: 4px;
    }

    #sonny-homepage .impact-stat strong {
      font-size: 21px;
    }

    #sonny-homepage .impact-stat span {
      font-size: 8.5px;
      letter-spacing: 0.055em;
    }

    #sonny-homepage .impact-divider {
      height: 34px;
    }
  }

  @media (max-width: 390px) {
    #sonny-homepage .headline-primary {
      font-size: 5.95vw;
    }

    #sonny-homepage .headline-accent {
      font-size: 8.45vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #sonny-homepage .cta-primary,
    #sonny-homepage .cta-primary::after {
      animation: none;
    }
  }
</style>
