---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact - Sonny Court" 
  description="Contacte Sonny Court pour tes questions sur la reprogrammation du subconscient et les formations."
  hideFormationsInHeader={true}
  hideBlogInHeader={true}
  headerVariant="glass"
  footerVariant="compact-glass"
>
  <div class="contact-page">
    <section class="contact-hero" aria-labelledby="contact-title">
      <div class="hero-content">
        <h1 id="contact-title">Contactez-nous</h1>
      </div>
    </section>

    <section class="contact-content" aria-label="Prendre contact">
      <div class="contact-grid">
        <aside class="contact-info">
          <h2>Informations de contact</h2>

          <div class="contact-list">
            <div class="contact-item">
              <div class="contact-icon" aria-hidden="true">@</div>
              <div>
                <h3>Email</h3>
                <p>info@sonnycourt.com</p>
              </div>
            </div>

            <div class="contact-item">
              <div class="contact-icon" aria-hidden="true">#</div>
              <div>
                <h3>Réseaux sociaux</h3>
                <p>@sonnycourt</p>
              </div>
            </div>

            <div class="contact-item">
              <div class="contact-icon contact-icon--time" aria-hidden="true">24h</div>
              <div>
                <h3>Réponse</h3>
                <p>Sous 24h en semaine</p>
              </div>
            </div>
          </div>
        </aside>

        <div class="contact-form">
          <h2>Envoie-moi un message</h2>

          <form name="contact" method="POST" netlify data-netlify="true" netlify-honeypot="bot-field" data-netlify-recaptcha="true">
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden" aria-hidden="true">
              <label>Ne pas remplir : <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>

            <div class="form-row">
              <div class="form-group">
                <label for="name">Nom complet</label>
                <input type="text" id="name" name="name" autocomplete="name" required>
              </div>

              <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" autocomplete="email" required>
              </div>
            </div>

            <div class="form-group">
              <label for="subject">Sujet</label>
              <select id="subject" name="subject" required>
                <option value="">Choisis un sujet</option>
                <option value="formation">Formation</option>
                <option value="coaching">Coaching privé</option>
                <option value="partnership">Partenariat</option>
                <option value="other">Autre</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="6" required></textarea>
            </div>

            <div data-netlify-recaptcha="true" data-theme="dark"></div>
            <button type="submit" class="submit-btn">
              Envoyer le message
            </button>

            <!-- Message de confirmation -->
            <div id="form-message" class="form-message" style="display: none;" role="status" aria-live="polite" aria-atomic="true">
              <div class="form-message-icon">✅</div>
              <div class="form-message-content">
                <h3>Message envoyé avec succès</h3>
                <p>Merci pour ton message. <strong>Mon équipe</strong> te répond sous 24h (jours ouvrés).</p>
              </div>
            </div>
          </form>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .contact-page {
    min-height: 100vh;
    padding-top: 100px;
  }

  .contact-hero {
    text-align: center;
    padding: 80px 20px 60px;
    max-width: 800px;
    margin: 0 auto;
  }

  .contact-hero h1 {
    font-size: clamp(48px, 8vw, 72px);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 24px;
    letter-spacing: -0.04em;
    background: linear-gradient(180deg, #FFFFFF 0%, #636366 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 20px;
    color: #8E8E93;
    line-height: 1.5;
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px 80px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 80px;
    margin-top: 60px;
  }

  .contact-info h2,
  .contact-form h2 {
    font-size: 28px;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 32px;
    letter-spacing: -0.02em;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 32px;
    padding: 24px;
    background: linear-gradient(145deg, #1C1C1E, rgba(0, 122, 255, 0.05));
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
  }

  .contact-icon {
    font-size: 24px;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 122, 255, 0.1);
    border-radius: 12px;
    flex-shrink: 0;
  }

  .contact-item h3 {
    font-size: 18px;
    font-weight: 600;
    color: #FFFFFF;
    margin-bottom: 8px;
  }

  .contact-item p {
    color: #8E8E93;
    font-size: 16px;
    margin: 0;
  }

  .contact-form {
    background: linear-gradient(145deg, #1C1C1E, rgba(0, 122, 255, 0.05));
    border-radius: 24px;
    padding: 40px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
  }

  .form-group {
    margin-bottom: 24px;
  }

  .form-group label {
    display: block;
    color: #FFFFFF;
    font-weight: 500;
    margin-bottom: 8px;
    font-size: 14px;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    color: #FFFFFF;
    font-size: 16px;
    font-family: inherit;
    transition: all 0.3s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #007AFF;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 0 4px rgba(0, 122, 255, 0.1);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #636366;
  }

  .hidden {
    display: none !important;
  }

  .submit-btn {
    width: 100%;
    padding: 18px 32px;
    background: linear-gradient(135deg, #007AFF 0%, #0051D5 100%);
    color: #FFFFFF;
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 16px;
  }

  .submit-btn:hover {
    background: linear-gradient(135deg, #0051D5 0%, #0039A6 100%);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 122, 255, 0.3);
  }

  .submit-btn:disabled {
    background: #48484A;
    cursor: not-allowed;
    transform: none;
    opacity: 0.6;
  }

  .form-message {
    margin-top: 20px;
    padding: 20px 24px;
    background: linear-gradient(135deg, rgba(52, 199, 89, 0.12), rgba(52, 199, 89, 0.18));
    border: 1px solid rgba(52, 199, 89, 0.45);
    border-radius: 14px;
    display: flex;
    gap: 14px;
    align-items: center;
    color: #FFFFFF;
    opacity: 0;
    transform: translateY(-8px);
    transition: all 0.3s ease;
  }

  .form-message.show {
    display: block !important;
    opacity: 1;
    transform: translateY(0);
  }

  .form-message h3 {
    color: #FFFFFF;
    font-size: 18px;
    margin: 0 0 4px 0;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .form-message p {
    color: #FFFFFF;
    font-weight: 500;
    margin: 0;
    font-size: 15px;
  }

  .form-message .form-message-icon {
    font-size: 22px;
    line-height: 1;
  }

  .form-message .form-message-content {
    display: flex;
    flex-direction: column;
  }

  .form-message.error {
    background: rgba(255, 59, 48, 0.1);
    border: 1px solid rgba(255, 59, 48, 0.2);
  }

  /* Mobile Optimization */
  @media (max-width: 768px) {
    .contact-hero {
      padding: 60px 20px 40px;
    }

    .contact-hero h1 {
      font-size: 42px;
    }

    .hero-subtitle {
      font-size: 18px;
    }

    .contact-content {
      padding: 0 20px 60px;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-top: 40px;
    }

    .contact-form {
      padding: 30px 24px;
    }

    .contact-info h2,
    .contact-form h2 {
      font-size: 24px;
      margin-bottom: 24px;
    }

    .contact-item {
      padding: 20px;
      margin-bottom: 20px;
    }

    .contact-icon {
      width: 40px;
      height: 40px;
      font-size: 20px;
    }
  }

  @media (max-width: 480px) {
    .contact-hero h1 {
      font-size: 36px;
    }

    .hero-subtitle {
      font-size: 16px;
    }

    .contact-form {
      padding: 24px 20px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 14px 16px;
      font-size: 14px;
    }

    .submit-btn {
      padding: 16px 24px;
      font-size: 14px;
    }
  }

  /* Liquid glass redesign */
  .contact-page {
    min-height: 100vh;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 128px 0 80px;
    color: #ffffff;
    background:
      linear-gradient(118deg, #02050c 0%, #061226 42%, #092755 76%, #0b356f 100%);
  }

  .contact-page::before,
  .contact-page::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .contact-page::before {
    z-index: -2;
    background:
      radial-gradient(circle at 78% 12%, rgba(96, 165, 250, 0.16), transparent 34%),
      radial-gradient(circle at 12% 64%, rgba(37, 99, 235, 0.08), transparent 38%);
  }

  .contact-page::after {
    z-index: -1;
    opacity: 0.58;
    background:
      linear-gradient(
        102deg,
        transparent 0%,
        transparent 24%,
        rgba(147, 197, 253, 0.035) 35%,
        transparent 46%,
        transparent 62%,
        rgba(147, 197, 253, 0.045) 76%,
        transparent 87%
      ),
      linear-gradient(180deg, rgba(2, 5, 12, 0.08) 0%, rgba(2, 5, 12, 0.3) 100%);
  }

  .contact-hero,
  .contact-content {
    position: relative;
    z-index: 1;
  }

  .contact-hero {
    max-width: 920px;
    margin: 0 auto;
    padding: 30px 24px 56px;
    text-align: center;
  }

  .contact-hero h1 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(58px, 7.2vw, 96px);
    font-weight: 780;
    line-height: 0.96;
    letter-spacing: -0.065em;
    text-transform: uppercase;
    background: linear-gradient(180deg, #ffffff 0%, #edf3fb 48%, #a9bad3 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 22px 70px rgba(1, 8, 24, 0.28);
  }

  .hero-subtitle {
    max-width: 680px;
    margin: 0 auto;
    color: rgba(219, 234, 254, 0.7);
    font-size: clamp(17px, 1.45vw, 20px);
    font-weight: 430;
    line-height: 1.55;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }

  .contact-content {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(300px, 360px) minmax(0, 1fr);
    align-items: start;
    gap: 24px;
    margin-top: 0;
  }

  .contact-info,
  .contact-form {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(191, 219, 254, 0.15);
    border-radius: 28px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.085), rgba(255, 255, 255, 0.025));
    box-shadow:
      0 28px 80px rgba(1, 5, 15, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(28px) saturate(145%);
    -webkit-backdrop-filter: blur(28px) saturate(145%);
  }

  .contact-info::before,
  .contact-form::before {
    content: '';
    position: absolute;
    inset: 0 12% auto;
    height: 1px;
    background:
      linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.38), transparent);
    pointer-events: none;
  }

  .contact-info {
    padding: 30px 28px 10px;
  }

  .contact-form {
    padding: 34px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.095), rgba(255, 255, 255, 0.032));
  }

  .contact-info h2,
  .contact-form h2 {
    margin: 0 0 24px;
    color: #ffffff;
    font-size: clamp(23px, 2vw, 29px);
    font-weight: 720;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .contact-list {
    border-top: 1px solid rgba(191, 219, 254, 0.1);
  }

  .contact-item {
    margin: 0;
    padding: 20px 0;
    display: flex;
    align-items: center;
    gap: 15px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(191, 219, 254, 0.1);
    border-radius: 0;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .contact-item:last-child {
    border-bottom: 0;
  }

  .contact-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: rgba(226, 240, 255, 0.88);
    border: 1px solid rgba(191, 219, 254, 0.15);
    border-radius: 14px;
    background:
      radial-gradient(circle at 30% 16%, rgba(255, 255, 255, 0.2), transparent 42%),
      linear-gradient(145deg, rgba(255, 255, 255, 0.11), rgba(96, 165, 250, 0.035));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.15),
      0 8px 22px rgba(1, 8, 24, 0.18);
    font-size: 18px;
    font-weight: 650;
    letter-spacing: -0.04em;
  }

  .contact-icon--time {
    font-size: 11px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .contact-item h3 {
    margin: 0 0 5px;
    color: rgba(255, 255, 255, 0.94);
    font-size: 15px;
    font-weight: 650;
    line-height: 1.2;
  }

  .contact-item p {
    margin: 0;
    color: rgba(191, 219, 254, 0.58);
    font-size: 14px;
    line-height: 1.35;
  }

  .contact-form form {
    color-scheme: dark;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .form-group {
    margin-bottom: 19px;
  }

  .form-group label {
    display: block;
    margin: 0 0 8px;
    color: rgba(239, 246, 255, 0.82);
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.015em;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    min-height: 54px;
    padding: 15px 17px;
    color: #ffffff;
    border: 1px solid rgba(191, 219, 254, 0.14);
    border-radius: 15px;
    outline: none;
    background: rgba(2, 10, 24, 0.5);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.035),
      0 10px 28px rgba(1, 8, 24, 0.08);
    font-family: inherit;
    font-size: 16px;
    line-height: 1.35;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .form-group textarea {
    min-height: 164px;
    resize: vertical;
  }

  .form-group select {
    cursor: pointer;
  }

  .form-group select option {
    color: #ffffff;
    background: #07152b;
  }

  .form-group input:hover,
  .form-group select:hover,
  .form-group textarea:hover {
    border-color: rgba(191, 219, 254, 0.24);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: rgba(96, 165, 250, 0.78);
    background: rgba(2, 12, 29, 0.72);
    box-shadow:
      0 0 0 4px rgba(59, 130, 246, 0.13),
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 14px 34px rgba(1, 8, 24, 0.14);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: rgba(191, 219, 254, 0.3);
  }

  .form-group input:-webkit-autofill,
  .form-group input:-webkit-autofill:hover,
  .form-group input:-webkit-autofill:focus {
    -webkit-text-fill-color: #ffffff;
    box-shadow: 0 0 0 1000px #09172d inset;
    transition: background-color 9999s ease-in-out 0s;
  }

  [data-netlify-recaptcha='true'] {
    max-width: 100%;
    margin-top: 4px;
  }

  .submit-btn {
    width: 100%;
    min-height: 58px;
    margin-top: 13px;
    padding: 16px 28px;
    position: relative;
    overflow: hidden;
    color: #ffffff;
    border: 1px solid rgba(147, 197, 253, 0.34);
    border-radius: 999px;
    background: linear-gradient(135deg, #1677ff 0%, #1f5fe5 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.23),
      0 15px 36px rgba(30, 64, 175, 0.3);
    font-size: 16px;
    font-weight: 720;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }

  .submit-btn::before {
    content: '';
    position: absolute;
    inset: 1px 12% auto;
    height: 1px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.38);
    pointer-events: none;
  }

  .submit-btn:hover {
    transform: translateY(-1px);
    background: linear-gradient(135deg, #2685ff 0%, #2563eb 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.27),
      0 18px 42px rgba(30, 64, 175, 0.38);
  }

  .submit-btn:focus-visible {
    outline: 2px solid rgba(191, 219, 254, 0.88);
    outline-offset: 4px;
  }

  .submit-btn:disabled {
    color: rgba(255, 255, 255, 0.6);
    border-color: rgba(191, 219, 254, 0.1);
    background: rgba(71, 85, 105, 0.55);
    box-shadow: none;
    cursor: not-allowed;
    transform: none;
    opacity: 0.72;
  }

  .form-message {
    margin-top: 20px;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    color: #ffffff;
    border: 1px solid rgba(74, 222, 128, 0.3);
    border-radius: 16px;
    background:
      linear-gradient(135deg, rgba(34, 197, 94, 0.12), rgba(16, 185, 129, 0.08));
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.24s ease,
      transform 0.24s ease;
  }

  .form-message.show {
    display: flex !important;
    opacity: 1;
    transform: translateY(0);
  }

  .form-message.error {
    border-color: rgba(248, 113, 113, 0.3);
    background: rgba(239, 68, 68, 0.1);
  }

  .form-message h3 {
    margin: 0 0 4px;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
  }

  .form-message p {
    margin: 0;
    color: rgba(239, 246, 255, 0.78);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
  }

  .form-message .form-message-icon {
    flex-shrink: 0;
    font-size: 20px;
    line-height: 1;
  }

  .form-message .form-message-content {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 960px) {
    .contact-page {
      padding-top: 112px;
    }

    .contact-hero {
      padding-top: 30px;
      padding-bottom: 46px;
    }

    .contact-content {
      max-width: 760px;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  @media (max-width: 640px) {
    .contact-page {
      padding: 104px 0 54px;
    }

    .contact-hero {
      padding: 26px 18px 38px;
    }

    .contact-hero h1 {
      margin-top: 0;
      font-size: clamp(48px, 15vw, 66px);
    }

    .hero-subtitle {
      max-width: 360px;
      font-size: 16px;
    }

    .contact-content {
      padding: 0 14px;
    }

    .contact-info,
    .contact-form {
      border-radius: 22px;
    }

    .contact-info {
      padding: 24px 22px 8px;
    }

    .contact-form {
      padding: 24px 20px;
    }

    .contact-info h2,
    .contact-form h2 {
      margin-bottom: 20px;
      font-size: 23px;
    }

    .contact-item {
      padding: 17px 0;
    }

    .contact-icon {
      width: 40px;
      height: 40px;
      border-radius: 13px;
    }

    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .form-group {
      margin-bottom: 17px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: 14px 15px;
      font-size: 16px;
    }

    .form-group textarea {
      min-height: 148px;
    }

    .submit-btn {
      min-height: 56px;
      padding: 15px 20px;
      font-size: 14px;
    }
  }

  @media (max-width: 360px) {
    [data-netlify-recaptcha='true'] {
      width: 116%;
      margin-bottom: -11px;
      transform: scale(0.86);
      transform-origin: top left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .form-group input,
    .form-group select,
    .form-group textarea,
    .submit-btn,
    .form-message {
      transition: none;
    }

    .submit-btn:hover,
    .form-message {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    .contact-hero h1 {
      color: CanvasText;
      background: none;
      -webkit-text-fill-color: CanvasText;
    }
  }
</style>

<script>
  // Amélioration de l'expérience utilisateur du formulaire
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form[name="contact"]');
    const submitBtn = form.querySelector('.submit-btn');
    const formMessage = document.getElementById('form-message');

    function isGibberish(text) {
      if (!text || text.length < 2) return false;

      // 1. Pas de voyelle = charabia
      const vowelCount = (text.match(/[aeiouyàâäéèêëîïôöùûüAEIOUYÀÂÄÉÈÊËÎÏÔÖÙÛÜ]/g) || []).length;
      const letterCount = (text.match(/[a-zA-ZÀ-ÿ]/g) || []).length;
      if (letterCount >= 5 && vowelCount / letterCount < 0.2) return true;

      // 2. Alternance majuscules/minuscules chaotique
      const alternations = (text.match(/[a-z][A-Z]|[A-Z][a-z][A-Z]/g) || []).length;
      if (text.length >= 8 && alternations >= 3) return true;

      // 3. Message long sans aucun espace
      if (text.length >= 20 && !text.includes(' ')) return true;

      // 4. Ratio chiffres/lettres suspect
      const digits = (text.match(/\d/g) || []).length;
      if (text.length >= 10 && digits / text.length > 0.3) return true;

      return false;
    }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi en cours...';

      const formData = new FormData(form);
      const recaptchaToken = document.querySelector('[name="g-recaptcha-response"]')?.value;
      if (recaptchaToken !== undefined) {
        formData.set('g-recaptcha-response', recaptchaToken);
      }

      const nom = String(formData.get('nom') || formData.get('name') || '').trim();
      const message = String(formData.get('message') || '').trim();

      if (isGibberish(nom) || isGibberish(message)) {
        formMessage.innerHTML = '<div class="form-message-icon">✅</div><div class="form-message-content"><h3>Message envoyé avec succès</h3><p>Merci pour ton message.</p></div>';
        formMessage.className = 'form-message show';
        form.reset();
        submitBtn.disabled = false;
        submitBtn.textContent = 'Envoyer le message';
        return;
      }

      try {
        const body = new URLSearchParams(formData).toString();
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body
        });

        if (res.ok) {
          formMessage.innerHTML = '<div class="form-message-icon">✅</div><div class="form-message-content"><h3>Message envoyé avec succès</h3><p>Merci pour ton message. <strong>Mon équipe</strong> te répond sous 24h (jours ouvrés).</p></div>';
          formMessage.className = 'form-message show';
          form.reset();
          formMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          throw new Error('Netlify response ' + res.status);
        }
      } catch (err) {
        formMessage.innerHTML = '<p>❌ Erreur lors de l\'envoi. Réessaie ou contacte-moi à info@sonnycourt.com</p>';
        formMessage.className = 'form-message show error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Envoyer le message';
      }
    });
    
    // Validation en temps réel
    const inputs = form.querySelectorAll('input[required], select[required], textarea[required]');
    inputs.forEach(input => {
      input.addEventListener('blur', function() {
        if (this.value.trim() === '') {
          this.style.borderColor = '#FF3B30';
        } else {
          this.style.borderColor = '#34C759';
        }
      });
      
      input.addEventListener('input', function() {
        if (this.value.trim() !== '') {
          this.style.borderColor = 'rgba(255, 255, 255, 0.1)';
        }
      });
    });
    
    // Validation email
    const emailInput = document.getElementById('email');
    emailInput.addEventListener('blur', function() {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(this.value)) {
        this.style.borderColor = '#FF3B30';
      } else {
        this.style.borderColor = '#34C759';
      }
    });
  });
</script>
