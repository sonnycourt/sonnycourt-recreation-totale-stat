</style>

<script>
  // ==========================================================
  // 0. Préférences
  // ==========================================================
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ==========================================================
  // 1. Reveal au scroll
  // ==========================================================
  const revealObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.12 }
  );
  document.querySelectorAll('#visu-page .reveal').forEach((el) => revealObserver.observe(el));

  // ==========================================================
  // 2. L'ESSAIM MORPHIQUE
  //    Un seul système de particules, fixé au viewport, qui se
  //    métamorphose au fil du scroll :
  //    cerveau → chaos → papillon → constellation → « TOI. »
  // ==========================================================
  const canvas = document.getElementById('morphCanvas') as HTMLCanvasElement | null;
  const page = document.getElementById('visu-page');

  if (canvas && page) {
    const ctx = canvas.getContext('2d')!;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    const isMobile = window.matchMedia('(max-width: 980px)').matches;
    const N = isMobile ? 420 : 680;

    let VW = window.innerWidth;
    let VH = window.innerHeight;

    // ---------- Génération des formes ----------

    // Cerveau : union d'ellipses (vue de profil)
    const BRAIN_ELLIPSES = [
      { cx: 0.52, cy: 0.40, rx: 0.40, ry: 0.30 },
      { cx: 0.22, cy: 0.48, rx: 0.16, ry: 0.20 },
      { cx: 0.40, cy: 0.62, rx: 0.22, ry: 0.14 },
      { cx: 0.80, cy: 0.55, rx: 0.14, ry: 0.16 },
      { cx: 0.78, cy: 0.76, rx: 0.13, ry: 0.10 },
    ];

    const insideBrain = (x: number, y: number) =>
      BRAIN_ELLIPSES.some((e) => ((x - e.cx) ** 2) / (e.rx ** 2) + ((y - e.cy) ** 2) / (e.ry ** 2) <= 1);

    // Points normalisés (0..1), générés une fois — indépendants du viewport
    const brainNorm: [number, number][] = [];
    while (brainNorm.length < N) {
      const x = Math.random(), y = Math.random();
      if (insideBrain(x, y)) brainNorm.push([x, y]);
    }

    const chaosNorm: [number, number][] = Array.from({ length: N }, () => [Math.random(), Math.random()]);
    const driftNorm: [number, number][] = Array.from({ length: N }, () => [Math.random(), Math.random()]);

    // Papillon : union d'ellipses (2 grandes ailes, 2 petites, corps) + antennes
    const WING_ELLIPSES = [
      { cx: 0.5, cy: 0.54, rx: 0.028, ry: 0.2, a: 0 },        // corps
      { cx: 0.345, cy: 0.375, rx: 0.165, ry: 0.135, a: -0.45 }, // aile haute gauche
      { cx: 0.655, cy: 0.375, rx: 0.165, ry: 0.135, a: 0.45 },  // aile haute droite
      { cx: 0.4, cy: 0.665, rx: 0.105, ry: 0.125, a: 0.35 },    // aile basse gauche
      { cx: 0.6, cy: 0.665, rx: 0.105, ry: 0.125, a: -0.35 },   // aile basse droite
    ];

    const insideButterfly = (x: number, y: number) =>
      WING_ELLIPSES.some((w) => {
        const dx = x - w.cx, dy = y - w.cy;
        const c = Math.cos(w.a), s = Math.sin(w.a);
        const xr = dx * c + dy * s, yr = -dx * s + dy * c;
        return (xr * xr) / (w.rx * w.rx) + (yr * yr) / (w.ry * w.ry) <= 1;
      });

    const butterflyNorm: [number, number][] = [];
    for (let k = 0; k < 8; k++) {
      const t = k / 7;
      butterflyNorm.push([0.5 - 0.03 - t * 0.06 - t * t * 0.03, 0.33 - t * 0.09]);
      butterflyNorm.push([0.5 + 0.03 + t * 0.06 + t * t * 0.03, 0.33 - t * 0.09]);
    }
    while (butterflyNorm.length < N) {
      const x = Math.random(), y = Math.random();
      if (insideButterfly(x, y)) butterflyNorm.push([x, y]);
    }

    // Texte « TOI. » : échantillonnage de pixels d'un canvas offscreen
    const sampleText = (word: string): [number, number][] => {
      const off = document.createElement('canvas');
      off.width = 600;
      off.height = 260;
      const octx = off.getContext('2d')!;
      octx.fillStyle = '#fff';
      octx.font = '900 190px -apple-system, BlinkMacSystemFont, sans-serif';
      octx.textAlign = 'center';
      octx.textBaseline = 'middle';
      octx.fillText(word, 300, 135);
      const data = octx.getImageData(0, 0, 600, 260).data;
      const pts: [number, number][] = [];
      for (let y = 0; y < 260; y += 4) {
        for (let x = 0; x < 600; x += 4) {
          if (data[(y * 600 + x) * 4 + 3] > 128) pts.push([x / 600, y / 260]);
        }
      }
      // Ajuste au nombre de particules
      const out: [number, number][] = [];
      for (let i = 0; i < N; i++) out.push(pts[Math.floor(Math.random() * pts.length)]);
      return out;
    };
    const textNorm = sampleText('TOI.');

    // ---------- Mise à l'échelle viewport ----------
    // Chaque forme = { cx, cy, w, h } en fraction du viewport
    type Frame = { cx: number; cy: number; w: number; h: number };
    let frames: Frame[] = [];

    const brainAnchor = document.getElementById('brainAnchor');

    const computeFrames = () => {
      VW = window.innerWidth;
      VH = window.innerHeight;
      canvas.width = VW * DPR;
      canvas.height = VH * DPR;
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

      // Position du cerveau : sur l'ancre du hero (mesurée à scroll≈0)
      let bx = 0.72, by = 0.45, bs = 0.55;
      if (brainAnchor) {
        const r = brainAnchor.getBoundingClientRect();
        const docY = r.top + window.scrollY + r.height / 2;
        bx = (r.left + r.width / 2) / VW;
        by = Math.min(docY, VH * 0.6) / VH;
        bs = Math.min((r.width * 1.05) / Math.min(VW, VH), 0.72);
      }

      const S = Math.min(VW, VH);
      frames = [
        { cx: bx * VW, cy: by * VH, w: S * bs, h: S * bs * 0.9 },          // cerveau
        { cx: VW / 2, cy: VH / 2, w: VW * 0.94, h: VH * 0.94 },            // chaos
        { cx: VW / 2, cy: VH * 0.46, w: S * 0.78, h: S * 0.78 },           // papillon
        { cx: VW / 2, cy: VH / 2, w: VW * 0.9, h: VH * 0.9 },              // constellation
        { cx: VW / 2, cy: VH * 0.40, w: Math.min(VW * 0.6, 680), h: Math.min(VW * 0.6, 680) * 0.43 }, // TOI.
      ];
    };

    const SHAPES = [brainNorm, chaosNorm, butterflyNorm, driftNorm, textNorm];
    // Opacité et taille des points par scène
    const SCENE_ALPHA = [1, 0.42, 0.95, 0.3, 1];
    const SCENE_SIZE = [1, 0.8, 0.95, 0.7, 1.15];

    const shapeXY = (scene: number, i: number): [number, number] => {
      const [nx, ny] = SHAPES[scene][i];
      const f = frames[scene];
      return [f.cx + (nx - 0.5) * f.w, f.cy + (ny - 0.5) * f.h];
    };

    // ---------- Particules ----------
    type P = {
      x: number; y: number; vx: number; vy: number;
      r: number; phase: number; delay: number; excite: number;
    };
    const parts: P[] = [];

    // ---------- Synapses (uniquement scène cerveau) ----------
    const edges: [number, number][] = [];
    const neighbors: number[][] = Array.from({ length: N }, () => []);
    {
      const MAX_D = 0.075;
      for (let i = 0; i < N; i++) {
        for (let j = i + 1; j < N; j++) {
          const dx = brainNorm[i][0] - brainNorm[j][0];
          const dy = brainNorm[i][1] - brainNorm[j][1];
          if (Math.hypot(dx, dy) < MAX_D && neighbors[i].length < 4 && neighbors[j].length < 4) {
            edges.push([i, j]);
            neighbors[i].push(j);
            neighbors[j].push(i);
          }
        }
      }
    }

    type Pulse = { a: number; b: number; t: number; speed: number; hops: number };
    const pulses: Pulse[] = [];
    const spawnPulse = (from?: number, hops = 3 + Math.floor(Math.random() * 3)) => {
      const a = from ?? Math.floor(Math.random() * N);
      const nbrs = neighbors[a];
      if (!nbrs.length) return;
      pulses.push({ a, b: nbrs[Math.floor(Math.random() * nbrs.length)], t: 0, speed: 0.02 + Math.random() * 0.025, hops });
    };

    // ---------- Progression de scène pilotée par le scroll ----------
    const sceneEls = [
      document.getElementById('scene-hero'),
      document.getElementById('scene-problem'),
      document.getElementById('methode'),
      document.getElementById('scene-stories'),
      document.getElementById('scene-final'),
    ];

    let anchors: number[] = [];
    const computeAnchors = () => {
      anchors = sceneEls.map((el, i) => {
        if (!el) return i * VH * 2;
        const top = el.getBoundingClientRect().top + window.scrollY;
        return i === 0 ? 0 : Math.max(1, top - VH * 0.45);
      });
      // Assure la monotonie
      for (let i = 1; i < anchors.length; i++) anchors[i] = Math.max(anchors[i], anchors[i - 1] + 1);
    };

    const scrollToProgress = (s: number) => {
      if (s <= anchors[0]) return 0;
      let g = anchors.length - 1;
      for (let i = 0; i < anchors.length - 1; i++) {
        if (s < anchors[i + 1]) { g = i + (s - anchors[i]) / (anchors[i + 1] - anchors[i]); break; }
      }
      // Plateaux : chaque forme tient pendant sa section, le morph
      // n'occupe que le milieu de la transition (30 % → 85 %)
      const i = Math.floor(g);
      const t = g - i;
      const m = Math.max(0, Math.min(1, (t - 0.3) / 0.55));
      return i + m;
    };

    // ---------- Init ----------
    computeFrames();
    computeAnchors();

    const ease = (t: number) => t * t * (3 - 2 * t); // smoothstep

    // Démarre directement sur la scène du scroll actuel
    // (reload en milieu de page, lien #methode, etc.)
    let gTarget = scrollToProgress(window.scrollY);
    let gCur = gTarget;

    const s0 = Math.max(0, Math.min(Math.floor(gCur), SHAPES.length - 2));
    const t0 = ease(Math.max(0, Math.min(1, gCur - s0)));
    for (let i = 0; i < N; i++) {
      const [ax0, ay0] = shapeXY(s0, i);
      const [bx0, by0] = shapeXY(Math.min(s0 + 1, SHAPES.length - 1), i);
      parts.push({
        x: ax0 + (bx0 - ax0) * t0,
        y: ay0 + (by0 - ay0) * t0,
        vx: 0, vy: 0,
        r: 0.9 + Math.random() * 1.3,
        phase: Math.random() * Math.PI * 2,
        delay: Math.random() * 0.3,
        excite: 0,
      });
    }

    window.addEventListener('resize', () => { computeFrames(); computeAnchors(); });

    // Les hauteurs de sections bougent quand fonts et images arrivent :
    // on remesure les ancres dès que la hauteur du document change
    new ResizeObserver(() => {
      computeAnchors();
      const g = scrollToProgress(window.scrollY);
      // juste après le chargement, on saute directement à la bonne scène
      if (Math.abs(g - gCur) > 0.5 && performance.now() - bootAt < 4000) {
        gCur = g;
        gTarget = g;
        teleportTo(g);
      }
    }).observe(document.body);

    // Débogage : état interne consultable en console
    (window as any).__morphDebug = () => ({ gCur, gTarget, scrollY: window.scrollY, anchors: [...anchors] });

    // ---------- Interactions ----------
    let mouseX = -9999, mouseY = -9999;
    window.addEventListener('pointermove', (e) => { mouseX = e.clientX; mouseY = e.clientY; });
    window.addEventListener('pointerleave', () => { mouseX = -9999; mouseY = -9999; });

    // Clic n'importe où (hors liens/boutons) = onde de choc
    type Wave = { x: number; y: number; r: number };
    const waves: Wave[] = [];
    page.addEventListener('pointerdown', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a, button, input, .v-rewrite')) return;
      waves.push({ x: e.clientX, y: e.clientY, r: 0 });
      // Décharge dans le cerveau si on est en scène 0
      if (gCur < 0.5) {
        let closest = 0, best = Infinity;
        parts.forEach((p, i) => {
          const d = Math.hypot(p.x - e.clientX, p.y - e.clientY);
          if (d < best) { best = d; closest = i; }
          if (d < 100) p.excite = 1;
        });
        for (let k = 0; k < 6; k++) spawnPulse(closest, 4 + Math.floor(Math.random() * 3));
      }
    });

    // ---------- Boucle ----------
    let time = 0;
    let spawnTimer = 0;
    let idleFrames = 0;
    const bootAt = performance.now();

    const lerpArr = (arr: number[], g: number) => {
      const i = Math.min(Math.floor(g), arr.length - 2);
      const t = g - i;
      return arr[i] + (arr[i + 1] - arr[i]) * t;
    };

    // Place instantanément chaque particule sur la forme correspondant à g
    const teleportTo = (g: number) => {
      const s = Math.max(0, Math.min(Math.floor(g), SHAPES.length - 2));
      const t = ease(Math.max(0, Math.min(1, g - s)));
      for (let i = 0; i < N; i++) {
        const [ax, ay] = shapeXY(s, i);
        const [bx2, by2] = shapeXY(Math.min(s + 1, SHAPES.length - 1), i);
        parts[i].x = ax + (bx2 - ax) * t;
        parts[i].y = ay + (by2 - ay) * t;
        parts[i].vx = 0;
        parts[i].vy = 0;
      }
    };

    const frame = () => {
      requestAnimationFrame(frame);

      gTarget = scrollToProgress(window.scrollY);
      let diff = gTarget - gCur;

      // Restauration de scroll / ancre juste après le chargement :
      // on saute directement à la scène, sans traversée de tout l'écran
      if (Math.abs(diff) > 0.5 && performance.now() - bootAt < 1500) {
        gCur = gTarget;
        diff = 0;
        teleportTo(gCur);
      }

      gCur += diff * 0.06;

      // Économie : si rien ne bouge et pas d'activité, saute des frames
      const active = Math.abs(diff) > 0.001 || pulses.length > 0 || waves.length > 0 || mouseX > -999 || gCur < 0.5;
      if (!active && ++idleFrames % 3 !== 0) return;

      time += 0.016;

      const sceneA = Math.max(0, Math.min(Math.floor(gCur), SHAPES.length - 2));
      const brainW = Math.max(0, 1 - gCur * 1.6); // poids de la scène cerveau
      const globalAlpha = lerpArr(SCENE_ALPHA, gCur);
      const sizeF = lerpArr(SCENE_SIZE, gCur);

      ctx.clearRect(0, 0, VW, VH);

      // Synapses du cerveau
      if (brainW > 0.03) {
        for (const [i, j] of edges) {
          const a = parts[i], b = parts[j];
          const alpha = (0.05 + (a.excite + b.excite) * 0.18) * brainW;
          ctx.strokeStyle = `rgba(96, 140, 255, ${alpha})`;
          ctx.lineWidth = 0.7;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }

        // Impulsions
        spawnTimer -= 0.016;
        if (spawnTimer <= 0 && pulses.length < 14 && brainW > 0.6) {
          spawnPulse();
          spawnTimer = 0.35 + Math.random() * 0.5;
        }
        for (let p = pulses.length - 1; p >= 0; p--) {
          const pulse = pulses[p];
          pulse.t += pulse.speed;
          const a = parts[pulse.a], b = parts[pulse.b];
          const x = a.x + (b.x - a.x) * pulse.t;
          const y = a.y + (b.y - a.y) * pulse.t;
          ctx.fillStyle = `rgba(140, 175, 255, ${0.25 * brainW})`;
          ctx.beginPath(); ctx.arc(x, y, 5, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = `rgba(220, 232, 255, ${0.95 * brainW})`;
          ctx.beginPath(); ctx.arc(x, y, 1.8, 0, Math.PI * 2); ctx.fill();
          if (pulse.t >= 1) {
            b.excite = 1;
            const nbrs = neighbors[pulse.b].filter((n) => n !== pulse.a);
            if (pulse.hops > 0 && nbrs.length) {
              pulse.a = pulse.b;
              pulse.b = nbrs[Math.floor(Math.random() * nbrs.length)];
              pulse.t = 0; pulse.hops--;
            } else {
              pulses.splice(p, 1);
            }
          }
        }
      } else if (pulses.length) {
        pulses.length = 0;
      }

      // Ondes de choc
      for (let w = waves.length - 1; w >= 0; w--) {
        waves[w].r += 16;
        if (waves[w].r > Math.max(VW, VH)) waves.splice(w, 1);
      }

      // Particules
      for (let i = 0; i < N; i++) {
        const p = parts[i];

        // Morph avec décalage individuel → effet nuée organique
        const local = Math.max(0, Math.min(1, ((gCur - sceneA) - p.delay) / 0.7));
        const t = ease(local);
        const [ax, ay] = shapeXY(sceneA, i);
        const [bx2, by2] = shapeXY(Math.min(sceneA + 1, SHAPES.length - 1), i);
        const tx = ax + (bx2 - ax) * t;
        const ty = ay + (by2 - ay) * t;

        // Ressort vers la cible
        p.vx += (tx - p.x) * 0.012;
        p.vy += (ty - p.y) * 0.012;

        // Répulsion souris
        const dmx = p.x - mouseX, dmy = p.y - mouseY;
        const dm = Math.hypot(dmx, dmy);
        if (dm < 130 && dm > 0.5) {
          const f = (1 - dm / 130) * 1.4;
          p.vx += (dmx / dm) * f;
          p.vy += (dmy / dm) * f;
          p.excite = Math.max(p.excite, 1 - dm / 130);
        }

        // Ondes de choc
        for (const w of waves) {
          const dwx = p.x - w.x, dwy = p.y - w.y;
          const dw = Math.hypot(dwx, dwy);
          if (Math.abs(dw - w.r) < 70 && dw > 0.5) {
            const f = (1 - Math.abs(dw - w.r) / 70) * 3.2;
            p.vx += (dwx / dw) * f;
            p.vy += (dwy / dw) * f;
            p.excite = Math.max(p.excite, 0.7);
          }
        }

        p.vx *= 0.86;
        p.vy *= 0.86;
        p.x += p.vx + Math.sin(time * 0.8 + p.phase) * 0.15;
        p.y += p.vy + Math.cos(time * 0.7 + p.phase * 1.3) * 0.15;

        p.excite *= 0.94;

        // Rendu
        const twinkle = 0.5 + 0.5 * Math.sin(time * 1.4 + p.phase);
        const alpha = (0.3 + twinkle * 0.15 + p.excite * 0.55) * globalAlpha;
        const radius = (p.r + p.excite * 2) * sizeF;

        if (p.excite > 0.25) {
          ctx.fillStyle = `rgba(122, 162, 255, ${p.excite * 0.2 * globalAlpha})`;
          ctx.beginPath();
          ctx.arc(p.x, p.y, radius * 3.2, 0, Math.PI * 2);
          ctx.fill();
        }

        const mix = Math.min(1, p.excite * 1.2);
        const rC = Math.round(120 + mix * 120);
        const gC = Math.round(158 + mix * 80);
        ctx.fillStyle = `rgba(${rC}, ${gC}, 255, ${alpha})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    if (reducedMotion) {
      // Statique : cerveau seul, une frame
      for (const [i, j] of edges) {
        const [ax, ay] = shapeXY(0, i);
        const [bx2, by2] = shapeXY(0, j);
        ctx.strokeStyle = 'rgba(96, 140, 255, 0.08)';
        ctx.lineWidth = 0.7;
        ctx.beginPath(); ctx.moveTo(ax, ay); ctx.lineTo(bx2, by2); ctx.stroke();
      }
      for (let i = 0; i < N; i++) {
        const [x, y] = shapeXY(0, i);
        ctx.fillStyle = 'rgba(140, 170, 255, 0.4)';
        ctx.beginPath(); ctx.arc(x, y, parts[i]?.r || 1.4, 0, Math.PI * 2); ctx.fill();
      }
    } else {
      frame();
    }
  }

  // ==========================================================
  // 3. Terminal de réécriture des croyances
  // ==========================================================
  const rwText = document.getElementById('rwText');
  const rwLabel = document.getElementById('rwLabel');
  const rwBox = document.getElementById('rewriteBox');

  if (rwText && rwLabel && rwBox && !reducedMotion) {
    const PAIRS = [
      ["Je n'y arriverai jamais.", 'Tout est possible pour moi.'],
      ['Je ne suis pas fait pour réussir.', 'Le succès est ma normalité.'],
      ["C'est trop tard pour moi.", 'Tout commence maintenant.'],
      ["Je n'ai pas de chance.", 'Je crée mes opportunités.'],
    ];

    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const type = async (text: string, speed: number) => {
      for (let i = 1; i <= text.length; i++) {
        rwText.textContent = text.slice(0, i);
        await sleep(speed + Math.random() * 30);
      }
    };

    const erase = async () => {
      const t = rwText.textContent || '';
      for (let i = t.length; i >= 0; i--) {
        rwText.textContent = t.slice(0, i);
        await sleep(16);
      }
    };

    (async () => {
      let idx = 0;
      await sleep(1400);
      while (true) {
        const [oldP, newP] = PAIRS[idx % PAIRS.length];

        rwBox.classList.remove('is-new');
        rwLabel.textContent = 'programme détecté';
        await type(oldP, 45);
        await sleep(1600);

        await erase();
        rwBox.classList.add('is-new');
        rwLabel.textContent = 'réécriture';
        await sleep(350);
        await type(newP, 55);
        await sleep(2600);

        await erase();
        await sleep(500);
        idx++;
      }
    })();
  } else if (rwText && rwLabel && rwBox) {
    rwLabel.textContent = 'réécriture';
    rwBox.classList.add('is-new');
    rwText.textContent = 'Tout est possible pour moi.';
  }

  // ==========================================================
  // 4. Compteurs animés
  // ==========================================================
  const formatFr = (n: number) => n.toLocaleString('fr-FR').replace(/ | /g, ' ');

  const counterObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        counterObserver.unobserve(entry.target);
        const el = entry.target as HTMLElement;
        const target = parseInt(el.dataset.counter || '0', 10);
        const useFr = el.dataset.format === 'fr';
        if (reducedMotion) {
          el.textContent = useFr ? formatFr(target) : String(target);
          continue;
        }
        const start = performance.now();
        const dur = 1600;
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 4);
          const val = Math.round(target * eased);
          el.textContent = useFr ? formatFr(val) : String(val);
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
    },
    { threshold: 0.5 }
  );
  document.querySelectorAll('#visu-page [data-counter]').forEach((el) => counterObserver.observe(el));

  // ==========================================================
  // 5. Tilt 3D sur les cartes
  // ==========================================================
  if (!reducedMotion && window.matchMedia('(pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('#visu-page [data-tilt]').forEach((card) => {
      let raf = 0;
      card.addEventListener('pointermove', (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const rect = card.getBoundingClientRect();
          const nx = (e.clientX - rect.left) / rect.width - 0.5;
          const ny = (e.clientY - rect.top) / rect.height - 0.5;
          card.style.transform = `rotateX(${(-ny * 6).toFixed(2)}deg) rotateY(${(nx * 8).toFixed(2)}deg) translateY(-3px)`;
        });
      });
      card.addEventListener('pointerleave', () => {
        cancelAnimationFrame(raf);
        card.style.transform = '';
        card.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s';
        setTimeout(() => { card.style.transition = ''; }, 600);
      });
    });
  }
</script>
